            response: bookingPrompt,
            booking: currentBooking,
            debug: { 
              intent: 'emergency_to_booking', 
              emergencyType: currentBooking.emergencyType,
              stage: 'booking_details'
            },
            metadata: { 
              emergency: true, 
              emergencyType: currentBooking.emergencyType,
              emergencyStage: 'booking',
              urgentBooking: true
            }
          };
        }
        
        // Default emergency mode response: acknowledge and request booking details
