    }
    // === SUMP PUMP ===
    else if (/\b(?:sump\s*pump)\s+(?:won'?t|wont|doesn'?t|not)\s+(?:turn\s+on|start|work|run)\b/i.test(message) ||
             /\b(?:sump\s*pump)\s+(?:is\s+)?(?:not\s+working|broken|dead)\b/i.test(message)) {
