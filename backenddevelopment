        return { 
          confidence: 'medium', 
          reason: 'confidence_floor_problem_known', 
          matchedIntent: intent.intent,
          matchedProblemType: existingProblemType 
        };
      }
      return { 
        confidence: 'low', 
        reason: 'plumbing_keywords_no_match', 
        matchedIntent: intent.intent,
        matchedProblemType: null 
      };
    }
    
    // Very short messages that could be anything
    if (msg.length < 15 && !entities.problemType) {
      // GUARD: If problem already known, floor to MEDIUM
      if (existingProblemType) {
        return { 
          confidence: 'medium', 
          reason: 'confidence_floor_problem_known', 
          matchedIntent: intent.intent,
          matchedProblemType: existingProblemType 
        };
      }
      return { 
        confidence: 'low', 
        reason: 'too_short', 
        matchedIntent: intent.intent,
        matchedProblemType: null 
      };
    }
    
    // Typo-heavy or text-speak that regex might miss
    if (/[0-9]/.test(msg.replace(/\d{1,5}\s/g, '')) && /\b(2|4|u|r|ur|pls|plz|thx|rn)\b/i.test(msg)) {
      // GUARD: If problem already known, floor to MEDIUM
      if (existingProblemType) {
        return { 
          confidence: 'medium', 
          reason: 'confidence_floor_problem_known', 
          matchedIntent: intent.intent,
          matchedProblemType: existingProblemType 
        };
      }
      return { 
        confidence: 'low', 
        reason: 'text_speak_detected', 
        matchedIntent: intent.intent,
        matchedProblemType: entities.problemType 
      };
    }
    
    // No problem type detected at all
    if (!entities.problemType && intent.intent !== 'greeting' && intent.intent !== 'company_question') {
      // GUARD: If problem already known, floor to MEDIUM
      if (existingProblemType) {
        return { 
          confidence: 'medium', 
          reason: 'confidence_floor_problem_known', 
          matchedIntent: intent.intent,
          matchedProblemType: existingProblemType 
        };
      }
      return { 
        confidence: 'low', 
        reason: 'no_problem_detected', 
        matchedIntent: intent.intent,
        matchedProblemType: null 
      };
    }
    
    // Default: medium if we have something, low if we don't
    if (entities.problemType || intent.confidence >= 0.7) {
      return { 
        confidence: 'medium', 
        reason: 'default_with_signal', 
        matchedIntent: intent.intent,
        matchedProblemType: entities.problemType 
      };
    }
    
    // FINAL GUARD: If problem known but we'd return LOW, floor to MEDIUM
    if (existingProblemType) {
      return { 
        confidence: 'medium', 
        reason: 'confidence_floor_problem_known', 
        matchedIntent: intent.intent,
        matchedProblemType: existingProblemType 
      };
    }
    
    return { 
      confidence: 'low', 
      reason: 'no_clear_signal', 
      matchedIntent: null,
      matchedProblemType: null 
    };
  },
  
  // Check if AI should handle this message (either for classification or generation)
  shouldUseAI: function(confidenceResult) {
    return confidenceResult.confidence === 'low' || 
           confidenceResult.confidence === 'medium' ||
           confidenceResult.confidence === 'emergency_triage';
  },
  
  // MEDIUM confidence: AI should CLASSIFY only, then fall through to deterministic response
  // AI extracts intent/entities but does NOT generate customer-facing response
  shouldClassifyWithAI: function(confidenceResult) {
    return confidenceResult.confidence === 'medium';
  },
  
  // LOW confidence: AI can GENERATE a full response (rare case - truly ambiguous)
  // Only when regex has zero signal and we need AI to ask a clarifying question
  shouldGenerateWithAI: function(confidenceResult) {
    return confidenceResult.confidence === 'low';
  },
  
  // Check if this is a hard block (AI has no say)
  isBlocked: function(confidenceResult) {
    return confidenceResult.confidence === 'blocked';
  },
  
  // Check if this requires emergency triage
  isEmergencyTriage: function(confidenceResult) {
    return confidenceResult.confidence === 'emergency_triage';
  }
};

// =============================================================================
// AI OUTPUT GUARD - Global enforcement of confidence tier rules
// =============================================================================
// RULE: AI-authored text output is ONLY allowed when confidence === 'low'
// This guard must be checked before ANY AI-generated response is returned
// AI classification/routing is allowed at all tiers, but AI-authored OUTPUT is not
const AI_OUTPUT_GUARD = {
  // Current confidence level for this message (set at start of processMessage)
  _currentConfidence: null,
  
  // Set the confidence level for the current message
  setConfidence: function(confidence) {
    this._currentConfidence = confidence;
  },
  
  // Get current confidence
  getConfidence: function() {
    return this._currentConfidence;
  },
  
  // Check if AI-authored output is allowed
  // Returns true ONLY when confidence === 'low' OR 'emergency_triage' (safety-critical)
  isAIOutputAllowed: function() {
    return this._currentConfidence === 'low' || this._currentConfidence === 'emergency_triage';
  },
  
  // Guard function: Call before returning any AI-generated response
  // If AI output is not allowed, returns a deterministic fallback
  // Otherwise returns null (allowing the AI response to proceed)
  guardResponse: function(aiResponse, booking, fallbackFn) {
    if (this.isAIOutputAllowed()) {
      return null; // AI output allowed, proceed with AI response
    }
    
    // AI output NOT allowed - must use deterministic fallback
    console.warn('AI_OUTPUT_GUARD: Blocked AI-authored output at confidence:', this._currentConfidence);
    
    if (typeof fallbackFn === 'function') {
      return fallbackFn(booking);
    }
    
    // Default fallback: request booking details
    return {
      response: "Got it. What's your name and address so we can get someone out to help?",
      blocked: true,
      reason: `AI output blocked at ${this._currentConfidence} confidence`
    };
  },
  
  // Reset at end of message processing
  reset: function() {
    this._currentConfidence = null;
  }
};

