  async function callOpenAI(messages, context) {
    const apiKey = CONFIG.OPENAI_API_KEY;
    
    if (!apiKey || !apiKey.startsWith('sk-')) {
      throw new Error('Invalid OpenAI API key in CONFIG');
    }

    // Retry logic: attempt up to 2 times
    for (let attempt = 0; attempt < 2; attempt++) {
    try {
      const response = await fetch('https://api.openai.com/v1/chat/completions', {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${apiKey}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
            model: 'gpt-4o-mini',
          messages: messages,
          max_tokens: 150,
          temperature: 0.3
        })
      });

      if (!response.ok) {
        throw new Error(`OpenAI API error: ${response.status}`);
      }

      const data = await response.json();
      return data.choices[0].message.content.trim();
    } catch (error) {
        console.error(`OpenAI API call failed (attempt ${attempt + 1}):`, error);
        if (attempt === 0) {
          // Wait 150ms before retry
          await new Promise(resolve => setTimeout(resolve, 150));
        } else {
      throw error;
        }
      }
    }
  }

  // Helper to check if information was already provided in diagnostic history
  function wasAlreadyAnswered(diagnosticHistory, patterns) {
    const allMessages = diagnosticHistory.map(msg => msg.content.toLowerCase()).join(' ');
    return patterns.some(pattern => pattern.test(allMessages));
  }

  // Extract diagnostic slots from all messages in history
  function extractSlotsFromHistory(diagnosticHistory) {
    let slots = {};
    for (const msg of diagnosticHistory) {
      if (msg.role === 'customer') {
        slots = extractDiagnosticSlots(msg.content, slots);
      }
    }
    return slots;
  }

  // Extract and update diagnostic slots from customer message
  function extractDiagnosticSlots(message, currentSlots = {}) {
    const msg = message.toLowerCase();
    const slots = { ...currentSlots };
    
    // =======================================================================
    // IDEMPOTENT SLOT EXTRACTION: Once a dimension is resolved, NEVER overwrite
    // This prevents re-asking the same dimension
    // =======================================================================
    
    // Helper: Only set slot if not already resolved
    const setIfUnresolved = (slotName, value) => {
      if (slots[slotName] === undefined || slots[slotName] === null) {
        slots[slotName] = value;
      }
    };
    
    // SEVERITY DIMENSION - ONLY resolves on EXPLICIT severity language
    // Does NOT resolve from vague descriptions, frequency, or activity alone
    if (!slots.severity) {
      // EXPLICIT HIGH-SEVERITY patterns
      if (/\b(overflow|overflowing|flood|flooding|gush|gushing|spray|spraying|burst|bursting|pour|pouring)\b/i.test(msg) ||
          /\b(completely\s*(blocked|clogged)|totally\s*(blocked|clogged)|100%\s*(blocked|clogged))\b/i.test(msg) ||
          /\b(no\s*water\s*at\s*all|won'?t\s*(drain|flush)\s*at\s*all|not\s*draining\s*at\s*all)\b/i.test(msg) ||
          /\b(sewage|raw\s*sewage|waste\s*water)\b/i.test(msg) ||
          /\b(emergency|urgent|serious|severe|major)\b/i.test(msg)) {
        setIfUnresolved('severity', 'severe');
      }
      // EXPLICIT LOW-SEVERITY patterns
      else if (/\b(small\s*drip|minor\s*leak|slow\s*leak|tiny\s*drip|occasional\s*drip)\b/i.test(msg) ||
               /\b(minor|slight|small|little|tiny)\s*(leak|drip|issue|problem)?\b/i.test(msg) ||
               /\b(not\s*(too|that)\s*bad|not\s*urgent|no\s*rush|when\s*you\s*can)\b/i.test(msg) ||
               /\b(drains?\s*slow|slow\s*drain|takes\s*a\s*while|a\s*bit\s*slow)\b/i.test(msg)) {
        setIfUnresolved('severity', 'partial');
      }
      // NOTE: Vague descriptions like "it's clogged" or "there's a leak" do NOT resolve severity
    }
    
    // SCOPE DIMENSION - Single vs multiple fixtures
    if (!slots.scope) {
      if (/\b(just|only)\s*(that|this|the)?\s*(one|1|toilet|sink|drain|faucet|shower)\b/i.test(msg) ||
          /\b(that\s*one|this\s*one|only\s*one|single|^1$|1\s+of)\b/i.test(msg) ||
          /\bjust\s*(it|that|this|1|one)\b/i.test(msg)) {
        setIfUnresolved('scope', 'single');
      }
      else if (/\b(other|multiple|all|every|several|both|few|couple|[2-9])\s*(drain|toilet|sink|fixture|faucet)?s?\b/i.test(msg) ||
               /\b(others?\s*too|them\s*too|those\s*too)\b/i.test(msg) ||
               /\b(whole\s*house|everywhere|all\s*over)\b/i.test(msg) ||
               /\b([2-9]|[1-9][0-9]+)\s+of\b/i.test(msg)) {
        setIfUnresolved('scope', 'multiple');
      }
    }
    
    // ACTIVE STATUS - Is it happening right now?
    // FIX B: Also resolve from "when you use it" / "only when running" patterns
    if (!slots.active) {
      if (/\b(still|currently|right\s*now|at\s*the\s*moment|as\s*we\s*speak)\b/i.test(msg) ||
          /\b(still\s*(coming|flowing|running|leaking|going|dripping))\b/i.test(msg) ||
          /\b(won'?t\s*stop|can'?t\s*stop|keeps?\s*(going|running|leaking))\b/i.test(msg) ||
          /\byes\b/i.test(msg)) {
        setIfUnresolved('active', 'yes');
      }
      else if (/\b(stopped|not\s*anymore|turned\s*off|shut\s*off|no\s*longer)\b/i.test(msg) ||
               /\b(earlier|before|was|used\s*to)\b/i.test(msg) ||
               /\b(?:only\s+)?(?:when|while)\s+(?:you\s+)?(?:use|run|turn\s+on)\b/i.test(msg) ||
               /\bjust\s+when\s+(?:using|running)\b/i.test(msg) ||
               /\bno\b/i.test(msg)) {
        setIfUnresolved('active', 'no');
      }
    }
    
    // FREQUENCY - Constant vs intermittent
    if (!slots.frequency) {
      if (/\b(constant|constantly|all\s*the\s*time|won'?t\s*stop|always|non-?stop|24\/7)\b/i.test(msg)) {
        setIfUnresolved('frequency', 'constant');
      }
      else if (/\b(intermittent(?:ly)?|starts?\s*and\s*stops?|sometimes|on\s*its\s*own|every\s*(few|couple)|off\s*and\s*on|comes?\s*and\s*goes?)\b/i.test(msg)) {
        setIfUnresolved('frequency', 'intermittent');
      }
    }
    
    // LOCATION - Room
    if (!slots.room) {
      if (/\b(kitchen|kitchin|kichen)\b/i.test(msg)) setIfUnresolved('room', 'kitchen');
      else if (/\b(bathroom|bath|washroom|restroom|half\s*bath|master\s*bath)\b/i.test(msg)) setIfUnresolved('room', 'bathroom');
      else if (/\b(laundry|utility|mud\s*room)\b/i.test(msg)) setIfUnresolved('room', 'laundry');
      else if (/\b(garage)\b/i.test(msg)) setIfUnresolved('room', 'garage');
    }
    
    // LOCATION - Floor level
    if (!slots.floor) {
      if (/\b(basement|downstairs|lower\s*level|cellar)\b/i.test(msg)) setIfUnresolved('floor', 'basement');
      else if (/\b(first\s*floor|main\s*floor|ground\s*floor|main\s*level)\b/i.test(msg)) setIfUnresolved('floor', 'first');
      else if (/\b(second\s*floor|upstairs|2nd\s*floor|upper)\b/i.test(msg)) setIfUnresolved('floor', 'second');
    }
    
    // APPLIANCE TYPE - Gas vs electric
    // NOTE: Uncertainty detection moved to forceResolveSlots where booking state is available
    if (!slots.appliance_type) {
      if (/\b(gas|gas\s*water\s*heater|natural\s*gas)\b/i.test(msg)) setIfUnresolved('appliance_type', 'gas');
      else if (/\b(electric|electrical|electric\s*water\s*heater)\b/i.test(msg)) setIfUnresolved('appliance_type', 'electric');
    }
    
    // AMOUNT - Small vs large
    if (!slots.amount) {
      if (/\b(little|small|bit|slight|tiny|drip|trickle)\b/i.test(msg)) setIfUnresolved('amount', 'small');
      else if (/\b(lot|lots|much|flood|everywhere|soaked|puddle|pool|gushing|pouring)\b/i.test(msg)) setIfUnresolved('amount', 'large');
    }
    
    // LEAK LOCATION - Specific to leak issues
    if (!slots.leak_location) {
      if (/\b(base|bottom|floor)\b/i.test(msg) && /\b(toilet|tank)\b/i.test(msg)) setIfUnresolved('leak_location', 'base');
      else if (/\b(tank)\b/i.test(msg)) setIfUnresolved('leak_location', 'tank');
      else if (/\b(spout|tip|faucet\s*tip|spout\s*tip)\b/i.test(msg) && /\b(leak|drip|water)\b/i.test(msg)) setIfUnresolved('leak_location', 'spout');
      else if (/\b(supply\s*line|supply|hose|connection)\b/i.test(msg)) setIfUnresolved('leak_location', 'supply_line');
      else if (/\b(under|beneath|below)\s*(the\s*)?(sink|cabinet)\b/i.test(msg)) setIfUnresolved('leak_location', 'under_sink');
      else if (/\b(ceiling|above|overhead)\b/i.test(msg)) setIfUnresolved('leak_location', 'ceiling');
      else if (/\b(wall|behind)\b/i.test(msg)) setIfUnresolved('leak_location', 'wall');
      // FIX 1: Shower/tub leak location detection - prevent "Where exactly do you see the water?" repeat
      // Detects: edges of tub, base of shower, bottom, crack in base, around the edges
      else if (/\b(?:edge|edges)\s*(?:of\s*(?:the\s*)?)?(?:tub|shower|bathtub)\b/i.test(msg) ||
               /\b(?:around\s*(?:the\s*)?)?(?:edge|edges)\b/i.test(msg)) {
        setIfUnresolved('leak_location', 'edges');
      }
      else if (/\b(?:base|bottom)\s*(?:of\s*(?:the\s*)?)?(?:tub|shower|bathtub)\b/i.test(msg) ||
               /\b(?:tub|shower|bathtub)\s*(?:base|bottom)\b/i.test(msg) ||
               /\b(?:at\s*(?:the\s*)?)?(?:bottom|base)\b/i.test(msg) && /\b(?:shower|tub|bathtub)\b/i.test(msg)) {
        setIfUnresolved('leak_location', 'base');
      }
      else if (/\bcrack\s*(?:in\s*(?:the\s*)?)?(?:base|bottom|tub|shower)\b/i.test(msg) ||
               /\b(?:tub|shower|bathtub)\s*(?:has\s*(?:a\s*)?)?crack\b/i.test(msg) ||
               /\bcracked\s*(?:tub|shower|bathtub)\b/i.test(msg)) {
        setIfUnresolved('leak_location', 'crack');
      }
      // General shower/tub floor/pan leak
      else if (/\b(?:shower|tub|bathtub)\s*(?:pan|floor)\b/i.test(msg) ||
               /\b(?:pan|floor)\s*(?:of\s*(?:the\s*)?)?(?:shower|tub)\b/i.test(msg)) {
        setIfUnresolved('leak_location', 'pan');
      }
    }
    
    // PIPE LOCATION SLOT - For pipe-specific location answers
    // Detects "in the wall", "behind the wall", "in the basement", etc.
    // NOTE: Slot locking is done in forceResolveSlots which has access to booking
    if (!isSlotFilled(slots, 'pipe_location')) {
      // Wall variations - "in the wall", "inside the wall", "behind the wall", "it's in the walls"
      if (/\b(?:in|inside|behind|within|through)\s+(?:the\s+)?(?:wall|walls)\b/i.test(msg) ||
          /\b(?:wall|walls)\s+(?:somewhere|area|section)\b/i.test(msg) ||
          /\bit'?s\s+(?:in|inside|behind)\s+(?:the\s+)?wall/i.test(msg)) {
        slots.pipe_location = 'wall';
        // Also set leak_location for compatibility
        if (!slots.leak_location) {
          slots.leak_location = 'wall';
        }
      }
      // Basement variations - "in the basement", "down in the basement", "basement area"
      else if (/\b(?:in|down\s+in|in\s+the|down\s+the)\s+basement\b/i.test(msg) ||
               /\bbasement\s+(?:area|somewhere|floor|level)\b/i.test(msg)) {
        slots.pipe_location = 'basement';
      }
      // Crawlspace variations
      else if (/\b(?:in|under|in\s+the)\s+(?:crawl\s*space|crawl)\b/i.test(msg) ||
               /\bcrawl\s*space\b/i.test(msg)) {
        slots.pipe_location = 'crawlspace';
      }
      // Ceiling variations - "in the ceiling", "above", "overhead"
      else if (/\b(?:in|above|in\s+the)\s+ceiling\b/i.test(msg) ||
               /\bceiling\s+(?:area|somewhere)\b/i.test(msg)) {
        slots.pipe_location = 'ceiling';
      }
      // Under house/slab/foundation
      else if (/\b(?:under|beneath)\s+(?:the\s+)?(?:house|slab|foundation|floor)\b/i.test(msg) ||
               /\bslab\b/i.test(msg) || /\bfoundation\b/i.test(msg)) {
        slots.pipe_location = 'under_slab';
      }
      // Utility room / mechanical room
      else if (/\b(?:utility|mechanical|boiler)\s*room\b/i.test(msg) ||
               /\b(?:in|near)\s+(?:the\s+)?(?:utility|mechanical)\b/i.test(msg)) {
        slots.pipe_location = 'utility_room';
      }
      // Outside / exterior - but NOT "I'm outside" (evacuation confirmation)
      else if (/\b(?:outside|exterior|outdoor|outdoors|yard|garden)\b/i.test(msg) && 
               !/\b(?:i'?m|i\s+am|went|going|staying|moved|waiting|stepped)\s+(?:outside|outdoors)\b/i.test(msg) &&
               !/\boutside\s+(?:now|already|safe)\b/i.test(msg)) {
        slots.pipe_location = 'outside';
      }
      // Attic
      else if (/\b(?:in\s+(?:the\s+)?)?attic\b/i.test(msg)) {
        slots.pipe_location = 'attic';
      }
      // "Don't know" / "can't find" / "can't see" / uncertainty responses
      else if (/\b(?:don'?t\s*know|not\s*sure|can'?t\s*(?:find|see|tell)|no\s*idea|somewhere|hard\s+to\s+(?:tell|say)|can'?t\s+(?:locate|find))\b/i.test(msg)) {
        slots.pipe_location = 'unknown';
      }
    }
    
    // NON-LEAK PIPE ISSUE DETECTION - Suppress leak questions for noise/buildup/corrosion issues
    // When customer describes mineral deposits, scale, rust, noise, etc. - don't ask "where do you see the water?"
    const isNonLeakPipeIssue = 
      /\b(?:mineral|scale|buildup|build\s*up|deposit|corroded|corrosion|rust|rusty|old\s+pipe|aging|deteriorat)\b/i.test(msg) ||
      /\b(?:noisy|bang|banging|hammer|hammering|clunk|clunking|rattle|rattling|vibrat|whistl|squeal|screech)\b/i.test(msg);
    
    if (isNonLeakPipeIssue) {
      // Suppress leak location questions - there may be no visible water
      slots.suppressedQuestionTypes = [...(slots.suppressedQuestionTypes || []), 'leak_location', 'dripping', 'active_vs_drip'];
      slots.suppressedQuestionTypes = [...new Set(slots.suppressedQuestionTypes)];
      // Mark as non-leak issue
      slots.negativeSignals = [...(slots.negativeSignals || []), 'no_leak'];
      slots.negativeSignals = [...new Set(slots.negativeSignals)];
    }
    
    // WATER HEATER NON-LEAK ISSUE DETECTION - Suppress leak questions for non-leak water heater issues
    // When customer describes pilot light, no hot water, error codes, thermostat, etc. - don't ask "where is the leak?"
    // This is an EARLY CLASSIFICATION GATE to prevent wrong diagnostic path
    const isWaterHeaterContext = /\b(?:water\s*heater|hot\s*water\s*tank|tankless|heater|tank)\b/i.test(msg);
    const hasExplicitLeakSignal = /\b(?:leak|leaking|drip|dripping|puddle|water\s+on\s+(?:the\s+)?floor|water\s+around|pooling)\b/i.test(msg);
    
    const isWaterHeaterNonLeakIssue = isWaterHeaterContext && !hasExplicitLeakSignal && (
      // Pilot light / ignition issues
      /\b(?:pilot|pilot\s*light|won'?t\s+(?:stay\s+)?lit|keeps?\s+going\s+out|ignit|flame|burner|won'?t\s+ignite)\b/i.test(msg) ||
      // No hot water / temperature issues
      /\b(?:no\s+hot|not\s+hot|cold\s+water|lukewarm|not\s+warm|no\s+hot\s+water|temperature|temp\s+(?:issue|problem)|too\s+(?:hot|cold)|scalding)\b/i.test(msg) ||
      // Error codes (especially tankless)
      /\b(?:error\s*code|code\s*(?:\d+|E\d+|F\d+)|flashing|blinking|display|error\s*message)\b/i.test(msg) ||
      // Electric element / thermostat / breaker issues
      /\b(?:electric|element|thermostat|breaker|tripped|no\s+power|won'?t\s+turn\s+on|not\s+(?:heating|working))\b/i.test(msg) ||
      // Flow / pressure issues (tankless specific)
      /\b(?:flow|minimum\s+flow|low\s+flow|pressure|sensor|flow\s+(?:rate|sensor)|not\s+(?:enough|sufficient)\s+flow)\b/i.test(msg) ||
      // Performance / capacity issues
      /\b(?:runs?\s+out|doesn'?t\s+last|inconsistent|fluctuat|not\s+(?:hot\s+)?enough|limited\s+hot)\b/i.test(msg) ||
      // Dip tube / anode / internal component issues
      /\b(?:dip\s*tube|anode|anode\s*rod|sediment|flush|flushing)\b/i.test(msg) ||
      // Noise-only issues (no leak)
      /\b(?:noise|noisy|bang|banging|popping|rumbl|humming|kettling|sounds?\s+(?:like|weird|strange))\b/i.test(msg) ||
      // Smell issues (without leak context)
      /\b(?:rotten\s+egg|sulfur|smells?|odor)\b/i.test(msg) ||
      // Rust/discoloration in water (not a tank leak)
      /\b(?:rusty|rust|discolor|brown\s+water|dirty\s+water)\b/i.test(msg) ||
      // Tankless specific issues
      /\b(?:tankless|on-?demand|instant).*(?:not\s+working|shutting\s+(?:off|down)|won'?t\s+(?:turn|heat|work)|error|code)\b/i.test(msg) ||
      /\b(?:shutting\s+off|shuts?\s+off|keeps?\s+(?:shutting|turning)\s+off)\b/i.test(msg)
    );
    
    if (isWaterHeaterNonLeakIssue) {
      // Suppress ALL leak-related questions for non-leak water heater issues
      slots.suppressedQuestionTypes = [...(slots.suppressedQuestionTypes || []), 'leak_location', 'dripping', 'active_vs_drip', 'leak_amount', 'where_leak'];
      slots.suppressedQuestionTypes = [...new Set(slots.suppressedQuestionTypes)];
      // Mark as non-leak issue to inform downstream logic
      slots.negativeSignals = [...(slots.negativeSignals || []), 'no_leak', 'water_heater_non_leak'];
      slots.negativeSignals = [...new Set(slots.negativeSignals)];
      // Set a flag for explicit tracking
      slots.isWaterHeaterNonLeakIssue = true;
    }
    
    // SINK LEAK WATER STATE - Required clarification for sink leaks before booking
    // Determines if emergency (spray/flood) or routine repair (drip/slow)
    if (!slots.sinkLeakWaterState) {
      // Check for negation first (not spraying, no flood, etc.)
      const hasNegatedEmergency = /\b(not|no|isn'?t|aren'?t|wasn'?t|weren'?t|without)\s+(spray|spraying|flood|flooding|gush|gushing|pour|pouring)\b/i.test(msg);
      
      // Active emergency water - spraying/flooding (but NOT if negated)
      if (/\b(spray|spraying|flood|flooding|gush|gushing|pour|pouring|can'?t\s*stop|won'?t\s*stop)\b/i.test(msg) && !hasNegatedEmergency) {
        setIfUnresolved('sinkLeakWaterState', 'active_emergency');
      }
      // Slow/drip - routine repair
      else if (/\b(drip|dripping|slow\s*leak|small\s*leak|steady\s*drip|just\s*a\s*drip|little\s*drip|minor)\b/i.test(msg)) {
        setIfUnresolved('sinkLeakWaterState', 'drip');
      }
      // FIX 1: "Only when in use" / conditional leak responses
      else if (/\b(only\s+when|when\s+(?:I|we|you|it'?s?)\s+(?:use|run|turn|running|using)|worse\s+when|when.*(?:on|running))\b/i.test(msg)) {
        setIfUnresolved('sinkLeakWaterState', 'when_in_use');
      }
      // Explicit "not spraying/flooding" - routine repair
      else if (/\b(not\s*spray|not\s*flood|no\s*flood|not\s*gush|just\s*leak|only\s*leak)\b/i.test(msg) || hasNegatedEmergency) {
        setIfUnresolved('sinkLeakWaterState', 'drip');
      }
      // DRAIN FIX: Resolve non-leak drain answers
      // When customer clearly describes drain/backup behavior (not leak), mark as resolved
      else if (/\b(no\s+drip|not\s+drip|no\s+leak|not\s+leak|isn'?t\s+leak|isn'?t\s+drip)\b/i.test(msg) ||
               /\b(just\s+fill|fills?\s+up|backed?\s+up|backs?\s+up|backing\s+up)\b/i.test(msg) ||
               /\b(gurgl|slow\s+drain|drains?\s+slow|draining\s+slow)\b/i.test(msg) ||
               /\b(only\s+when\s+using|when\s+(?:the\s+)?(?:shower|toilet|washer)\s+(?:runs?|flushes?))\b/i.test(msg) ||
               /\b(when\s+running)\b/i.test(msg)) {
        setIfUnresolved('sinkLeakWaterState', 'not_leaking_drain_issue');
      }
    }
    
    // NEGATIVE SIGNALS: Track what the user says is NOT happening
    // These persist and suppress related question types
    const negativeSignals = DIAGNOSTIC_PATHS.detectNegativeSignals(message);
    if (negativeSignals.length > 0) {
      slots.negativeSignals = [...(slots.negativeSignals || []), ...negativeSignals];
      // Deduplicate
      slots.negativeSignals = [...new Set(slots.negativeSignals)];
    }
    
    // FIX: Auto-detect no_water from explicit "no water" language
    // This ensures drip/leak questions are suppressed for no-water issues
    if (/\b(no\s+water|nothing\s+(comes?|coming)\s+out|not\s+getting\s+any\s+water)\b/i.test(msg)) {
      slots.negativeSignals = [...(slots.negativeSignals || []), 'no_water'];
      slots.negativeSignals = [...new Set(slots.negativeSignals)];
    }
    
    // Track suppressed question types based on negative signals
    if (slots.negativeSignals && slots.negativeSignals.length > 0) {
      slots.suppressedQuestionTypes = DIAGNOSTIC_PATHS.getSuppressedQuestionTypes(slots.negativeSignals);
    }
    
    return slots;
  }

  // Check if a diagnostic slot is already filled
  function isSlotFilled(slots, slotName) {
    return slots && slots[slotName] !== undefined && slots[slotName] !== null;
  }

  // ==========================================================================
  // SLOT LOCKING & MAX-ONE-ASK ENFORCEMENT
  // ==========================================================================
  
  // Check if a slot has been asked (max-one-ask rule)
  function hasSlotBeenAsked(booking, slotName) {
    return booking.slotsAsked && booking.slotsAsked[slotName] === true;
  }
  
  // Mark a slot as asked (max-one-ask rule)
  function markSlotAsked(booking, slotName) {
    if (!booking.slotsAsked) booking.slotsAsked = {};
    booking.slotsAsked[slotName] = true;
  }
  
  // Check if a slot is locked (cannot be re-asked or changed)
  function isSlotLocked(booking, slotName) {
    return booking.slotsLocked && booking.slotsLocked[slotName] === true;
  }
  
  // Lock a slot permanently
  function lockSlot(booking, slotName) {
    if (!booking.slotsLocked) booking.slotsLocked = {};
    booking.slotsLocked[slotName] = true;
  }
  
  // FORCED SLOT RESOLUTION: Resolve slot from ANY reasonable signal
  // This runs after each user message to force resolution even from ambiguous answers
  function forceResolveSlots(message, slots, booking) {
    const msg = message.toLowerCase();
    
    // SEVERITY: Resolve from any directional signal
    if (!isSlotLocked(booking, 'severity') && !isSlotFilled(slots, 'severity')) {
      // High severity signals
      if (/\b(bad|really|very|pretty|super|totally|completely|awful|terrible|serious|major|urgent|emergency|won'?t|can'?t|flood|overflow|burst|gush|spray|pour)\b/i.test(msg)) {
        slots.severity = 'severe';
        lockSlot(booking, 'severity');
      }
      // Low severity signals
      else if (/\b(minor|small|little|slight|slow|drip|trickle|bit|somewhat|kinda|okay|ok|fine|not\s*(too|that)\s*bad)\b/i.test(msg)) {
        slots.severity = 'partial';
        lockSlot(booking, 'severity');
      }
      // After one ask, force resolution to 'unknown' to prevent loops
      else if (hasSlotBeenAsked(booking, 'severity')) {
        slots.severity = 'unknown';
        lockSlot(booking, 'severity');
      }
    }
    
    // SCOPE: Resolve from any directional signal
    if (!isSlotLocked(booking, 'scope') && !isSlotFilled(slots, 'scope')) {
      // Single fixture signals
      if (/\b(just|only|this|that)\s*(one|1|toilet|sink|drain|faucet|shower|tub)?\b/i.test(msg) ||
          /\b(single|one|^1$)\b/i.test(msg)) {
        slots.scope = 'single';
        lockSlot(booking, 'scope');
      }
      // Multiple fixture signals
      else if (/\b(other|multiple|all|every|both|several|everywhere|whole\s*house|few|couple|[2-9])\b/i.test(msg)) {
        slots.scope = 'multiple';
        lockSlot(booking, 'scope');
      }
      // "Not sure" signals - resolve as single (most common, safer to check on-site)
      else if (/\b(not\s*sure|don'?t\s*know|no\s*idea|unsure|can'?t\s*tell)\b/i.test(msg)) {
        slots.scope = 'single';
        lockSlot(booking, 'scope');
      }
      // After one ask, force resolution
      else if (hasSlotBeenAsked(booking, 'scope') || booking.crossFixtureGateAsked) {
        slots.scope = 'single';  // Default to single (most common)
        lockSlot(booking, 'scope');
      }
    }
    
    // FLOW STATE (no_water): Resolve from any signal
    if (!isSlotLocked(booking, 'flowState')) {
      // No water signals - CRITICAL for faucet routing
      if (/\b(no\s+water|nothing|dry|totally\s+dry|not\s+getting|won'?t\s+come|doesn'?t\s+come|zero|none)\b/i.test(msg) &&
          !/\b(leak|drip|flood|overflow)\b/i.test(msg)) {
        slots.flowState = 'no_water';
        slots.negativeSignals = [...(slots.negativeSignals || []), 'no_water'];
        slots.negativeSignals = [...new Set(slots.negativeSignals)];
        slots.suppressedQuestionTypes = [...(slots.suppressedQuestionTypes || []), 'dripping', 'leak_location', 'active_vs_drip', 'leak_amount'];
        lockSlot(booking, 'flowState');
      }
      // Dripping signals
      else if (/\b(drip|dripping|drops?|trickle)\b/i.test(msg)) {
        slots.flowState = 'dripping';
        lockSlot(booking, 'flowState');
      }
      // Running/flowing signals
      else if (/\b(running|flowing|pouring|gushing|spraying)\b/i.test(msg)) {
        slots.flowState = 'running';
        lockSlot(booking, 'flowState');
      }
    }
    
    // TOILET STATE: Running vs clogged - CRITICAL for question routing
    // FIX: Prevent clog questions from being asked for running toilets
    if (!isSlotLocked(booking, 'toiletState')) {
      // Running toilet signals - SUPPRESS clog questions
      if (/\b(keeps?\s+running|running|refilling|won'?t\s+stop|doesn'?t\s+stop|constantly|keeps?\s+going)\b/i.test(msg) &&
          /\b(toilet|tolet|toylet|toiley|tilet|toiet|toliet)\b/i.test(msg)) {
        slots.toiletState = 'running';
        slots.negativeSignals = [...(slots.negativeSignals || []), 'not_clogged'];
        slots.negativeSignals = [...new Set(slots.negativeSignals)];
        slots.suppressedQuestionTypes = [...(slots.suppressedQuestionTypes || []), 'clog_severity', 'blocked_vs_slow', 'standing_water', 'drain_speed', 'backup'];
        lockSlot(booking, 'toiletState');
      }
      // Not filling toilet signals - SUPPRESS leak questions
      else if (/\b(not\s+filling|won'?t\s+fill|tank.*empty|no\s+water.*tank)\b/i.test(msg)) {
        slots.toiletState = 'not_filling';
        slots.negativeSignals = [...(slots.negativeSignals || []), 'no_leak'];
        slots.negativeSignals = [...new Set(slots.negativeSignals)];
        slots.suppressedQuestionTypes = [...(slots.suppressedQuestionTypes || []), 'dripping', 'leak_location', 'active_vs_drip', 'leak_amount'];
        lockSlot(booking, 'toiletState');
      }
      // Tank leak signals - SUPPRESS generic disambiguation
      else if (/\b(leak|leaking|drip).*(?:from\s+)?(?:the\s+)?tank\b/i.test(msg) ||
               /\btank.*(?:leak|leaking|drip)\b/i.test(msg)) {
        slots.toiletState = 'tank_leak';
        slots.leak_location = 'tank';
        lockSlot(booking, 'toiletState');
        lockSlot(booking, 'leak_location');
      }
      // Clogged toilet signals
      else if (/\b(clog|blocked|backed|backup|won'?t\s+flush|overflow)\b/i.test(msg) &&
               /\b(toilet|tolet|toylet|toiley|tilet|toiet|toliet)\b/i.test(msg)) {
        slots.toiletState = 'clogged';
        lockSlot(booking, 'toiletState');
      }
    }
    
    // BLOCKED VS SLOW: Resolve from any signal
    if (!isSlotLocked(booking, 'blocked_vs_slow') && !isSlotFilled(slots, 'blocked_vs_slow')) {
      // Completely blocked signals
      if (/\b(completely|totally|won'?t|doesn'?t|not\s+at\s+all|nothing|zero|blocked|stuck)\b/i.test(msg) &&
          /\b(drain|flush|go\s+down|clog)\b/i.test(msg)) {
        slots.blocked_vs_slow = 'blocked';
        lockSlot(booking, 'blocked_vs_slow');
      }
      // Slow drain signals
      else if (/\b(slow|slowly|takes\s+a\s+while|eventually|partial|somewhat)\b/i.test(msg)) {
        slots.blocked_vs_slow = 'slow';
        lockSlot(booking, 'blocked_vs_slow');
      }
      // After one ask, force resolution
      else if (hasSlotBeenAsked(booking, 'blocked_vs_slow')) {
        slots.blocked_vs_slow = 'unknown';
        lockSlot(booking, 'blocked_vs_slow');
      }
    }
    
    // LOCK FIX B: Active leak slot lock - prevent "actively dripping" repeat
    // GLOBAL FIX: Applies to all fixtures (sink, toilet, shower/tub, water heater) for conditional leak recognition
    if (!isSlotLocked(booking, 'active') && !isSlotFilled(slots, 'active')) {
      // Active now signals - comprehensive patterns for "yes it's active"
      // These indicate CONTINUOUS leak that needs urgent attention
      const isActiveLeak = /\b(still|currently|right\s*now|rn|at\s*the\s*moment|as\s*we\s*speak|still\s*(?:coming|flowing|running|leaking|going|dripping)|won'?t\s*stop|can'?t\s*stop|keeps?\s*(?:going|running|leaking|dripping)|nonstop|non-stop|non\s+stop|all\s*the\s*time|constantly|always|continuous|continuously|24\/7|twenty\s*four\s*seven|never\s*stops?|doesn'?t\s*stop|it'?s\s*(?:always|constant)|permanent|perpetual|actively|a\s*lot|dripping\s*(?:a\s*lot|rn|right\s*now|constantly|non-?stop)|pooling|puddle|water\s+(?:is\s+)?everywhere)\b/i.test(msg) ||
        // WATER HEATER ACTIVE LEAK PATTERNS - recognize explicit dripping/leaking statements
        /\b(?:valve|tank|heater|water\s*heater).*(?:drip|leak|pour|gush|spray)/i.test(msg) ||
        /\b(?:drip|leak|pour|gush|spray).*(?:valve|tank|heater|water\s*heater)/i.test(msg) ||
        /\b(?:it'?s|is)\s+(?:dripping|leaking|pouring|gushing|spraying)\b/i.test(msg) ||
        /\bwater\s+(?:is\s+)?(?:coming|dripping|leaking|pouring)\s+(?:out|from)\b/i.test(msg) ||
        // Water heater location answers that imply active leak
        /\b(?:from\s+(?:the\s+)?(?:top|bottom|side|base|fittings?))\b/i.test(msg) ||
        /\b(?:leaking|dripping)\s+(?:from\s+(?:the\s+)?)?(?:top|bottom|side|valve|base|tank|fittings?)\b/i.test(msg);
      
      // CONDITIONAL LEAK RECOGNITION (GLOBAL FIX)
      // Detects "only when I use it" patterns across ALL fixtures (sink, toilet, shower/tub)
      // When detected: sets active='only_when_using' and LOCKS to prevent re-asking
      // Not active / only when using signals - comprehensive patterns for "only when I use it"
      // Including standalone messages like "ONLY WHEN RUNNING WATER!" or "WHEN I USE IT"
      const isConditionalUseLeak = 
        /\b(stopped|not\s*anymore|turned\s*off|shut\s*off|no\s*longer|earlier|before|was|used\s*to|not\s*(?:dripping|leaking)\s*(?:now|anymore|otherwise))\b/i.test(msg) ||
        // Core conditional patterns: "only when", "only if", "just when"
        /\b(?:only|just)\s+(?:when|while|if)\s+(?:i\s+)?(?:use|run|turn|running|using|flush|shower)\b/i.test(msg) ||
        // "only during use" / "only in use"
        /\b(?:only|just)\s+(?:during|while\s+in|when\s+in)\s+use\b/i.test(msg) ||
        // "when I run the water" / "when I turn it on"
        /\b(?:when|while)\s+(?:i\s+)?(?:run|use|turn\s*on)\s+(?:the\s+)?(?:water|it|faucet|tap|shower|tub)\b/i.test(msg) ||
        /\b(?:when|while)\s+(?:water(?:'s|\s*is)?)\s+running\b/i.test(msg) ||
        // "when it's on" / "when the water is on"
        /\b(?:when|while)\s+(?:the\s+)?(?:water|faucet|tap|it)\s+(?:is\s+)?(?:on|running)\b/i.test(msg) ||
        /\bwhen\s+it'?s\s+on\b/i.test(msg) ||
        // "drips/leaks when I turn/use/run"
        /\b(?:drips?|leaks?)\s+(?:only\s+)?when\s+(?:i\s+)?(?:turn|use|run|flush|shower)\b/i.test(msg) ||
        /\b(?:stops?|doesn'?t)\s+(?:leak|drip).*(?:off|not\s+using)\b/i.test(msg) ||
        /\bjust\s+when\s+(?:using|running|i\s+use|i\s+run|flushing|showering)\b/i.test(msg) ||
        /\bonly\s+(?:leaks?|drips?)\s+when\b/i.test(msg) ||
        // "not dripping unless" patterns
        /\bnot\s+(?:dripping|leaking)\s+(?:otherwise|unless|except)\b/i.test(msg) ||
        /\b(?:doesn'?t|won'?t|don'?t)\s+(?:drip|leak)\s+unless\b/i.test(msg) ||
        /\b(?:it\s+)?(?:leaks?|drips?)\s+(?:only\s+)?(?:when|while)\s+(?:the\s+)?(?:water|faucet|tap|shower|tub)\b/i.test(msg) ||
        /\b(?:when|if)\s+(?:i\s+)?(?:run|turn\s+on)\s+(?:the\s+)?water\b/i.test(msg) ||
        // FIX: Standalone patterns for direct answers like "ONLY WHEN RUNNING WATER!"
        /^(?:only\s+)?when\s+(?:i\s+)?(?:run|running|use|using)\s+(?:the\s+)?(?:water|it|faucet|tap|shower|tub)/i.test(msg.trim()) ||
        /^only\s+when\s+(?:running|using|on)/i.test(msg.trim()) ||
        /^just\s+when\s+(?:i\s+)?(?:use|run|turn)/i.test(msg.trim()) ||
        /\bonly\s+when\s+(?:i\s+)?run(?:ning)?\s+(?:the\s+)?water\b/i.test(msg) ||
        /\bwhen\s+(?:i\s+)?use\s+it\b/i.test(msg) ||
        /\bwhen\s+(?:the\s+)?water\s+(?:is\s+)?running\b/i.test(msg) ||
        /\bjust\s+when\s+(?:the\s+)?water\b/i.test(msg) ||
        // Additional fixture-specific conditional patterns (tub spout, shower head, etc.)
        /\b(?:tub\s*spout|shower\s*head|faucet)\s+(?:only\s+)?(?:leaks?|drips?)\s+(?:when|while|during)\b/i.test(msg) ||
        /\b(?:only|just)\s+(?:when|while|if)\s+(?:the\s+)?(?:shower|tub|bath)\s+(?:is\s+)?(?:on|running|in\s+use)\b/i.test(msg);
      
      if (isActiveLeak) {
        slots.active = 'yes';
        lockSlot(booking, 'active');
      }
      else if (isConditionalUseLeak) {
        slots.active = 'only_when_using';
        lockSlot(booking, 'active');
      }
      // After one ask, force resolution to prevent loops
      else if (hasSlotBeenAsked(booking, 'active')) {
        slots.active = 'intermittent';
        lockSlot(booking, 'active');
      }
    }
    
    // WATER HEATER FIX 1 + FIX 2: Appliance type uncertainty resolution
    // If user says "don't know" or "how do I check", resolve as unknown and stop asking
    if (!isSlotLocked(booking, 'appliance_type') && !isSlotFilled(slots, 'appliance_type')) {
      // Detect uncertainty responses - FIX 2: Added "how do I check"
      if (/\b(don'?t\s*know|not\s*sure|no\s*idea|i\s*rent|how\s*(?:do\s*)?(?:i|can\s*i)\s*(?:tell|check)|unsure|couldn'?t\s*tell|can'?t\s*tell|no\s*clue)\b/i.test(msg)) {
        // Increment uncertainty count
        booking.applianceTypeUncertainCount = (booking.applianceTypeUncertainCount || 0) + 1;
        
        // FIX 2: After 1 uncertain response (not 2), resolve as unknown to prevent loops
        if (booking.applianceTypeUncertainCount >= 1) {
          slots.appliance_type = 'unknown';
          lockSlot(booking, 'appliance_type');
        }
      }
      // After one ask without uncertainty, force resolution to unknown
      else if (hasSlotBeenAsked(booking, 'appliance_type')) {
        slots.appliance_type = 'unknown';
        lockSlot(booking, 'appliance_type');
      }
    }
    
    // ROOM: Force resolution after location gate is asked
    if (!isSlotLocked(booking, 'room') && !isSlotFilled(slots, 'room')) {
      // After location gate asked, force resolution to 'unknown' to prevent loops
      if (booking.locationGateAsked) {
        slots.room = 'unknown';
        lockSlot(booking, 'room');
      }
    }
    
    // PIPE LOCATION: Lock slot when filled to prevent repeat questions
    // Also handle "wall" response after asking once, and uncertainty responses
    if (!isSlotLocked(booking, 'pipe_location')) {
      // If slot was filled by extractDiagnosticSlots, lock it
      if (isSlotFilled(slots, 'pipe_location')) {
        lockSlot(booking, 'pipe_location');
        // Also lock leak_location if pipe_location is wall (for compatibility)
        if (slots.pipe_location === 'wall' && slots.leak_location === 'wall') {
          lockSlot(booking, 'leak_location');
        }
      }
      // After asking once, accept simpler location-like responses
      else if (hasSlotBeenAsked(booking, 'pipe_location')) {
        // Simple "wall" answer after asking
        if (/\bwall\b/i.test(msg)) {
          slots.pipe_location = 'wall';
          lockSlot(booking, 'pipe_location');
          if (!slots.leak_location) {
            slots.leak_location = 'wall';
            lockSlot(booking, 'leak_location');
          }
        }
        // Simple "basement" answer after asking
        else if (/\bbasement\b/i.test(msg)) {
          slots.pipe_location = 'basement';
          lockSlot(booking, 'pipe_location');
        }
        // Simple "ceiling" answer after asking
        else if (/\bceiling\b/i.test(msg)) {
          slots.pipe_location = 'ceiling';
          lockSlot(booking, 'pipe_location');
        }
        // Any other location-like response
        else if (/\b(?:upstairs|downstairs|garage|kitchen|bathroom|laundry|under|behind|inside|attic|outside)\b/i.test(msg)) {
          slots.pipe_location = 'specified';
          lockSlot(booking, 'pipe_location');
        }
        // Uncertainty after asking - accept and move on
        else if (/\b(?:don'?t\s*know|not\s*sure|can'?t\s*(?:find|see|tell)|no\s*idea|somewhere|hard\s+to\s+(?:tell|say))\b/i.test(msg)) {
          slots.pipe_location = 'unknown';
          lockSlot(booking, 'pipe_location');
        }
      }
    }
    
    // LEAK LOCATION: Lock slot when filled (for shower/tub edge/base/crack detections)
    if (!isSlotLocked(booking, 'leak_location') && isSlotFilled(slots, 'leak_location')) {
      lockSlot(booking, 'leak_location');
    }
    
    return slots;
  }
  
  // Get which slot a question is targeting (for max-one-ask tracking)
  function getQuestionTargetSlot(question) {
    const q = question.toLowerCase();
    
    if (q.includes('completely') && (q.includes('blocked') || q.includes('clogged') || q.includes('slow'))) return 'blocked_vs_slow';
    if (q.includes('blocked') && q.includes('slow')) return 'blocked_vs_slow';
    if (q.includes('just that one') || q.includes('just this one') || q.includes('other')) return 'scope';
    if (q.includes('how bad') || q.includes('minor') || q.includes('serious')) return 'severity';
    // INVARIANT 2: Map "actively dripping" question to 'active' slot for single-ask enforcement
    if (q.includes('actively dripping')) return 'active';
    if (q.includes('still') && (q.includes('coming') || q.includes('leaking') || q.includes('running'))) return 'active';
    if (q.includes('right now') && (q.includes('dripping') || q.includes('leaking'))) return 'active';
    if (q.includes('constantly') || q.includes('intermittent')) return 'frequency';
    if (q.includes('gas') && q.includes('electric')) return 'appliance_type';
    if (q.includes('which') && (q.includes('sink') || q.includes('faucet') || q.includes('bathroom'))) return 'room';
    if (q.includes('which floor') || q.includes('what floor')) return 'floor';
    if (q.includes('how much')) return 'amount';
    if (q.includes('where') && (q.includes('leak') || q.includes('water') || q.includes('drip'))) return 'leak_location';
    // PIPE LOCATION: Map pipe location questions to pipe_location slot
    if (q.includes('where') && q.includes('pipe')) return 'pipe_location';
    if (q.includes('basement') && q.includes('wall') && q.includes('utility')) return 'pipe_location';
    if (q.includes('drip') || q.includes('dripping')) return 'flowState';
    if (q.includes('no water') || q.includes('any water')) return 'flowState';
    
    return null;
  }

  // ==========================================================================
  // CENTRALIZED QUESTION ELIGIBILITY GATE
  // This is the SINGLE enforcement point for all question selection
  // ==========================================================================
  function isQuestionEligible(question, booking) {
    if (!question) return false;
    
    const q = question.toLowerCase();
    const slots = booking.diagnosticSlots || {};
    const suppressedTypes = slots.suppressedQuestionTypes || [];
    const negativeSignals = slots.negativeSignals || [];
    const problemType = booking.problemType || '';
    
    // RULE 1: Check if target slot is locked or already asked
    const targetSlot = getQuestionTargetSlot(question);
    if (targetSlot) {
      if (isSlotLocked(booking, targetSlot)) return false;
      if (hasSlotBeenAsked(booking, targetSlot)) return false;
    }
    
    // WATER HEATER HARDENING: HARD BLOCK gas/electric questions when appliance_type is resolved
    // This applies regardless of how appliance_type was resolved (gas, electric, or unknown)
    if (slots.appliance_type) {
      if (q.includes('gas') && q.includes('electric')) return false;
      if (q.includes('gas or electric')) return false;
      if (q.includes('type of heater')) return false;
    }
    
    // RULE 2: Enforce suppressed question types
    for (const suppressed of suppressedTypes) {
      const s = suppressed.toLowerCase();
      if (s === 'dripping' && (q.includes('drip') || q.includes('dripping'))) return false;
      if (s === 'leak_location' && q.includes('where') && (q.includes('leak') || q.includes('water'))) return false;
      if (s === 'active_vs_drip' && q.includes('drip') && q.includes('or')) return false;
      if (s === 'leak_amount' && q.includes('how much') && q.includes('water')) return false;
    }
    
    // RULE 3: HARD GUARD - If flowState is no_water, NEVER ask drip/leak/water-location questions
    if (slots.flowState === 'no_water' || negativeSignals.includes('no_water')) {
      // Block ALL drip-related questions
      if (q.includes('drip') || q.includes('dripping')) return false;
      // Block ALL leak-location questions
      if (q.includes('where') && (q.includes('leak') || q.includes('water') || q.includes('see'))) return false;
      // Block "is it leaking" type questions
      if (q.includes('leak') && !q.includes('no water') && !q.includes('not leak')) return false;
      // Block water amount questions
      if (q.includes('how much water')) return false;
    }
    
    // GUARD 1: TOILET TANK LEAK - Block generic disambiguation questions
    // When problemType is toilet_leaking_tank, we already know it's a tank leak
    if (problemType === 'toilet_leaking_tank') {
      // Block generic "what's it doing?" questions - we already know
      if (q.includes('clogged') && q.includes('overflowing') && q.includes('running') && q.includes('leaking')) return false;
      // Block generic leak disambiguation - we already know it's the tank
      if (q.includes('at the base') && q.includes('from the tank') && q.includes('supply line')) return false;
    }
    
    // GUARD 2: TOILET NOT-FILLING - Hard suppress ALL leak-related questions
    // When problemType is toilet_tank_not_filling, leak questions are impossible
    if (problemType === 'toilet_tank_not_filling') {
      // Block ALL drip-related questions
      if (q.includes('drip') || q.includes('dripping')) return false;
      // Block ALL leak questions
      if (q.includes('leak') || q.includes('leaking')) return false;
      // Block water-on-floor questions
      if (q.includes('water on floor') || q.includes('puddle')) return false;
      // Block "actively" water questions (implies leak)
      if (q.includes('actively') && (q.includes('water') || q.includes('drip'))) return false;
    }
    
    // GUARD 3: WATER HEATER NON-LEAK ISSUES - Hard suppress ALL leak-related questions
    // When isWaterHeaterNonLeakIssue is true OR negative signal includes 'water_heater_non_leak'
    // Applies to: pilot light, no hot water, error codes, thermostat, electric issues, flow issues, etc.
    if (slots.isWaterHeaterNonLeakIssue || negativeSignals.includes('water_heater_non_leak')) {
      // Block ALL drip-related questions
      if (q.includes('drip') || q.includes('dripping')) return false;
      // Block ALL leak questions
      if (q.includes('leak') || q.includes('leaking')) return false;
      // Block water-on-floor questions
      if (q.includes('water on floor') || q.includes('water on the floor') || q.includes('puddle')) return false;
      // Block "where is the water" location questions
      if (q.includes('where') && (q.includes('leak') || q.includes('see the water') || q.includes('water coming'))) return false;
      // Block "is water still" type questions
      if (q.includes('water still') || q.includes('still leaking')) return false;
      // Block tank/bottom/base leak location questions
      if (q.includes('bottom of tank') || q.includes('base') || q.includes('supply line') || q.includes('connections')) return false;
      // Block "how much water" questions
      if (q.includes('how much water')) return false;
      // Block "actively" water questions
      if (q.includes('actively') && (q.includes('water') || q.includes('drip') || q.includes('leak'))) return false;
    }
    
    // GUARD 3B: WATER HEATER PROBLEM TYPES - Hard suppress leak questions for non-leak problem types
    // These problem types are explicitly non-leak issues
    const waterHeaterNonLeakTypes = [
      'water_heater_no_hot', 'water_heater_inconsistent', 'water_heater_limited', 
      'water_heater_pilot', 'water_heater_burner', 'water_heater_no_power',
      'water_heater_noise', 'water_heater_too_hot', 'water_heater_rusty', 
      'water_heater_smelly', 'recirculating_pump', 'expansion_tank'
    ];
    if (waterHeaterNonLeakTypes.includes(problemType)) {
      // Block ALL leak-related questions for these problem types
      if (q.includes('drip') || q.includes('dripping')) return false;
      if (q.includes('leak') || q.includes('leaking')) return false;
      if (q.includes('puddle') || q.includes('water on') || q.includes('water around')) return false;
      if (q.includes('where') && q.includes('water')) return false;
      if (q.includes('how much water')) return false;
      if (q.includes('bottom of tank') || q.includes('base') || q.includes('supply line')) return false;
    }
    
    return true;
  }

  // ==========================================================================
  // EMERGENCY BOOKING LOCK - Prevents conversation exit during confirmed emergency
  // ==========================================================================
  function mustForceEmergencyBooking(booking) {
    // Only applies if emergency has been evaluated AND confirmed
    if (!booking.emergencyModeActive) return false;
    if (!booking.emergencyEvaluated) return false;
    
    // If already in booking stages, let normal flow continue
    if (booking.stage === 'booking_details') return false;
    if (booking.stage === 'awaiting_confirmation') return false;
    if (booking.stage === 'confirmed') return false;
    
    // Emergency is active but not yet in booking - FORCE booking
    return true;
  }

  // HYBRID DIAGNOSTIC: Fixed sequences for common cases, AI for edge cases
  // Complete diagnostic tree for ALL residential plumbing issues
  function getFixedDiagnosticSequence(problemType, customerMessage, diagnosticHistory, diagnosticSlots = {}) {
    const msg = customerMessage.toLowerCase();
    const exchangeCount = Math.floor(diagnosticHistory.length / 2);
    
    // INSTALLATION GUARD: Never ask repair diagnostics for installation requests
    // This prevents "is it jammed, leaking, not turning on?" for install requests
    if (problemType && (problemType.includes('install') || problemType.startsWith('install_'))) {
      return null;  // Skip repair diagnostics for installations
    }
    
    // DISAMBIGUATION SKIP: Don't ask "which appliance/outdoor?" if customer already specified
    // This prevents asking "Which appliance?" when customer said "fridge leaking"
    if (problemType === 'appliance' && exchangeCount === 0) {
      // Check if customer already mentioned a specific appliance
      if (/\b(?:fridge|refrigerator|ice\s*maker|icemaker)\b/i.test(customerMessage) ||
          /\b(?:dishwasher|dish\s*washer)\b/i.test(customerMessage) ||
          /\b(?:washing\s*machine|washer|laundry)\b/i.test(customerMessage)) {
        return null;  // Skip "Which appliance?" - let fallback handle with specific question
      }
    }
    
    // DISAMBIGUATION SKIP: Same for outdoor fixtures
    if (problemType === 'outdoor' && exchangeCount === 0) {
      // Check if customer already mentioned a specific outdoor fixture
      if (/\b(?:sprinkler|irrigation|sprinklr|sprinker)\b/i.test(customerMessage) ||
          /\b(?:hose\s*bib|spigot|outdoor\s*faucet|outside\s*faucet|exterior\s*faucet)\b/i.test(customerMessage)) {
        return null;  // Skip "What's the outdoor problem?" - let fallback handle
      }
    }
    
    // Get suppressed question types from negative signals
    const suppressedTypes = diagnosticSlots.suppressedQuestionTypes || [];

    // WATER HEATER LEAKING - First question should be about location, not active state
    // FIX E: Skip if leak_location already provided OR highConfidenceDetection is set
    if (problemType === 'water_heater_leaking' && exchangeCount === 0) {
      if (!diagnosticSlots.leak_location && !diagnosticSlots.highConfidenceDetection) {
        return "Where do you see the leak - bottom of tank, top connections, pressure relief valve, or somewhere else?";
      }
    }
    
    // FIX E: Also handle water_heater_leak_tank - skip q1 if leak location already known
    if (problemType === 'water_heater_leak_tank' && exchangeCount === 0) {
      return null;
    }
    
    // FIX R: Skip severity question for water_heater_no_hot when highConfidenceDetection is set
    if (problemType === 'water_heater_no_hot' && exchangeCount === 0) {
      if (diagnosticSlots.highConfidenceDetection || diagnosticSlots.severity === 'complete') {
        // Skip "no hot water at all vs not hot enough" - already know it's complete loss
        // Ask about scope instead if not known
        if (!diagnosticSlots.scope) {
          return diagnosticSlots.appliance_type 
            ? "Is it all the hot water in the house, or just certain faucets?"
            : "Is it gas or electric - or are you not sure?";
        }
        return null;  // All diagnostic info gathered, proceed to booking
      }
    }
    
    // FIX E: Water heater noise - skip noise type question if already specified
    if (problemType === 'water_heater_noise' && exchangeCount === 0) {
      if (diagnosticSlots.noise_type || diagnosticSlots.highConfidenceDetection) {
        return null;
      }
    }
    
    // FIX GD-7: Check for skip conditions on questions
    if (exchangeCount === 0) {
      const sequence = DIAGNOSTIC_SEQUENCES[problemType];
      if (sequence && sequence.q1_skip_if && diagnosticSlots[sequence.q1_skip_if]) {
        if (sequence.q2) {
          return sequence.q2;
        }
        return null; // All diagnostics complete
      }
    }
    
    // First, try to get the question from DIAGNOSTIC_SEQUENCES config
    const question = DIAGNOSTIC_SEQUENCES.getQuestion(problemType, exchangeCount);
    if (question) {
      // ALIGNMENT CHECK: Validate question is aligned with problem and not suppressed
      const alignmentCheck = QUESTION_ALIGNMENT.isQuestionAligned(question, problemType, suppressedTypes);
      if (!alignmentCheck.aligned) {
        // Question is misaligned - try to get an alternative
        const alternative = QUESTION_ALIGNMENT.getAlignedAlternative(problemType, suppressedTypes);
        if (alternative) {
          return alternative;
        }
        // No alternative available - skip this question
        return null;
      }
      
      // =================================================================
      // SLOT LOCKING: Skip question if target slot is already filled
      // This is runtime enforcement to prevent repeated questions
      // =================================================================
      const questionLower = question.toLowerCase();
      
      // SEVERITY SLOT - blocked vs slow, drip vs pour, minor vs major
      if (isSlotFilled(diagnosticSlots, 'severity')) {
        if (questionLower.includes('completely') && questionLower.includes('or')) return null;  // "completely X or Y"
        if (questionLower.includes('blocked') && questionLower.includes('slow')) return null;
        if (questionLower.includes('minor') && questionLower.includes('serious')) return null;
        if (questionLower.includes('how bad')) return null;
        if (questionLower.includes('dripping') && questionLower.includes('or')) return null;
      }
      
      // SCOPE SLOT - single vs multiple fixtures
      if (isSlotFilled(diagnosticSlots, 'scope')) {
        if (questionLower.includes('just that one') || questionLower.includes('just this one')) return null;
        if (questionLower.includes('other') && (questionLower.includes('drain') || questionLower.includes('faucet') || questionLower.includes('toilet'))) return null;
        if (questionLower.includes('multiple') || questionLower.includes('elsewhere')) return null;
        if (questionLower.includes('whole house')) return null;
      }
      
      // ACTIVE SLOT - is it happening now
      if (isSlotFilled(diagnosticSlots, 'active')) {
        if (questionLower.includes('still') && (questionLower.includes('coming') || questionLower.includes('leaking') || questionLower.includes('running'))) return null;
        if (questionLower.includes('right now')) return null;
        if (questionLower.includes('actively')) return null;
      }
      
      // FREQUENCY SLOT - constant vs intermittent
      if (isSlotFilled(diagnosticSlots, 'frequency')) {
        if (questionLower.includes('constantly') || questionLower.includes('intermittent')) return null;
        if (questionLower.includes('start') && questionLower.includes('stop')) return null;
        if (questionLower.includes('on its own')) return null;
      }
      
      // APPLIANCE_TYPE SLOT - gas vs electric
      // WATER HEATER HARDENING: Completely block gas/electric questions when slot is filled
      if (isSlotFilled(diagnosticSlots, 'appliance_type')) {
        if (questionLower.includes('gas') && questionLower.includes('electric')) return null;
        if (questionLower.includes('gas or electric')) return null;
        if (questionLower.includes('type of heater')) return null;
        // If the question contains gas/electric as the ONLY content, skip entirely
        // But if it has other content, strip the gas/electric part and return the rest
        if (/is it gas or electric\??/i.test(question)) {
          const strippedQuestion = question.replace(/is it gas or electric\??\s*/gi, '').replace(/\s*gas or electric\??\s*/gi, ' ').trim();
          if (strippedQuestion.length > 10) {
            return strippedQuestion;
          }
          return null;
        }
      }
      
      // ROOM SLOT - which room/fixture
      if (isSlotFilled(diagnosticSlots, 'room')) {
        if (questionLower.includes('which') && (questionLower.includes('sink') || questionLower.includes('faucet') || questionLower.includes('bathroom'))) return null;
        if (questionLower.includes('kitchen') && questionLower.includes('bathroom')) return null;
      }
      
      // FLOOR SLOT - which floor
      if (isSlotFilled(diagnosticSlots, 'floor')) {
        if (questionLower.includes('which floor') || questionLower.includes('what floor')) return null;
        if (questionLower.includes('basement') && questionLower.includes('upstairs')) return null;
      }
      
      // AMOUNT SLOT - how much water
      if (isSlotFilled(diagnosticSlots, 'amount')) {
        if (questionLower.includes('how much')) return null;
      }
      
      // FIX D: NOISE_TYPE SLOT - what kind of noise
      if (isSlotFilled(diagnosticSlots, 'noise_type')) {
        if (questionLower.includes('what kind of noise') || 
            questionLower.includes('what type of noise') ||
            (questionLower.includes('rumbling') && questionLower.includes('popping') && questionLower.includes('hissing'))) {
          return null;
        }
      }
      
      // LEAK_LOCATION SLOT - where is the leak
      if (isSlotFilled(diagnosticSlots, 'leak_location')) {
        if (questionLower.includes('where') && (questionLower.includes('leak') || questionLower.includes('water') || questionLower.includes('drip'))) return null;
        // BUG 2 FIX: Skip generic "what is it doing?" if leak location is already known
        if (questionLower.includes('what') && questionLower.includes('doing') && questionLower.includes('clogged')) return null;
        if (questionLower.includes('is it clogged, overflowing, running, leaking')) return null;
      }
      
      // NO_WATER GUARD: If no_water signal is set, skip ALL drip/leak questions
      const negativeSignals = diagnosticSlots.negativeSignals || [];
      if (negativeSignals.includes('no_water')) {
        if (questionLower.includes('drip') || questionLower.includes('dripping')) return null;
        if (questionLower.includes('where') && questionLower.includes('water')) return null;
        if (questionLower.includes('leak') && !questionLower.includes('no water')) return null;
      }
      
      // Also check pattern matching as fallback
      if (questionLower.includes('completely clogged or partially') && wasAlreadyAnswered(diagnosticHistory, [/completely|partial|slow|blocked|won'?t drain/i])) return null;
      if (questionLower.includes('just that one') && wasAlreadyAnswered(diagnosticHistory, [/just (that |this )?(one|toilet|sink)|other (drain|toilet|sink)|multiple|all of them|every/i])) return null;
      if (questionLower.includes('still coming out') && wasAlreadyAnswered(diagnosticHistory, [/still (coming|flowing|running)|stopped|not anymore/i])) return null;
      if (questionLower.includes('constantly running') && wasAlreadyAnswered(diagnosticHistory, [/constant(?:ly)?|intermittent(?:ly)?|starts? and stops?|every few|on its own/i])) return null;
      if (questionLower.includes('gas or electric') && wasAlreadyAnswered(diagnosticHistory, [/\b(gas|electric)\b/i])) return null;
      if (questionLower.includes('which sink') && wasAlreadyAnswered(diagnosticHistory, [/kitchen|bathroom|laundry/i])) return null;
      if (questionLower.includes('which floor') && wasAlreadyAnswered(diagnosticHistory, [/first floor|second floor|basement|main floor|upstairs|downstairs/i])) return null;
      if (questionLower.includes('how much water') && wasAlreadyAnswered(diagnosticHistory, [/little|lot|puddle|flood|everywhere|soaked/i])) return null;
      
      return question;
    }
    
    // Handle special fallback cases for generic types with keyword-based follow-ups
    // These need message inspection for q2, so they're handled separately
    
    // Generic toilet fallback with keyword detection for q2
    if (problemType === 'toilet' && exchangeCount === 1) {
      if (/\b(clog|clogged|blocked|stuck|won'?t\s+flush)\b/i.test(msg)) {
        return "Is it just that one toilet or are other drains backing up too?";
      }
      if (/\b(overflow|overflowing|spilling|water\s+everywhere)\b/i.test(msg)) {
        return "Is water still coming out or has it stopped? Turn off the valve behind the toilet if you can.";
      }
      if (/\b(running|won'?t\s+stop|keeps\s+running)\b/i.test(msg)) {
        return "Is it constantly running or does it start and stop on its own?";
      }
    }
    
    // Generic water heater fallback with keyword detection for q2
    if (problemType === 'water_heater' && exchangeCount === 1) {
      // WATER HEATER HARDENING: Only include gas/electric if not already resolved
      const askGasElectric = !isSlotFilled(diagnosticSlots, 'appliance_type');
      if (/\b(no\s+hot|not\s+hot|cold|lukewarm|not\s+warm)\b/i.test(msg)) {
        return askGasElectric 
          ? "Is it all the hot water in the house or just certain faucets? Is it gas or electric?"
          : "Is it all the hot water in the house or just certain faucets?";
      }
      if (/\b(noise|sound|banging|knocking|hissing)\b/i.test(msg)) {
        return "Is the noise coming from the water heater itself? Are you still getting hot water?";
      }
      if (/\b(leak|leaking|drip|water)\b/i.test(msg)) {
        return "Is water still leaking right now? Where do you see the leak - bottom of tank or pipes?";
      }
    }
    
    // Generic pipe fallback with keyword detection for q2
    if (problemType === 'pipe' && exchangeCount === 1) {
      if (/\b(leak|burst|broken)\b/i.test(msg)) {
        return "Is water still leaking from the pipe? Where do you see it - basement, under sink, or in wall?";
      }
    }
    
    // FIX #4: SHOWER-SPECIFIC LEAK DIAGNOSTICS (must check BEFORE generic leak)
    // Detect shower/tub context from:
    // 1. Current message
    // 2. problemType 
    // 3. diagnosticHistory from earlier turns
    // 4. diagnosticSlots.fixture
    const historyText = diagnosticHistory.map(m => m.content || '').join(' ').toLowerCase();
    const slotFixture = (diagnosticSlots.fixture || '').toLowerCase();
    const isShowerTubLeakContext = 
      /\b(?:shower|tub|bathtub|bath)\b/i.test(msg) ||
      (problemType && /shower|tub|bath/i.test(problemType)) ||
      /\b(?:shower|tub|bathtub)\b/i.test(historyText) ||
      /shower|tub|bath/i.test(slotFixture);
    
    if (problemType === 'leak' && exchangeCount === 1 && isShowerTubLeakContext) {
      if (/\b(drip|dripping|constant)\b/i.test(msg)) {
        return "Where is the drip - from the shower head, the faucet/valve, or the tub spout?";
      }
      if (/\b(spray|spraying|shooting|gushing)\b/i.test(msg)) {
        return "Is water spraying from the shower head, valve area, or somewhere else?";
      }
      // Generic shower leak
      return "Is the leak from the shower head, faucet, or somewhere else like the floor/wall?";
    }
    
    // Generic leak fallback with keyword detection for q2 (SINK context)
    if (problemType === 'leak' && exchangeCount === 1) {
      if (/\b(drip|dripping|slow)\b/i.test(msg)) {
        return "Where is the drip - under the sink, behind toilet, or visible pipe?";
      }
      if (/\b(spray|spraying|shooting|gushing)\b/i.test(msg)) {
        return "Is water still spraying? Can you shut off the water supply to stop it?";
      }
    }
    
    // Generic drain fallback with keyword detection for q2
    if (problemType === 'drain' && exchangeCount === 1) {
      if (/\b(slow|backing|backed|clog)\b/i.test(msg)) {
        return "Is it just one drain or are multiple drains slow? Kitchen, bathroom, or both?";
      }
    }
    
    // Generic faucet fallback with keyword detection for q2
    if (problemType === 'faucet' && exchangeCount === 1) {
      if (/\b(drip|dripping)\b/i.test(msg)) {
        return "Which faucet is dripping - kitchen sink, bathroom sink, or bathtub?";
      }
      if (/\b(won'?t\s+turn\s+off|won'?t\s+stop|stuck)\b/i.test(msg)) {
        return "Which faucet won't turn off - kitchen or bathroom? Can you shut off the water under the sink?";
      }
    }
    
    // No fixed sequence match - return null to use AI
    return null;
  }

