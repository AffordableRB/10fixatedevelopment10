            metadata: { stage: 'booking_details', installFlow: true, earlyReturn: true }
          };
        }
        
        // Ask location (item is always confirmed now)
        install.locationAsked = true;
        // FIX: Set problemType even before location is known
        // This prevents null problemType in test assertions
        setProblemTypeIfAllowed(currentBooking, `${install.item}_install`, 'specific_compound');
        bookingData.set(customerKey, currentBooking);
        
        // Format item name for display
        let itemName;
        if (install.item === 'generic_install') {
          itemName = 'installation';
        } else if (install.item === 'washer') {
          itemName = 'washing machine installation';
        } else if (install.item === 'water_heater') {
          itemName = 'water heater installation';
        } else if (install.item === 'refrigerator') {
          itemName = 'refrigerator installation';
        } else if (install.item === 'garbage_disposal') {
          itemName = 'garbage disposal installation';
        } else if (install.item === 'ice_maker_line') {
          itemName = 'ice maker line installation';
        } else if (install.item === 'hose_bib') {
          itemName = 'outdoor faucet installation';
        } else if (install.item === 'pot_filler') {
          itemName = 'pot filler installation';
        } else if (install.item === 'sewage_pump') {
          itemName = 'sewage pump installation';
        } else if (install.item === 'sump_pump') {
          itemName = 'sump pump installation';
        } else if (install.item === 'gas_line') {
          itemName = 'gas line installation';
        } else if (install.item === 'backflow') {
          itemName = 'backflow preventer installation';
        } else if (install.item === 'tub') {
          itemName = 'tub installation';
        } else if (install.item === 'water_line') {
          itemName = 'water line installation';
        } else if (install.item === 'water_meter') {
          itemName = 'water meter installation';
        } else if (install.item === 'water_filter') {
          itemName = 'water filter installation';
        } else if (install.item === 'under_sink_filter') {
          itemName = 'under-sink filter installation';
        } else if (install.item === 'appliance') {
          itemName = 'appliance installation';
        } else {
          itemName = install.item + ' installation';
        }
        
        return {
          response: `Got it - ${itemName}. Where will it be installed?`,
          booking: currentBooking,
          debug: { intent: 'installation', stage: 'install_intake', item: install.item },
          metadata: { stage: 'install_intake', installFlow: true, earlyReturn: true }
        };
      }
      // ================================================================
      // END INSTALLATION EARLY RETURN (Phase 1)
      // ================================================================
      
      // BOOKING_DETAILS FIX: If in booking_details, missing city, and message is a service area city name,
      // treat as BOTH service_area_question AND booking_info_providing (answer question AND extract city)
      // FIX: Don't override - make it multi-intent so the service area question gets answered
      if (currentBooking.stage === 'booking_details' && 
          !currentBooking.city && 
          intent.intent === 'service_area_question' &&
          entities.city) {
        // Mark that we should answer the service area question
        currentBooking.pendingServiceAreaAnswer = true;
        // Also extract the city
        updates.city = entities.city;
        currentBooking.city = entities.city;
        // Keep intent as service_area_question so it gets properly answered
        // The template will handle both answering AND asking for remaining booking info
      }
      
      // Use AI extraction for booking_details stage (fully AI-powered)
      if (currentBooking.stage === 'booking_details') {
        // TIME LOOP BREAKER: If customer expresses urgency, accept as ASAP
        const urgentTimePattern = /\b(now|asap|immediately|right\s*away|right\s*now|as\s*soon\s*as\s*possible|urgent|emergency|hurry|quick|fast)\b/i;
        if (!currentBooking.timePreference && urgentTimePattern.test(customerMessage)) {
          updates.timePreference = 'ASAP';
          currentBooking.timePreference = 'ASAP';
        }
        
        // Track time ask count to prevent loops
        // Only increment when time is the ONLY missing field (we're specifically asking for time)
        if (!currentBooking.timePreference) {
          const hasName = currentBooking.name || updates.name;
          const hasAddress = currentBooking.address || updates.address;
          const hasCity = currentBooking.city || updates.city;
          const timeIsOnlyMissing = hasName && hasAddress && hasCity;
          
          if (timeIsOnlyMissing) {
          currentBooking.timeAskCount = (currentBooking.timeAskCount || 0) + 1;
            // After 2 asks specifically for time, default to ASAP
          if (currentBooking.timeAskCount >= 2) {
            updates.timePreference = 'ASAP';
            currentBooking.timePreference = 'ASAP';
            }
          }
        }
        
        const aiEntities = await extractBookingInfoWithAI(customerMessage);

        // DIAGNOSTIC ACKNOWLEDGMENT: If customer provided diagnostic info during booking, note it
        if (aiEntities.diagnosticNote) {
          diagnosticAck = "Good to know - I've noted that. ";
          // Optionally store in booking for plumber reference
          if (!currentBooking.diagnosticNotes) currentBooking.diagnosticNotes = [];
          currentBooking.diagnosticNotes.push(aiEntities.diagnosticNote);
        }
        
        // FIX: Also detect common problem keywords that AI might miss
        // This ensures simple answers like "clogged", "kitchen", "leaking" are acknowledged
        const problemKeywords = /\b(clog(?:ged)?|leak(?:ing)?|drip(?:ping)?|overflow(?:ing)?|running|broken|stuck|backed\s*up|backing\s*up|slow|burst|frozen|flooded|flooding|smell|noise|gurgling|won'?t\s+(?:flush|drain|work|stop))\b/i;
        const locationKeywords = /\b(kitchen|bathroom|basement|upstairs|downstairs|master|guest|main\s*(?:floor|bath)|laundry|garage|outside|outdoor|backyard|front\s*yard)\b/i;
        
        const hasProblemKeyword = problemKeywords.test(customerMessage);
        const hasLocationKeyword = locationKeywords.test(customerMessage);
        
        // If customer provides problem/location info but AI didn't capture it as diagnosticNote
        if (!diagnosticAck && (hasProblemKeyword || hasLocationKeyword)) {
          // Only acknowledge if there's no booking info in the message
          const hasBookingInfo = aiEntities.name || aiEntities.address || aiEntities.city || aiEntities.time;
          if (!hasBookingInfo) {
            diagnosticAck = "Got it - I've noted that. ";
            // Store in diagnosticNotes
            if (!currentBooking.diagnosticNotes) currentBooking.diagnosticNotes = [];
            currentBooking.diagnosticNotes.push(customerMessage);
          }
        }
        
        // Explicit indicator patterns for each field
        const hasNameIndicator = /\b(?:my\s+name\s+is|i\s+am|i'm|this\s+is|name\s*:|call\s+me)\b/i.test(customerMessage);
        const hasAddressIndicator = /\b(?:address\s+is|live\s+at|located\s+at|i'm\s+at|we're\s+at|address\s*:)\b/i.test(customerMessage);
        const hasCityIndicator = /\b(?:city\s+is|in\s+the\s+city|city\s*:|located\s+in)\b/i.test(customerMessage);
        const hasTimeIndicator = /\b(?:time\s+is|at\s+\d|around\s+\d|after\s+\d|before\s+\d|it's\s+at|come\s+at|come\s+by|available\s+at|time\s*:)\b/i.test(customerMessage);
        
        // Only save if field is empty OR user explicitly indicates they are providing it
        // FILTER: Reject common confirmation phrases that AI might mistake for names
        const isConfirmationPhrase = /^(sounds?\s*good|ok(ay)?|sure|yes|yep|yeah|no|nope|that\s*works?|perfect|great|fine|alright|got\s*it|thanks?|thank\s*you|please|hello|hi|hey)$/i.test((aiEntities.name || '').trim());
        if (aiEntities.name && (!currentBooking.name || hasNameIndicator) && !isConfirmationPhrase) {
          updates.name = aiEntities.name;
        }
        if (aiEntities.address && (!currentBooking.address || hasAddressIndicator)) {
          updates.address = aiEntities.address;
        }
        if (aiEntities.city && (!currentBooking.city || hasCityIndicator)) {
          updates.city = aiEntities.city;
        }
        if (aiEntities.time && (!currentBooking.timePreference || hasTimeIndicator)) {
          updates.timePreference = aiEntities.time;
        }
        
        // ADDRESS FALLBACK: If AI didn't extract address but regex did (e.g., "456 Oak Avenue"),
        // use regex extraction to prevent address question loop
        if (!updates.address && !currentBooking.address && entities.address) {
          updates.address = entities.address;
        }
        
        // CITY FALLBACK: If AI didn't extract city but regex did (e.g., simple "Toronto" message),
        // use regex extraction to prevent city question loop
        if (!updates.city && !currentBooking.city && entities.city) {
          updates.city = entities.city;
        }
        
        // FIX 5: TIME FALLBACK: If AI didn't extract time but regex did (e.g., simple "morning" message),
        // use regex extraction to prevent time question loop
        if (!updates.timePreference && !currentBooking.timePreference && entities.time) {
          updates.timePreference = entities.time;
        }
      } else {
        // Use regex extraction for other stages
      if (entities.name) updates.name = entities.name;
      if (entities.address) updates.address = entities.address;
      if (entities.city) updates.city = entities.city;
      if (entities.time) updates.timePreference = entities.time;
      }
      
      // Always extract phone and unit (for all stages)
      if (entities.phone && !currentBooking.phone) {
        updates.phone = entities.phone;
      }
      if (entities.unit && !currentBooking.unit) {
        updates.unit = entities.unit;
      }
      
      // DRAIN FIX 2: Prevent rhetorical fixture-list hijacking
      // If message is a clarification QUESTION listing multiple fixtures (e.g., "toilet, tub, drain?"),
      // do NOT reclassify into toilet/sink/shower based on those words
      const isRhetoricalOptionList = (
        /[?]/.test(customerMessage) || /^(?:where|which)\b/i.test(customerMessage)
      ) && (
        // Contains 2+ fixture words
        (customerMessage.match(/\b(?:toilet|tub|bathtub|shower|sink|drain|floor\s+drain|basement\s+drain)\b/gi) || []).length >= 2
      ) && (
        // Contains "or" or comma-separated structure
        /\bor\b/i.test(customerMessage) || /,/.test(customerMessage)
      );
      
      // LOCK PROBLEM TYPE: Only extract during initial/diagnosis stages
      // During booking_details/awaiting_confirmation, problem is already set - only collect contact info
      // DRAIN FIX 2: Skip problemType extraction if this is a rhetorical option list
      // FIX G: Don't reclassify if message is answering appliance type question (gas/electric)
      const isApplianceTypeAnswer = /^(?:gas|electric|gas\s+water\s*heater|electric\s+water\s*heater|not\s*sure|i\s*don'?t\s*know)$/i.test(customerMessage.trim()) ||
                                    /^(?:it'?s?\s+)?(?:gas|electric)$/i.test(customerMessage.trim());
      
      // FIX 2F: Allow fixture correction when correction signal detected
      if (entities.fixture && (!currentBooking.fixture || entities.previousFixtureCleared) && !updates.fixture) {
        updates.fixture = entities.fixture;
      }
      if (entities.problemType && entities.previousFixtureCleared &&
          currentBooking.stage !== 'booking_details' && 
          currentBooking.stage !== 'awaiting_confirmation') {
        if (setProblemTypeIfAllowed(currentBooking, entities.problemType, 'fixture_correction')) {
          updates.problemType = currentBooking.problemType;
          updates.problemTypeSource = currentBooking.problemTypeSource;
        }
      }
      if (entities.problemType && !isRhetoricalOptionList && !isApplianceTypeAnswer &&
          currentBooking.stage !== 'booking_details' && 
          currentBooking.stage !== 'awaiting_confirmation') {
        // Use authority system - only set if allowed by priority
        const source = entities.problemTypeSourceHint || (entities.fixture ? 'specific_compound' : 'generic_pattern');
        if (setProblemTypeIfAllowed(currentBooking, entities.problemType, source)) {
          updates.problemType = currentBooking.problemType;
          updates.problemTypeSource = currentBooking.problemTypeSource;
        if (currentBooking.stage === 'initial') {
          updates.stage = 'problem_diagnosis';
        }
        
        // Transfer high-confidence detection flag (for toilet early detection)
        if (entities.highConfidenceDetection) {
          updates.highConfidenceDetection = true;
            // FIX F: Also transfer to diagnosticSlots for use in getFixedDiagnosticSequence
            if (!updates.diagnosticSlots) {
              updates.diagnosticSlots = { ...currentBooking.diagnosticSlots };
            }
            updates.diagnosticSlots.highConfidenceDetection = true;
        }
        
        // Transfer leak_location to diagnosticSlots if detected (e.g., supply line leak)
        if (entities.leak_location) {
          if (!updates.diagnosticSlots) {
            updates.diagnosticSlots = { ...currentBooking.diagnosticSlots };
          }
          updates.diagnosticSlots.leak_location = entities.leak_location;
        }

          // FIX C: Transfer noise_type to diagnosticSlots if detected
          if (entities.noise_type) {
            if (!updates.diagnosticSlots) {
              updates.diagnosticSlots = { ...currentBooking.diagnosticSlots };
            }
            updates.diagnosticSlots.noise_type = entities.noise_type;
        }
        
        // INVARIANT 1: WATER HEATER INTENT LOCK (STATE-BASED)
        // Once water heater intent is detected, lock it in state to prevent opener fallthrough
        if (entities.problemType && entities.problemType.startsWith('water_heater')) {
          updates.waterHeaterIntentLocked = true;
        }
        
        // Check if the detected problem type is an emergency
        if (PROBLEM_TYPES.isEmergency(entities.problemType)) {
          updates.isEmergency = true;
          updates.emergencyModeActive = true;  // STICKY LATCH
          updates.urgencyLevel = 'emergency';
          }
        }
      }
      
      // INVARIANT 1 (ADDITIONAL): Also lock water heater intent from message content even if problemType already set
      if (!currentBooking.waterHeaterIntentLocked && !updates.waterHeaterIntentLocked) {
        const hasWaterHeaterSignal = /\b(water\s*heater|hot\s*water\s*tank|no\s+hot\s+water|not\s+hot|scalding|too\s+hot|heater.*leak|pilot\s+light|tankless|water\s+(?:isn'?t|not)\s+heating|barely\s+warm|temp.*(?:changing|spiking)|worse\s+when\s+multiple\s+showers|tank\s+thing|heating\s+right|lukewarm|only\s+(?:getting\s+)?(?:warm|tepid)|little\s+(?:valve|pipe).*heater)\b/i.test(customerMessage);
        if (hasWaterHeaterSignal) {
          updates.waterHeaterIntentLocked = true;
        }
      }
      
      updates.lastMessage = customerMessage;
      const updatedBooking = updateBookingData(customerKey, updates);
      
      // MULTI-INTENT: Handle at initial stage (before diagnostic)
      if (intent.isMultiIntent && updatedBooking.stage === 'initial') {
        if (intent.allIntents.some(i => i.intent === 'authentication_question' || i.intent === 'real_plumber_question')) {
          incrementAuthenticationCount(customerKey);
        }
        
        const response = buildMultiIntentResponse(intent, updatedBooking, fullContext);
        stats.aiResponses++;
        
        const missing = [];
        if (!updatedBooking.name) missing.push('full name');
        if (!updatedBooking.address) missing.push('address');
        if (!updatedBooking.city) missing.push('city');
        if (!updatedBooking.timePreference) missing.push('best time');
        
        return {
          response,
          booking: updatedBooking,
          debug: {
            booking: updatedBooking,
            entities: entities,
            intent: intent,
            stage: updatedBooking.stage,
            missing: missing,
            responseType: 'Multi-Intent (Initial): ' + intent.allIntents.map(i => i.intent).join(', '),
            templateParams: [],
            customerMessage: customerMessage
          },
          metadata: {
            stage: updatedBooking.stage,
            usingAI: isAIEnabled(),
            multiIntent: true
          }
        };
      }
      
      // MULTI-INTENT: Handle during booking_details stage
      if (intent.isMultiIntent && updatedBooking.stage === 'booking_details') {
        if (intent.allIntents.some(i => i.intent === 'authentication_question' || i.intent === 'real_plumber_question')) {
          incrementAuthenticationCount(customerKey);
        }
        
        const response = buildMultiIntentResponse(intent, updatedBooking, fullContext);
        stats.aiResponses++;
        
        const missing = [];
        if (!updatedBooking.name) missing.push('full name');
        if (!updatedBooking.address) missing.push('address');
        if (!updatedBooking.city) missing.push('city');
        if (!updatedBooking.timePreference) missing.push('best time');
        
        return {
          response,
          booking: updatedBooking,
          debug: {
            booking: updatedBooking,
            entities: entities,
            intent: intent,
            stage: updatedBooking.stage,
            missing: missing,
            responseType: 'Multi-Intent (Booking): ' + intent.allIntents.map(i => i.intent).join(', '),
            templateParams: [],
            customerMessage: customerMessage
          },
          metadata: {
            stage: updatedBooking.stage,
            usingAI: isAIEnabled(),
            multiIntent: true
          }
        };
      }
      
      // ================================================================
      // LIGHTWEIGHT ROUTING: New problem categories (Phase 1 expansion)
      // These route directly to booking with minimal/no diagnostics
      // ================================================================
      
      // 1️⃣ SUMP PUMP: If flooding mentioned, safety message, then book
      if (updatedBooking.problemType === 'sump_pump' && updatedBooking.stage === 'problem_diagnosis') {
        const msg = customerMessage.toLowerCase();
        const hasFlooding = /\b(flood|flooding|water\s*everywhere|overflowing|overflow|backing\s*up|filling\s*up)\b/i.test(msg);
        
        // If flooding, deliver safety message once then book
        if (hasFlooding && !updatedBooking.safetyGuidanceGiven) {
          updatedBooking.safetyGuidanceGiven = true;
          updatedBooking.stage = 'booking_details';
          bookingData.set(customerKey, updatedBooking);
          return {
            response: "If there's active flooding, avoid the area and don't use any electrical outlets nearby. Let's get someone out right away - what's your name and address?",
            booking: updatedBooking,
            debug: { intent: 'sump_pump_flooding', stage: 'booking_details' },
            metadata: { stage: 'booking_details', category: 'sump_pump' }
          };
        }
        
        // No flooding - ask one clarifier then book (use explicit flag, not diagnosticHistory)
        if (!updatedBooking.sumpPumpClarified) {
          updatedBooking.sumpPumpClarified = true;
          bookingData.set(customerKey, updatedBooking);
          return {
            response: "Got it - is the sump pump not running at all, or is it running but water is still rising?",
            booking: updatedBooking,
            debug: { intent: 'sump_pump_clarify', stage: 'problem_diagnosis' },
            metadata: { stage: 'problem_diagnosis', category: 'sump_pump' }
          };
        }
        
        // After clarifier, go to booking
        updatedBooking.stage = 'booking_details';
        bookingData.set(customerKey, updatedBooking);
        return {
          response: "Got it. Let's get someone out to take a look. What's your name and address?",
          booking: updatedBooking,
          debug: { intent: 'sump_pump_booking', stage: 'booking_details' },
          metadata: { stage: 'booking_details', category: 'sump_pump' }
        };
      }
      
      // 2️⃣ MAIN SHUTOFF VALVE: Safety message, then immediate booking
      if (updatedBooking.problemType === 'main_shutoff_valve' && updatedBooking.stage === 'problem_diagnosis') {
        updatedBooking.stage = 'booking_details';
        bookingData.set(customerKey, updatedBooking);
        return {
          response: "Don't force the valve - that can cause it to break. Let's get someone out to help. What's your name and address?",
          booking: updatedBooking,
          debug: { intent: 'main_shutoff_valve', stage: 'booking_details' },
          metadata: { stage: 'booking_details', category: 'main_shutoff_valve' }
        };
      }
      
      // 3️⃣ PRV (Pressure Reducing Valve): Direct to booking, no diagnostics
      if (updatedBooking.problemType === 'prv' && updatedBooking.stage === 'problem_diagnosis') {
        updatedBooking.stage = 'booking_details';
        bookingData.set(customerKey, updatedBooking);
        return {
          response: "Got it - pressure issues can cause damage if left too long. Let's get someone out. What's your name and address?",
          booking: updatedBooking,
          debug: { intent: 'prv', stage: 'booking_details' },
          metadata: { stage: 'booking_details', category: 'prv' }
        };
      }
      
      // 4️⃣ WELL PUMP: One clarifier (well vs city), then booking
      if (updatedBooking.problemType === 'well_pump' && updatedBooking.stage === 'problem_diagnosis') {
        // Check if they already mentioned well explicitly
        const msg = customerMessage.toLowerCase();
        const explicitWell = /\b(private\s*well|well\s*pump|well\s*system|on\s*a\s*well|we'?re\s*on\s*well)\b/i.test(msg);
        
        // Use explicit flag instead of diagnosticHistory.length
        if (!explicitWell && !updatedBooking.wellPumpClarified) {
          updatedBooking.wellPumpClarified = true;
          bookingData.set(customerKey, updatedBooking);
          return {
            response: "Are you on a private well or city water?",
            booking: updatedBooking,
            debug: { intent: 'well_pump_clarify', stage: 'problem_diagnosis' },
            metadata: { stage: 'problem_diagnosis', category: 'well_pump' }
          };
        }
        
        // After clarifier or if explicit, go to booking
        updatedBooking.stage = 'booking_details';
        bookingData.set(customerKey, updatedBooking);
        return {
          response: "Got it - well pump issues need a look in person. What's your name and address?",
          booking: updatedBooking,
          debug: { intent: 'well_pump_booking', stage: 'booking_details' },
          metadata: { stage: 'booking_details', category: 'well_pump' }
        };
      }
      
      // ================================================================
      // END LIGHTWEIGHT ROUTING
      // ================================================================
      
      // NOTE: Installation V1 is now handled by EARLY INTENT FORK (before entity extraction)
      // This ensures install requests NEVER enter repair framing
      
      // INSTALLATION GUARD: Skip ALL repair diagnostics if in install flow
      // Install flow has its own path: identify item → location → book
      if (updatedBooking.installIntentLocked || updatedBooking.installFlow) {
        // Force to booking if we somehow got here with install flow active
        if (updatedBooking.stage === 'problem_diagnosis') {
          updatedBooking.stage = 'booking_details';
          if (updatedBooking.installFlow?.item) {
            setProblemTypeIfAllowed(updatedBooking, `install_${updatedBooking.installFlow.item}`, 'specific_compound');
          }
          bookingData.set(customerKey, updatedBooking);
          return {
            response: RESPONSE_TEMPLATES.getSmartBookingRequest(currentBooking, "Let's get you booked. "),
            booking: updatedBooking,
            debug: { intent: 'install_flow_redirect', stage: 'booking_details' },
            metadata: { stage: 'booking_details', installFlow: true }
          };
        }
      }
      
      // Problem just mentioned + question = Do diagnostic first
      if (updatedBooking.stage === 'problem_diagnosis') {
        let diagnosticHistory = updatedBooking.diagnosticHistory || [];
        
        // LATE PROBLEM-TYPE IDENTIFICATION: Detect subtypes from keywords within LOCKED category
        const currentProblemType = updatedBooking.problemType;
        const msg = customerMessage.toLowerCase();
        
        // Get the base category of current type
        const getBaseCategory = (type) => {
          if (!type) return null;
          if (type.startsWith('toilet')) return 'toilet';
          if (type.startsWith('sink')) return 'sink';
          if (type.startsWith('shower') || type.startsWith('bathtub')) return 'shower';
          if (type.startsWith('sewer') || type.startsWith('main_drain')) return 'sewer';
          if (type.startsWith('water_heater')) return 'water_heater';
          if (type.startsWith('pipe')) return 'pipe';
          if (type.startsWith('drain')) return 'drain';
          if (type.startsWith('leak')) return 'leak';
          if (type.startsWith('faucet')) return 'faucet';
          if (type.startsWith('dishwasher') || type.startsWith('washer') || type.startsWith('fridge') || type.startsWith('ice_maker') || type === 'appliance') return 'appliance';
          if (type.startsWith('hose_bib') || type.startsWith('outdoor') || type.startsWith('sprinkler') || type.startsWith('exterior') || type.startsWith('water_meter') || type.startsWith('yard') || type.startsWith('sump')) return 'outdoor';
          return type;
        };
        
        const currentCategory = getBaseCategory(currentProblemType);
        
        // Detect specific subtype from message keywords (within locked category)
        const detectSubtypeFromMessage = (category, message) => {
          const m = message.toLowerCase();
          
          // TOILET subtypes (15 categories)
          if (category === 'toilet') {
            if (/\b(smell|smells|odor|odour|stink|stinks|sewer|bad\s+smell)\b/i.test(m)) return 'toilet_smell';
            if (/\b(overflow|overflowing|spilling|water\s+everywhere|flooding)\b/i.test(m)) return 'toilet_overflowing';
            if (/\b(clog|clogged|blocked|backed\s*up|wont\s+go\s+down|won't\s+go\s+down)\b/i.test(m)) return 'toilet_clogged';
            if (/\b(starts?\s+and\s+stops?|intermittent|phantom|ghost)\b/i.test(m)) return 'toilet_running_intermittent';
            if (/\b(running|keeps\s+running|wont\s+stop|won't\s+stop|constantly)\b/i.test(m)) return 'toilet_running';
            if (/\b(chain|flapper)\b/i.test(m)) return 'toilet_flapper_chain';
            if (/\b(handle|lever|flush\s+handle|broken\s+handle|loose\s+handle)\b/i.test(m)) return 'toilet_handle_issue';
            if (/\b(leak.*base|base.*leak|water.*around.*base|base|floor|where\s+it\s+meets)\b/i.test(m)) return 'toilet_leaking_base';
            if (/\b(tank\s+itself|from\s+(?:the\s+)?tank|tank\s+leak)\b/i.test(m)) return 'toilet_leaking_tank';
            if (/\b(leak|leaking|drip|dripping|puddle|water\s+on\s+floor)\b/i.test(m)) return 'toilet_leaking';
            if (/\b(object|toy|dropped|fell\s+in|stuck\s+in|something\s+stuck)\b/i.test(m)) return 'toilet_object_stuck';
            if (/\b(noise|noisy|gurgle|gurgling|whistl|hiss|hissing|bang|banging|loud)\b/i.test(m)) return 'toilet_noise_issue';
            if (/\b(weak\s+flush|poor\s+flush|barely\s+flush|half\s+flush|flush.*weak|flush.*poor|double\s+flush|flush\s+twice|have\s+to\s+flush\s+twice|need\s+to\s+flush\s+twice)\b/i.test(m)) return 'toilet_weak_flush';
            if (/\b(incomplete|doesn'?t\s+clear|won'?t\s+clear|partial|flush.*incomplete|flushing\s+incomplete|incomplete\s+flush)\b/i.test(m)) return 'toilet_incomplete_flush';
            if (/\b(water\s+level|too\s+high|too\s+low|bowl\s+water)\b/i.test(m)) return 'toilet_water_level_issue';
            if (/\b(wobbly|wobbles|loose|rocks|rocking|moves|unstable)\b/i.test(m)) return 'toilet_wobbly';
            if (/\b(crack|cracked)\b/i.test(m)) return 'toilet_cracked';
            if (/\b(tank.*not\s+fill|not\s+filling|no\s+water\s+in\s+tank|tank\s+empty)\b/i.test(m)) return 'toilet_tank_not_filling';
          }
          
          // SINK subtypes (12 categories)
          if (category === 'sink') {
            if (/\b(slow|draining\s+slow|slowly)\b/i.test(m)) return 'sink_slow_drain';
            if (/\b(clog|clogged|blocked|won'?t\s+drain|not\s+draining)\b/i.test(m)) return 'sink_clogged';
            if (/\b(gurgl|bubble|bubbling)\b/i.test(m)) return 'sink_gurgling';
            if (/\b(backing\s*up|backed\s*up|backup)\b/i.test(m)) return 'sink_backing_up';
            if (/\b(trap|p-?trap)\b/i.test(m)) return 'sink_leak_trap';
            if (/\b(supply|valve)\b/i.test(m)) return 'sink_leak_supply';
            if (/\b(faucet.*broken|broken.*faucet|handle)\b/i.test(m)) return 'sink_faucet_broken';
            if (/\b(low\s+pressure|no\s+pressure|weak)\b/i.test(m)) return 'sink_low_pressure';
            if (/\b(no\s+water|not\s+working)\b/i.test(m)) return 'sink_no_water';
            if (/\b(no\s+hot|not\s+hot|cold\s+only)\b/i.test(m)) return 'sink_no_hot_water';
            if (/\b(smell|stink|odor)\b/i.test(m)) return 'sink_smell';
            if (/\b(drip|leak)\b/i.test(m)) return 'sink_leak_faucet';
          }
          
          // SHOWER/BATHTUB subtypes (14 categories)
          if (category === 'shower') {
            if (/\b(no\s+pressure|low\s+pressure|weak\s+pressure|pressure\s+low)\b/i.test(m)) return 'shower_low_pressure';
