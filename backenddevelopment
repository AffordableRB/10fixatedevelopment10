        const isImplicitConfirmation = /^(?:pretty\s+steady|constant(?:\s+drip)?|slow(?:\s+drip)?|steady|intermittent|on\s+and\s+off|all\s+the\s+time|only\s+(?:when|after)|once\s+in\s+a\s+while|sounds?\s*good|that\s*works?|sure|ok(?:ay)?|yes|yep|yeah|ya|fine|great|perfect|got\s*it|alright|k|kk|yup|mhm|cool|awesome)$/i.test(customerMessage.trim());
        
        const correctionEntities = isImplicitConfirmation ? {} : extractEntities(customerMessage, 'booking_details');
        const corrections = {};
        
        if (correctionEntities.name) corrections.name = correctionEntities.name;
        if (correctionEntities.address) corrections.address = correctionEntities.address;
        if (correctionEntities.city) corrections.city = correctionEntities.city;
        if (correctionEntities.time) corrections.timePreference = correctionEntities.time;
        
