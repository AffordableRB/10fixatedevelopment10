              debug: {
                intent: 'sink_high_confidence_shortcircuit',
                stage: 'booking_details',
                problemType: updatedBooking.problemType
              },
              metadata: {
                stage: 'booking_details',
                shortCircuit: 'sink_high_confidence'
              }
