             (/\bwater\s+(?:stopped|quit)\s*(?:working)?\b/i.test(message) && !/\bhot\s+water\s+(?:stopped|quit)/i.test(message)) ||
             /\bno\s+water\s+(?:in\s+)?(?:the\s+)?(?:house|home|anywhere)\b/i.test(message)) {
      entities.problemType = 'no_water_house';
    }
    // === GENERAL PLUMBING ===
    else if (/\b(?:plumbing)\s+(?:emergency)\b/i.test(message)) {
      entities.problemType = 'general_plumbing';
      entities.isEmergency = true;
    }
    else if (/\b(?:plumbing)\s+(?:problem|issue)\b/i.test(message) ||
             /\b(?:i\s+have\s+a)\s+plumbing\s+(?:problem|issue)\b/i.test(message)) {
      entities.problemType = 'general_plumbing';
    }
    else if (/\bneed\s+(?:a\s+)?(?:plumber)\b/i.test(message)) {
      entities.problemType = 'general_plumbing';
    }
    // === TYPOS ===
    else if (/\b(?:softner|sofener)\s+(?:not\s+working|broken|leaking)\b/i.test(message) ||
             /\bwater\s+(?:softner|sofener)\b/i.test(message)) {
      entities.problemType = 'water_softener_not_working';
    }
    else if (/\b(?:low|no)\s+(?:presure|pressur|preasure)\b/i.test(message)) {
