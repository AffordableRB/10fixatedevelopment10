  }

  function extractEntities(message, stage = null) {
    const entities = {
      name: null,
      address: null,
      city: null,
      time: null,
      problemType: null,
      phone: null,
      unit: null,
      fixture: null
    };
    
    // FIX N: Clear fixture state when user corrects themselves
    // "sorry wrong, water heater not working" should re-classify fixture
    const isCorrectionSignal = /\b(?:sorry\s*(?:wrong)?|actually|no\s*wait|wrong\s*(?:one)?|not\s*(?:that|the)|meant|i\s*mean)\b/i.test(message);
    if (isCorrectionSignal) {
      // Clear previous fixture to allow re-classification
      entities.fixture = null;
      entities.previousFixtureCleared = true;
    }
    
    // Name extraction is ONLY allowed during booking_details stage
    const allowNameExtraction = (stage === 'booking_details');

    // Use centralized SERVICE_AREAS config
    const cities = [...SERVICE_AREAS.cities, ...Object.keys(SERVICE_AREAS.typoMap)];
    const cityMap = SERVICE_AREAS.typoMap;
    
    // FIX #6: REPAIR vs INSTALL disambiguation
    // "needs to be replaced" / "needs replacing" / "needs a new cartridge" = REPAIR
    // "want to replace with new" / "replacing old with new" / "bought new, need installed" = INSTALL
    const isRepairReplacement = 
      /\b(?:needs?|need)\s+(?:to\s+be\s+)?(?:replaced|replacing|fixed|repaired|rebuilt)\b/i.test(message) ||
      /\b(?:needs?|need)\s+(?:the\s+)?(?:\w+\s+)?(?:rebuilt|replaced|fixed|repaired)\b/i.test(message) ||
      /\b(?:cartridge|valve|washer|seal|part|component)\s+(?:needs?|need)\s+(?:to\s+be\s+)?(?:replaced|replacing|rebuilt)\b/i.test(message) ||
      /\b(?:should|must|has\s+to)\s+be\s+(?:replaced|rebuilt)\b/i.test(message) ||
      /\breplacement\s+(?:cartridge|valve|washer|part)\b/i.test(message) ||
      /\b(?:valve|cartridge|faucet|shower)\s+(?:rebuilt|replaced)\b/i.test(message);
    
    const isNewInstallation = 
      /\b(?:bought|purchased|got|have)\s+(?:a\s+)?new\b/i.test(message) ||
      /\bwant\s+(?:to\s+)?(?:install|put\s+in)\s+(?:a\s+)?new\b/i.test(message) ||
      /\b(?:new|brand\s+new)\s+(?:toilet|sink|faucet|tub|shower).*(?:install|put\s+in|hook\s+up)\b/i.test(message);
    
    // FIX-18: Detect "need [fixture] installed" pattern
    // This catches patterns like "Need toilet installed", "Need water heater installed"
    // Also catches typos: instalation, instll, instal
    const needFixtureInstalled = 
      /\bneed\s+(?:a\s+)?(?:toilet|sink|faucet|shower|tub|bathtub|water\s*heater|dishwasher|disposal|garbage\s*disposal)\s+(?:installed|installation|instalation|instll|instal)\b/i.test(message) ||
      /\b(?:toilet|sink|faucet|shower|tub|bathtub|water\s*heater|dishwasher|disposal)\s+(?:instalation|instll)\b/i.test(message);
    
    // If needFixtureInstalled is true, we'll use this to force isInstall = true later
    if (needFixtureInstalled) {
      entities.isInstall = true;
    }
    
    // If it's clearly a repair replacement, don't trigger installation flow
    if (isRepairReplacement && !isNewInstallation) {
      // FIX: Check for "in my shower/tub" context FIRST - overrides bare faucet mention
      // "faucet cartridge in my shower" = shower fixture, not faucet
      const hasShowerContext = /\b(?:in\s+(?:my|the|our)\s+(?:(?:\w+\s+)*)(?:shower|tub|bathtub))\b/i.test(message) ||
                               /\b(?:shower|tub|bathtub)\s+(?:faucet|valve|cartridge|handle)\b/i.test(message);
      
      if (hasShowerContext || /\b(?:shower|tub|bathtub)\b/i.test(message)) {
        entities.fixture = 'shower';
        if (/cartridge/i.test(message)) {
          entities.problemType = 'shower_valve_issue';
        } else {
          entities.problemType = 'shower_repair';
        }
      } else if (/\b(?:faucet|tap)\b/i.test(message)) {
        entities.fixture = 'faucet';
        entities.problemType = 'faucet_repair';
      }
    }
    
    const msg = message.toLowerCase();
    for (const city of cities) {
      if (msg.includes(city)) {
        entities.city = cityMap[city] || city;
        break;
      }
    }

    // PHONE NUMBER EXTRACTION
    // Supports: (416) 555-1234, 416-555-1234, 416.555.1234, 4165551234, +1 416 555 1234
    const phonePatterns = [
      /\b(?:\+?1[-.\s]?)?\(?([0-9]{3})\)?[-.\s]?([0-9]{3})[-.\s]?([0-9]{4})\b/,
      /\b([0-9]{3})[-.\s]([0-9]{3})[-.\s]([0-9]{4})\b/,
      /\b([0-9]{10})\b/
    ];
    
    for (const phonePattern of phonePatterns) {
      const phoneMatch = message.match(phonePattern);
      if (phoneMatch) {
        // Format as XXX-XXX-XXXX
        let phone = phoneMatch[0].replace(/[^\d]/g, '');
        if (phone.length === 11 && phone.startsWith('1')) {
          phone = phone.substring(1);
        }
        if (phone.length === 10) {
          entities.phone = `${phone.substring(0,3)}-${phone.substring(3,6)}-${phone.substring(6)}`;
          break;
        }
      }
    }

    // UNIT/APT/LOT NUMBER EXTRACTION
    // Supports: unit 4b, apt 3, apartment 12, suite 100, lot 5, #12, floor 2
    const unitPatterns = [
      /\b(?:unit|apt|apartment|suite|ste|lot|#)\s*([a-zA-Z0-9]+)\b/i,
      /\b(?:floor|fl)\s*([0-9]+)\b/i,
      /\b(?:basement|bsmt)\b/i
    ];
    
    for (const unitPattern of unitPatterns) {
      const unitMatch = message.match(unitPattern);
      if (unitMatch) {
        if (/basement|bsmt/i.test(unitMatch[0])) {
          entities.unit = 'Basement';
    } else {
          entities.unit = unitMatch[0].trim();
        }
        break;
      }
    }

    // ADDRESS EXTRACTION: Run on raw message before any cleaning
    // Supports multiple formats:
    // - "9 spooner street", "8 spooner st" (number first)
    // - "spooner street lot 9", "main st #12" (number after street)
    // - "lot 9 spooner street", "unit 4b main ave" (qualifier + number + street)
    // - "spooner st unit 4b", "main street apt 3" (street + qualifier + number)
    
    const streetTypes = '(?:street|st\\.?|avenue|ave\\.?|road|rd\\.?|drive|dr\\.?|lane|ln\\.?|way|boulevard|blvd\\.?|court|ct\\.?|crescent|cres\\.?|circle|cir\\.?|place|pl\\.?|terrace|ter\\.?|trail|trl\\.?|parkway|pkwy\\.?|highway|hwy\\.?)';
    const qualifiers = '(?:lot|unit|apt|apartment|suite|ste|floor|fl|basement|bsmt|#)';
    
    // Pattern 1: number + street name + street type (e.g., "9 spooner street")
    // FIX: Changed \s* to \s+ before streetTypes to prevent matching "st" inside words like "just", "first"
    const pattern1 = new RegExp(`\\b(\\d+[a-zA-Z]?\\s+[a-zA-Z]+(?:\\s+[a-zA-Z]+)*\\s+${streetTypes})\\b`, 'i');
    // Pattern 2: street name + street type + qualifier + number (e.g., "spooner street lot 9", "main st #12")
    // FIX: Changed \s* to \s+ before streetTypes to prevent matching "st" inside words like "just", "first"
    const pattern2 = new RegExp(`\\b([a-zA-Z]+(?:\\s+[a-zA-Z]+)*\\s+${streetTypes}\\s*${qualifiers}?\\s*#?\\d+[a-zA-Z]?)\\b`, 'i');
    // Pattern 3: qualifier + number + street name + street type (e.g., "lot 9 spooner street", "unit 4b main ave")
    // FIX: Changed \s* to \s+ before streetTypes to prevent matching "st" inside words like "just", "first"
    const pattern3 = new RegExp(`\\b(${qualifiers}\\s*#?\\d+[a-zA-Z]?\\s+[a-zA-Z]+(?:\\s+[a-zA-Z]+)*\\s+${streetTypes})\\b`, 'i');
    // Pattern 4: number + street name (no street type) (e.g., "9 spooner")
    const pattern4 = /\b(\d+[a-zA-Z]?\s+[a-zA-Z]{2,}(?:\s+[a-zA-Z]{2,})?)\b/i;
    // Pattern 5: PO Box (e.g., "PO Box 123", "P.O. Box 456")
    const pattern5 = /\b(P\.?O\.?\s*Box\s*\d+)\b/i;
    // Pattern 6: Rural route (e.g., "RR 2", "Rural Route 3")
    const pattern6 = /\b((?:RR|Rural\s*Route)\s*\d+(?:\s*(?:Box|Site)\s*\d+)?)\b/i;
    
    let addressMatch = message.match(pattern1) || message.match(pattern2) || message.match(pattern3) || 
                       message.match(pattern5) || message.match(pattern6) || message.match(pattern4);
    
    if (addressMatch) {
      let potentialAddress = addressMatch[1].trim();
      // Exclude times like "8am", phone numbers, time durations, frequency phrases, and very short matches
      const isTimeDuration = /^\d+\s*(seconds?|secs?|minutes?|mins?|hours?|hrs?|days?|weeks?|months?|years?)$/i.test(potentialAddress);
      const isFrequencyPhrase = /^\d+\s*times?\b/i.test(potentialAddress);
        if (!/^\d+\s*(?:am|pm)$/i.test(potentialAddress) && 
            !/^\d{3,4}[-\s]?\d{3,4}/.test(potentialAddress) &&
            !isTimeDuration &&
            !isFrequencyPhrase &&
            potentialAddress.length > 3) {
        // Append unit if extracted separately and not already in address
        if (entities.unit && !potentialAddress.toLowerCase().includes(entities.unit.toLowerCase())) {
          potentialAddress = `${potentialAddress}, ${entities.unit}`;
        }
          entities.address = potentialAddress;
      }
    }

    let messageForNameExtraction = message;
    
    if (entities.city) {
      messageForNameExtraction = messageForNameExtraction.replace(new RegExp(entities.city, 'gi'), '').trim();
    }
    
    if (entities.address) {
      messageForNameExtraction = messageForNameExtraction.replace(new RegExp(entities.address.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi'), '').trim();
    }
    
    const questionPhrases = [
      /who\s+is\s+this/gi,
      /what\s+is\s+this/gi,
      /where\s+is\s+this/gi,
      /when\s+is\s+this/gi,
      /how\s+is\s+this/gi,
      /who\s+is/gi,
      /what\s+is/gi,
      /it\s+is/gi,
      /this\s+is/gi,
      /are\s+you/gi,
      /is\s+this/gi,
      /is\s+it/gi,
      /who\s+are/gi,
      /what\s+are/gi
    ];
    
    for (const phrase of questionPhrases) {
      messageForNameExtraction = messageForNameExtraction.replace(phrase, '').trim();
    }
    
    // NAME EXTRACTION: Only during booking_details stage
    if (allowNameExtraction) {
      // HIGH-PRIORITY: Explicit name declaration patterns (bypass all skip logic)
      const explicitNamePatterns = [
        /^my\s+name\s+is\s+(.+)$/i,
        /^name\s+is\s+(.+)$/i,
        /^my\s+name'?s\s+(.+)$/i,
        /^it'?s\s+(.+)\s+for\s+the\s+name$/i
      ];
      
      let explicitNameFound = false;
      for (const pattern of explicitNamePatterns) {
        const match = message.trim().match(pattern);
        if (match && match[1]) {
          const namePart = match[1].trim();
          // Clean and capitalize the name
          const formattedName = namePart
            .split(/\s+/)
            .map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())
            .join(' ');
          entities.name = formattedName;
          explicitNameFound = true;
          break;
        }
      }
      
      // If we found an explicit name, skip the rest of the name extraction logic
      if (!explicitNameFound) {
        // CORRECTION LANGUAGE CHECK: If message contains correction words, disable name extraction entirely
        const isCorrectionMessage = /\b(?:change|changing|switch|update|correct|correction|fix|from|instead|actually|should\s+be|meant\s+to\s+be)\b/i.test(message);
        
        if (isCorrectionMessage) {
        // Skip name extraction - this is a correction request, not a name
      } else if (/\d/.test(messageForNameExtraction)) {
        // Skip name extraction - messages like "8am", "3 toilets", "2 upstairs" are not names
      } else if (messageForNameExtraction.length >= 3) {
      const notNameWords = [
          // Plumbing terms (with plurals and variations)
          'toilet', 'toilets', 'tolet', 'tolets', 'toylet', 'toylets',
          'drain', 'drains', 'drainage', 'draining',
          'leak', 'leaks', 'leaking', 'leaked', 'leaky',
          'clog', 'clogs', 'clogged', 'clogging',
          'overflow', 'overflows', 'overflowing', 'overflowed', 'overfl', 'overflo', 'overfll',
          'flood', 'floods', 'flooding', 'flooded', 'everywhere',
          'broken', 'break', 'breaks', 'breaking',
          'drip', 'drips', 'dripping', 'dripped', 'drippy',
          'back', 'backed', 'backup', 'backups', 'backing',
          'stuck', 'burst', 'bursts', 'bursting', 'busted',
          'pipe', 'pipes', 'piping', 'piped',
          'faucet', 'faucets', 'tap', 'taps',
          'shower', 'showers', 'showering',
          'sink', 'sinks', 'sinking',
          'water', 'waters', 'watery',
          'heater', 'heaters', 'heating',
          'hot', 'cold', 'warm', 'lukewarm',
          'run', 'runs', 'running', 'ran',
          'wobbly', 'wobble', 'wobbles', 'wobbling', 'loose',
          'smell', 'smells', 'smelly', 'smelling', 'stink', 'stinks', 'stinky',
          'sewer', 'sewers', 'sewage',
          'plumbing', 'plumber', 'plumbers',
          'fix', 'fixes', 'fixing', 'fixed',
          'repair', 'repairs', 'repairing', 'repaired',
          'issue', 'isu', 'issues', 'problem', 'problems',
          'handle', 'handles', 'valve', 'valves',
          'tank', 'tanks', 'bowl', 'bowls',
          'pressure', 'low', 'high', 'noise', 'noisy', 'noises',
          'flushing', 'flush', 'flushgin', 'flushin', 'flusing',
          // Common non-name words
          'just', 'completely', 'very', 'really', 'totally', 'not',
        'what', 'when', 'where', 'how', 'please', 'help', 'need', 'want',
        'good', 'morning', 'afternoon', 'evening', 'who', 'this', 'you',
          'road', 'roads', 'street', 'streets', 'avenue', 'avenues', 'drive', 'drives', 'lane', 'lanes', 'court', 'courts',
          'hi', 'hello', 'hey', 'there', 'real',
          'neither', 'its', 'yes', 'no', 'yeah', 'nope', 'yep',
