  // Helper: Get refined problem type (general → specific), with safety checks
  function getRefinedProblemType(currentType, message, refinementLocked = false) {
    // If already locked, don't refine
    if (refinementLocked) {
      return currentType;
    }
    
    // Get current category
    const getCurrentCategory = (type) => {
      for (const [category, types] of Object.entries(PROBLEM_TYPES.categories)) {
        if (types.includes(type)) return category;
      }
      return null;
    };
    
    const currentCategory = getCurrentCategory(currentType);
    if (!currentCategory) return currentType;
    
    const msg = message.toLowerCase();
    let bestMatch = currentType;
    let bestSeverity = PROBLEM_TYPE_SEVERITY[currentType] || 0;
    
    // Check each refinement pattern
    for (const [refinedType, patterns] of Object.entries(REFINEMENT_PATTERNS)) {
      // Must be in same category
      const refinedCategory = getCurrentCategory(refinedType);
      if (refinedCategory !== currentCategory) continue;
      
      // Check if message matches this refinement
      const matches = patterns.some(pattern => pattern.test(msg));
      if (!matches) continue;
      
      // Check severity - only upgrade, never downgrade
      const refinedSeverity = PROBLEM_TYPE_SEVERITY[refinedType] || 0;
      if (refinedSeverity > bestSeverity) {
        bestMatch = refinedType;
        bestSeverity = refinedSeverity;
      }
    }
    
    return bestMatch;
  }

  // Helper: Check if newType is a valid subtype upgrade from oldType
  // Returns true only if both are in same category and newType is more specific
  function isValidSubtypeUpgrade(oldType, newType) {
    if (!oldType || !newType || oldType === newType) return false;
    
    // Get categories for both types
    const getCategory = (type) => {
      for (const [category, types] of Object.entries(PROBLEM_TYPES.categories)) {
        if (types.includes(type)) return category;
      }
      return null;
    };
    
    const oldCategory = getCategory(oldType);
    const newCategory = getCategory(newType);
    
    // Must be same category - never allow cross-category switches
    if (!oldCategory || !newCategory || oldCategory !== newCategory) {
      return false;
    }
    
    // Check severity - only allow upgrades (more specific), never downgrades
    const oldSeverity = PROBLEM_TYPE_SEVERITY[oldType] || 0;
    const newSeverity = PROBLEM_TYPE_SEVERITY[newType] || 0;
    
    // New type must be more specific (higher severity)
    return newSeverity > oldSeverity;
