        // Check if it's a positive/neutral message vs actual change request
        // FIX A/B: Also accept time-related responses as implicit confirmations
        // e.g., "morning works", "today if possible", "pretty steady" (frequency answer treated as ok)
        const isPositiveMessage = /\b(?:thanks|thank|great|perfect|good|sounds?\s*good|ok|okay|cool|awesome|hurry|asap|soon|quick)\b/i.test(customerMessage);
        const isTimeResponse = /\b(?:morning|afternoon|evening|today|tomorrow|monday|tuesday|wednesday|thursday|friday|saturday|sunday|next\s+week|this\s+week|anytime|whenever|asap|works?|if\s+possible)\b/i.test(customerMessage) && customerMessage.trim().split(/\s+/).length <= 5;
        const isAffirmativeShort = /^(?:sure|yea|ya|ok|okay|k|kk|yup|yep|mhm|uh\s*huh|works?|fine|good|great|perfect|sounds?\s*good|that'?s?\s*(?:good|fine|great|perfect))$/i.test(customerMessage.trim());
        
        // FIX G: Treat diagnostic-style answers as implicit confirmation during awaiting_confirmation
        // "pretty steady", "constant drip", "slow drip" etc. are answers to diagnostic Qs, not corrections
        const isDiagnosticAnswer = /^(?:pretty\s+steady|constant(?:\s+drip)?|slow(?:\s+drip)?|steady|intermittent|on\s+and\s+off|all\s+the\s+time|only\s+(?:when|after)|once\s+in\s+a\s+while)$/i.test(customerMessage.trim());
        
        // Construction/project echo at confirmation - not a change request
        const isConstructionEcho = /^(?:full\s+remodel|remodel|everything|rough\s*-?in|just\s+fixtures?|fixtures?\s+only|all\s+(?:of\s+)?(?:it|that|the\s+above)|the\s+whole\s+(?:thing|job)|moving\s+fixtures?|adding\s+shower|full\s+(?:gut|bathroom|kitchen|reno))$/i.test(customerMessage.trim());
        
        if (isPositiveMessage || isTimeResponse || isAffirmativeShort || isDiagnosticAnswer || isConstructionEcho) {
          // Treat as confirmation
          const finalBooking = updateBookingData(customerKey, { 
            stage: 'confirmed', 
            awaitingConfirmation: false,
            bookingConfirmed: true
          });
          
          return {
            response: RESPONSE_TEMPLATES.bookingConfirmedFinal(
              finalBooking.name,
              finalBooking.address,
              finalBooking.city,
              finalBooking.timePreference,
              finalBooking.problemType
            ),
            booking: finalBooking,
            debug: { intent: 'implicit_confirmation', stage: 'confirmed' },
            metadata: { confirmed: true }
          };
        }
        
        // Truly unclear - ask what to change (but don't repeat if already asked)
        // CONFIRMATION LOOP FIX: If change prompt was already sent, advance to booking_details
        // and let the user provide the correction directly
        if (currentBooking.changePromptSent) {
          // Already asked what to change - advance stage and wait for their correction
          updateBookingData(customerKey, { awaitingConfirmation: false, stage: 'booking_details' });
          return {
            response: "Just let me know the correct information and I'll update it.",
            booking: getBookingData(customerKey),
            debug: { intent: 'awaiting_correction', stage: 'booking_details' },
            metadata: { awaitingCorrection: true }
          };
        }
        
        updateBookingData(customerKey, { awaitingConfirmation: false, changePromptSent: true });
        return {
          response: RESPONSE_TEMPLATES.bookingChangePrompt(),
          booking: getBookingData(customerKey),
          debug: { intent: 'unclear', stage: 'booking_details' },
          metadata: { changeRequested: true }
        };
      }
      
      // ENTITY EXTRACTION: Run FIRST on raw, untouched customer message
      // NOTE: Installation intent is handled ABOVE as a first-class intent, before this point
      const entities = extractEntities(customerMessage, currentBooking.stage);
      
      // Force standalone names to be treated as booking info during the booking stage
      const isStandaloneName = /^[A-Za-z]{2,}\s[A-Za-z]{2,}$/.test(customerMessage);
      
      let intent;
      
      if (currentBooking.stage === "booking_details" && isStandaloneName) {
        // Override intent to booking_info_providing
        intent = {
          intent: "booking_info_providing",
          confidence: 1.0,
          isMultiIntent: false,
          allIntents: []
        };
        
        // Apply the name immediately if not already set
        // FILTER: Reject common confirmation phrases that match two-word pattern
        const isConfirmationPhraseStandalone = /^(sounds?\s*good|ok(ay)?|sure|yes|yep|yeah|no|nope|that\s*works?|perfect|great|fine|alright|got\s*it|thanks?|thank\s*you|please|hello|hi|hey|pretty\s+steady|constant\s*(?:drip)?|slow\s*(?:drip)?|steady|intermittent|full\s+remodel|remodel|everything|rough\s*-?in|just\s+fixtures?|fixtures?\s+only|moving\s+fixtures?|adding\s+shower|all\s+(?:of\s+)?(?:it|that)|the\s+whole\s+(?:thing|job))$/i.test(customerMessage.trim());
        if (!currentBooking.name && !isConfirmationPhraseStandalone) {
          updates.name = customerMessage
            .trim()
            .split(/\s+/)
            .map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())
            .join(" ");
        }
      } else {
        intent = classifyIntent(customerMessage);
      
      // HYBRID APPROACH: If regex returns "general", try AI fallback
      if (intent.intent === 'general' && intent.confidence <= 0.5) {
        const aiIntent = await classifyIntentWithAI(customerMessage);
        if (aiIntent.usedAI && aiIntent.intent !== 'general') {
          intent = aiIntent;
          console.log('AI fallback used for intent classification');
          }
        }
      }
      
      // FIX A: BOOKING_DETAILS TIME OVERRIDE
      // When in booking_details and customer provides time-like response (asap, morning, etc.),
      // force intent to booking_info_providing to ensure time extraction happens
      if (currentBooking.stage === 'booking_details' && !currentBooking.timePreference) {
        const isTimeResponse = /\b(asap|morning|afternoon|evening|today|tomorrow|now|immediately|right\s*away|anytime|whenever|this\s*week|next\s*week|monday|tuesday|wednesday|thursday|friday|saturday|sunday)\b/i.test(customerMessage);
        if (isTimeResponse && intent.intent !== 'booking_info_providing') {
          intent = { intent: 'booking_info_providing', confidence: 1.0, isMultiIntent: false, allIntents: [], timeOverride: true };
        }
      }
      
      // ================================================================
      // INSTALL INTENT LATCH CHECK
      // If install intent was previously locked, force intent to 'installation'
      // This prevents install flow from being abandoned due to intent reclassification
      // ================================================================
      if (currentBooking.installIntentLocked && 
          currentBooking.installFlow &&
          currentBooking.stage !== 'booking_details' && 
          currentBooking.stage !== 'awaiting_confirmation') {
        // Force intent to installation - do not allow reclassification
        intent = { intent: 'installation', confidence: 1.0, isMultiIntent: false, allIntents: [], latched: true };
      }
      
      // ================================================================
      // REGEX_CONFIDENCE INSTALL OVERRIDE
      // When REGEX_CONFIDENCE detected gas_line_install (or similar), force intent
      // ================================================================
      const confidenceFromEarly = currentBooking.lastConfidenceResult;
      if (confidenceFromEarly && 
          confidenceFromEarly.matchedIntent === 'installation' &&
          confidenceFromEarly.matchedProblemType &&
          confidenceFromEarly.matchedProblemType.includes('_install')) {
        intent = { intent: 'installation', confidence: 1.0, isMultiIntent: false, allIntents: [], fromConfidence: true };
        entities.problemType = confidenceFromEarly.matchedProblemType;
        entities.isInstall = true;
      }
      
      // ================================================================
      // SPECIALIST INSTALL DETECTION & ROUTING (Phase 2)
      // Uses INSTALLATION_UNIVERSE to detect specialist_only installs
      // Routes directly to: acknowledge → location → booking
      // NO diagnostic questions, NO fixture selection downgrade
      // ================================================================
      
      // Location keyword heuristic for confirming location responses
      const LOCATION_KEYWORDS = /\b(?:kitchen|bathroom|basement|garage|laundry|outside|yard|utility|upstairs|downstairs|bedroom|living|dining|attic|crawl\s*space|shed|patio|deck|pool|well\s*house|mechanical|furnace|boiler)\b/i;
      
      // ONGOING SPECIALIST INSTALL FLOW - Handle first to prevent re-detection
      // If specialist flow is already active, skip detection and handle location → booking
      if (currentBooking.installFlow && 
          currentBooking.installFlow.isSpecialist === true &&
          currentBooking.installFlow.itemConfirmed === true &&
          !currentBooking.isEmergency &&
          currentBooking.stage !== 'booking_details' && 
          currentBooking.stage !== 'awaiting_confirmation') {
        
        const install = currentBooking.installFlow;
        const msgLower = customerMessage.toLowerCase();
        
        // Location already asked, check if user is providing a plausible location
        if (install.locationAsked) {
          // Hard location confirmation guard - only advance if message contains location keyword
          if (LOCATION_KEYWORDS.test(msgLower)) {
