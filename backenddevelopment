        bookingData.set(customerKey, currentBooking);
        return {
          response: RESPONSE_TEMPLATES.getSmartBookingRequest(currentBooking, "Perfect - let's get you booked. "),
          booking: currentBooking,
          debug: { intent: 'installation', stage: 'booking_details', item: install.item, location: install.location },
          metadata: { stage: 'booking_details', installFlow: true }
        };
      }
      // ================================================================
      // END ONGOING INSTALL FLOW
      // ================================================================
      
      // Check for booking confirmation response
      if (currentBooking.awaitingConfirmation) {
        // FIRST: Check for explicit confirmation - DO NOT extract entities first!
        // This prevents "YES pls come today" from re-extracting "today" as a new time
        if (UX_BEHAVIORS.isConfirmation(customerMessage)) {
          // Confirm the booking - set bookingConfirmed to prevent re-triggering
          const finalBooking = updateBookingData(customerKey, { 
            stage: 'confirmed', 
            awaitingConfirmation: false,
            bookingConfirmed: true
          });
          
          return {
            response: RESPONSE_TEMPLATES.bookingConfirmedFinal(
              finalBooking.name,
              finalBooking.address,
              finalBooking.city,
              finalBooking.timePreference,
              finalBooking.problemType
