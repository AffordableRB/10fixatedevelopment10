    if (/\bcan'?t\s+(?:find|turn|shut)\s*(?:off)?\s*(?:the\s+)?(?:water|valve|shutoff|shut-?off)\b/i.test(msg) ||
        /\bvalve\s+(?:won'?t|doesn'?t)\s+(?:turn|work|budge)\b/i.test(msg) ||
        /\b(?:where|how)\s+(?:is|do\s+i\s+find)\s+(?:the\s+)?(?:main\s+)?(?:shutoff|shut-?off)\b/i.test(msg)) {
      return 'cant_shutoff';
    }
    
    // active_leak - water from ceiling/wall
    if (/\bwater\s+(?:pouring|dripping|coming)\s+(?:from|through)\s+(?:the\s+)?ceiling\b/i.test(msg) ||
        /\bceiling\s+(?:is\s+)?(?:leaking|dripping)\b/i.test(msg) ||
        /\bwater\s+(?:coming\s+)?(?:through|from)\s+(?:the\s+)?wall\b/i.test(msg)) {
      return 'active_leak';
    }
    
    // flooding - water accumulation
    // Includes floor drain overflow, water backing up/coming up from floor, pooling
    // EXPANDED: Clean water flooding patterns
    if (/\b(?:flood|flooding|flooded)\b/i.test(msg) ||
        /\bwater\s+(?:everywhere|all\s+over|rising)\b/i.test(msg) ||
        /\b(?:ankle|knee|waist|inch)\s*(?:deep|of\s+water)\b/i.test(msg) ||
        /\bstanding\s+water\b/i.test(msg) ||
        /\bbasement.*(?:flood|water|filling)\b/i.test(msg) ||
        /\bwater\s+(?:backing|coming)\s+up\s+(?:on|from|through)\s+(?:the\s+)?floor\b/i.test(msg) ||
        /\bwater\s+(?:pooling|collecting)\s+(?:on|all\s+over)\b/i.test(msg) ||
        /\b(?:floor\s+)?drain\s+(?:is\s+)?(?:overflowing|backing\s+up|flooding)\b/i.test(msg) ||
        /\bwater\s+(?:on|all\s+over)\s+(?:the\s+)?(?:basement\s+)?floor\b/i.test(msg) ||
        // Clean water flooding patterns
        /\b(?:clean|clear)\s+water\s+(?:flooding|everywhere)\b/i.test(msg) ||
        /\bpipe\s+burst\s+(?:clean|clear)\s+water\b/i.test(msg) ||
        /\bwater\s+heater\s+burst\s+flooding\b/i.test(msg) ||
        /\bsupply\s+line\s+(?:broke|burst)\b/i.test(msg)) {
      return 'flooding';
    }
    
    // active_water - water won't stop
    if (/\bwater\s+(?:spraying|gushing|pouring|shooting|won'?t\s+stop)\b/i.test(msg) ||
        /\bcan'?t\s+(?:stop|turn\s+off)\s+(?:the\s+)?water\b/i.test(msg)) {
      return 'active_water';
    }
    
    return 'general_emergency';
  },
  
  // Detect explicit booking request (user wants to skip triage)
  isBookingRequest: function(message) {
    const msg = message.toLowerCase();
    return INTENT_PATTERNS.booking_request.some(p => p.test(msg));
  },
  
  // Get brief safety message for urgent situations during diagnostics
  getUrgentSafetyMessage: function(emergencyType) {
    switch(emergencyType) {
      case 'gas_leak':
        return "Leave the house immediately and call 911 or your gas company.";
      case 'carbon_monoxide':
        return "Leave the house immediately with everyone. Call 911 from outside. CO is deadly.";
      case 'electrical_hazard':
        return "Don't touch anything wet. Stay away from electrical outlets and devices.";
      case 'sewage_emergency':
        return "Stop using all water immediately to prevent further backup.";
      case 'heater_flooding':
        return "Turn off the water supply to the heater. Stay away from electrical outlets.";
      case 'pipe_burst':
        return "Turn off the main water valve immediately if you can do it safely.";
      case 'pump_failure':
        return "Stop using water and drains until we can check the pump.";
      case 'flooding':
        return "Avoid standing water, especially near electrical outlets.";
      case 'cant_shutoff':
        return "Check near the water meter for the main shutoff. Call your water company if you can't find it.";
      case 'active_leak':
        return "If safe, turn off the water supply and put containers under the leak.";
      case 'active_water':
        return "Turn off the main water valve if you can find it safely.";
      case 'heater_critical':
        return "Stay back - hot water or steam can cause severe burns. Don't touch the heater.";
      default:
        return "That sounds urgent. If it's safe, avoid using water and keep away from standing water near electrical outlets.";
    }
  },
  
  // Get full emergency safety protocol message (used for initial emergency response)
  getEmergencySafetyProtocol: function(emergencyType) {
    switch(emergencyType) {
      case 'gas_leak':
        return {
          safety: "!!  GAS SAFETY: Leave the house NOW. Don't touch any light switches or electronics. Call 911 or your gas company from outside.",
          followUp: "Are you outside and safe?",
