    }
    // === CRACKED/BROKEN SEWER LINE ===
    else if (/\b(?:sewer|sewer\s*line).*(?:crack|cracked|broken|collapse|collapsed)\b/i.test(message) ||
             /\b(?:crack|cracked|broken|collapse).*(?:sewer|sewer\s*line)\b/i.test(message)) {
