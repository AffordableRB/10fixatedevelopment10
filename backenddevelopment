          }
        }
        
        // Check if user is providing booking info (name, address, city)
        const hasBookingInfo = emergencyEntities.name || emergencyEntities.address || emergencyEntities.city;
        
        if (hasBookingInfo) {
          // User is providing booking details - transition to booking stage
          const freshEntities = extractEntities(customerMessage, context);
          if (freshEntities.name && !currentBooking.name) currentBooking.name = freshEntities.name;
          if (freshEntities.address && !currentBooking.address) currentBooking.address = freshEntities.address;
          if (freshEntities.city && !currentBooking.city) currentBooking.city = freshEntities.city;
          if (freshEntities.timePreference && !currentBooking.timePreference) currentBooking.timePreference = freshEntities.timePreference;
          currentBooking.stage = 'booking_details';
          bookingData.set(customerKey, currentBooking);
          
          // Check what's still missing
          const missing = [];
          if (!currentBooking.name) missing.push('name');
          if (!currentBooking.address) missing.push('address');
          if (!currentBooking.city) missing.push('city');
          
          if (missing.length === 0) {
            // All info collected - request confirmation
            currentBooking.awaitingConfirmation = true;
            currentBooking.stage = 'awaiting_confirmation';
            bookingData.set(customerKey, currentBooking);
            return {
              response: RESPONSE_TEMPLATES.bookingConfirmation(
                currentBooking.name,
                currentBooking.address,
                currentBooking.city,
                currentBooking.timePreference || 'ASAP',
                currentBooking.problemType,
                currentBooking.phone
              ),
              booking: currentBooking,
              debug: { intent: 'emergency_booking_confirmation', stage: 'awaiting_confirmation' },
              metadata: { emergencyMode: true, awaitingConfirmation: true }
            };
          } else {
            // Still need more info - vary phrasing based on what's missing
            let emergencyMissingResponse;
            if (missing.length === 1 && missing[0] === 'address') {
              emergencyMissingResponse = "Thanks - what's the address?";
            } else if (missing.length === 1 && missing[0] === 'name') {
              emergencyMissingResponse = "Got it. And your name for the technician?";
            } else if (missing.length === 1 && missing[0] === 'city') {
              emergencyMissingResponse = "Thanks - which city is that in?";
            } else {
              const missingStr = missing.length === 1 ? missing[0] : missing.slice(0, -1).join(', ') + ' and ' + missing[missing.length - 1];
              emergencyMissingResponse = `Thanks. I just need your ${missingStr} to dispatch.`;
