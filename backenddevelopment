            if (/\bhot\s+water\s+(?:suddenly\s+)?(?:got|became|turned|is)\s+(?:very\s+)?hot\b/i.test(m)) return 'water_heater_too_hot';
            if (/\b(no\s+hot|not\s+hot|cold|lukewarm|not\s+warm|no\s+hot\s+water)\b/i.test(m)) return 'water_heater_no_hot';
