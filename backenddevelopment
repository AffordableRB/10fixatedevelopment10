    // ================================================================
    // FIXTURE-SPECIFIC DRAIN ISSUES - Before generic drain patterns
    // ================================================================
    
    // === TOILET DRAIN ISSUES ===
    else if (/\b(?:toilet)\s+(?:drain(?:s|ing)?)\s+(?:slow(?:ly)?|very\s+slow)\b/i.test(message) ||
             /\b(?:toilet)\s+(?:is\s+)?(?:slow|sluggish)\b/i.test(message) ||
             /\b(?:toilet)\s+(?:fills?\s+up|water\s+rises?).*(?:then|slowly)\s+drain/i.test(message)) {
      entities.problemType = 'toilet_clogged';
