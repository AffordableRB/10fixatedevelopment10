    const suppressedTypes = diagnosticSlots.suppressedQuestionTypes || [];
    
    // Determine diagnostic path for alignment
    const diagnosticPath = DIAGNOSTIC_PATHS.getPath(booking.problemType);
    const pathName = diagnosticPath ? diagnosticPath.name : 'unknown';
    
    // Build suppression guidance for AI
    let suppressionGuidance = '';
    if (negativeSignals.includes('no_leak')) {
      suppressionGuidance += '\n- Customer said it\'s NOT leaking - do NOT ask about leaks, drips, or where water is coming from';
    }
    if (negativeSignals.includes('no_clog')) {
      suppressionGuidance += '\n- Customer said it\'s NOT clogged - do NOT ask about drain speed or backups';
    }
    if (negativeSignals.includes('single_fixture')) {
      suppressionGuidance += '\n- Customer said it\'s just ONE fixture - do NOT ask about other drains or whole house';
    }
    if (negativeSignals.includes('no_water')) {
      suppressionGuidance += '\n- Customer has NO WATER - do NOT ask about leaks or drips (there\'s no water to leak!)';
    }
    if (negativeSignals.includes('water_heater_non_leak') || diagnosticSlots.isWaterHeaterNonLeakIssue) {
      suppressionGuidance += '\n- This is a NON-LEAK water heater issue - do NOT ask about leaks, drips, puddles, or water location. Focus on the actual issue (pilot, temperature, error codes, etc.)';
    }
    
    // Build path-specific question guidance
    let pathGuidance = '';
    
    // FIX: Running/refilling toilet must NEVER get clog/drain questions
    if (booking.problemType && (booking.problemType.includes('running') || booking.problemType.includes('refilling'))) {
      pathGuidance = 'This is a RUNNING TOILET issue. ONLY ask about: constant vs intermittent, does jiggling handle help, just this toilet or others. NEVER ask about clogs, drains, or blockages - this toilet is RUNNING, not clogged!';
    }
    // FIX: Not-filling toilet must get fill/valve questions, NOT leak questions
    else if (booking.problemType && (booking.problemType.includes('not_filling') || booking.problemType.includes('tank_not'))) {
      pathGuidance = 'This is a TOILET NOT FILLING issue. ONLY ask about: any water going into tank, hissing sounds, water supply valve. NEVER ask about leaks or drips - the problem is NOT ENOUGH water, not too much!';
    }
    else {
      switch (pathName) {
        case 'no_water':
          pathGuidance = 'This is a NO WATER / LOW PRESSURE issue. Only ask about: which fixtures affected, hot vs cold, when it started.';
          break;
        case 'leak':
          pathGuidance = 'This is a LEAK issue. Only ask about: where the leak is, if it\'s active or dripping, how much water.';
          break;
        case 'clog':
          pathGuidance = 'This is a CLOG / DRAIN issue. Only ask about: how blocked it is, if other drains are affected, standing water.';
          break;
        case 'sewer':
          pathGuidance = 'This is a SEWER / MAIN LINE issue. Only ask about: how many fixtures affected, sewage smell, basement involvement.';
          break;
        case 'fixture':
          pathGuidance = 'This is a FIXTURE-SPECIFIC issue. Only ask about: the specific symptom, when it started, if it\'s intermittent.';
          break;
        default:
          pathGuidance = guidance;
      }
    }
    
    const messages = [
      {
        role: "system",
        content: `You are ${plumberName}, a plumber texting a customer about their ${booking.problemType.replace(/_/g, ' ')} problem. You text like a real person, not a robot.

CONVERSATION SO FAR:
${conversationSummary}

CUSTOMER JUST SAID: "${customerMessage}"

INFORMATION ALREADY KNOWN: ${knownInfo}
${booking.isEmergency ? '\n!!  URGENT SITUATION - Keep this brief!' : ''}

CONCEPTS ALREADY ANSWERED (NEVER ASK OR REPHRASE):
${filledConcepts.length > 0 ? filledConcepts.join(', ') : 'None'}

If any of these concepts are already known, do NOT ask about them again and do NOT rephrase them.

YOUR JOB: Decide if you have enough info for dispatch, or ask ONE short follow-up question.

!!  QUESTION ALIGNMENT - CRITICAL:
${pathGuidance}
${suppressionGuidance ? '\nSUPPRESSED TOPICS (customer already clarified these - DO NOT ASK):' + suppressionGuidance : ''}

MISALIGNMENT EXAMPLES TO AVOID:
- If issue is "no water" → NEVER ask about leaks or drips
- If issue is "leak" → NEVER ask about clogs or drain speed
- If issue is "clog" → NEVER ask about leaks or water pressure
- If customer said "just this one" → NEVER ask about other fixtures

COMPLETION DECISION:
${completionGuidance}

RULES:
1. You've asked ${exchangeCount} question(s). ${isClearIssue ? 'This is routine - don\'t over-question.' : isAmbiguousIssue ? 'Need severity OR scope, then done.' : 'Ask only what\'s needed.'}
2. Use NORMAL words customers understand - NO jargon like "fixtures," "scope," or "severity"
3. Keep it SHORT - 1 sentence question max
4. STAY ON PATH: Only ask questions relevant to the ${pathName.toUpperCase()} diagnostic path
5. Don't give advice or explain plumbing - just ask what you need to know
6. Sound like a real plumber texting, not writing a formal email
7. Do NOT say "Got it, let's get you booked" - that will be added separately when ready.
8. NEVER repeat or rephrase a question you already asked. NEVER ask about information the customer already provided.
9. If the customer can't answer a technical question, don't push - you have enough info.
10. If your question would contradict what the customer just said, respond with "Got it." instead.${questionsAlreadyAsked ? `\n\nQUESTIONS ALREADY ASKED (DO NOT REPEAT OR REPHRASE THESE):\n- ${questionsAlreadyAsked}` : ''}

EXAMPLE GOOD QUESTIONS:
- "Is it all the hot water in the house or just certain faucets?" (for no_water path)
- "Is water coming out right now or just when you use it?" (for leak path)
- "Is it completely stopped or just draining slow?" (for clog path)
- "Just that one toilet or are others backing up too?" (for clog path)

EXAMPLE BAD QUESTIONS (DON'T USE THESE):
- "How many fixtures are affected?" (customers don't know what fixtures means!)
- "What is the severity level?" (too formal)
- "Can you describe the scope?" (jargon)
- "Is it dripping?" when customer said there's NO WATER (contradicts their statement!)`
      }
    ];

    try {
      stats.openaiCalls++;
      const response = await callOpenAI(messages, context);
      
      // Check if AI responded with just "Got it" (ready to move to booking)
      // OR if booking gate says we're ready
      const aiSaysComplete = /^got it\.?$/i.test(response.trim());
      const isReadyToBook = aiSaysComplete || bookingReady;
      
      return {
        response: response,
        diagnosticComplete: isReadyToBook,
        isAIPowered: true,
        aiFailed: false
      };
    } catch (error) {
      console.error('Diagnostic AI error:', error);
      
      // Return fallback indicating AI failure (do NOT auto-complete diagnostic)
      return {
        response: null,
        diagnosticComplete: false,
        isAIPowered: false,
        aiFailed: true,
        aiDecidedComplete: false,
        aiFollowupQuestion: null
      };
    }
  }

  // AI FALLBACK INTENT CLASSIFICATION - Only called when regex fails
  async function classifyIntentWithAI(message) {
    const apiKey = CONFIG.OPENAI_API_KEY;
    
    if (!apiKey || !apiKey.startsWith('sk-')) {
      return { intent: 'general', confidence: 0, isMultiIntent: false, allIntents: [], usedAI: false };
    }

    // Retry logic: attempt up to 2 times
    for (let attempt = 0; attempt < 2; attempt++) {
    try {
      const response = await fetch('https://api.openai.com/v1/chat/completions', {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${apiKey}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          model: 'gpt-4o-mini',
          messages: [{
            role: 'system',
            content: `Classify the customer's intent. Return ONLY ONE of these exact labels:
- greeting
- real_plumber_question
- authentication_question
- company_question
- service_area_question
- availability_now_question
- problem_description
- booking_info_providing
- general

Customer message: "${message}"

Return ONLY the label, nothing else.`
          }],
          max_tokens: 20,
          temperature: 0.1
        })
      });

      if (!response.ok) {
        throw new Error(`AI classification failed: ${response.status}`);
      }

      const data = await response.json();
      const intent = data.choices[0].message.content.trim().toLowerCase().replace(/_/g, '_');
      
      // Validate it's a known intent
      const validIntents = ['greeting', 'real_plumber_question', 'authentication_question', 'company_question', 
                           'service_area_question', 'availability_now_question', 'problem_description', 
                           'booking_info_providing', 'general'];
      
      if (validIntents.includes(intent)) {
        return { intent: intent, confidence: 0.7, isMultiIntent: false, allIntents: [{ intent: intent, confidence: 0.7 }], usedAI: true };
      } else {
        return { intent: 'general', confidence: 0.5, isMultiIntent: false, allIntents: [], usedAI: true };
      }
    } catch (error) {
        console.error(`AI intent classification error (attempt ${attempt + 1}):`, error);
        if (attempt === 0) {
          // Wait 150ms before retry
          await new Promise(resolve => setTimeout(resolve, 150));
        }
      }
    }
    // Both attempts failed - return fallback
    return { intent: 'general', confidence: 0, isMultiIntent: false, allIntents: [], usedAI: false };
  }

  function classifyIntent(message) {
    const msg = message.toLowerCase().trim();
    const intents = [];
    
    // Helper to check if any pattern in array matches
    const matchesAny = (patterns, text) => patterns.some(p => p.test(text));
    
    // Greetings
    if (matchesAny(INTENT_PATTERNS.greeting, msg)) {
      intents.push({ intent: 'greeting', confidence: 0.9 });
    }
    
    // Real plumber question
    if (matchesAny(INTENT_PATTERNS.real_plumber_question, msg)) {
      intents.push({ intent: 'real_plumber_question', confidence: 0.9 });
    }
    
    // Authentication question
    if (matchesAny(INTENT_PATTERNS.authentication_question, msg)) {
      intents.push({ intent: 'authentication_question', confidence: 0.8 });
    }
    
    // Company question
    if (matchesAny(INTENT_PATTERNS.company_question, msg)) {
      intents.push({ intent: 'company_question', confidence: 0.8 });
    }
    
    // Service area question
    // If message ALSO contains a plumbing problem (toilet, sink, etc.), lower confidence
    // so the problem takes priority and service area is answered secondarily
    const hasPlumbingProblemInMsg = /\b(?:toilet|tolet|toylet|toiley|tilet|toiet|toliet|commode|sink|faucet|drain|shower|tub|pipe|leak|clog|blocked|running|broken|handle|flush|drip|puddle|wobbly|gurgl)\b/i.test(msg);
    
    if (matchesAny(INTENT_PATTERNS.service_area_question, msg)) {
      // Lower confidence if there's also a plumbing problem mentioned
      const serviceAreaConfidence = hasPlumbingProblemInMsg ? 0.4 : 0.9;
      intents.push({ intent: 'service_area_question', confidence: serviceAreaConfidence });
    }
    
    // Service area with city (special case - check for "are you in" but not "available")
    if (matchesAny(INTENT_PATTERNS.service_area_with_city, msg) && !/\b(?:available|avilable|avalable)\b/i.test(msg)) {
      if (!intents.some(i => i.intent === 'service_area_question')) {
        const serviceAreaConfidence = hasPlumbingProblemInMsg ? 0.4 : 0.9;
        intents.push({ intent: 'service_area_question', confidence: serviceAreaConfidence });
      }
    }
    
    // Availability question
    if (matchesAny(INTENT_PATTERNS.availability_now_question, msg)) {
      intents.push({ intent: 'availability_now_question', confidence: 0.8 });
    }
    
    // Price question
    if (matchesAny(INTENT_PATTERNS.price_question, msg)) {
      // Don't match "how much water" - that's a diagnostic question
      if (!/\bhow\s+much\s+water\b/i.test(msg)) {
        intents.push({ intent: 'price_question', confidence: 0.85 });
      }
    }
    
    // ================================================================
    // INSTALLATION INTENT (must be checked BEFORE problem_description)
    // ================================================================
    const INSTALL_VERBS = /\b(?:install(?:ed|ing|ation)?|instalation|instll|instal|replace(?:d|ing|ment)?|put\s*in|hook\s*up|swap\s*out|get\s*a\s*new|add(?:ing)?|mount(?:ing)?|set\s*up|plumb(?:ed)?\s*in)\b/i;
    const REQUEST_SIGNALS = /\b(?:need|want|looking\s+(?:to|for)|hoping\s+to|like\s+to|can\s+(?:you|i|we)|could\s+(?:you|i|we)|do\s+you|are\s+you\s+able|please|would\s+like|i'?d\s+like|we'?d\s+like|i\s+need\s+to)\b/i;
    const STARTS_WITH_INSTALL = /^(?:install|instalation|instll|instal|replace|put\s+in|hook\s+up|add|need\s+to\s+add|need\s+a\s+new)\b/i;
    // Installation noun pattern: "toilet installation", "need installation", "looking for installation"
    const INSTALL_NOUN = /\b(?:toilet|sink|faucet|shower|tub|bathtub|water\s*heater|dishwasher|washer|washing\s*machine|fridge|refrigerator|garbage\s*disposal|disposal)\s+(?:installation|instalation|instll|instal)\b/i;
    const GENERIC_INSTALL_NOUN = /\b(?:need|want|looking\s+for|schedule|book)\s+(?:an?\s+)?installation\b/i;
    // Install-intent questions: "do you install", "can I install", "are you able to install", "do you do installations"
    const INSTALL_QUESTION = /\b(?:do\s+you|can\s+(?:you|i|we)|could\s+(?:you|i|we)|are\s+you\s+able\s+to)\s+(?:install|do\s+install)/i;
    const INSTALL_SERVICE_QUESTION = /\b(?:do\s+you\s+(?:guys?\s+)?(?:do|offer|provide)|do\s+u\s+(?:guys?\s+)?(?:do|offer))\s+(?:installation|installs?)\b/i;
    const HISTORICAL_BLOCKERS = [
      /\b(?:installed|replaced|put\s*in|hooked\s*up|swapped\s*out)\s+(?:it\s+)?(?:\d+|a\s+few|several|last|recently|ago|before|previously|already)\b/i,
      /\b(?:\d+|a\s+few|several|last)\s+(?:months?|years?|weeks?|days?)\s+ago\b/i,
      /\bafter\s+(?:installing|replacing|putting\s*in)\b/i,
      /\b(?:was|were|had\s+been)\s+(?:installed|replaced)\b/i,
      /\b(?:previous|former|old)\s+(?:owner|tenant|plumber)\s+(?:installed|replaced)\b/i,
      /\bwhen\s+(?:it\s+was|they|we|i)\s+(?:installed|replaced)\b/i,
      /\b(?:since|ever\s+since)\s+(?:installing|replacing|the\s+install)\b/i
    ];
    
    const HAS_FIXTURE = /\b(?:toilet|sink|faucet|shower|tub|bathtub|water\s*heater|dishwasher|washer|washing\s*machine|fridge|refrigerator|garbage\s*disposal|disposal)\b/i;
    
    const hasInstallVerb = INSTALL_VERBS.test(message);
    const hasRequestSignal = REQUEST_SIGNALS.test(message) || STARTS_WITH_INSTALL.test(message);
    const hasInstallNoun = INSTALL_NOUN.test(message);  // "toilet installation" - already has fixture
    const hasGenericInstallNoun = GENERIC_INSTALL_NOUN.test(message) && HAS_FIXTURE.test(message);  // "need installation" + fixture
    const hasInstallQuestion = INSTALL_QUESTION.test(message);
    const isHistorical =
      HISTORICAL_BLOCKERS.some(p => p.test(message)) &&
      !REQUEST_SIGNALS.test(message);
    
    // WASHING MACHINE INSTALL FORCE: If message has washer/washing machine + install verb, force installation intent
    // This prevents washer installs from entering repair triage
    const WASHER_INSTALL_FORCE = /\b(?:washing\s*machine|washer)\b/i.test(message) && 
                                  /\b(?:install|installing|hook\s*up|set\s*up|new)\b/i.test(message);
    
    // GARBAGE DISPOSAL INSTALL FORCE: If message has garbage disposal/disposal + install verb, force installation intent
    // This prevents disposal installs from being misclassified as sink installs
    const DISPOSAL_INSTALL_FORCE = /\b(?:garbage\s*disposal|disposal)\b/i.test(message) && 
                                    /\b(?:install|installing|hook\s*up|set\s*up|new)\b/i.test(message);
    
    // VALVE INSTALL FORCE: If message has valve + install verb, force installation intent
    // This catches: "flood stop valve install", "install a valve on my water heater", "preventative shutoff valve"
    // Full install verb list: install, replace, put in, hook up, swap out, change out, set up, add, mount
    const VALVE_INSTALL_FORCE =
      /\b(?:valve|shutoff|shut-off|shut\s+off|flood\s*stop|preventa?tive)\b/i.test(message) &&
      /\b(?:install|installing|replace|replacing|put\s*in|hook\s*up|set\s*up|swap\s*(?:out)?|change\s*(?:out)?|add|mount)\b/i.test(message);
    
    // GENERIC INSTALL FORCE: If message starts with "install" + any object, force installation intent
    // This catches: "install something on my main line", "put in a new...", "hook up my..."
    const GENERIC_INSTALL_FORCE = /^(?:install|need\s+to\s+install|want\s+to\s+install|put\s*in|hook\s*up|swap\s*out|change\s*out)\b/i.test(message);
    
    // Check for install service question pattern
    const hasInstallServiceQuestion = INSTALL_SERVICE_QUESTION.test(message);
    
    // Installation triggers if: (verb + request) OR (install noun) OR (generic + fixture) OR (install question) OR (washer force) OR (disposal force) OR (valve force) OR (generic force) OR (install service question) - and NOT historical
    if (!isHistorical && (
        (hasInstallVerb && hasRequestSignal) ||
        hasInstallNoun ||
        hasGenericInstallNoun ||
        hasInstallQuestion ||
        hasInstallServiceQuestion ||
        WASHER_INSTALL_FORCE ||
        DISPOSAL_INSTALL_FORCE ||
        VALVE_INSTALL_FORCE ||
        GENERIC_INSTALL_FORCE
    )) {
      intents.push({ intent: 'installation', confidence: 0.95 });
    }
    // ================================================================
    
    // Problem description (only if NOT installation)
    if (matchesAny(INTENT_PATTERNS.problem_description, msg) && !intents.some(i => i.intent === 'installation')) {
      intents.push({ intent: 'problem_description', confidence: 0.8 });
    }
    
    // Booking info - check original message for capitalized names
    const bookingPatterns = INTENT_PATTERNS.booking_info_providing;
    if (bookingPatterns[0].test(message) || // Capitalized name pattern uses original message
        bookingPatterns[1].test(message) || // Address pattern
        SERVICE_AREAS.cities.some(city => msg.includes(city)) || // Dynamic city check
        bookingPatterns[2].test(msg)) { // Time pattern
      intents.push({ intent: 'booking_info_providing', confidence: 0.7 });
    }
    
    if (intents.length === 0) {
      return { intent: 'general', confidence: 0.5, isMultiIntent: false, allIntents: [] };
    } else if (intents.length === 1) {
      return { ...intents[0], isMultiIntent: false, allIntents: intents };
    } else {
      // Multi-intent detected: prioritize questions over greetings
      // Installation has HIGHER priority than problem_description
      const intentPriority = {
        'real_plumber_question': 10,
        'authentication_question': 9,
        'company_question': 8,
        'service_area_question': 7,
        'price_question': 7,  // Same level as service_area
        'availability_now_question': 6,
        'installation': 6,  // Same level as availability, HIGHER than problem_description
        'problem_description': 5,
        'booking_info_providing': 4,
        'greeting': 3,
        'general': 1
      };
      
      // Sort by confidence first, then by priority if confidence is equal
      const sorted = intents.sort((a, b) => {
        if (b.confidence !== a.confidence) {
          return b.confidence - a.confidence;
        }
        return (intentPriority[b.intent] || 0) - (intentPriority[a.intent] || 0);
      });
      
      return { 
        intent: sorted[0].intent, 
        confidence: sorted[0].confidence, 
        isMultiIntent: true, 
        allIntents: intents 
      };
    }
  }

  // ================================================================
  // FIXTURE AND PROBLEM EXTRACTION - Extract all context upfront
  // This prevents asking redundant clarifying questions
  // ================================================================
  function extractFixtureAndProblem(message) {
    const result = {
      fixture: null,
      location: null,
      problemType: null,
      severity: null,
      hasRichContext: false
    };
    
    const msg = message.toLowerCase();
    
    // FIXTURE detection (order matters - more specific first)
    if (/water\s*heater|hot\s*water\s*tank/i.test(msg)) result.fixture = 'water_heater';
    else if (/garbage\s*disposal|disposal/i.test(msg)) result.fixture = 'garbage_disposal';
    else if (/dish\s*washer/i.test(msg)) result.fixture = 'dishwasher';
    else if (/wash(?:ing)?\s*machine|washer(?!\s*dryer)/i.test(msg)) result.fixture = 'washing_machine';
    else if (/water\s*softener|softener/i.test(msg)) result.fixture = 'water_softener';
    else if (/sump\s*pump/i.test(msg)) result.fixture = 'sump_pump';
    else if (/ejector|sewage\s*pump|grinder\s*pump/i.test(msg)) result.fixture = 'ejector_pump';
    else if (/toilet/i.test(msg)) result.fixture = 'toilet';
    else if (/bidet/i.test(msg)) result.fixture = 'bidet';
    else if (/urinal/i.test(msg)) result.fixture = 'urinal';
    else if (/shower/i.test(msg)) result.fixture = 'shower';
    else if (/(?:bath)?tub|jacuzzi|jetted|whirlpool/i.test(msg)) result.fixture = 'tub';
    else if (/faucet|tap(?!\s*water)/i.test(msg)) result.fixture = 'faucet';
    else if (/kitchen\s*sink/i.test(msg)) result.fixture = 'kitchen_sink';
    else if (/bathroom\s*sink/i.test(msg)) result.fixture = 'bathroom_sink';
    else if (/sink/i.test(msg)) result.fixture = 'sink';
    else if (/hose\s*bib|spigot|outdoor\s*faucet/i.test(msg)) result.fixture = 'hose_bib';
    else if (/main\s*(?:water\s*)?line|main\s*shutoff/i.test(msg)) result.fixture = 'main_line';
    else if (/pipe/i.test(msg)) result.fixture = 'pipe';
    else if (/drain/i.test(msg)) result.fixture = 'drain';
    else if (/backflow/i.test(msg)) result.fixture = 'backflow';
    else if (/septic/i.test(msg)) result.fixture = 'septic';
    
    // LOCATION detection
    if (/under\s*(?:the\s*)?sink/i.test(msg)) result.location = 'under_sink';
    else if (/ceiling/i.test(msg)) result.location = 'ceiling';
    else if (/wall|drywall/i.test(msg)) result.location = 'wall';
    else if (/basement/i.test(msg)) result.location = 'basement';
    else if (/kitchen/i.test(msg)) result.location = 'kitchen';
    else if (/bathroom|bath\s*room/i.test(msg)) result.location = 'bathroom';
    else if (/laundry/i.test(msg)) result.location = 'laundry';
    else if (/garage/i.test(msg)) result.location = 'garage';
    else if (/outside|outdoor|yard|exterior/i.test(msg)) result.location = 'outdoor';
    else if (/attic/i.test(msg)) result.location = 'attic';
    else if (/crawl\s*space/i.test(msg)) result.location = 'crawl_space';
    else if (/upstairs|second\s*floor|2nd\s*floor/i.test(msg)) result.location = 'upstairs';
    else if (/downstairs|first\s*floor|1st\s*floor|main\s*floor/i.test(msg)) result.location = 'downstairs';
    
    // PROBLEM TYPE detection (order matters - more specific first)
    // Toilet clog patterns - check BEFORE generic clog
    if (/\b(?:clog|clogged)\s+(?:the\s+)?(?:toilet|tolet|toylet|toiley|tilet|toiet|toliet|commode)\b/i.test(msg) ||
        /\b(?:toilet|tolet|toylet|toiley|tilet|toiet|toliet|commode)\s+(?:is\s+)?(?:clog|clogged)\b/i.test(msg) ||
        /\b(?:clogged)\s+(?:toilet|tolet|toylet|toiley|tilet|toiet|toliet|commode)\b/i.test(msg) ||
        /\b(?:toilet|tolet|toylet|toiley|tilet|toiet|toliet|commode).*(?:clog|clogged|blocked|backed\s*up|won'?t\s*drain)\b/i.test(msg) ||
        /\b(?:clog|clogged|blocked|backed\s*up).*(?:toilet|tolet|toylet|toiley|tilet|toiet|toliet|commode)\b/i.test(msg)) {
      result.problemType = 'toilet_clogged';
    }
    // Sink clog patterns - check BEFORE generic clog
    else if (/\b(?:clog|clogged)\s+(?:the\s+)?(?:sink)\b/i.test(msg) ||
             /\b(?:sink)\s+(?:is\s+)?(?:clog|clogged)\b/i.test(msg) ||
             /\b(?:sink).*(?:clog|clogged|blocked|backed\s*up|won'?t\s*drain)\b/i.test(msg) ||
             /\b(?:clog|clogged|blocked|backed\s*up).*(?:sink)\b/i.test(msg)) {
      result.problemType = 'sink_clogged';
    }
    // Shower/drain clog patterns - check BEFORE generic clog
    else if (/\b(?:shower|tub|bathtub).*(?:clog|clogged|blocked|backed\s*up|won'?t\s*drain)\b/i.test(msg) ||
             /\b(?:clog|clogged|blocked|backed\s*up).*(?:shower|tub|bathtub)\b/i.test(msg)) {
      result.problemType = 'shower_drain_clogged';
    }
    // Generic clog (fallback)
    else if (/clog|block|backed?\s*up|won'?t\s*drain|slow\s*drain|drain.*slow/i.test(msg)) result.problemType = 'clog';
    else if (/leak|drip|water\s*coming|dripping/i.test(msg)) result.problemType = 'leak';
    else if (/not\s*work|broken|dead|won'?t\s*turn|stopped|doesn'?t\s*work/i.test(msg)) result.problemType = 'not_working';
    else if (/running|won'?t\s*stop|keeps\s*running|constantly/i.test(msg)) result.problemType = 'running';
    else if (/noise|loud|grinding|humming|whistling|banging/i.test(msg)) result.problemType = 'noise';
    else if (/smell|odor|stink/i.test(msg)) result.problemType = 'smell';
    else if (/no\s*(?:hot\s*)?water|not\s*getting\s*(?:hot\s*)?water/i.test(msg)) result.problemType = 'no_water';
    else if (/low\s*pressure|weak\s*pressure|no\s*pressure/i.test(msg)) result.problemType = 'low_pressure';
    else if (/install|replace|new/i.test(msg)) result.problemType = 'installation';
    else if (/overflow|overflowing/i.test(msg)) result.problemType = 'overflow';
    else if (/won'?t\s*flush|flush.*not|not.*flush/i.test(msg)) result.problemType = 'wont_flush';
    else if (/won'?t\s*spray|not\s*spray/i.test(msg)) result.problemType = 'not_spraying';
    
    // CREATE COMPOUND PROBLEM TYPES - combine fixture + problem into specific type
    // This must happen AFTER individual fixture and problemType detection
    // Acts as a safety net for cases where specific patterns above didn't match
    if (result.fixture === 'toilet' && result.problemType === 'clog') {
      result.problemType = 'toilet_clogged';
    } else if (result.fixture === 'toilet' && result.problemType === 'leak') {
      result.problemType = 'toilet_leaking';
    } else if (result.fixture === 'toilet' && result.problemType === 'running') {
      result.problemType = 'toilet_running';
    } else if (result.fixture === 'toilet' && result.problemType === 'overflow') {
      result.problemType = 'toilet_overflowing';
    } else if (result.fixture === 'toilet' && result.problemType === 'wont_flush') {
      result.problemType = 'toilet_not_flushing';
    } else if (result.fixture === 'sink' && result.problemType === 'clog') {
      result.problemType = 'sink_clogged';
    } else if (result.fixture === 'sink' && result.problemType === 'leak') {
      result.problemType = 'sink_leaking';
    } else if (result.fixture === 'shower' && result.problemType === 'clog') {
      result.problemType = 'shower_drain_clogged';
    } else if (result.fixture === 'shower' && result.problemType === 'leak') {
      result.problemType = 'shower_leaking';
    }
    
    // SEVERITY detection
    if (/flood|everywhere|gush|burst|emergency|urgent|asap|help|shooting|spraying/i.test(msg)) result.severity = 'emergency';
    else if (/drip|small|minor|little|slow/i.test(msg)) result.severity = 'minor';
    else result.severity = 'normal';
    
    // Determine if message has rich context (fixture + problem at minimum)
    const wordCount = msg.split(/\s+/).length;
    let signals = 0;
    if (result.fixture) signals++;
    if (result.problemType) signals++;
    if (result.location) signals++;
    
    result.hasRichContext = (signals >= 2) || (result.fixture && result.problemType);
    
    // Add source hint based on detection specificity
    if (result.problemType) {
      if (result.fixture && result.problemType.includes(result.fixture)) {
        result.problemTypeSourceHint = 'specific_compound';
      } else if (result.fixture) {
        result.problemTypeSourceHint = 'generic_compound';
      } else {
        result.problemTypeSourceHint = 'generic_pattern';
      }
    }
    
    return result;
  }
  
  // Helper to create compound problem type from fixture + problem
