    // === FAUCET TYPOS ===
    else if (/\b(?:faucit|faucett|foucat|fawcett)\s+(?:is\s+)?(?:drip|dripping|leak|leaking)\b/i.test(message)) {
      entities.problemType = 'faucet_dripping';
