              metadata: {
                stage: 'booking_details',
                shortCircuit: 'garbage_disposal'
              }
            };
          }
          
          // =================================================================
          // URGENCY FAST-TRACK: Skip diagnostics when customer needs service today/ASAP
          // =================================================================
          const hasUrgencySignal = /\b(?:today|asap|right\s*now|immediately|urgent|emergency|need\s*(?:someone|help)\s*(?:today|now|asap)|help|sos|please\s+hurry|can'?t\s+wait)\b/i.test(customerMessage);
          const hasSpecificProblem = updatedBooking.problemType && 
            !['sink', 'faucet', 'drain', 'leak', 'pipe'].includes(updatedBooking.problemType);
          
          if (hasUrgencySignal && hasSpecificProblem) {
            updatedBooking.stage = 'booking_details';
            bookingData.set(customerKey, updatedBooking);
            
            // Use emergency safety preamble for real emergencies
            const isRealEmergency = updatedBooking.isEmergency || PROBLEM_TYPE_DATA.isEmergency(updatedBooking.problemType);
            let responsePrefix;
            if (isRealEmergency) {
              responsePrefix = EMERGENCY_SAFETY_PREAMBLE + "\n\nI'm treating this as urgent. ";
              updatedBooking.isEmergency = true;
            } else {
              responsePrefix = "Got it - we'll try to get someone out today. ";
            }
            
            return {
              response: responsePrefix + RESPONSE_TEMPLATES.getSmartBookingRequest(updatedBooking, ""),
              booking: updatedBooking,
              debug: {
                intent: 'urgency_fast_track',
                stage: 'booking_details',
                problemType: updatedBooking.problemType,
                urgencySignal: true,
                isRealEmergency: isRealEmergency
              },
              metadata: {
                stage: 'booking_details',
                shortCircuit: 'urgency_fast_track',
                emergency: isRealEmergency
              }
            };
          }
          
          // OLD EMERGENCY INTERRUPT REMOVED - Now handled by triageEmergencyWithAI()
          
          // =================================================================
          // EXPLICIT SEVERITY FAST-TRACK: Skip diagnostics when customer is crystal clear
          // "completely clogged", "totally blocked", "won't drain at all" = no need to ask severity
          // =================================================================
          const hasExplicitSeverityInMsg = /\b(?:completely|totally|fully|100%|absolutely)\s+(?:clogged|blocked|stopped|backed)/i.test(customerMessage) ||
                                           /\b(?:won'?t|wont|doesn'?t|doesnt)\s+(?:drain|flush|work)\s+(?:at\s+all)/i.test(customerMessage) ||
                                           /\bno\s+(?:water|drainage|flow)\s+(?:at\s+all)/i.test(customerMessage);
          
          if (hasExplicitSeverityInMsg && updatedBooking.problemType) {
            updatedBooking.stage = 'booking_details';
            bookingData.set(customerKey, updatedBooking);
            
            // Get safety guidance if applicable
            let safetyTip = '';
            if (!updatedBooking.safetyGuidanceGiven && !updatedBooking.isEmergency) {
              const guidance = getSafetyGuidanceIfNeeded(updatedBooking.problemType, updatedBooking);
              if (guidance) {
                safetyTip = guidance + ' ';
                updatedBooking.safetyGuidanceGiven = true;
              }
            }
            
            return {
              response: safetyTip + "Got it - I'll get a plumber scheduled for you. " + RESPONSE_TEMPLATES.getSmartBookingRequest(updatedBooking, ""),
              booking: updatedBooking,
              debug: {
                intent: 'explicit_severity_fast_track',
                stage: 'booking_details',
                problemType: updatedBooking.problemType
              },
              metadata: {
                stage: 'booking_details',
                shortCircuit: 'explicit_severity'
              }
            };
          }
          
          // Get the first fixed diagnostic question from the comprehensive system
