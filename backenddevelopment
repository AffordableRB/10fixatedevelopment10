        if (classification.classification === 'UNCLEAR') {
          currentBooking.installClassificationDone = true; // Don't ask again
          return {
            response: classification.clarifyingQuestion || "Just to clarify - are you looking to install something new, or is there an issue with something you already have?",
            booking: currentBooking,
            debug: { intent: 'install_clarification_needed', classification },
            metadata: { installClarification: true }
          };
        }
      }
      
      // ================================================================
      // HANDLE RESPONSE TO INSTALL VS REPAIR CLARIFICATION
      // When customer answers after we asked "install or issue?"
      // ================================================================
      if (currentBooking.installVsRepairAsked && currentBooking.pendingFixture) {
        const fixture = currentBooking.pendingFixture;
        
        // Check their response
        const indicatesInstall = /\b(?:install|installed|new|hook\s*up|put\s*in|yes.*install|need.*installed|set\s*up|add)\b/i.test(normalizedMessage);
        const indicatesRepair = /\b(?:issue|problem|broken|leak|leaking|clog|clogged|not\s*working|fix|repair|current|broke|drip|stuck|noise|smell|won'?t|doesn'?t)\b/i.test(normalizedMessage);
        
        if (indicatesInstall && !indicatesRepair) {
          // Go to install booking
          currentBooking.installIntentLocked = true;
          setProblemTypeIfAllowed(currentBooking, fixture + '_install', 'specific_compound');
          currentBooking.stage = 'booking_details';
          currentBooking.pendingFixture = null;
          bookingData.set(customerKey, currentBooking);
          
          const fixtureName = fixture.replace(/_/g, ' ');
          return {
            response: `Got it - ${fixtureName} installation. I'll get a plumber scheduled for you.`,
            booking: currentBooking,
            debug: { intent: 'install_from_clarification', fixture },
            metadata: { installFromClarification: true }
          };
        }
        
        if (indicatesRepair && !indicatesInstall) {
          // Set problem type and clear pending fixture
          setProblemTypeIfAllowed(currentBooking, fixture, 'specific_compound');
          currentBooking.pendingFixture = null;
          bookingData.set(customerKey, currentBooking);
          // Fall through to diagnostic flow - don't return
        }
        
        // If both or neither, clear pending and let AI handle
        if (!indicatesInstall && !indicatesRepair) {
          currentBooking.pendingFixture = null;
          bookingData.set(customerKey, currentBooking);
          // Fall through to normal processing
        }
      }
      
      // ================================================================
      // BARE FIXTURE MENTION - Ask install vs repair
      // When customer just says "Dishwasher" or "Toilet" with no context
      // ================================================================
      if (earlyConfidenceResult.reason === 'generic_fixture_only' &&
          currentBooking.stage === 'initial' &&
          !currentBooking.installVsRepairAsked) {
        
        const fixture = earlyConfidenceResult.matchedProblemType;
        const fixtureDisplayName = fixture?.replace(/_/g, ' ') || 'that';
        
        // Check if message has ANY install or problem signals
        const hasInstallSignal = /\b(?:install|installed|installing|installation|instalation|instll|instal|new|bought|replace|replaced|upgrade|upgrading|hook\s*up|put\s*in|set\s*up|add|mount|quote|first\s*time|convert|converting|conversion)\b/i.test(normalizedMessage);
        const hasProblemSignal = /\b(?:leaks?|leaking|clogs?|clogged|clogging|broke|broken|not\s*working|won'?t|can'?t|doesn'?t|isn'?t|drips?|dripping|floods?|flooding|backup|backing\s*up|backed\s*up|stuck|noise|noisy|smell|smells|smelly|running|overflow|overflowing|burst|bursting|crack|cracked|issue|problem|damage|damaged|rebuilt|replaced|replacing|rebuild|needs?\s+(?:to\s+be\s+)?(?:fixed|repaired|replaced|rebuilt)|used\s+to\s+be|le+k(?:ing|s)?|low\s*(?:water\s+)?pressure|no\s*(?:water\s+)?pressure|weak\s*(?:pressure|flow|water)|no\s*hot\s*water|cold\s*water|hot\s*water|temperature|scalding|freezing|lukewarm|puddle|rumbling|rumble|banging|bang|popping|pop|hissing|hiss|sediment|pilot\s*(?:light)?|burner|not\s*hot|not\s*(?:getting\s*)?warm|rusty|rust|rotten\s*egg|sulfur|went\s*out|stopped\s*working|quit|dead|kaput|gave\s*up|out\s*of\s*hot|no\s*warm|acting\s*up|making\s*noise|sounds?\s*like|error\s*(?:code|message)?|fault\s*(?:code)?|flashing|blinking|beeping|shutting\s*(?:off|down)|fell\s*off|falls?\s*off|came\s*off|loose|stripped|spins|spinning|wobbl|rises|rising|partial|partially|keeps\s*going|won'?t\s*stop|whistl|squeal|screech|flapper|fill\s*valve|float|element|coming\s*out|keeps\s*running|runing|rnning|runnig|reduced|sprays|spraying|sideways|irregular|squeaks|squeaking|squeak|overflows|fills\s*(?:very\s+)?slow|slowly|water\s*on\s*(?:the\s*)?floor|on\s*the\s*floor|not\s*heating|hybrid|indirect|needs\s*replacing|need\s*(?:a\s*)?new)\b/i.test(normalizedMessage);
        
        // If truly bare fixture with no signals, ask clarifying question
        if (!hasInstallSignal && !hasProblemSignal) {
          currentBooking.installVsRepairAsked = true;
          currentBooking.pendingFixture = fixture;
          bookingData.set(customerKey, currentBooking);
          
          // Fixture-specific questions
          const clarifyingQuestions = {
            'dishwasher': "Do you need a dishwasher installed or is there an issue with your current one?",
            'garbage_disposal': "Do you need a disposal installed or is there a problem with your current one?",
            'toilet': "Do you need a toilet installed or is there an issue with your current one?",
            'sink': "Do you need a sink installed or is there an issue with your current one?",
            'faucet': "Do you need a faucet installed or is there an issue with your current one?",
            'water_heater': "Do you need a water heater installed or is there an issue with your current one?",
            'shower': "Is this about installing something or is there an issue with your shower?",
            'bathtub': "Is this about installing something or is there an issue with your tub?",
            'washing_machine': "Do you need a washer hooked up or is there a plumbing issue with it?",
            'bidet': "Do you need a bidet installed or is there an issue with your current one?",
            'drain': "Is there a clog or other issue with the drain?",
            'pipe': "Is there a leak or other issue with the pipe?"
          };
          
          const question = clarifyingQuestions[fixture] || 
            `Got it - ${fixtureDisplayName}. Do you need one installed or is there an issue with your current one?`;
          
          return {
            response: question,
            booking: currentBooking,
            debug: { intent: 'bare_fixture_clarification', fixture },
            metadata: { bareFixtureClarification: true }
          };
        }
      }
      
      // ================================================================
      // BUG A FIX: EMERGENCY MODE ACTIVE → GO TO BOOKING (more robust)
      // If emergency safety delivered OR emergency mode active, go straight to booking
      // ================================================================
      if ((currentBooking.emergencySafetyDelivered || currentBooking.emergencyModeActive) && 
          !currentBooking.emergencyBookingStarted &&
          currentBooking.stage !== 'booking_details' &&
          currentBooking.stage !== 'awaiting_confirmation') {
        
        // Customer has responded after emergency - go straight to booking
        currentBooking.emergencyBookingStarted = true;
        currentBooking.stage = 'booking_details';
        bookingData.set(customerKey, currentBooking);
        
        return {
          response: "Got it. I'll get a plumber out ASAP.",
          booking: currentBooking,
          debug: { intent: 'emergency_to_booking', stage: 'booking_details' },
          metadata: { emergencyBooking: true }
        };
      }
      
      // ================================================================
      // BUG 2 FIX: RESOLVED SITUATION DETECTION (expanded)
      // Catch "was spraying but stopped", "got it stopped", etc.
      // ================================================================
      const hasResolvedLanguage = 
        /\b(?:got\s+it\s+(?:stopped|fixed|shut)|stopped\s+it|shut\s+it\s+off|turned\s+it\s+off|fixed\s+it|it\s+stopped)\b/i.test(normalizedMessage) ||
        /\b(?:was\s+(?:spraying|leaking|flooding|running)\s+but\s+(?:i\s+)?(?:got|stopped|shut|turned))\b/i.test(normalizedMessage) ||
        /\b(?:i\s+)?(?:managed|able)\s+to\s+(?:stop|shut|turn\s+off|fix)\b/i.test(normalizedMessage) ||
        /\b(?:but\s+(?:it\s+)?stopped|but\s+(?:it'?s\s+)?stopped\s+now|stopped\s+now|it\s+stopped)\b/i.test(normalizedMessage) ||
        /\b(?:was|were)\s+\w+ing\s+but\s+(?:stopped|not\s+anymore|done|finished)\b/i.test(normalizedMessage);
      
      if (hasResolvedLanguage && !currentBooking.emergencyModeActive) {
        currentBooking.problemType = currentBooking.problemType || 'resolved_leak';
        currentBooking.stage = 'booking_details';
        bookingData.set(customerKey, currentBooking);
        
        return {
          response: "Good that you got it stopped. I'll get a plumber out to check it and make sure there's no damage.",
          booking: currentBooking,
          debug: { intent: 'resolved_situation_booking', problemType: currentBooking.problemType },
          metadata: { resolvedSituation: true }
        };
      }
      
      // ================================================================
      // BUG G FIX: DIRECT BOOKING REQUEST
      // "just send a plumber already" → book immediately
      // ================================================================
      const isDirectBookingRequest = 
        /\b(?:just\s+)?(?:send|need|want|get)\s+(?:me\s+)?(?:a\s+)?(?:plumber|someone)\s*(?:already|now|asap|please|pls)?\b/i.test(normalizedMessage) ||
        /\b(?:book|schedule)\s+(?:me\s+)?(?:a\s+)?(?:plumber|appointment|someone)\b/i.test(normalizedMessage) ||
        /\bjust\s+(?:book|schedule)\s+(?:it|me|something)\b/i.test(normalizedMessage);
      
      // Check if message has install intent - don't ask "What's the issue?" for installations
      // Full install verb list: install, replace, put in, hook up, swap out, change out, set up, add, mount, new
      const directBookingHasInstall = /\b(?:install|installing|installation|replace|replacing|put\s*in|hook\s*up|hookup|set\s*up|swap\s*(?:out)?|change\s*(?:out)?|add(?:ing)?|mount(?:ing)?|new)\b/i.test(normalizedMessage);
      
      // Guard: Don't bypass fixture detection if message mentions a specific fixture
      const isShortMessage = normalizedMessage.split(/\s+/).length <= 6;
      const hasAnyFixture = /\b(?:toilet|sink|shower|faucet|water\s*heater|drain|pipe|tub|bathtub|disposal|dishwasher|washer|bidet|sump\s*pump|ejector|water\s*softener|backflow)\b/i.test(normalizedMessage);
      
      if (isDirectBookingRequest && currentBooking.stage === 'initial' && (isShortMessage || !hasAnyFixture)) {
        currentBooking.problemType = currentBooking.problemType || 'general_plumbing';
        currentBooking.stage = 'booking_details';
        bookingData.set(customerKey, currentBooking);
        
        // Don't ask "What's the issue?" if install intent is clear OR problem is already known
        const problemAlreadyKnown = currentBooking.problemType && currentBooking.problemType !== 'general_plumbing';
        const skipIssueQuestion = directBookingHasInstall || currentBooking.installIntentLocked || problemAlreadyKnown;
        
        let bookingPrompt;
        if (skipIssueQuestion) {
          // Problem is known - go straight to booking details
          bookingPrompt = RESPONSE_TEMPLATES.getSmartBookingRequest(currentBooking, "On it - I'll get a plumber out. ");
        } else {
          // Problem unknown - ask what the issue is
          bookingPrompt = "On it. I'll get a plumber scheduled for you. What's the issue?";
        }
        
        return {
          response: bookingPrompt,
          booking: currentBooking,
          debug: { intent: 'direct_booking_request', problemKnown: problemAlreadyKnown },
          metadata: { directBooking: true }
        };
      }
      
      // ================================================================
      // EARLY BACKFLOW DETECTION - Skip emergency triage for clear backflow requests
      // This runs BEFORE routine service detection to catch backflow immediately
      // ================================================================
      const isBackflowTestRequest = 
        (/\b(?:backflow).*(?:test|testing|certification|certify|inspection|letter|notice|city|county|hoa|annual|required|yearly)\b/i.test(normalizedMessage) ||
        /\b(?:city|county|hoa|letter|notice).*(?:backflow)\b/i.test(normalizedMessage) ||
        /\b(?:test|certification|inspection).*(?:backflow|that\s+(?:green\s+)?(?:thing|valve))\b/i.test(normalizedMessage)) &&
        !/\b(?:install|installation|replace|put\s*in|hook\s*up|set\s*up|add|new)\b/i.test(normalizedMessage);
      
      const isBackflowIssue =
        /\b(?:backflow).*(?:leak|leaking|stuck|broken|spray|spraying|fail|failed|not\s*working)\b/i.test(normalizedMessage) ||
        /\b(?:that\s+green\s+(?:thing|valve)).*(?:leak|spray|stuck|broken)\b/i.test(normalizedMessage);
      
      // Backflow test request - go straight to booking, skip all triage
      if (isBackflowTestRequest && !isBackflowIssue && currentBooking.stage === 'initial') {
        setProblemTypeIfAllowed(currentBooking, 'backflow_test', 'specific_compound');
        currentBooking.isRoutineService = true;
        currentBooking.skipEmergencyTriage = true;
        currentBooking.stage = 'booking_details';
        bookingData.set(customerKey, currentBooking);
        
        return {
          response: buildBookingResponse("backflow testing/certification", currentBooking),
          booking: currentBooking,
          debug: { intent: 'backflow_test_direct', problemType: 'backflow_test' },
          metadata: { routineService: true, skipEmergencyTriage: true, backflowTest: true }
        };
      }
      
      // Backflow issue (leaking, broken) - may need some triage but set problem type
      if (isBackflowIssue && currentBooking.stage === 'initial') {
        setProblemTypeIfAllowed(currentBooking, 'backflow_leak', 'specific_compound');
        currentBooking.fixture = 'backflow';
        currentBooking.stage = 'booking_details';
        bookingData.set(customerKey, currentBooking);
        
        return {
          response: buildBookingResponse("backflow preventer issue", currentBooking),
          booking: currentBooking,
          debug: { intent: 'backflow_issue_direct', problemType: 'backflow_leak' },
          metadata: { backflowIssue: true }
        };
      }
      
      // ================================================================
      // ROUTINE SERVICE EXCLUSION - Don't trigger emergencies for routine requests
      // ================================================================
      
      // Check for emergency signals that OVERRIDE routine detection
      const hasEmergencySignals = /\b(?:smell|odor|leak|leaking|flood|flooding|gushing|spray|burst|emergency|urgent|asap|dangerous|gas\s*smell|rotten\s*egg|hissing|water\s*everywhere)\b/i.test(normalizedMessage);
      
      // Backflow testing/certification - NOT emergency
      const isBackflowTest = /\b(?:backflow).*(?:test|testing|certification|certify|inspection|annual|yearly|required|letter|notice|city|county|hoa)\b/i.test(normalizedMessage) ||
                             /\b(?:test|certification|inspection).*(?:backflow)\b/i.test(normalizedMessage) ||
                             /\b(?:city|county|hoa|letter|notice).*(?:backflow|test)\b/i.test(normalizedMessage);
      
      // Winterization - NOT emergency
      const isWinterization = /\b(?:winterize|winterization|blow\s*out|spring\s*startup)\b/i.test(normalizedMessage);
      
      const isRoutineServiceRequest = 
        (/\b(?:test|testing|certification|annual|yearly|inspection|maintenance|check|tune-up)\b/i.test(normalizedMessage) ||
         (/\bservice\b/i.test(normalizedMessage) && !/\b(?:do\s+you\s+service|service\s+(?:area|my\s+area|this\s+area|here|brampton|toronto|mississauga|oakville|vaughan|hamilton|burlington|markham|richmond|ajax|whitby|oshawa|barrie|guelph|kitchener|waterloo|cambridge|london|windsor|ottawa|scarborough|etobicoke|north\s+york))/i.test(normalizedMessage)) ||
         isBackflowTest || isWinterization) &&
        !hasEmergencySignals;
      
      const isInstallationRequest =
        /\b(?:install|hook\s*up|connect|new|replace|add|run\s*line)\b/i.test(normalizedMessage) &&
        !hasEmergencySignals;
      
      // Gas line installation/hookup = NOT emergency (unless smell/leak mentioned)
      const isGasInstallRequest = 
        (/\b(?:gas\s*line|gas\s*pipe).*(?:install|run|hook\s*up|connect|new|range|stove|dryer|grill|fireplace)\b/i.test(normalizedMessage) ||
         /\b(?:install|hook\s*up|connect).*(?:gas\s*line|gas\s*range|gas\s*stove|gas\s*dryer)\b/i.test(normalizedMessage) ||
         /\b(?:new).*(?:gas\s*range|gas\s*stove|gas\s*dryer)\b/i.test(normalizedMessage)) &&
        !hasEmergencySignals;
      
      // Combined routine service flag for use elsewhere
      const isAnyRoutineService = isRoutineServiceRequest || isBackflowTest || isWinterization || isGasInstallRequest;
      
      // ================================================================
      // ROUTINE FAUCET ISSUES - NOT emergencies (drips, loose handles, weak pressure)
      // Only urgent if water won't stop or is gushing
      // ================================================================
      const isUrgentFaucetIssue = 
        /\b(?:faucet|tap).*(?:won'?t\s+(?:shut|turn)\s+off|can'?t\s+(?:shut|turn)\s+off|won'?t\s+stop|gushing|spraying\s+everywhere|burst)\b/i.test(normalizedMessage) ||
        /\b(?:water).*(?:won'?t\s+stop|can'?t\s+stop|pouring|gushing).*(?:faucet|tap|sink)\b/i.test(normalizedMessage);
      
      const isRoutineFaucetIssue =
        (/\b(?:faucet|tap).*(?:drip|dripping|leak|leaking|loose|wobbly|squeaky|hard\s+to\s+turn|stiff|low\s+pressure|weak|slow)\b/i.test(normalizedMessage) ||
         /\b(?:drip|dripping|leak|leaking).*(?:faucet|tap)\b/i.test(normalizedMessage) ||
         /\b(?:handle).*(?:loose|broken|stuck|won'?t\s+turn).*(?:faucet|sink|tap)\b/i.test(normalizedMessage) ||
         /\b(?:sprayer).*(?:weak|low\s+pressure|not\s+working|broken)\b/i.test(normalizedMessage)) &&
        !isUrgentFaucetIssue;
      
      // ================================================================
      // ROUTINE SERVICE DIRECT ROUTING - Skip emergency triage for these
      // ================================================================
      if (isAnyRoutineService && currentBooking.stage === 'initial' && !currentBooking.problemType) {
        // Determine the specific service type
        let routineServiceType = 'general_service';
        let routineServiceDesc = 'service request';
        
        if (isBackflowTest) {
          routineServiceType = 'backflow_test';
          routineServiceDesc = 'backflow testing/certification';
        } else if (isWinterization) {
          routineServiceType = /\b(?:spring\s*startup)\b/i.test(normalizedMessage) ? 'spring_startup' : 'winterization';
          routineServiceDesc = /\b(?:spring\s*startup)\b/i.test(normalizedMessage) ? 'spring startup' : 'winterization';
        } else if (isGasInstallRequest) {
          routineServiceType = 'gas_line_install';
          routineServiceDesc = 'gas line installation';
        }
        
        setProblemTypeIfAllowed(currentBooking, routineServiceType, 'specific_compound');
        currentBooking.isRoutineService = true;
        currentBooking.stage = 'booking_details';
        bookingData.set(customerKey, currentBooking);
        
        return {
          response: `Got it - ${routineServiceDesc}. I'll get a plumber scheduled for you.`,
          booking: currentBooking,
          debug: { intent: 'routine_service_booking', problemType: routineServiceType },
          metadata: { routineService: true, skipEmergencyTriage: true }
        };
      }
      
      // ================================================================
      // OLD EMERGENCY DETECTION BLOCKS REMOVED
      // Gas leak, sulfur smell, CO symptoms, electrical+water emergencies
      // are now handled by triageEmergencyWithAI() via EMERGENCY_SAFETY_GATE
      // ================================================================
      
      // ================================================================
      // OLD OVERFLOW AND BROKEN SHUTOFF EMERGENCY HANDLERS REMOVED
      // Now handled by triageEmergencyWithAI() via EMERGENCY_SAFETY_GATE
      // ================================================================
      
      // ================================================================
      // BUG D FIX: VAGUE URGENCY HANDLER
      // "something is wrong", "something is happening" → clarifying question
      // ================================================================
      const hasVagueUrgency = 
        /\b(?:something)\s+(?:is\s+)?(?:very\s+)?(?:wrong|happening|bad|weird)\b/i.test(normalizedMessage) ||
        /\b(?:not\s+sure|don'?t\s+know)\s+(?:but|what).+(?:happening|wrong|going\s+on)\b/i.test(normalizedMessage);
      
      if (hasVagueUrgency && !currentBooking.vagueUrgencyClarified && currentBooking.stage === 'initial') {
        currentBooking.vagueUrgencyClarified = true;
        bookingData.set(customerKey, currentBooking);
        
        return {
          response: "I want to help - can you tell me what's happening? Is there water, a leak, a smell, or something else?",
          booking: currentBooking,
          debug: { intent: 'vague_urgency_clarification' },
          metadata: { vagueUrgency: true }
        };
      }
      
      // ================================================================
      // "NOT EMERGENCY" RESPONSE HANDLER
      // When customer answers "no emergency, just X" - extract X and book
      // ================================================================
      const isNotEmergencyResponse = 
        /\b(?:no|not|isn'?t|isnt)\s*(?:an?\s*)?(?:emergency|urgent)\b/i.test(normalizedMessage) ||
        /\b(?:just|only)\s*(?:need|want|have)\s*(?:a\s*)?(?:repair|plumber|fix|appointment|schedule)\b/i.test(normalizedMessage);
      
      if (isNotEmergencyResponse && currentBooking.stage === 'initial') {
        // Try to extract the problem from their message
        const problemMatch = normalizedMessage.match(/\b(?:just|only)\s+(?:a\s+)?(\w+(?:\s+\w+)?)\s*$/i) ||
                            normalizedMessage.match(/(?:just|have|need)\s+(?:a\s+)?(?:low\s+)?(\w+\s*\w*)/i);
        
        let detectedProblem = 'general_plumbing';
        if (/\blow\s*pressure\b/i.test(normalizedMessage)) detectedProblem = 'low_pressure';
        else if (/\b(?:clog|clogged|blocked)\b/i.test(normalizedMessage)) detectedProblem = 'clog';
        else if (/\b(?:leak|leaking|drip)\b/i.test(normalizedMessage)) detectedProblem = 'leak';
        else if (/\b(?:slow\s*drain|drain.*slow)\b/i.test(normalizedMessage)) detectedProblem = 'slow_drain';
        else if (/\b(?:no\s*hot\s*water|water\s*not\s*hot)\b/i.test(normalizedMessage)) detectedProblem = 'water_heater_no_hot';
        
        setProblemTypeIfAllowed(currentBooking, detectedProblem, 'specific_compound');
        currentBooking.stage = 'booking_details';
        bookingData.set(customerKey, currentBooking);
        
        // Use detected problem description instead of "not an emergency" to avoid triggering forbidden word
        const problemDescMap = {
          general_plumbing: 'routine repair',
          leak: 'leak repair',
          clog: 'clog',
          low_pressure: 'low pressure issue',
          slow_drain: 'slow drain',
          water_heater_no_hot: 'water heater issue'
        };
        const problemDesc = problemDescMap[detectedProblem] || 'routine repair';
        return {
          response: buildBookingResponse(problemDesc, currentBooking),
          booking: currentBooking,
          debug: { intent: 'not_emergency_booking', problemType: detectedProblem },
          metadata: { notEmergency: true }
        };
      }
      
      // ================================================================
      // BUG E FIX: SINGLE WORD PLUMBING TERMS → CLARIFYING QUESTION
      // "leak" alone should ask where, not go straight to booking
      // ================================================================
      const isSingleWord = normalizedMessage.trim().split(/\s+/).length === 1;
      const singleWordPlumbingPattern = /^(leak|clog|drip|flood|burst|blocked)$/i;
      
      if (isSingleWord && singleWordPlumbingPattern.test(normalizedMessage.trim()) && 
          !currentBooking.singleWordClarified && currentBooking.stage === 'initial') {
        
        currentBooking.singleWordClarified = true;
        bookingData.set(customerKey, currentBooking);
        
        const word = normalizedMessage.trim().toLowerCase();
        const questions = {
          leak: "Where is the leak - faucet, toilet, pipe, water heater, or an appliance like dishwasher/washer?",
          clog: "What's clogged - sink, toilet, shower, or multiple drains?",
          drip: "Where is the drip - faucet, pipe, or somewhere else?",
          flood: "Is water actively flooding right now? Where is it coming from?",
          burst: "Did a pipe burst? Is water spraying?",
          blocked: "What's blocked - toilet, sink, or drain?"
        };
        
        return {
          response: questions[word] || "Can you tell me more about what's happening?",
          booking: currentBooking,
          debug: { intent: 'single_word_clarification', word },
          metadata: { singleWordClarification: true }
        };
      }
      
      // ================================================================
      // COMMON PLUMBING ISSUE DIRECT HANDLER
      // Bread-and-butter issues that should NEVER fall back
      // BUG 1 FIX: Skip if message has dangerous context (gas, electrical, etc.)
      // BUG F FIX: Exclude billing language from dangerous context
      // ================================================================
      // FIXTURE-SPECIFIC patterns checked FIRST to preserve semantic context
      // This prevents "toilet clogged" from becoming generic "clog" with "drain" language
      const commonPlumbingPatterns = {
        // === COMPOUND PATTERNS (FIXTURE + PROBLEM - check FIRST) ===
