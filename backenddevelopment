  // Get base category from problem type
  getBaseCategory: function(type) {
    if (!type) return null;
    for (const [category, types] of Object.entries(this.categories)) {
      if (types.includes(type)) return category;
    }
    // Fallback: check prefix
    if (type.startsWith('toilet')) return 'toilet';
    if (type.startsWith('sink')) return 'sink';
    if (type.startsWith('shower') || type.startsWith('bathtub') || type.startsWith('jacuzzi')) return 'shower';
    if (type.startsWith('sewer') || type.startsWith('main_drain')) return 'sewer';
    if (type.startsWith('water_heater')) return 'water_heater';
    if (type.startsWith('pipe')) return 'pipe';
    if (type.startsWith('drain')) return 'drain';
    if (type.startsWith('leak')) return 'leak';
    if (type.startsWith('faucet')) return 'faucet';
    if (type.startsWith('dishwasher') || type.startsWith('washer') || type.startsWith('fridge') || type.startsWith('ice_maker')) return 'appliance';
    if (type.startsWith('hose_bib') || type.startsWith('outdoor') || type.startsWith('sprinkler') || type.startsWith('exterior') || type.startsWith('water_meter') || type.startsWith('yard') || type.startsWith('sump')) return 'outdoor';
    if (type.startsWith('garbage_disposal') || type.startsWith('disposal')) return 'garbage_disposal';
    if (type.startsWith('water_softener') || type.startsWith('softener')) return 'water_softener';
    if (type.startsWith('septic')) return 'septic';
    if (type.startsWith('gas')) return 'gas_line';
    if (type.startsWith('backflow')) return 'backflow';
    if (type.startsWith('ejector')) return 'ejector_pump';
    return type;
  },
  
  // Check if refinement is valid (same category, more specific)
  isValidRefinement: function(currentType, newType) {
    const currCat = this.getBaseCategory(currentType);
    const newCat = this.getBaseCategory(newType);
    // Must be same category AND new type must be more specific (contain underscore)
    return currCat === newCat && newType.includes('_');
  },
  
  // Check if problem type is an emergency
  isEmergency: function(type) {
    return this.emergencyTypes && this.emergencyTypes.includes(type);
  }
};

