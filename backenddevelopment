             /\b(?:pump).*(?:not\s*(?:working|running|circulating))\b/i.test(message) && /\b(?:hot\s*water|recirc|circulation)\b/i.test(message) ||
             /\b(?:water).*(?:not\s*circulating|won'?t\s*circulate)\b/i.test(message)) {
      entities.problemType = 'recirculating_pump';
      entities.fixture = 'water_heater';
      entities.subtype = 'recirculating_pump';
    }
    // EXPANSION TANK ISSUES - route to water heater service, not emergency
    else if (/\b(?:expansion\s*tank).*(?:waterlogged|leaking|failed|bad|problem)\b/i.test(message) ||
             /\b(?:waterlogged|leaking|failed).*(?:expansion\s*tank)\b/i.test(message) ||
             /\bexpansion\s*tank\b/i.test(message)) {
      entities.problemType = 'expansion_tank';
      entities.fixture = 'water_heater';
      entities.subtype = 'expansion_tank';
    }
    // GUARD: Don't overwrite HIGH-PRIORITY classifications (install, emergency)
    else if (!entities.problemType && /\b(water heater|water heter|waterheater|waterheter|water heater|wate heater|waterheate|hot water tank|hotwater tank|hot water|hotwater|hotwate|hot wate|hotwatr|hw tank|heater|heter|heaterr)\b/i.test(message)) {
      entities.problemType = 'water_heater';
    }
    
    // ================================================================
    // F) PIPE PROBLEMS - 10 specific categories
    // ================================================================
    // FIX GD-4: Check for disposal context FIRST - "disposal frozen" = jammed, not frozen pipe
    else if (/\b(?:garbage\s*disposal|disposal|garburator).*(?:frozen|froze|seized|locked)\b/i.test(message) ||
             /\b(?:frozen|froze|seized|locked).*(?:garbage\s*disposal|disposal|garburator)\b/i.test(message)) {
      entities.problemType = 'garbage_disposal_jammed';
      entities.fixture = 'garbage_disposal';
    } else if (/\b(?:pipe|pipes).*(?:frozen|froze|ice|won'?t\s+flow)\b/i.test(message) ||
             /\b(?:frozen|froze).*(?:pipe|pipes)\b/i.test(message)) {
      entities.problemType = 'pipe_frozen';
      entities.isEmergency = true;
    } else if (/\b(?:think|suspect|might\s+be).*(?:frozen|froze)\b/i.test(message) &&
               !/\b(?:disposal|garburator)\b/i.test(message)) {
      entities.problemType = 'pipe_suspected_frozen';
    } else if (/\b(?:pipe|pipes).*(?:burst|bursted|ruptured|exploded|broke|broken)\b/i.test(message) ||
               /\b(?:burst|bursted|ruptured|exploded).*(?:pipe|pipes)\b/i.test(message)) {
      entities.problemType = 'pipe_burst';
    } else if (/\b(?:pipe|pipes).*(?:slow\s+leak|small\s+leak|drip)\b/i.test(message)) {
      entities.problemType = 'pipe_slow_leak';
    } else if (/\b(?:pipe|pipes).*(?:spray|gush|pour|fast\s+leak)\b/i.test(message)) {
      entities.problemType = 'pipe_fast_leak';
    } else if (/\b(?:leak|water).*(?:wall|behind\s+wall|inside\s+wall|in\s+wall)\b/i.test(message)) {
      entities.problemType = 'pipe_leak_wall';
    } else if (/\b(?:leak|water|drip).*(?:ceiling|from\s+above|upstairs)\b/i.test(message) ||
               /\b(?:ceiling).*(?:leak|drip|water)\b/i.test(message)) {
      entities.problemType = 'pipe_leak_ceiling';
    } else if (/\b(?:pipe|pipes).*(?:corrod|corrosion|rust|green|white\s+buildup)\b/i.test(message)) {
      entities.problemType = 'pipe_corrosion';
    } else if (/\b(?:water\s*hammer|bang.*water|pipes?\s+bang)\b/i.test(message)) {
      entities.problemType = 'pipe_water_hammer';
    } else if (/\b(?:pipe|pipes).*(?:whistl)\b/i.test(message)) {
      entities.problemType = 'pipe_whistling';
    } else if (/\b(?:pipe|pipes).*(?:rattl|vibrat)\b/i.test(message)) {
      entities.problemType = 'pipe_rattling';
    } else if (/\b(?:pipe|pipes).*(?:noise|noisy|loud|sound)\b/i.test(message)) {
      entities.problemType = 'pipe_noise';
    } else if (/\b(?:pipe|pipes).*(?:leak|leaking)\b/i.test(message) ||
               /\b(?:leak|leaking).*(?:pipe|pipes)\b/i.test(message)) {
      entities.problemType = 'pipe_leaking';
    } else if (/\b(?:pipe|pipes).*(?:clog|clogged|blocked)\b/i.test(message)) {
      entities.problemType = 'pipe_clogged';
    } else if (/\b(pipe|pipes|pype|piping|pype|ppipe|pippe|pipping|pyping|burst|burts|brust|brst|burstt|bursted|busted|frozen|froze|froezen|frozn|frozenn|frosen)\b/i.test(message)) {
      entities.problemType = 'pipe';
    }
    
    // ================================================================
    // G) APPLIANCE PLUMBING PROBLEMS - 17 specific categories
    // FIX GD-8: Check disposal context for dishwasher drainage issues
    // ================================================================
    // FIX GD-8a: Dishwasher draining INTO disposal = disposal issue
    else if (/\b(?:dishwasher).*(?:drain|draining).*(?:into|to|through)\s*(?:the\s+)?(?:disposal|garburator)\b/i.test(message) ||
             /\b(?:disposal|garburator).*(?:dishwasher).*(?:drain|backing)\b/i.test(message)) {
      entities.problemType = 'garbage_disposal_clogged';
      entities.fixture = 'garbage_disposal';
      entities.dishwasherRelated = true;
    } else if (/\b(?:dishwasher).*(?:leak|leaking|water\s+under)\b/i.test(message) &&
               !/\b(?:disposal|garburator)\b/i.test(message)) {
      entities.problemType = 'dishwasher_leak';
    } else if (/\b(?:dishwasher).*(?:won'?t\s+drain|not\s+draining|standing\s+water)\b/i.test(message) &&
               !/\b(?:disposal|garburator)\b/i.test(message)) {
      entities.problemType = 'dishwasher_no_drain';
    } else if (/\b(?:dishwasher).*(?:backup|backing)\b/i.test(message)) {
      entities.problemType = 'dishwasher_backup';
    // Dishwasher not filling
    } else if (/\b(?:dishwasher).*(?:no\s+water|not\s+filling|won'?t\s+fill|empty|dry)\b/i.test(message)) {
      entities.problemType = 'dishwasher_no_water';
    // Dishwasher installation - full install verb list
    } else if (/\b(?:dishwasher).*(?:install|replace|put\s*in|hook\s*up|swap\s*(?:out)?|change\s*(?:out)?|set\s*up|add|mount|connect|(?:get|need|want)\s*(?:a\s*)?new|new)\b/i.test(message) ||
               /\b(?:install|replace|put\s*in|hook\s*up|swap|change|set\s*up|add|mount|connect).*(?:dishwasher)\b/i.test(message)) {
      entities.problemType = 'dishwasher_install';
    // FIX GD-9: Air gap with disposal context = disposal issue
    } else if (/\b(?:disposal|garburator)\s*(?:air\s*gap)\b/i.test(message) ||
               /\b(?:air\s*gap).*(?:disposal|garburator)\b/i.test(message)) {
      entities.problemType = 'garbage_disposal_leaking';
      entities.fixture = 'garbage_disposal';
      entities.leak_location = 'air_gap';
    // Dishwasher air gap (no disposal context)
    } else if (/\b(?:dishwasher)?.*(?:air\s*gap).*(?:leak|clog|overflow|drip)\b/i.test(message) ||
               /\b(?:air\s*gap).*(?:dishwasher)?\b/i.test(message) &&
               !/\b(?:disposal|garburator)\b/i.test(message)) {
      entities.problemType = 'dishwasher_air_gap';
    } else if (/\b(?:wash.*machine|washer|laundry).*(?:overflow)\b/i.test(message)) {
      entities.problemType = 'washer_overflow';
    } else if (/\b(?:washing\s+machine|washer\s+machine|clothes\s+washer).*(?:drain.*backup|backup.*drain)\b/i.test(message)) {
      entities.problemType = 'washer_drain_backup';
    // FIX M + P: Washer-specific patterns BEFORE generic patterns
    // Washer valve leaking
    } else if (!entities.problemType && /\b(?:wash(?:ing)?\s*machine|washer)\b/i.test(message) && 
               /\b(?:valve)\s*(?:is\s+)?(?:leak|leaking)\b/i.test(message)) {
      entities.problemType = 'washer_valve_leak';
      entities.fixture = 'washer';
    // Washer hose/line leak or burst
    } else if (!entities.problemType && /\b(?:wash(?:ing)?\s*machine|washer|laundry)\b/i.test(message) && 
               /\b(?:hose|line|supply)\s*(?:is\s+)?(?:leak|burst|broke|broken|leaking)\b/i.test(message)) {
      entities.problemType = 'washer_supply_leak';
      entities.fixture = 'washer';
    // FIX P: Washer drain clogged - BEFORE sewer_backup pattern
    } else if (!entities.problemType && /\b(?:wash(?:ing)?\s*machine|washer|laundry)\b/i.test(message) && 
               /\b(?:drain)\s*(?:is\s+)?(?:clog|clogged|blocked|backing|backed)\b/i.test(message)) {
      entities.problemType = 'washer_drain_clogged';
      entities.fixture = 'washer';
    // FIX P: Washer drain - alternative phrasing
    } else if (!entities.problemType && /\b(?:wash(?:ing)?\s*machine|washer|laundry)\s+(?:drain)\b/i.test(message) && 
               /\b(?:clog|block|backup|back\s*up|slow|won'?t\s+drain)\b/i.test(message)) {
      entities.problemType = 'washer_drain_clogged';
      entities.fixture = 'washer';
    } else if (/\b(?:washing\s+machine|washer\s+machine|clothes\s+washer).*(?:supply|hose).*(?:leak)\b/i.test(message)) {
      entities.problemType = 'washer_supply_leak';
    // Generic washer leak - require "washing machine" or exclude faucet washer context
    } else if (/\b(?:washing\s+machine|washer\s+machine|clothes\s+washer|laundry\s+machine).*(?:leak|leaking|water\s+under|puddle)\b/i.test(message) ||
               (/\b(?:washer|laundry).*(?:leak|leaking|water\s+under|puddle)\b/i.test(message) && !/\b(?:faucet|replace|replacing|replaced|new)\s*washer\b/i.test(message))) {
      entities.problemType = 'washer_leak';
    // Washer won't drain - require "washing machine" or exclude faucet washer context
    } else if (/\b(?:washing\s+machine|washer\s+machine|clothes\s+washer).*(?:won'?t\s+drain|not\s+draining|standing\s+water)\b/i.test(message) ||
               (/\b(?:washer|laundry).*(?:won'?t\s+drain|not\s+draining|standing\s+water)\b/i.test(message) && !/\b(?:faucet|replace|replacing|replaced|new)\s*washer\b/i.test(message))) {
      entities.problemType = 'washer_no_drain';
    // Washer installation - full install verb list, require "washing machine" to avoid faucet washer collision
    } else if (/\b(?:washing\s+machine|washer\s+machine|clothes\s+washer).*(?:install|replace|put\s*in|hook\s*up|swap\s*(?:out)?|change\s*(?:out)?|set\s*up|add|mount|connect|(?:get|need|want)\s*(?:a\s*)?new|new)\b/i.test(message) ||
               /\b(?:install|replace|put\s*in|hook\s*up|swap|change|set\s*up|add|mount|connect).*(?:washing\s+machine|washer\s+machine|clothes\s+washer)\b/i.test(message)) {
      entities.problemType = 'washer_install';
    // Washer box leak
    } else if (/\b(?:washer\s*box|laundry\s*box|outlet\s*box|wash.*machine\s*box).*(?:leak)\b/i.test(message) ||
               /\b(?:leak).*(?:washer\s*box|laundry\s*box|outlet\s*box)\b/i.test(message)) {
      entities.problemType = 'washer_box_leak';
    } else if (/\b(?:fridge|refrigerator).*(?:leak|water|puddle)\b/i.test(message)) {
      entities.problemType = 'fridge_leak';
    } else if (/\b(?:ice\s*maker).*(?:no\s+water|not\s+working|won'?t)\b/i.test(message)) {
      entities.problemType = 'ice_maker_no_water';
    // Ice maker leak
    } else if (/\b(?:ice\s*maker|icemaker).*(?:leak|leaking|drip|water\s+under)\b/i.test(message)) {
      entities.problemType = 'ice_maker_leak';
    // FIX: Ice maker not working / not making ice (generic problem without "no water")
    } else if (/\b(?:ice\s*maker|icemaker).*(?:not\s+(?:working|making)|broken|stopped|quit|issue|problem)\b/i.test(message) ||
               /\b(?:not\s+(?:working|making)|broken|stopped).*(?:ice\s*maker|icemaker)\b/i.test(message)) {
      entities.problemType = 'ice_maker_not_working';
    // Fridge water line install/repair - full install verb list
    } else if (/\b(?:fridge|refrigerator).*(?:water\s*line|supply\s*line).*(?:install|replace|put\s*in|hook\s*up|swap\s*(?:out)?|change\s*(?:out)?|set\s*up|add|run|connect|repair|(?:get|need|want)\s*(?:a\s*)?new|new)\b/i.test(message) ||
               /\b(?:install|replace|put\s*in|hook\s*up|swap|change|set\s*up|run|connect).*(?:water\s*line|supply\s*line).*(?:fridge|refrigerator)\b/i.test(message) ||
               /\b(?:water\s*line|supply\s*line).*(?:fridge|refrigerator)\b/i.test(message)) {
      entities.problemType = 'fridge_water_line';
    } else if (/\b(dishwasher|washing\s*machine|washer|fridge|refrigerator|ice\s*maker)\b/i.test(message)) {
      entities.problemType = 'appliance';
    }
    
    // ================================================================
    // H) OUTDOOR PLUMBING PROBLEMS - 8 specific categories
    // FROZEN outdoor faucet = URGENT (pipe burst risk) - check FIRST
    // ================================================================
    else if (/\b(?:hose\s*bib|outdoor\s*faucet|outside\s*faucet|spigot).*(?:frozen|froze|freeze)\b/i.test(message) ||
             /\b(?:frozen|froze).*(?:hose\s*bib|outdoor\s*faucet|outside\s*faucet|spigot)\b/i.test(message)) {
      entities.problemType = 'hose_bib_frozen';
    } else if (/\b(?:hose\s*bib|outdoor\s*faucet|outside\s*faucet|spigot).*(?:leak)\b/i.test(message) ||
             /\b(?:leak).*(?:hose\s*bib|outdoor\s*faucet|outside\s*faucet|spigot)\b/i.test(message)) {
      entities.problemType = 'hose_bib_leak';
    } else if (/\b(?:outdoor\s*faucet|outside\s*faucet|hose\s*bib|spigot).*(?:stuck|won'?t\s+turn)\b/i.test(message)) {
      entities.problemType = 'outdoor_faucet_stuck';
    // FIX: "pop-up spray head" is a sprinkler term, not faucet - check BEFORE faucet patterns
    } else if (!entities.problemType && /\b(?:pop[\s-]*up)\s+(?:spray\s+)?head\b/i.test(message)) {
      entities.problemType = 'sprinkler_leak';
      entities.fixture = 'sprinkler';
    // FIX P: Sprinkler valve/head/line patterns
    } else if (!entities.problemType && /\b(?:sprinkler|irrigation)\b/i.test(message) && 
               /\b(?:valve|head|line)\s*(?:is\s+)?(?:leak|leaking|broke|broken)\b/i.test(message)) {
      entities.problemType = 'sprinkler_leak';
      entities.fixture = 'sprinkler';
    // FIX: Enhanced sprinkler patterns - catch more phrasings including zones, heads, winterize
    // Also includes common typos (irriation, irrigaton) and abbreviations (irrig)
    } else if (/\b(?:sprinkler|irrigation|irriation|irrigaton|irrig|drip\s*line|yard\s*line|lawn\s*system).*(?:leak|leaking|broken|not\s*working|won'?t\s+work|head|zone|winterize|turn\s+on|startup|sys|system)\b/i.test(message) ||
               /\b(?:leak|leaking|broken|not\s+working).*(?:sprinkler|irrigation|irriation|irrigaton|irrig|drip\s*line|yard\s*line)\b/i.test(message) ||
               /\b(?:sprinkler|irrigation|irriation|irrig)\s+(?:system|sys|head|zone|line|valve)\b/i.test(message)) {
      entities.problemType = 'sprinkler_leak';
      entities.fixture = 'sprinkler';
    } else if (/\b(?:outside|outdoor|exterior).*(?:pipe|pipes).*(?:frozen|froze)\b/i.test(message)) {
      entities.problemType = 'exterior_pipe_freeze';
    } else if (/\b(?:water\s*meter).*(?:leak)\b/i.test(message)) {
      entities.problemType = 'water_meter_leak';
    } else if (/\b(?:yard|lawn|garden).*(?:flood|flooding|water|soggy|wet)\b/i.test(message)) {
      entities.problemType = 'yard_flooding';
    // FIX M + O: Fixture-specific "won't turn on" patterns BEFORE generic
    } else if (!entities.problemType && /\bsump\s*pump\b/i.test(message) && 
               /\b(?:won'?t|will\s*n[o']?t|doesn'?t|does\s*n[o']?t)\s+(?:turn\s+on|start|work|pump)\b/i.test(message)) {
      entities.problemType = 'sump_pump';
    } else if (/\b(?:sump\s*pump)\b/i.test(message)) {
      entities.problemType = 'sump_pump';
    // FIX O: Garbage disposal "won't turn on" - check BEFORE generic pattern
    } else if (!entities.problemType && /\b(?:garbage\s*disposal|disposer|disposal)\b/i.test(message) && 
               /\b(?:won'?t|will\s*n[o']?t|doesn'?t|does\s*n[o']?t)\s+(?:turn\s+on|start|work|run)\b/i.test(message)) {
      entities.problemType = 'garbage_disposal_not_working';
    // FIX O: Well pump "won't turn on"
    } else if (!entities.problemType && /\b(?:well\s*pump)\b/i.test(message) && 
               /\b(?:won'?t|will\s*n[o']?t|doesn'?t|does\s*n[o']?t)\s+(?:turn\s+on|start|work|pump)\b/i.test(message)) {
      entities.problemType = 'well_pump';
    // FIX O: Ejector pump "won't turn on"
    } else if (!entities.problemType && /\b(?:ejector\s*pump|sewage\s*pump)\b/i.test(message) && 
               /\b(?:won'?t|will\s*n[o']?t|doesn'?t|does\s*n[o']?t)\s+(?:turn\s+on|start|work|pump)\b/i.test(message)) {
      entities.problemType = 'ejector_pump_failure';
    // Won't turn on - generic fallback (only if no fixture context matched)
    } else if (!entities.problemType && /\bwon'?t\s+turn\s+on\b/i.test(message) && 
               !/\b(?:sump|well|ejector|garbage\s*disposal|disposer|disposal)\s*(?:pump)?\b/i.test(message)) {
      entities.problemType = 'pipe_burst';
    } else if (/\b(outdoor|outside|exterior|yard|hose\s*bib|spigot|sprinkler|irrigation|drip\s*line|lawn\s*system)\b/i.test(message)) {
      entities.problemType = 'outdoor';
    }
    
    // ================================================================
    // NEW CATEGORY: Main Water Shutoff Valve
    // ================================================================
    else if (/\b(?:main|water)\s*(?:shut\s*off|shutoff)\s*(?:valve)?\b/i.test(message) ||
             /\b(?:shut\s*off|shutoff)\s*(?:valve|won'?t|stuck|broken)\b/i.test(message) ||
             /\b(?:can'?t|cannot)\s*(?:shut|turn)\s*(?:off|down)\s*(?:the\s+)?(?:water|main)\b/i.test(message) ||
             /\b(?:main\s*valve|water\s*valve)\s*(?:stuck|won'?t|broken|leaking)\b/i.test(message)) {
      entities.problemType = 'main_shutoff_valve';
    }
    
    // ================================================================
    // NEW CATEGORY: Pressure Reducing Valve (PRV)
    // ================================================================
    else if (/\b(?:pressure\s*(?:reducing|regulator|relief)\s*valve|PRV)\b/i.test(message) ||
             /\b(?:water\s*pressure)\s*(?:too\s+high|very\s+high|extremely\s+high)\b/i.test(message) ||
             /\b(?:pipes?\s*(?:banging|hammering|shaking)\s*everywhere)\b/i.test(message) ||
             /\b(?:pressure\s*regulator)\b/i.test(message)) {
      entities.problemType = 'prv';
    }
    
    // ================================================================
    // NEW CATEGORY: Well Pump
    // ================================================================
    else if (/\b(?:well\s*pump)\b/i.test(message) ||
             /\b(?:we'?re|i'?m|we\s+are)\s*(?:on\s+a\s+)?well\b/i.test(message) ||
             /\b(?:private\s*well|well\s*system|well\s*water)\b/i.test(message) ||
             /\b(?:no\s*water).*(?:well)\b/i.test(message) ||
             /\b(?:well).*(?:no\s*water|not\s*working|stopped)\b/i.test(message)) {
      entities.problemType = 'well_pump';
    }
    
    // ================================================================
    // I) GENERAL / UNKNOWN PROBLEMS - 8 specific categories
    // ================================================================
    // Guard: Don't trigger on "random" if message is about shower/faucet temperature fluctuation
    else if (/\b(?:water).*(?:where.*shouldn'?t|unexpected|random)\b/i.test(message) &&
             !/\b(?:shower|faucet|tub|bathtub).*(?:random|scalding|temperature|hot|cold)\b/i.test(message) &&
             !/\b(?:random|scalding|temperature).*(?:shower|faucet|tub|bathtub)\b/i.test(message)) {
      entities.problemType = 'water_where_shouldnt_be';
    } else if (/\b(?:no\s+water).*(?:house|home|anywhere|all)\b/i.test(message) ||
               /\b(?:house|home).*(?:no\s+water)\b/i.test(message) ||
               /\b(?:no\s+water).*(?:any|all|every)\s+(?:faucet|sink|fixture)s?\b/i.test(message)) {
      entities.problemType = 'no_water_house';
    } else if (/\b(?:low\s+pressure|no\s+pressure).*(?:house|home|everywhere|all)\b/i.test(message) ||
               /\b(?:whole\s+house|everywhere).*(?:low\s+pressure|no\s+pressure)\b/i.test(message)) {
      entities.problemType = 'low_pressure_house';
    } else if (/\b(?:air).*(?:pipe|faucet|sputter)\b/i.test(message) ||
               /\b(?:sputter|spit).*(?:water|faucet)\b/i.test(message)) {
      entities.problemType = 'air_in_pipes';
    } else if (/\b(?:water\s*bill).*(?:high|spike|increase)\b/i.test(message)) {
      entities.problemType = 'water_bill_spike';
    } else if (/\b(?:knock|knocking|bang|banging).*(?:pipe|wall|sound)\b/i.test(message)) {
      entities.problemType = 'knocking_sounds';
    }
    
    // ================================================================
    // J) GARBAGE DISPOSAL PROBLEMS (FIX GD-6: Expanded patterns)
    // Includes: disposer, food grinder, brands (Whirlpool, GE, etc.), reset button context
    // ================================================================
    // DISPOSAL_SYNONYMS: garbage disposal, disposal, garburator, disposer, food grinder, food disposer, insinkerator
    // DISPOSAL_BRANDS: InSinkErator, Badger, Waste King, Moen, Whirlpool, GE, KitchenAid
    else if (/\b(?:garbage\s*disposal|disposal|garburator|disposer|food\s*(?:grinder|disposer)|insinkerator|badger\s*\d*).*(?:jam|jammed|stuck|won'?t\s+(?:turn|spin)|not\s+spinning|frozen|seized|locked)\b/i.test(message) ||
             /\b(?:jam|jammed|stuck|frozen|seized).*(?:garbage\s*disposal|disposal|garburator|disposer|food\s*grinder)\b/i.test(message) ||
             /\b(?:fork|spoon|knife|utensil|bone|something)\s+(?:stuck|fell|dropped|jammed?).*(?:disposal|garburator)\b/i.test(message) ||
             /\b(?:disposal|garburator).*(?:fork|spoon|knife|utensil|bone)\s+(?:stuck|fell|in\s*it)\b/i.test(message)) {
      entities.problemType = 'garbage_disposal_jammed';
      entities.fixture = 'garbage_disposal';
    } else if (/\b(?:garbage\s*disposal|disposal|garburator|disposer|food\s*grinder).*(?:leak|leaking|drip|water\s+under)\b/i.test(message) ||
               /\b(?:leak|leaking).*(?:garbage\s*disposal|disposal|garburator|disposer)\b/i.test(message)) {
      entities.problemType = 'garbage_disposal_leaking';
      entities.fixture = 'garbage_disposal';
      // FIX GD-6b: Pre-fill leak location if specified
      if (/\b(?:from\s+(?:the\s+)?)?bottom\b/i.test(message)) {
        entities.leak_location = 'bottom';
        entities.skipLeakLocationQuestion = true;
      } else if (/\b(?:from\s+(?:the\s+)?)?(?:side|connection|where\s+it\s+connects)\b/i.test(message)) {
        entities.leak_location = 'connection';
        entities.skipLeakLocationQuestion = true;
      }
    } else if (/\b(?:garbage\s*disposal|disposal|garburator|disposer|food\s*grinder).*(?:not\s+working|won'?t\s+(?:start|turn\s*on|run|work)|dead|broken|nothing\s+happens)\b/i.test(message) ||
               /\b(?:won'?t|can'?t|doesn'?t)\s+(?:turn\s*on|start|run|work).*(?:disposal|garburator|disposer)\b/i.test(message) ||
               /\b(?:disposal|garburator|disposer).*(?:won'?t|can'?t|doesn'?t)\s+(?:turn|start|run|work)\b/i.test(message)) {
      entities.problemType = 'garbage_disposal_not_working';
      entities.fixture = 'garbage_disposal';
    } else if (/\b(?:garbage\s*disposal|disposal|garburator|disposer).*(?:hum|humming|buzzing|buzz|motor\s+runs?)\b/i.test(message) ||
               /\b(?:hum|humming|buzzing).*(?:disposal|garburator|disposer)\b/i.test(message)) {
      entities.problemType = 'garbage_disposal_humming';
      entities.fixture = 'garbage_disposal';
    } else if (/\b(?:garbage\s*disposal|disposal|garburator|disposer).*(?:smell|stink|odor|stench|reek)\b/i.test(message) ||
               /\b(?:smell|stink|odor|bad\s+smell).*(?:disposal|garburator|disposer|from\s+(?:the\s+)?sink)\b/i.test(message)) {
      entities.problemType = 'garbage_disposal_smell';
      entities.fixture = 'garbage_disposal';
    } else if (/\b(?:garbage\s*disposal|disposal|garburator|disposer).*(?:clog|clogged|backed?\s*up|backing\s*up|not\s+draining)\b/i.test(message) ||
               /\b(?:back|backing)\s*up.*(?:disposal|garburator)\b/i.test(message) ||
               /\b(?:back|backing)\s*up.*(?:when|while).*(?:run|running|use|using).*(?:disposal|garburator)\b/i.test(message) ||
               /\b(?:disposal|garburator).*(?:back|backing)\s*up\b/i.test(message)) {
      entities.problemType = 'garbage_disposal_clogged';
      entities.fixture = 'garbage_disposal';
    } else if (/\b(?:garbage\s*disposal|disposal|garburator|disposer|food\s*grinder).*(?:install|replace|new|put\s*in)\b/i.test(message) ||
               /\b(?:install|replace|need|want)\s+(?:a\s+)?(?:new\s+)?(?:garbage\s*disposal|disposal|garburator)\b/i.test(message)) {
      entities.problemType = 'garbage_disposal_install';
      entities.fixture = 'garbage_disposal';
    // FIX GD-6c + FIX 2C: Reset button context - disposal is most common
    // Standalone reset button phrases almost always mean garbage disposal:
    //   - "reset button keeps popping" - only disposals have external reset buttons
    //   - "tried the reset button" - water heater reset is internal, rarely discussed
    //   - "reset button won't stay in" - typical disposal symptom
    // ONLY associate with water heater if "water heater", "heater", or "tank" is present
    } else if (/\b(?:reset\s*button|reset).*(?:disposal|garburator)\b/i.test(message) ||
               /\b(?:disposal|garburator).*(?:reset\s*button|reset)\b/i.test(message) ||
               (/\breset\s*button\b/i.test(message) && /\b(?:disposal|garburator|garbage)\b/i.test(message))) {
      entities.problemType = 'garbage_disposal_not_working';
      entities.fixture = 'garbage_disposal';
      entities.triedReset = true;
    // FIX 2C: Standalone reset button phrases (no fixture mentioned) → assume disposal
    } else if (/\breset\s*button\s*(?:keeps?\s+)?(?:popping|tripping|clicking|going)\b/i.test(message) ||
               /\breset\s*button\s*(?:won'?t|doesn'?t|will\s*not)\s*(?:stay|hold|work)\b/i.test(message) ||
               /\b(?:tried|pressed|pushed|hit)\s*(?:the\s+)?reset\s*(?:button)?.*(?:not\s+working|still|nothing|didn'?t\s+(?:work|help))\b/i.test(message)) {
      // Only if NO water heater context
      if (!/\b(?:water\s*heater|heater|tank|hot\s*water)\b/i.test(message)) {
        entities.problemType = 'garbage_disposal_not_working';
        entities.fixture = 'garbage_disposal';
        entities.triedReset = true;
      }
    // FIX GD-6d: Brand + disposal context
    } else if (/\b(?:whirlpool|ge|kenmore|kitchenaid|maytag|moen|waste\s*king|badger).*(?:garbage\s*disposal|disposal|garburator|disposer)\b/i.test(message) ||
               /\b(?:garbage\s*disposal|disposal|garburator|disposer).*(?:whirlpool|ge|kenmore|kitchenaid|maytag|moen|waste\s*king)\b/i.test(message)) {
      // Brand mentioned with disposal - set fixture, let problem detection continue
      entities.fixture = 'garbage_disposal';
      if (!entities.problemType) {
      entities.problemType = 'garbage_disposal';
      }
    // FIX GD-6e: Food grinder as standalone term
    } else if (/\bfood\s*grinder\b/i.test(message)) {
      entities.fixture = 'garbage_disposal';
      if (/\b(?:jam|jammed|stuck)\b/i.test(message)) {
        entities.problemType = 'garbage_disposal_jammed';
      } else if (/\b(?:not\s+working|broken|dead)\b/i.test(message)) {
        entities.problemType = 'garbage_disposal_not_working';
      } else if (/\b(?:leak|leaking)\b/i.test(message)) {
        entities.problemType = 'garbage_disposal_leaking';
      } else {
        entities.problemType = 'garbage_disposal';
      }
    // GUARD: Don't overwrite HIGH-PRIORITY classifications (install, emergency)
    } else if (!entities.problemType && /\b(garbage\s*disposal|disposal|garburator|disposer|insinkerator)\b/i.test(message)) {
      entities.problemType = 'garbage_disposal';
      entities.fixture = 'garbage_disposal';
    }
    
    // FIX 2E: Post-extraction correction for disposal smell
    // If disposal detected but smell words present, upgrade to garbage_disposal_smell
    if (entities.fixture === 'garbage_disposal' && 
        entities.problemType === 'garbage_disposal' &&
        /\b(?:smell|stink|odor|stench|reek|smelly|stinky)\b/i.test(message)) {
      entities.problemType = 'garbage_disposal_smell';
    }
    
    // ================================================================
    // K) WATER SOFTENER PROBLEMS
    // ================================================================
    else if (/\b(?:water\s*softener|softener).*(?:not\s+working|broken|stopped)\b/i.test(message)) {
      entities.problemType = 'water_softener_not_working';
    } else if (/\b(?:water\s*softener|softener).*(?:leak|leaking|drip|water\s+around)\b/i.test(message) ||
               /\b(?:leak|leaking).*(?:water\s*softener|softener)\b/i.test(message)) {
      entities.problemType = 'water_softener_leaking';
    } else if (/\b(?:water\s*softener|softener).*(?:not\s+soft|hard\s+water|no\s+soft)\b/i.test(message) ||
               /\b(?:hard\s+water|water.*hard).*(?:softener)?\b/i.test(message)) {
      entities.problemType = 'water_softener_no_soft_water';
    } else if (/\b(?:water\s*softener|softener).*(?:salt|brine)\b/i.test(message)) {
      entities.problemType = 'water_softener_salt';
    } else if (/\b(?:water\s*softener|softener).*(?:regenerat|cycling|keeps\s+running)\b/i.test(message)) {
      entities.problemType = 'water_softener_regenerating';
    } else if (/\b(?:water\s*softener|softener).*(?:overflow|overflowing)\b/i.test(message)) {
      entities.problemType = 'water_softener_overflow';
    } else if (/\b(?:water\s*softener|softener).*(?:install|new|replace|upgrade|upgrading|quote|first\s*time)\b/i.test(message) ||
               /\b(?:upgrade|quote|first\s*time).*(?:water\s*softener|softener)\b/i.test(message)) {
      entities.problemType = 'water_softener_install';
      entities.isInstall = true;
    } else if (/\b(water\s*softener|softener)\b/i.test(message)) {
      entities.problemType = 'water_softener';
    }
    
    // ================================================================
    // L) SEPTIC SYSTEM PROBLEMS
    // ================================================================
    else if (/\b(?:septic).*(?:backup|backing\s*up|backed\s*up|overflow)\b/i.test(message) ||
             /\b(?:backup|backing).*(?:septic)\b/i.test(message) ||
             /\b(?:sewage).*(?:backup|backing\s*up|backed\s*up)\b/i.test(message)) {
      entities.problemType = 'septic_backup';
    } else if (/\b(?:septic).*(?:full|needs?\s+pump|pump\s*(?:out|it)|pumping)\b/i.test(message) ||
               /\b(?:pump\s*(?:out)?|pumping).*(?:septic)\b/i.test(message) ||
               /\b(?:need|needs)\s+(?:septic|tank)\s+(?:pumped?|pumping)\b/i.test(message)) {
      entities.problemType = 'septic_full';
    } else if (/\b(?:septic|sewage).*(?:smell|odor|stink|stench)\b/i.test(message) ||
               /\b(?:smell|odor|stink|stench).*(?:septic|sewage)\b/i.test(message) ||
               /\b(?:rotten\s*egg|sulfur).*(?:smell|yard|outside|house)\b/i.test(message) ||
               /\b(?:sewage)\s+(?:smell|odor)\s+(?:in|inside|throughout)\b/i.test(message)) {
      entities.problemType = 'septic_smell';
    } else if (/\b(?:septic).*(?:alarm|beeping|alert|going\s*off)\b/i.test(message) ||
               /\b(?:alarm|beeping|alert).*(?:septic)\b/i.test(message)) {
      entities.problemType = 'septic_alarm';
    } else if (/\b(?:septic).*(?:pump|effluent)\b/i.test(message)) {
      entities.problemType = 'septic_pump';
    } else if (/\b(?:septic|drain\s*field|leach\s*field).*(?:drain\s*field|leach|soggy|wet\s+yard|failing|saturated)\b/i.test(message) ||
               /\b(?:wet|soggy|saturated)\s*(?:spot|area|yard|ground)\b/i.test(message) && /\b(?:smell|stink|sewage)\b/i.test(message)) {
      entities.problemType = 'septic_drain_field';
    } else if (/\b(?:septic).*(?:tank|system)\b/i.test(message)) {
      entities.problemType = 'septic_tank_issue';
    // FIX-10: Explicit negation - "sewer problem, not septic" should be sewer
    } else if (/\bsewer\b/i.test(message) && /\bnot\s+septic\b/i.test(message)) {
      entities.problemType = 'sewer';
    } else if (/\b(septic)\b/i.test(message)) {
      entities.problemType = 'septic';
    }
    
    // ================================================================
    // M) GAS LINE PROBLEMS - EMERGENCY DETECTION
    // ================================================================
    else if (/\b(?:smell|smells?)\s*(?:like\s+)?(?:gas|rotten\s+egg)\b/i.test(message) ||
             /\b(?:gas)\s*(?:smell|odor|leak)\b/i.test(message)) {
      entities.problemType = 'gas_smell';
    } else if (/\b(?:gas).*(?:leak|leaking)\b/i.test(message) ||
               /\b(?:leak|leaking).*(?:gas)\b/i.test(message)) {
      entities.problemType = 'gas_leak';
    // Gas line installation - full install verb list
    } else if (/\b(?:gas\s*line).*(?:install|replace|put\s*in|hook\s*up|swap\s*(?:out)?|change\s*(?:out)?|set\s*up|add|run|(?:get|need|want)\s*(?:a\s*)?new|new)\b/i.test(message) ||
               /\b(?:install|replace|put\s*in|hook\s*up|swap|change|set\s*up|add|run).*(?:gas\s*line)\b/i.test(message)) {
      entities.problemType = 'gas_line_install';
    } else if (/\b(?:gas).*(?:stove|range|dryer|water\s*heater|fireplace|bbq|grill).*(?:hookup|connect|install)\b/i.test(message) ||
               /\b(?:hookup|connect|install).*(?:gas).*(?:stove|range|dryer|water\s*heater)\b/i.test(message) ||
               /\b(?:hook\s*up|connect)\s+(?:a\s+)?(?:my\s+)?gas\s+(?:stove|range|dryer|grill|fireplace)\b/i.test(message) ||
               /\bneed\s+(?:a\s+)?(?:my\s+)?gas\s+(?:stove|range|dryer)\s+(?:hooked\s*up|connected|installed)\b/i.test(message) ||
               /\bneed\s+(?:to\s+)?(?:hook\s*up|connect)\s+(?:a\s+)?(?:my\s+)?gas\s+(?:stove|range|dryer)\b/i.test(message)) {
      entities.problemType = 'gas_appliance_hookup';
    } else if (/\b(?:gas).*(?:meter)\b/i.test(message)) {
      entities.problemType = 'gas_meter_issue';
    } else if (/\b(?:gas).*(?:shutoff|shut\s*off|valve)\b/i.test(message)) {
      entities.problemType = 'gas_shutoff';
    // Vague gas work requests
    } else if (/\bneed\s+gas\s+work\b/i.test(message) ||
               /\bgas\s+work\s+(?:done|needed)\b/i.test(message)) {
      entities.problemType = 'gas_line';
    // Pilot light issues - plumber/gas work, NOT HVAC
    // FIX 2: Expanded patterns for "extinguished", "trouble with", "wont light"
    } else if (/\b(?:pilot\s*light).*(?:out|won'?t|can'?t|not|keeps?\s*going|went\s*out|gone\s*out|extinguish|trouble)\b/i.test(message) ||
               /\b(?:pilot).*(?:light|flame).*(?:out|off|won'?t|can'?t|not\s*stay|extinguish)\b/i.test(message) ||
               /\b(?:can'?t|won'?t|unable|having\s+trouble).*(?:light|ignite|relight).*(?:pilot)\b/i.test(message) ||
               /\b(?:relight|re-light).*(?:pilot)\b/i.test(message) ||
               /\b(?:pilot).*(?:relight|re-light|keeps?\s*going\s*out|extinguish|won'?t\s*light|wont\s*light)\b/i.test(message) ||
               /\b(?:trouble|problem|issue)\s+(?:with\s+)?(?:the\s+)?pilot\b/i.test(message) ||
               /\bpilot\s+(?:extinguish|went\s*out|is\s*out|keeps?\s*going)\b/i.test(message) ||
               /\bpilot\s*light\s+extinguished\b/i.test(message) ||
               /\bpilot\s+(?:won'?t|wont|doesn'?t|cant|can'?t)\s+(?:stay\s+)?(?:lit|light|on)\b/i.test(message)) {
      entities.problemType = 'pilot_light_issue';
    } else if (/\b(gas\s*line|gas\s*pipe)\b/i.test(message)) {
      entities.problemType = 'gas_line';
    }
    
    // ================================================================
    // N) BACKFLOW PREVENTER PROBLEMS
    // ================================================================
    // Backflow testing/certification (routine - NOT emergency)
    else if ((/\b(?:backflow).*(?:test|testing|certification|certify|inspection|annual|yearly)\b/i.test(message) ||
             /\b(?:test|testing|certification|inspect).*(?:backflow)\b/i.test(message) ||
             /\b(?:city|county|water\s*company).*(?:backflow|letter|notice|require)\b/i.test(message) ||
             /\b(?:letter|notice).*(?:backflow)\b/i.test(message)) &&
             !/\b(?:install|installation|replace|put\s*in|hook\s*up|set\s*up|add|new)\b/i.test(message)) {
      entities.problemType = 'backflow_test';
      entities.isRoutineService = true; // Flag to prevent emergency trigger
    // Backflow preventer leaking
    } else if (/\b(?:backflow).*(?:leak|leaking|dripping|spraying|puddle|water\s*under)\b/i.test(message) ||
               /\b(?:leak|leaking|dripping|spraying|puddle|water\s*under).*(?:backflow)\b/i.test(message) ||
               /\b(?:green\s*thing|that\s*thing).*(?:sprinkler|irrigation).*(?:leak|spray)\b/i.test(message)) {
      entities.problemType = 'backflow_leak';
    // Backflow preventer failed/broken
    } else if (/\b(?:backflow).*(?:fail|failed|broken|not\s*working)\b/i.test(message) ||
               /\b(?:fail|failed).*(?:backflow)\b/i.test(message)) {
      entities.problemType = 'backflow_failed';
    // Backflow installation/replacement - full install verb list
    } else if (/\b(?:backflow).*(?:install|replace|put\s*in|hook\s*up|swap\s*(?:out)?|change\s*(?:out)?|set\s*up|add|(?:get|need|want)\s*(?:a\s*)?new|new)\b/i.test(message) ||
               /\b(?:install|replace|put\s*in|hook\s*up|swap|change|set\s*up|add).*(?:backflow)\b/i.test(message)) {
      entities.problemType = 'backflow_install';
    // RPZ valve (type of backflow preventer)
    } else if (/\b(?:rpz|reduced\s*pressure\s*zone|double\s*check)\s*(?:valve)?\b/i.test(message)) {
      entities.problemType = 'backflow';
    // Generic backflow mention
    } else if (/\b(?:backflow|back\s*flow)\s*(?:preventer|device|valve)?\b/i.test(message)) {
      entities.problemType = 'backflow';
    }
    
    // ================================================================
    // O) EJECTOR PUMP / SEWAGE PUMP PROBLEMS
    // ================================================================
    // Ejector pump not working / failure
    else if (/\b(?:ejector|sewage|grinder|lift)\s*pump.*(?:not\s*work|won'?t|stopped|broken|failed|dead)\b/i.test(message) ||
             /\b(?:basement|sewage)\s*pump.*(?:not\s*work|won'?t|stopped|broken)\b/i.test(message)) {
      entities.problemType = 'ejector_pump_failure';
    // Ejector pump alarm/alert
    } else if (/\b(?:ejector|sewage|grinder|lift|basement)\s*pump.*(?:alarm|alert|beep|light)\b/i.test(message) ||
               /\b(?:alarm|beeping).*(?:ejector|sewage|pump|pit|basement)\b/i.test(message)) {
      entities.problemType = 'ejector_pump_alarm';
    // Check valve issues (ON PUMP, not toilet)
    } else if (/\b(?:pump|ejector|sewage|pit).*(?:check\s*valve)\b/i.test(message) ||
               /\b(?:check\s*valve).*(?:pump|ejector|sewage|basement|pit)\b/i.test(message)) {
      entities.problemType = 'ejector_pump_check_valve';
    // Float switch issues (ON PUMP)
    } else if (/\b(?:pump|ejector|sewage|sump|pit).*(?:float\s*switch|float)\b/i.test(message) ||
               /\b(?:float\s*switch|float).*(?:pump|ejector|sewage|sump|pit|basement)\b/i.test(message)) {
      entities.problemType = 'ejector_pump_float';
    // Ejector pit issues
    } else if (/\b(?:ejector|sewage|pump)\s*pit\b/i.test(message) ||
               /\b(?:pit).*(?:basement|sewage|smell|overflow|full)\b/i.test(message) ||
               /\b(?:that\s*pit|the\s*pit).*(?:basement|smell)\b/i.test(message)) {
      entities.problemType = 'ejector_pit_issue';
    // Pump running constantly/dry
    } else if (/\b(?:pump).*(?:running\s*dry|won'?t\s*stop|running\s*constant|keeps\s*running)\b/i.test(message) ||
               /\b(?:sewage|ejector|basement).*(?:pump).*(?:running)\b/i.test(message)) {
      entities.problemType = 'ejector_pump_running';
    // Ejector pump smell
    } else if (/\b(?:ejector|sewage\s*pump|grinder\s*pump).*(?:smell|odor|stink)\b/i.test(message)) {
      entities.problemType = 'ejector_pump_smell';
    // Ejector pump overflow
    } else if (/\b(?:ejector|sewage\s*pump|grinder\s*pump).*(?:overflow|overflowing|backing\s*up)\b/i.test(message)) {
      entities.problemType = 'ejector_pump_overflow';
    // Ejector pump noise
    } else if (/\b(?:ejector|sewage\s*pump|grinder\s*pump).*(?:noise|loud|grinding)\b/i.test(message)) {
      entities.problemType = 'ejector_pump_noise';
    // Ejector pump leaking
    } else if (/\b(?:ejector|sewage\s*pump|grinder\s*pump).*(?:leak|leaking)\b/i.test(message)) {
      entities.problemType = 'ejector_pump_leaking';
    // Ejector pump installation - full install verb list
    } else if (/\b(?:install|replace|put\s*in|hook\s*up|swap\s*(?:out)?|change\s*(?:out)?|set\s*up|add|(?:get|need|want)\s*(?:a\s*)?new|new).*(?:ejector|sewage|grinder|lift)\s*pump\b/i.test(message) ||
               /\b(?:ejector|sewage|grinder)\s*pump.*(?:install|replace|put\s*in|hook\s*up|swap|change|set\s*up|add|(?:get|need|want)\s*(?:a\s*)?new|new)\b/i.test(message)) {
      entities.problemType = 'ejector_pump_install';
    // "Ejector pump for basement bathroom" = install (basement bathrooms need ejector pumps installed)
    } else if (/\b(?:ejector|sewage|grinder)\s*pump\s+for\s+(?:basement|new)\s*(?:bathroom|toilet|bath)\b/i.test(message) ||
               /\b(?:pump)\s+for\s+(?:basement\s*bathroom|basement\s*toilet)\b/i.test(message) ||
               /\b(?:need|want|looking\s+for|get)\s+(?:a\s+)?(?:ejector|sewage)\s*pump\s+for\b/i.test(message)) {
      entities.problemType = 'ejector_pump_install';
    // Basement pump (likely ejector)
    } else if (/\b(?:basement).*(?:pump).*(?:toilet|sewage|waste)\b/i.test(message) ||
               /\b(?:pump).*(?:basement\s*toilet|basement\s*bathroom)\b/i.test(message)) {
      // Only set to repair if there's a problem indicator
      const hasRepairIndicator = /\b(?:not\s*working|broken|failed|stopped|issue|problem|noise|smell|alarm|overflow|backing\s*up)\b/i.test(message);
      entities.problemType = hasRepairIndicator ? 'ejector_pump' : 'ejector_pump_install';
    // Generic ejector/sewage pump mention
    } else if (/\b(?:ejector\s*pump|sewage\s*pump|grinder\s*pump|lift\s*pump|lift\s*station|sewage\s*ejector)\b/i.test(message)) {
      entities.problemType = 'ejector_pump';
    }
    
    // ================================================================
    // P) ADDITIONAL LEAK SUBTYPES
    // ================================================================
    else if (/\b(?:slab).*(?:leak)\b/i.test(message) || /\b(?:leak).*(?:slab|under.*floor|under.*concrete)\b/i.test(message)) {
      entities.problemType = 'leak_slab';
    } else if (/\b(?:foundation).*(?:leak|water)\b/i.test(message) || /\b(?:leak|water).*(?:foundation)\b/i.test(message)) {
      entities.problemType = 'leak_foundation';
    } else if (/\b(?:supply\s*line).*(?:leak)\b/i.test(message) || /\b(?:leak).*(?:supply\s*line)\b/i.test(message)) {
      entities.problemType = 'leak_supply_line';
    } else if (/\b(?:drain\s*line).*(?:leak)\b/i.test(message) || /\b(?:leak).*(?:drain\s*line)\b/i.test(message)) {
      entities.problemType = 'leak_drain_line';
    } else if (/\b(?:hidden).*(?:leak)\b/i.test(message) || /\b(?:leak).*(?:hidden|can'?t\s+find|somewhere)\b/i.test(message)) {
      entities.problemType = 'leak_hidden';
    } else if (/\b(?:crawl\s*space|crawlspace).*(?:leak|water)\b/i.test(message)) {
      entities.problemType = 'leak_crawlspace';
    } else if (/\b(?:attic).*(?:leak|water|pipe)\b/i.test(message)) {
      entities.problemType = 'leak_attic';
    }
    
    // ================================================================
    // Q) ADDITIONAL SINK/SHOWER/BATH VARIATIONS
    // ================================================================
    // NOTE: sink_kitchen/bathroom/utility are LOCATION REFINEMENTS, not problems
    // They should NOT overwrite actual problem types like sink_clogged
    else if (!entities.problemType && /\b(?:kitchen\s*sink)\b/i.test(message)) {
      entities.problemType = 'sink_kitchen';
      entities.problemTypeSourceHint = 'location_refinement';
      entities.fixture = 'sink';
    } else if (!entities.problemType && /\b(?:bathroom\s*sink)\b/i.test(message)) {
      entities.problemType = 'sink_bathroom';
      entities.problemTypeSourceHint = 'location_refinement';
      entities.fixture = 'sink';
    } else if (!entities.problemType && /\b(?:utility\s*sink|laundry\s*sink|slop\s*sink)\b/i.test(message)) {
      entities.problemType = 'sink_utility';
      entities.problemTypeSourceHint = 'location_refinement';
      entities.fixture = 'sink';
    } else if (/\b(?:sink).*(?:sprayer|spray\s*hose)\b/i.test(message) || /\b(?:sprayer).*(?:sink)\b/i.test(message)) {
      entities.problemType = 'sink_sprayer_broken';
    } else if (/\b(?:tub|bathtub).*(?:faucet).*(?:leak)\b/i.test(message)) {
      entities.problemType = 'bathtub_faucet_leak';
    } else if (/\b(?:tub|bathtub).*(?:stopper|plug|drain\s*stopper)\b/i.test(message)) {
      entities.problemType = 'bathtub_stopper';
    } else if (/\b(?:shower\s*pan|shower\s*base|shower\s*floor).*(?:leak)\b/i.test(message)) {
      entities.problemType = 'shower_pan_leak';
    } else if (/\b(?:shower\s*door).*(?:leak)\b/i.test(message)) {
      entities.problemType = 'shower_door_leak';
    } else if (/\b(?:jacuzzi|jetted\s*tub|whirlpool|hot\s*tub|spa).*(?:jet|jets)\b/i.test(message)) {
      entities.problemType = 'jacuzzi_jets';
    } else if (/\b(?:jacuzzi|jetted\s*tub|whirlpool|hot\s*tub|spa).*(?:pump)\b/i.test(message)) {
      entities.problemType = 'jacuzzi_pump';
    } else if (/\b(?:jacuzzi|jetted\s*tub|whirlpool|hot\s*tub|spa).*(?:leak)\b/i.test(message)) {
      entities.problemType = 'jacuzzi_leak';
    } else if (/\b(jacuzzi|jetted\s*tub|whirlpool|hot\s*tub|spa)\b/i.test(message)) {
      entities.problemType = 'jacuzzi';
    }
    
    // ================================================================
    // GENERIC FALLBACKS (if no specific match above)
    // ================================================================
    // FIX D: Add guards to prevent overwriting specific classifications (e.g., sewer_backup -> drain)
    else if (!entities.problemType && /\b(drain|drayn|drane|drian|drains|dran|draine|drian|dain|drein|clog|clogs|clogd|cloged|clogg|clogge|cloged|clooged|backup|backp|bckup|bakup|backupp)\b/i.test(message)) {
      entities.problemType = 'drain';
    }
    // === FAUCET NOISE / WHISTLING (HIGH CONFIDENCE REPAIR) ===
    else if (/\b(?:faucet|tap).*(?:whistl|squeal|screech|whine|hum|humming|noise|noisy|loud|sound)\b/i.test(message) ||
             /\b(?:whistl|squeal|screech|whine|hum|humming|noise).*(?:faucet|tap)\b/i.test(message) ||
             /\b(?:faucet|tap)\s+(?:is\s+)?(?:making|makes)\s+(?:a\s+)?(?:whistl|squeal|screech|whine|hum|noise|sound)\b/i.test(message)) {
      entities.problemType = 'faucet_whistling';
      entities.fixture = 'faucet';
      entities.highConfidenceDetection = true;
    }
    // === FAUCET SPRAYING ===
    else if (/\b(?:faucet|tap)\s+(?:is\s+)?(?:spraying|sputtering|spurting)\b/i.test(message) ||
             /\b(?:water\s+)?(?:spraying|sputtering).*(?:from\s+)?(?:the\s+)?(?:faucet|tap)\b/i.test(message) ||
             /\b(?:spray|spraying)\s+(?:everywhere|all\s+over).*(?:faucet|tap)\b/i.test(message)) {
      entities.problemType = 'faucet_spraying';
      entities.fixture = 'faucet';
    }
    // FAUCET DRIPPING: Specific pattern BEFORE generic leak (faucet + drip in any order)
    else if (!entities.problemType && (/\b(?:faucet|tap).*(?:drips?|dripping)\s*(?:constantly|all\s+the\s+time|non-?stop|continuously|keeps?\s+dripping)\b/i.test(message) ||
             /\b(?:drips?|dripping)\s*(?:constantly|all\s+the\s+time|non-?stop|continuously).*(?:faucet|tap)\b/i.test(message) ||
             /\b(?:kitchen|bathroom)\s+(?:faucet|tap).*(?:drips?|dripping)\b/i.test(message) ||
             /\b(?:faucet|tap|spout).*(?:drip|dripping)\b/i.test(message) ||
             /\b(?:drip|dripping).*(?:faucet|tap|spout)\b/i.test(message))) {
      entities.problemType = 'faucet_dripping';
      entities.fixture = 'faucet';
    }
    else if (!entities.problemType && /\b(leak|leek|leac|leaking|leeking|leakin|leeking|leek|liek|laek|leack|leaak|drip|dripp|dripping|drippin|driping|drippng|water damage|water damge|waterdamage|wate damage)\b/i.test(message)) {
      entities.problemType = 'leak';
    }
    // GUARD: Don't overwrite HIGH-PRIORITY classifications (install, emergency)
    else if (!entities.problemType && /\b(faucet|fawcet|fosset|fauct|faucett|fawset|faucit|fawcit|facet|faucett|fawcett|tap|tapp|taps|taap|spout|spowt|spout|spout)\b/i.test(message)) {
      entities.problemType = 'faucet';
    }

    // ================================================================
    // FIX I: EMERGENCY AUTO-FLAG
    // Certain problem types should ALWAYS trigger emergency mode
    // ================================================================
    if (entities.problemType && !entities.isEmergency) {
      const emergencyProblemTypes = [
        'gas_smell', 'gas_leak',
        'pipe_burst', 'flooding',
        'water_heater_burst',
        'septic_alarm', 'septic_backup',
        'ejector_pump_alarm',
        'sewer_backup'
      ];
      
      if (emergencyProblemTypes.includes(entities.problemType)) {
        entities.isEmergency = true;
      }
      
      // Also check for severity modifiers in message that upgrade to emergency
      const severityUpgrade = /\b(?:badly|heavily|a\s+lot|everywhere|gushing|pouring|massive|major|serious|urgent|emergency)\b/i.test(message);
      const leakingTypes = ['water_heater_leaking', 'pipe_leaking', 'leak'];
      
      if (severityUpgrade && leakingTypes.includes(entities.problemType)) {
        entities.isEmergency = true;
      }
      
      // Alarm types should always be emergency
      if (entities.problemType.includes('_alarm')) {
        entities.isEmergency = true;
      }
    }

    // ================================================================
    // FIX J: INSTALL AUTO-FLAG
    // If message contains install keywords but isInstall not set, set it
    // ================================================================
    if (!entities.isInstall) {
      // Comprehensive install keyword detection (handles installed, installation, instll typos)
      const installKeywords = /\b(?:install(?:ed|ing|ation|s)?|instl+|instal+|hookup|hook\s*up|hooked\s*up|put\s*in|replace(?:ment)?|replac(?:ed|ing)?|swap(?:ped|ping)?(?:\s*out)?|new\s+(?:toilet|sink|faucet|shower|water\s*heater|disposal|dishwasher|tub|bathtub))\b/i;
      
      // Exclude repair context - these words indicate repair, not install
      const repairContext = /\b(?:not\s+working|broken|leak(?:ing)?|clog(?:ged)?|backed?\s*up|running|overflow|won'?t\s+(?:flush|drain|turn)|drip(?:ping)?|stuck|noise|smell|problem|issue|fix|repair)\b/i;
      
      if (installKeywords.test(message) && !repairContext.test(message)) {
        entities.isInstall = true;
      }
      
      // Also set isInstall for specific install problem types that might have been set
      const installProblemTypes = [
        'toilet_install', 'sink_install', 'faucet_install', 'shower_install',
        'bathtub_install', 'water_heater_install', 'garbage_disposal_install',
        'dishwasher_install', 'washer_install', 'water_softener_install',
        'gas_line_install', 'backflow_install', 'generic_install',
        'ice_maker_line_install', 'fridge_water_line'
      ];
      
      if (entities.problemType && installProblemTypes.includes(entities.problemType)) {
        entities.isInstall = true;
      }
    }

    // ================================================================
    // FIX N: NULL HANDLER PATTERNS
    // Catch common phrases that weren't matched by specific patterns
    // ================================================================
    
    // "no water" by itself (very short/casual)
    if (!entities.problemType && /^(?:hi[,.]?\s*)?(?:i\s+have\s+)?no\s+water\.?$/i.test(message.trim())) {
      entities.problemType = 'no_water_house';
    }
    
    // Gas plumber request
    if (!entities.problemType && /\b(?:need|looking\s+for|want)\s+(?:a\s+)?gas\s+plumber\b/i.test(message)) {
      entities.problemType = 'gas_line';
    }
    
    // Water sputtering/spitting from faucets
    if (!entities.problemType && /\b(?:water|faucet)\s*(?:sputters?|spits?|spurts?|splatters?)\b/i.test(message)) {
      entities.problemType = 'air_in_lines';
    }
    
    // Pressure dropped/fell suddenly
    if (!entities.problemType && /\b(?:pressure|water)\s+(?:suddenly\s+)?(?:dropped|fell|decreased|went\s+down)\b/i.test(message)) {
      entities.problemType = 'low_pressure_house';
    }
    
    // Sewer connection to street
    if (!entities.problemType && /\bsewer\s+(?:connection|line|pipe)\s+(?:to|at)\s+(?:the\s+)?street\b/i.test(message)) {
      entities.problemType = 'sewer';
    }

    return entities;
  }

  // Get safety guidance for a problem type (returns null if not needed or already given)
  function getSafetyGuidanceIfNeeded(problemType, booking) {
    // Don't give safety guidance for emergencies (they have their own protocol)
    if (booking.isEmergency) return null;
    
    // Don't repeat safety guidance
    if (booking.safetyGuidanceGiven) return null;
    
    // Try specific problem type first
    let guidance = SAFETY_GUIDANCE.getGuidance(problemType);
    
    // If no specific guidance, try category fallback for risky situations
    if (!guidance) {
      guidance = SAFETY_GUIDANCE.getCategoryGuidance(problemType);
    }
    
    return guidance;
  }

  function getBookingData(customerKey) {
    if (!bookingData.has(customerKey)) {
      bookingData.set(customerKey, {
        problemType: null,
        problemTypeSource: null,
        name: null,
        address: null,
        city: null,
        timePreference: null,
        phone: null,
        unit: null,
        urgencyLevel: 'normal',
        stage: 'initial',
        diagnosticHistory: [],
        diagnosticQuestionsAsked: [],  // FIX 5: Track which diagnostic questions have been asked
        diagnosticSlots: {},
        slotsAsked: {},        // MAX-ONE-ASK: Track which slots have been asked
        slotsLocked: {},       // SLOT LOCKING: Track which slots are permanently locked
        refinementLocked: false,
        awaitingConfirmation: false,
        isEmergency: false,
        isInstall: false,
        emergencyType: null,
        emergencyStage: null,
        emergencyModeActive: false,  // STICKY LATCH: Once true, stays true until booking
        emergencyEvaluated: false,   // ONE-TIME GATE: Once true, emergency logic never re-runs
        emergencySafetyDelivered: false,  // DE-DUPE: Once true, safety message never repeats
        safetyGuidanceGiven: false,
        diagnosticAiFailures: 0,
        nonAnswerCount: 0,
        installIntentLocked: false,  // INSTALL LATCH: Once true, install intent stays active
        installFlow: null,           // Install flow state object
        awaitingCancellationConfirm: false,  // SOFT CANCEL: Waiting for user to confirm cancellation
        applianceTypeUncertainCount: 0,  // WATER HEATER FIX 1: Track uncertainty about gas/electric
        temperatureStabilizationAsked: false,  // WATER HEATER FIX 3: Track if temp stabilization question asked
        lastResponseWasOpener: false,  // FIX A: Track if last response was the opener to prevent loops
        openerFallbackCount: 0,  // FALLBACK LOOP PREVENTION: Track consecutive opener responses
        tradeClarified: false,  // TRADE GATE: Asked once about electrical vs plumbing
        outsideScope: false,  // TERMINAL STATE: Conversation ended (e.g. electrician redirect)
        outOfAreaMessageShown: false,  // SERVICE AREA: Track out-of-area message to prevent loops
        cantShutoffGuidanceGiven: false,  // CANT_SHUTOFF: Urgent guidance delivered once
        cantShutoffResolved: false,  // CANT_SHUTOFF: Resolved/false alarm - terminal state
        urgencyClarificationAsked: false,  // URGENCY-ONLY: Asked what the problem is
        urgencyExpressed: false,  // URGENCY-ONLY: Customer said it's urgent/emergency
        uncertainEmergencyClarified: false,  // UNCERTAIN EMERGENCY: Asked clarifying question
        singleWordEmergencyClarified: false,  // SINGLE WORD: Asked clarifying question for "smoke", "flood", etc.
        binaryQuestionAsked: false,  // FALLBACK: Asked emergency/repair binary question
        emergencyBookingStarted: false,  // BUG 3 FIX: Tracks if we've started booking after emergency safety
        vagueUrgencyClarified: false,  // BUG D FIX: Asked clarification for "something is wrong"
        changePromptSent: false,  // CONFIRMATION LOOP FIX: Track if "what would you like to change?" was sent
        singleWordClarified: false,  // BUG E FIX: Asked clarification for single word like "leak"
        aiClassificationAttempted: false,  // AI CLASSIFICATION: Track if AI fallback was attempted this turn
        aiEarlyNormalizationDone: false,  // EARLY AI: Track if first-message normalization was attempted
        aiAgentUsedThisTurn: false,       // AI AGENT: Track if AI agent was used this turn (reset each message)
        lastConfidenceResult: null        // CONFIDENCE: Store last confidence scoring result for debugging
      });
    }
    return bookingData.get(customerKey);
  }

  function updateBookingData(customerKey, updates) {
    const current = getBookingData(customerKey);
    const updated = { ...current };
    
    // FIX L: Track last message for install intent detection
    if (updates.lastMessage) {
      updated.lastMessage = updates.lastMessage;
    }
    
    let didUpdateProblemType = false;
    
    if (updates.problemType) {
      // LOCK DURING BOOKING: Don't change problem type during booking stages
      const inBookingStage = updated.stage === 'booking_details' || updated.stage === 'awaiting_confirmation';
      if (inBookingStage && updated.problemType) {
        // Locked - skip problemType update during booking
      } else if (updates.problemTypeSource) {
        // Use authority system if source is provided
        didUpdateProblemType = setProblemTypeIfAllowed(updated, updates.problemType, updates.problemTypeSource);
      } else if (!updated.problemTypeSource || updated.problemTypeSource === 'initial' || updated.problemTypeSource === 'generic_pattern') {
        updated.problemType = updates.problemType;
        didUpdateProblemType = true;
      }
    }
    if (updates.problemTypeSource && didUpdateProblemType) {
      updated.problemTypeSource = updates.problemTypeSource;
    }
    
    if (updates.name) {
      if (!current.name || updates.name.length > current.name.length) {
        updated.name = updates.name;
      }
    }
    
    if (updates.address) {
      if (!current.address || updates.address.length > current.address.length) {
        updated.address = updates.address;
      }
    }
    
    if (updates.city) updated.city = updates.city;
    if (updates.timePreference) updated.timePreference = updates.timePreference;
    if (updates.fixture) updated.fixture = updates.fixture;
    if (updates.phone) updated.phone = updates.phone;
    if (updates.unit) updated.unit = updates.unit;
    if (updates.diagnosticHistory) updated.diagnosticHistory = updates.diagnosticHistory;
    if (updates.diagnosticSlots) updated.diagnosticSlots = updates.diagnosticSlots;
    if (updates.slotsAsked) updated.slotsAsked = updates.slotsAsked;
    if (updates.slotsLocked) updated.slotsLocked = updates.slotsLocked;
    if (updates.refinementLocked !== undefined) updated.refinementLocked = updates.refinementLocked;
    if (updates.awaitingConfirmation !== undefined) updated.awaitingConfirmation = updates.awaitingConfirmation;
    if (updates.isEmergency !== undefined) updated.isEmergency = updates.isEmergency;
    if (updates.emergencyType) updated.emergencyType = updates.emergencyType;
    if (updates.emergencyStage) updated.emergencyStage = updates.emergencyStage;
    // CRITICAL: Copy emergency flags that control flow
    if (updates.emergencyModeActive !== undefined) updated.emergencyModeActive = updates.emergencyModeActive;
    if (updates.emergencySafetyDelivered !== undefined) updated.emergencySafetyDelivered = updates.emergencySafetyDelivered;
    if (updates.emergencyEvaluated !== undefined) updated.emergencyEvaluated = updates.emergencyEvaluated;
    if (updates.emergencyBookingStarted !== undefined) updated.emergencyBookingStarted = updates.emergencyBookingStarted;
    if (updates.safetyGuidanceGiven !== undefined) updated.safetyGuidanceGiven = updates.safetyGuidanceGiven;
    if (updates.urgencyLevel) updated.urgencyLevel = updates.urgencyLevel;
    if (updates.diagnosticAiFailures !== undefined) updated.diagnosticAiFailures = updates.diagnosticAiFailures;
    if (updates.nonAnswerCount !== undefined) updated.nonAnswerCount = updates.nonAnswerCount;
    
    if (updated.problemType && updated.name && updated.address && updated.city && updated.timePreference) {
      // If all required fields present and not awaiting confirmation, set to awaiting
      // BUT NOT if booking is already confirmed (prevents re-triggering after confirmation)
      if (!updated.awaitingConfirmation && updated.stage !== 'confirmed' && !updated.bookingConfirmed) {
        updated.stage = 'awaiting_confirmation';
        updated.awaitingConfirmation = true;
      }
    } else if (updates.stage) {
      updated.stage = updates.stage;
    } else if (updated.problemType && current.stage === 'initial') {
      updated.stage = 'problem_diagnosis';
    }
    
    // ================================================================
    // FIX I-2: EMERGENCY AUTO-FLAG (FINAL CHECK)
    // Certain problem types MUST be emergencies regardless of AI triage
    // This runs AFTER all updates are applied to ensure it's not overwritten
    // ================================================================
    if (updated.problemType) {
      const emergencyProblemTypes = [
        'gas_smell', 'gas_leak',
        'pipe_burst', 'flooding',
        'water_heater_burst', 'water_heater_leak_tpr',
        'septic_alarm', 'septic_backup',
        'ejector_pump_alarm', 'ejector_pump_overflow',
        'sewer_backup'
      ];
      
      if (emergencyProblemTypes.includes(updated.problemType)) {
        updated.isEmergency = true;
      }
      
      // Any _alarm problem type is emergency
      if (updated.problemType.includes('_alarm')) {
        updated.isEmergency = true;
      }
    }
    
    // ================================================================
    // FIX J-2 + L: INSTALL AUTO-FLAG (FINAL CHECK)
    // Certain problem types are installs regardless of how they were classified
    // ================================================================
    if (updated.problemType && !updated.isInstall) {
      const installProblemTypes = [
        'toilet_install', 'sink_install', 'faucet_install', 'shower_install',
        'bathtub_install', 'water_heater_install', 'garbage_disposal_install',
        'dishwasher_install', 'washer_install', 'water_softener_install',
        'gas_line_install', 'backflow_install', 'generic_install',
        'ice_maker_line_install', 'fridge_water_line', 'remodel_plumbing',
        'sewage_pump_install', 'shutoff_valve_install', 'install_generic_install',
        'hose_bib_install', 'drain_install', 'ejector_pump_install',
        'prv_install', 'expansion_tank_install'
      ];
      
      if (installProblemTypes.includes(updated.problemType)) {
        updated.isInstall = true;
      }
      
      // Any problem type ending in _install is an install
      if (updated.problemType.endsWith('_install')) {
        updated.isInstall = true;
      }
      
      // FIX L: Detect install intent from lastMessage if available
      // This catches cases like "Install water softener" → water_softener (should be install)
      if (!updated.isInstall && updated.lastMessage) {
        const msg = updated.lastMessage;
        const installKeywords = /\b(?:install(?:ed|ing|ation|s)?|hook\s*up|put\s*in|set\s*up|need\s+(?:a\s+)?new)\b/i;
        const repairContext = /\b(?:not\s+working|broken|leak(?:ing)?|clog(?:ged)?|backed?\s*up|running|overflow|won'?t\s+(?:flush|drain|turn|work)|drip(?:ping)?|stuck|noise|smell|problem|issue|fix|repair|replace)\b/i;
        
        if (installKeywords.test(msg) && !repairContext.test(msg)) {
          updated.isInstall = true;
        }
      }
    }
    
    bookingData.set(customerKey, updated);
    return updated;
  }
  
  // Reset booking for restart
  function resetBooking(customerKey) {
    bookingData.set(customerKey, {
      problemType: null,
      problemTypeSource: null,
      name: null,
      address: null,
      city: null,
      timePreference: null,
      phone: null,
      unit: null,
      urgencyLevel: 'normal',
      stage: 'initial',
      diagnosticHistory: [],
      diagnosticSlots: {},
      slotsAsked: {},
      slotsLocked: {},
      refinementLocked: false,
      awaitingConfirmation: false,
      isEmergency: false,
      emergencyType: null,
      emergencyStage: null,
      emergencyEvaluated: false,
      emergencySafetyDelivered: false,
      safetyGuidanceGiven: false,
      diagnosticAiFailures: 0,
      nonAnswerCount: 0
    });
    return bookingData.get(customerKey);
  }

  function buildMultiIntentResponse(intent, booking, context) {
    if (!intent.isMultiIntent) {
      const responseTemplate = selectResponseTemplate(intent, booking, context);
      return RESPONSE_TEMPLATES[responseTemplate.template](...responseTemplate.params);
    }
    
    const responses = [];
    const businessName = context.businessName || CONFIG.DEFAULT_BUSINESS_NAME;
    const plumberName = context.plumberName || CONFIG.DEFAULT_PLUMBER_NAME;
    const serviceAreas = SERVICE_AREAS.get(context);
    
    const problemIntent = intent.allIntents.find(i => i.intent === 'problem_description');
    if (problemIntent && booking.problemType) {
      responses.push(`Got it, ${getProblemDescription(booking.problemType)}.`);
    }
    
    for (const singleIntent of intent.allIntents) {
      if (singleIntent.intent === 'authentication_question') {
        const authCount = getAuthenticationCount(context.customerKey);
        if (authCount === 0) {
          responses.push("I handle missed calls and scheduling, and a real plumber will be there for the work.");
        } else if (authCount === 1) {
          responses.push("Yes, I'm an AI that handles missed calls, but a real licensed plumber will come out for the actual work.");
        } else {
          responses.push("Yes, I'm an AI-I've already explained that.");
        }
      } else if (singleIntent.intent === 'company_question') {
        responses.push(`This is ${businessName}.`);
      } else if (singleIntent.intent === 'real_plumber_question') {
        responses.push("I handle missed calls and scheduling, and a real licensed plumber will be there for the actual work.");
      } else if (singleIntent.intent === 'service_area_question') {
        responses.push(`We service ${serviceAreas}.`);
      } else if (singleIntent.intent === 'availability_now_question') {
        responses.push("We're available.");
      } else if (singleIntent.intent === 'price_question') {
        responses.push("Pricing depends on the job - we'll give you a quote on-site.");
      }
    }
    
    // At initial stage, after answering questions, ask for plumbing issue
    if (booking.stage === 'initial' && !problemIntent) {
      responses.push("What's your plumbing issue?");
    }
    
    if (booking.stage === 'booking_details') {
      const missing = [];
      if (!booking.name) missing.push('full name');
      if (!booking.address) missing.push('address');
      if (!booking.city) missing.push('city');
      if (!booking.timePreference) missing.push('best time');
      
      if (missing.length > 0) {
        if (missing.length === 1) {
          responses.push(`Please provide your ${missing[0]}.`);
        } else if (missing.length === 2) {
          responses.push(`Please provide your ${missing[0]} and ${missing[1]}.`);
        } else if (missing.length === 3) {
          responses.push(`Please provide your ${missing[0]}, ${missing[1]} and ${missing[2]}.`);
        } else {
          responses.push(`Please provide your ${missing.slice(0, -1).join(', ')} and ${missing[missing.length - 1]}.`);
        }
      }
    }
    
    return responses.join(' ');
  }
  
  function getAuthenticationCount(customerKey) {
    return authenticationCounts.get(customerKey) || 0;
  }

  function selectResponseTemplate(intent, booking, context) {
    const plumberName = context.plumberName || CONFIG.DEFAULT_PLUMBER_NAME;
    const businessName = context.businessName || CONFIG.DEFAULT_BUSINESS_NAME;
    const message = context.customerMessage || '';
    const entities = context.entities || {};

    // PRIORITY: Handle questions FIRST, even if customer hasn't been introduced yet
    // This prevents re-introduction when they ask "are you a real plumber?"
    
    if (intent.intent === 'authentication_question') {
      // Mark as introduced if first interaction
      if (!hasBeenIntroduced(context.customerKey)) {
        markAsIntroduced(context.customerKey);
      }
      const authCount = incrementAuthenticationCount(context.customerKey);
      
      if (booking.stage === 'booking_details' || booking.stage === 'problem_diagnosis') {
        const missing = [];
        if (!booking.name) missing.push('full name');
        if (!booking.address) missing.push('address');
        if (!booking.city) missing.push('city');
        if (!booking.timePreference) missing.push('best time');
        
        return { template: 'authDuringBooking', params: [authCount, missing] };
      }
      
      if (authCount === 1) return { template: 'authFirst', params: [] };
      if (authCount === 2) return { template: 'authSecond', params: [] };
      return { template: 'authThird', params: [] };
    }
    
    if (intent.intent === 'real_plumber_question') {
      // Mark as introduced if first interaction
      if (!hasBeenIntroduced(context.customerKey)) {
        markAsIntroduced(context.customerKey);
      }
      
      if (booking.stage === 'booking_details' || booking.stage === 'problem_diagnosis') {
        const missing = [];
        if (!booking.name) missing.push('full name');
        if (!booking.address) missing.push('address');
        if (!booking.city) missing.push('city');
        if (!booking.timePreference) missing.push('best time');
        
        return { template: 'realPlumberDuringBooking', params: [missing] };
      }
      
      // At initial stage - always ask for plumbing issue
      return { template: 'realPlumberInitial', params: [] };
    }
    
    if (intent.intent === 'company_question') {
      // Mark as introduced if first interaction
      if (!hasBeenIntroduced(context.customerKey)) {
        markAsIntroduced(context.customerKey);
      }
      
      const missing = [];
      if (!booking.name) missing.push('full name');
      if (!booking.address) missing.push('address');
      if (!booking.city) missing.push('city');
      if (!booking.timePreference) missing.push('best time');
      
      return { template: 'company', params: [businessName, booking.stage, missing] };
    }
    
    if (intent.intent === 'service_area_question') {
      // Mark as introduced if first interaction
      if (!hasBeenIntroduced(context.customerKey)) {
        markAsIntroduced(context.customerKey);
      }
      // During booking, treat as city providing + service area answer
      const knownCities = /\b(toronto|mississauga|brampton|oakville|vaughan|hamilton|burlington|markham|richmond|scarborough|etobicoke|north\s*york|ajax|whitby|oshawa|barrie|guelph|kitchener|waterloo|cambridge|london|windsor|ottawa)\b/i;
      const cityMatch = message.match(knownCities);
      
      // Also try to extract any capitalized word as potential city (for out-of-area cities)
      const potentialCityMatch = message.match(/\b([A-Z][a-z]+(?:\s+[A-Z][a-z]+)?)\b/);
      
      const serviceAreas = SERVICE_AREAS.get(context);
      const serviceAreaList = serviceAreas.toLowerCase().split(',').map(s => s.trim());
      
      if (booking.stage === 'booking_details' || booking.stage === 'awaiting_confirmation') {
        if (cityMatch) {
          booking.city = cityMatch[1];
          // Track if city is outside service area
          const cityLower = cityMatch[1].toLowerCase();
          if (!serviceAreaList.some(area => cityLower.includes(area) || area.includes(cityLower))) {
            booking.outOfAreaCity = cityMatch[1];
          }
        } else if (potentialCityMatch && !booking.city) {
          // Accept potential city names that aren't in our known list
          const potentialCity = potentialCityMatch[1];
          // Exclude common non-city words
          if (!/\b(john|mike|lisa|sarah|bob|dave|tom|jim|joe|bill|name|help|yes|no|ok|sure|thanks|hi|hello)\b/i.test(potentialCity.toLowerCase())) {
            booking.city = potentialCity;
            booking.outOfAreaCity = potentialCity; // Mark as out-of-area for template handling
          }
        }
      }
      
      const missing = [];
      if (!booking.name) missing.push('full name');
      if (!booking.address) missing.push('address');
      if (!booking.city) missing.push('city');
      if (!booking.timePreference) missing.push('best time');
      
      // FIX: Track if we've already shown the out-of-area message to prevent loops
      const alreadyShownOutOfArea = booking.outOfAreaMessageShown || false;
      if (booking.outOfAreaCity && !alreadyShownOutOfArea) {
        booking.outOfAreaMessageShown = true;
      }
      // Pass out-of-area city to template for graceful handling
      return { template: 'serviceArea', params: [serviceAreas, booking.stage, missing, booking.outOfAreaCity || null, alreadyShownOutOfArea] };
    }
    
    if (intent.intent === 'availability_now_question') {
      // Mark as introduced if first interaction
      if (!hasBeenIntroduced(context.customerKey)) {
        markAsIntroduced(context.customerKey);
      }
      
      const missing = [];
      if (!booking.name) missing.push('full name');
      if (!booking.address) missing.push('address');
      if (!booking.city) missing.push('city');
      if (!booking.timePreference) missing.push('best time');
      
      return { template: 'availabilityNow', params: [booking.stage, missing] };
    }
    
    if (intent.intent === 'price_question') {
      // Mark as introduced if first interaction
      if (!hasBeenIntroduced(context.customerKey)) {
        markAsIntroduced(context.customerKey);
      }
      
      const missing = [];
      if (!booking.name) missing.push('full name');
      if (!booking.address) missing.push('address');
      if (!booking.city) missing.push('city');
      if (!booking.timePreference) missing.push('best time');
      
      return { template: 'priceQuestion', params: [booking.stage, missing] };
    }
    
    // ================================================================
    // INSTALLATION INTENT HANDLER
    // Routes directly to install flow, bypassing all repair/diagnostic logic
    // ================================================================
    if (intent.intent === 'installation') {
      // Mark as introduced if first interaction
      if (!hasBeenIntroduced(context.customerKey)) {
        markAsIntroduced(context.customerKey);
      }
      
      // Return special template that signals installation flow
      return { template: 'installation', params: [message] };
    }
    // ================================================================
    
    // NOW check for greeting or introduction (only AFTER handling all questions)
    if (intent.intent === 'greeting') {
      if (!hasBeenIntroduced(context.customerKey) && booking.stage === 'initial') {
        markAsIntroduced(context.customerKey);
        return { template: 'introduction', params: [businessName, plumberName] };
      }
      
      // BOOKING STAGE PASSTHROUGH: If we're in booking stages, don't use diagnostic guards.
      // Just fall through to the stage-based template selection below.
      const isInBookingStage = booking.stage === 'booking_details' || booking.stage === 'awaiting_confirmation' || booking.stage === 'confirmed';
      if (!isInBookingStage) {
      // CANT_SHUTOFF RESOLVED TERMINAL: Never fall back if shutoff was resolved
      if (booking.cantShutoffResolved) {
        return { template: 'booking_request', params: [] };
      }
      // INVARIANT 1: WATER HEATER INTENT IS STICKY (STATE-BASED)
      // If waterHeaterIntentLocked flag is set, NEVER return opener
      if (booking.waterHeaterIntentLocked) {
        return { template: 'problem_description', params: [] }; // Continue diagnostic flow
      }
      // WATER HEATER FIX 2: HARD INVARIANT - Never reset if diagnostics have started
      // Once problemType is set OR diagnosticHistory has exchanges, never return needProblem
      const hasDiagnosticsStarted = booking.problemType || (booking.diagnosticHistory && booking.diagnosticHistory.length > 0);
      if (hasDiagnosticsStarted) {
        return { template: 'problem_description', params: [] }; // Continue diagnostic flow
      }
      // LOCK FIX A: HARD WATER HEATER INTENT LOCK - detect and lock from current message
      const hasWaterHeaterContext = /\b(water\s*heater|hot\s*water\s*tank|no\s+hot\s+water|not\s+hot|scalding|too\s+hot|heater.*leak|pilot\s+light|tankless|water\s+(?:isn'?t|not)\s+heating|barely\s+warm|temp.*(?:changing|spiking)|worse\s+when\s+multiple\s+showers|tank\s+thing|heating\s+right|lukewarm|only\s+(?:getting\s+)?(?:warm|tepid))\b/i.test(message);
      if (hasWaterHeaterContext) {
        return { template: 'problem_description', params: [] }; // Continue diagnostic flow
      }
      // PIPE FIX 3: Don't reset to "What can I help you with?" if message contains pipe keywords
      const hasPipeContext = /\b(pipe|leaking|dripping|wet\s*wall|ceiling\s*leak|water\s*in\s*basement|burst|frozen\s*pipe|spraying)\b/i.test(message);
      if (hasPipeContext) {
        return { template: 'problem_description', params: [] }; // Continue diagnostic flow
      }
        // FIXTURE FIX: Don't reset to "What can I help you with?" if message contains ANY fixture keywords
        const hasFixtureContext = /\b(toilet|tolet|toylet|sink|shower|tub|bathtub|faucet|drain|disposal|garbage\s*disposal|sump\s*pump|ejector|septic|sewer|water\s*line|main\s*line)\b/i.test(message);
        if (hasFixtureContext) {
        return { template: 'problem_description', params: [] }; // Continue diagnostic flow
      }
      // FIX A: Prevent repeated opener - if last response was opener, show clarification instead
      if (booking.lastResponseWasOpener) {
        return { template: 'openerClarification', params: [] };
      }
      if (!booking.problemType && !entities.problemType && !entities.fixture && !booking.fixture) {
        return { template: 'needProblem', params: [] };
      }
      
      // If we have a fixture but no problem type, ask what's wrong with that specific fixture
      if (!booking.problemType && !entities.problemType && (entities.fixture || booking.fixture)) {
        const fixture = entities.fixture || booking.fixture;
        booking.fixture = fixture;  // Persist the fixture
        return { 
          template: 'fixtureNeedsProblem', 
          params: [{ fixture }]
        };
      }
      return { template: 'needProblem', params: [] };
      }
      // If in booking stage, fall through to stage-based template selection below
    }
    
    // If the user has not been introduced yet but their first message was NOT a greeting,
    // do NOT override real intents. Simply mark them as introduced and continue normally.
    if (!hasBeenIntroduced(context.customerKey) && booking.stage === 'initial') {
      markAsIntroduced(context.customerKey);
    }
    
    // If somehow not introduced but past initial stage, mark as introduced and continue
    if (!hasBeenIntroduced(context.customerKey)) {
      markAsIntroduced(context.customerKey);
    }

    if (booking.stage === 'confirmed') {
      return { 
        template: 'bookingConfirmedFinal', 
        params: [booking.name, booking.address, booking.city, booking.timePreference, booking.problemType] 
      };
    } else if (booking.stage === 'awaiting_confirmation') {
      // Show confirmation screen before final booking
      return { 
        template: 'bookingConfirmation', 
        params: [booking.name, booking.address, booking.city, booking.timePreference, booking.problemType, booking.phone] 
      };
    } else if (booking.stage === 'booking_details') {
      const missing = [];
      if (!booking.name) missing.push('full name');
      if (!booking.address) missing.push('address');
      if (!booking.city) missing.push('city');
      if (!booking.timePreference) missing.push('best time');
      
      if (missing.length === 0) {
        // All info collected - show confirmation screen
        return { 
          template: 'bookingConfirmation', 
          params: [booking.name, booking.address, booking.city, booking.timePreference, booking.problemType, booking.phone] 
        };
      } else if (missing.length === 1) {
        return { template: 'missingOne', params: [missing[0]] };
      } else if (missing.length === 2) {
        return { template: 'missingTwo', params: [missing[0], missing[1]] };
      } else {
        return { template: 'missingMultiple', params: [missing] };
      }
    } else if (booking.stage === 'problem_diagnosis') {
      // Still in diagnostic - continue diagnostic flow
      // WATER HEATER FIX 2: Never return needProblem during diagnostics
      return { template: 'problem_description', params: [] };
    }

    // Default fallback - only if no stage matched
    // CANT_SHUTOFF RESOLVED TERMINAL: Never fall back if shutoff was resolved
    if (booking.cantShutoffResolved) {
      return { template: 'booking_request', params: [] };
    }
    // INVARIANT 1: WATER HEATER INTENT IS STICKY (STATE-BASED) - fallback path
    if (booking.waterHeaterIntentLocked) {
      return { template: 'problem_description', params: [] };
    }
    // WATER HEATER FIX 2: Check if diagnostics started before returning needProblem
    const hasDiagnosticsStarted = booking.problemType || (booking.diagnosticHistory && booking.diagnosticHistory.length > 0);
    if (hasDiagnosticsStarted) {
      return { template: 'problem_description', params: [] };
    }
    // LOCK FIX A: HARD WATER HEATER INTENT LOCK - detect and lock from current message (fallback path)
    const hasWaterHeaterContextFallback = /\b(water\s*heater|hot\s*water\s*tank|no\s+hot\s+water|not\s+hot|scalding|too\s+hot|heater.*leak|pilot\s+light|tankless|water\s+(?:isn'?t|not)\s+heating|barely\s+warm|temp.*(?:changing|spiking)|worse\s+when\s+multiple\s+showers|tank\s+thing|heating\s+right|lukewarm|only\s+(?:getting\s+)?(?:warm|tepid))\b/i.test(message);
    if (hasWaterHeaterContextFallback) {
      return { template: 'problem_description', params: [] };
    }
    if (!booking.problemType && !entities.problemType && !entities.fixture && !booking.fixture) {
      return { template: 'needProblem', params: [] };
    }
    
    // If we have a fixture but no problem type, ask what's wrong with that specific fixture
    if (!booking.problemType && !entities.problemType && (entities.fixture || booking.fixture)) {
      const fixture = entities.fixture || booking.fixture;
      booking.fixture = fixture;  // Persist the fixture
      return { 
        template: 'fixtureNeedsProblem', 
        params: [{ fixture }]
      };
    }
    return { template: 'needProblem', params: [] };
  }

  async function extractBookingInfoWithAI(message) {
    const apiKey = CONFIG.OPENAI_API_KEY;
    if (!apiKey || !apiKey.startsWith('sk-')) {
      return { name: null, address: null, city: null, time: null, diagnosticNote: null };
    }
    
    // Retry logic: attempt up to 2 times
    for (let attempt = 0; attempt < 2; attempt++) {
      try {
        const response = await fetch('https://api.openai.com/v1/chat/completions', {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${apiKey}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            model: 'gpt-4o-mini',
            messages: [{
              role: 'system',
              content: `You are extracting booking information for a plumbing appointment.
Only extract information if it is explicitly present in the message. Never guess.

Return a JSON object:
{
  "name": string | null,
  "address": string | null,
  "city": string | null,
  "time": string | null,
  "diagnosticNote": string | null
}

RULES:

1. NAME:
   - Identify a real human name.
   - Accept mixed case like 'mark anthony'.
   - Reject street names, plumbing terms, or random two-word phrases.
   - If unclear, return null.

2. ADDRESS:
   - Must include a number + street word (e.g., '20 milford rd').
   - Support variations ('20 milford', '20 milford road', '20 elm st').
   - If only a street name without a number is provided, return null.

3. CITY:
   - Return only if explicitly mentioned.
   - Do not infer city from street names.

4. TIME:
   - Extract booking times such as:
     '8pm', 'after 5', 'tonight', 'tomorrow morning',
     'anytime before noon', 'around 6', 'noon', '3pm-5pm'.
   - Return the exact text as written.

5. If the message contains none of these, return all null.
6. DIAGNOSTIC NOTE:
   - If the message contains problem details like "tank is empty", "only leaks when flushing", "makes gurgling sound", "started yesterday", extract as diagnosticNote.
   - This captures additional context the customer provides during booking.
   - If no diagnostic content, return null.
Return only the JSON.`
            }, {
              role: 'user',
              content: message
            }],
            max_tokens: 150,
            temperature: 0.1
          })
        });
        
        if (!response.ok) {
          throw new Error(`AI extraction failed: ${response.status}`);
        }
        
        const data = await response.json();
        const content = data.choices[0].message.content.trim();
        const parsed = JSON.parse(content);
        return {
          name: parsed.name || null,
          address: parsed.address || null,
          city: parsed.city || null,
          time: parsed.time || null,
          diagnosticNote: parsed.diagnosticNote || null
        };
      } catch (error) {
        console.error(`AI booking extraction error (attempt ${attempt + 1}):`, error);
        if (attempt === 0) {
          // Wait 150ms before retry
          await new Promise(resolve => setTimeout(resolve, 150));
        }
      }
    }
    // Both attempts failed - return null values (keep existing booking data unchanged)
    return { name: null, address: null, city: null, time: null, diagnosticNote: null };
  }

