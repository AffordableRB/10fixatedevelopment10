    }
    // === GAS LINE INSTALL / HOOKUP ===
    // Includes: stove/range hookup, dryer hookup, grill hookup, fireplace, generator
    // Also catches "can you install gas lines?" and "hook up gas stove"
    else if (/\b(?:install|run|add)\s+(?:a\s+)?gas\s*line/i.test(message) ||
             /\bgas\s*line\s*(?:install|installation)/i.test(message) ||
             /\bneed\s+(?:a\s+)?gas\s*line/i.test(message) ||
             /\b(?:hook\s*up|connect|install)\s+(?:a\s+)?(?:my\s+)?gas\s+(?:stove|range|dryer|grill|fireplace|generator)/i.test(message) ||
             /\bneed\s+to\s+hook\s*up\s+(?:a\s+)?(?:my\s+)?gas\s+(?:stove|range|dryer)/i.test(message) ||
             /\bgas\s+(?:stove|range|dryer|grill|fireplace)\s+(?:hook\s*up|hookup|connection|install)/i.test(message) ||
             /\bneed\s+gas\s+(?:for|to)\s+(?:stove|range|dryer|grill|outdoor|fireplace|generator)/i.test(message) ||
             /\b(?:stove|range|dryer)\s+gas\s+(?:line|connection|hookup)/i.test(message) ||
             /\brun\s+gas\s+(?:to|for)\s+(?:outdoor|grill|kitchen|dryer)/i.test(message) ||
             /\b(?:can\s+you|do\s+you)\s+install\s+gas\s*line/i.test(message)) {
      entities.problemType = 'gas_line_install';
      entities.isInstall = true;
    }
    // === WATER MAIN VALVE ===
    else if (/\b(?:can'?t|won'?t)\s+(?:turn|shut)\s+(?:the\s+)?(?:main\s+)?(?:water\s+)?(?:valve|shutoff)\b/i.test(message)) {
      entities.problemType = 'water_shutoff_valve';
    }
    // === PIPE NOISE ===
    else if ((/\b(?:knock|knocking|banging|water\s*hammer).*(?:pipe|water)\b/i.test(message) && !/\bwater\s*heater\b/i.test(message)) ||
             /\b(?:pipe|water).*(?:knock|knocking|banging)\b/i.test(message)) {
      entities.problemType = 'pipe_noise';
