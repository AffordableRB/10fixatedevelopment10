        const msg = customerMessage.toLowerCase().trim();
        const wantsToChangeName = /\b(?:name|my\s+name)\b/.test(msg) && !correctionEntities.name;
        const wantsToChangeAddress = /\b(?:address)\b/.test(msg) && !correctionEntities.address;
