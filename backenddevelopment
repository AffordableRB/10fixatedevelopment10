    }
    // === GAS SMELL WITH CONTEXT ===
    // Must catch: "Rotten egg smell, think it's gas", "smells like rotten eggs could be gas"
    else if (/\b(?:rotten\s*egg|sulfur|sulphur).*(?:gas|think\s*(?:it'?s?|it\s+is|could\s+be)\s*gas)/i.test(message) ||
