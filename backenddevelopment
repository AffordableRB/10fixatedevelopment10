          return {
            response: "No problem - which room or area will this be installed in?",
            booking: currentBooking,
            debug: { intent: 'specialist_installation', stage: 'install_intake', item: install.item, locationRetry: true },
            metadata: { stage: 'install_intake', installFlow: true, specialistInstall: true }
