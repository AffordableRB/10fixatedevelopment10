  const dataTimestamps = new Map(); // For TTL tracking

  // TTL Cleanup - runs periodically to remove stale data
  function cleanupStaleData() {
    const now = Date.now();
    for (const [key, timestamp] of dataTimestamps.entries()) {
      if (now - timestamp > TTL_MS) {
        conversations.delete(key);
        customerProfiles.delete(key);
        bookingData.delete(key);
