      entities.problemType = 'septic_smell';
    }
    
    // ================================================================
    // A) TOILET PROBLEMS - 15 specific categories
    // HIGH-CONFIDENCE EARLY DETECTION: Detect obvious states first to prevent generic questions
    // ================================================================
    
    // ================================================================
    // TOILET EDGE CASES - Must be checked FIRST (before generic patterns)
    // ================================================================
    
    // Toilet slow drain = clogged (prevents falling through to drain_clogged)
    // CRITICAL FIX: Changed from 'if' to 'else if' to connect to install/emergency chain above
    // This prevents toilet patterns from overwriting emergency classifications like septic_backup
    else if (/\b(?:toilet|tolet|toylet|toiley|tilet|toiet|toliet|commode).*(?:slow\s*(?:to\s*)?drain|drain\s*slow|slowly\s*drain)/i.test(message) ||
