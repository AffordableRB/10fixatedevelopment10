        if (Object.keys(corrections).length > 0) {
          corrections.awaitingConfirmation = true;
          corrections.changePromptSent = false;  // Reset flag after correction applied
          const updatedBooking = updateBookingData(customerKey, corrections);
          
          return {
            response: RESPONSE_TEMPLATES.bookingConfirmation(
              updatedBooking.name,
              updatedBooking.address,
              updatedBooking.city,
              updatedBooking.timePreference,
              updatedBooking.problemType,
              updatedBooking.phone
