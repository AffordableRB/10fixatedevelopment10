    }
    // === ROTTEN EGG FROM TOILET (not gas) ===
    else if (/\b(?:rotten\s*egg|sulfur).*(?:smell|odor).*(?:from|in|at)\s+(?:the\s+)?(?:toilet)\b/i.test(message) ||
             /\b(?:toilet).*(?:smell|smells).*(?:rotten\s*egg|sulfur)\b/i.test(message)) {
      if (!/gas/i.test(message)) {
        entities.problemType = 'toilet_smell';
        entities.fixture = 'toilet';
      }
    }
    // === ROTTEN EGG FROM SINK (not gas) ===
    else if (/\b(?:rotten\s*egg|sulfur).*(?:smell|odor).*(?:from|in|at)\s+(?:the\s+)?(?:sink)\b/i.test(message) ||
             /\b(?:sink).*(?:smell|smells).*(?:rotten\s*egg|sulfur)\b/i.test(message)) {
      if (!/gas/i.test(message)) {
