              .replace(/^(?:in\s+)?(?:the\s+)?(?:my\s+)?/i, '')
              .replace(/[.!?]+$/g, '');
            install.location = cleanedLocation || customerMessage.trim();
          }
        }
        
        // Item + location collected - hand off to booking
