const QUESTION_ALIGNMENT = {
  // Question type detection patterns
  questionTypes: {
    // Leak-related questions
    leak_location: /\b(?:where.*leak|leak.*where|base|tank|supply|drip|dripping)\b/i,
    dripping: /\b(?:drip|dripping|won'?t\s+(?:turn\s+off|stop))\b/i,
    active_vs_drip: /\b(?:spray|spraying|small\s+drip|constant|active)\b/i,
    
    // Clog-related questions
    clog_severity: /\b(?:completely|partially|totally)\s+(?:clog|blocked|drain)\b/i,
    standing_water: /\b(?:standing\s+water|water\s+in\s+(?:the\s+)?(?:sink|tub|toilet))\b/i,
    drain_speed: /\b(?:drain.*slow|slow.*drain|how\s+slow)\b/i,
    backup: /\b(?:back.*up|backing|come.*back)\b/i,
    
    // Scope questions
    single_vs_multiple: /\b(?:just\s+(?:that|this)\s+one|other.*(?:drain|toilet|sink)|multiple)\b/i,
    multiple_fixtures: /\b(?:other|multiple|all|every|several)\s+(?:drain|fixture|toilet|sink)\b/i,
    whole_house: /\b(?:whole\s+house|everywhere|all\s+(?:faucet|sink|drain))\b/i,
    
    // Supply/pressure questions
    pressure: /\b(?:pressure|flow|stream|trickle)\b/i,
    hot_vs_cold: /\b(?:hot|cold|warm)\s+(?:water|side)\b/i,
    no_water: /\b(?:no\s+water|any\s+water|water\s+at\s+all)\b/i,
    
    // Sewer questions
    sewage: /\b(?:sewage|sewer|smell|odor|brown|dirty)\b/i,
    
    // Running/mechanical questions
    running_frequency: /\b(?:constant(?:ly)?|intermittent(?:ly)?|start.*stop|how\s+often)\b/i
  },
  
  // Detect what type of question is being asked
  detectQuestionType: function(question) {
    const q = question.toLowerCase();
    const types = [];
    
    for (const [type, pattern] of Object.entries(this.questionTypes)) {
      if (pattern.test(q)) {
        types.push(type);
      }
    }
    
    return types;
  },
  
  // Check if a question is aligned with the problem and not suppressed
  isQuestionAligned: function(question, problemType, suppressedTypes) {
    const questionTypes = this.detectQuestionType(question);
    
    // If question type is suppressed by negative signals, reject it
    for (const qType of questionTypes) {
      if (suppressedTypes.includes(qType)) {
        return { aligned: false, reason: `Question type '${qType}' suppressed by user clarification` };
      }
    }
    
    // Check if question is valid for the diagnostic path
    for (const qType of questionTypes) {
      if (!DIAGNOSTIC_PATHS.isQuestionValid(problemType, qType)) {
        return { aligned: false, reason: `Question type '${qType}' not valid for ${problemType}` };
      }
    }
    
    return { aligned: true };
  },
  
  // Get an aligned alternative question if the original is misaligned
  getAlignedAlternative: function(problemType, suppressedTypes) {
    const path = DIAGNOSTIC_PATHS.getPath(problemType);
    if (!path) return null;
    
    // Return a generic aligned question based on path
    switch (path.name) {
      case 'no_water':
        if (!suppressedTypes.includes('single_vs_multiple')) {
          return "Is it just that one faucet or are others doing the same thing?";
        }
        if (!suppressedTypes.includes('hot_vs_cold')) {
          return "Is it the hot water, cold water, or both?";
        }
        break;
      case 'leak':
        if (!suppressedTypes.includes('active_vs_drip')) {
          return "Is water coming out right now, or only when you use it?";
        }
        if (!suppressedTypes.includes('leak_location')) {
          return "Where exactly do you see the water?";
        }
        break;
      case 'clog':
        if (!suppressedTypes.includes('clog_severity')) {
          return "Is it completely stopped or just draining slow?";
        }
        if (!suppressedTypes.includes('single_vs_multiple')) {
          return "Is it just that one drain or are others slow too?";
        }
        break;
      case 'sewer':
        if (!suppressedTypes.includes('multiple_fixtures')) {
          return "How many drains are affected?";
        }
        if (!suppressedTypes.includes('sewage')) {
          return "Is it dirty water or clean water backing up?";
        }
        break;
      case 'fixture':
        return "When did this start happening?";
    }
    
    return null;
  }
};

