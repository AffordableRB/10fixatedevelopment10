          !currentBooking.emergencyModeActive &&
          !currentBooking.emergencyEvaluated &&
          !isAnyRoutineService &&
          !mentionsBackflow &&
          !hasInstallationIntent &&
          !isServiceInquiry &&
          !isEmergencyInformational &&
          !currentBooking.installIntentLocked) {
        
        currentBooking.urgencyClarificationAsked = true;
        currentBooking.urgencyExpressed = true;  // LATCH: Remember they said it's urgent
        bookingData.set(customerKey, currentBooking);
        
        return {
          response: "I hear you - what's happening? Is it flooding, a gas smell, a burst pipe, or something else?",
