            }
          }
          
          updatedBooking.stage = 'booking_details';
          bookingData.set(customerKey, updatedBooking);
          
          const bookingMsg = RESPONSE_TEMPLATES.getSmartBookingRequest(currentBooking, "Got it, let's get you booked. ");
          const finalMsg = dedupSecondaryResponses.length > 0 
            ? dedupSecondaryResponses.join(' ') + ' ' + bookingMsg
            : bookingMsg;
          return {
            response: finalMsg,
            booking: updatedBooking,
            debug: { intent: 'diagnostic_dedup_skip', skippedQuestion: questionKey, secondaryIntents: dedupSecondaryResponses.length },
            metadata: { stage: 'booking_details', dedupSkip: true }
          };
        }
        
        // FIRST TIME seeing problem - use FIXED question
        if (diagnosticHistory.length === 0) {
          // Extract diagnostic slots from initial message
          updatedBooking.diagnosticSlots = extractDiagnosticSlots(customerMessage, updatedBooking.diagnosticSlots || {});
          // FORCED SLOT RESOLUTION: Resolve slots from any reasonable signal
          updatedBooking.diagnosticSlots = forceResolveSlots(customerMessage, updatedBooking.diagnosticSlots, updatedBooking);
          
          // =================================================================
          // FAUCET NO-WATER SHORT-CIRCUIT: Skip diagnostics, go to booking
          // =================================================================
