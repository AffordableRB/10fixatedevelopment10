      }
      // ================================================================
      
      // ================================================================
      // UX BEHAVIORS: Cancellation, Restart, Emergency Detection
      // ================================================================
      
      // RESILIENCE: Check for explicit reset phrases
      // GUARD: Block reset during active emergency mode
      if (RESILIENCE.isResetRequest(customerMessage) && !currentBooking.emergencyModeActive) {
        resetBooking(customerKey);
        currentBooking = getBookingData(customerKey);
        return {
          response: "No problem - just text us when you're ready.",
          booking: currentBooking,
          debug: { intent: 'reset_request', stage: 'initial' },
          metadata: { reset: true }
        };
      }
      
      // ================================================================
      // CANCELLATION HANDLING (Two-tier system)
      // Tier 1: HARD STOP - Standalone commands (STOP/END/QUIT/CANCEL) exit immediately
      // Tier 2: SOFT CANCEL - Natural language signals require confirmation first
      // ================================================================
      const hasInstallVerb = /\b(?:install|installing|replace|replacing|put\s*in|hook\s*up|set\s*up|swap\s*(?:out)?|change\s*(?:out)?|add|mount)\b/i.test(customerMessage);
      
      // Handle cancellation confirmation response (if we previously asked)
      if (currentBooking.awaitingCancellationConfirm) {
        // User confirms they want to stop
        if (/\b(?:yes|yeah|yep|stop|quit|end|cancel|done)\b/i.test(customerMessage) &&
            !/\b(?:no|nope|keep|continue|going|help)\b/i.test(customerMessage)) {
        resetBooking(customerKey);
        return {
          response: RESPONSE_TEMPLATES.cancellation(),
          booking: getBookingData(customerKey),
            debug: { intent: 'cancellation_confirmed', stage: 'cancelled' },
          metadata: { cancelled: true }
          };
        }
        // User wants to continue
        else {
          currentBooking.awaitingCancellationConfirm = false;
          bookingData.set(customerKey, currentBooking);
