const RESILIENCE = {
  // Maximum attempts before forcing booking
  maxDiagnosticAttempts: 2,
  maxNonAnswers: 2,
  maxExchangesBeforeForceBooking: 4,
  
  // Non-answer patterns - user doesn't know or won't answer
  // NOTE: "kinda", "not really", "I think so", "sorta" are VALID answers, not non-answers
  // EXPANDED: Include longer "I don't know" variants that indicate true uncertainty
  nonAnswerPatterns: [
    // Short non-answers (strict match)
    /^(?:idk|i\s*don'?t\s*know|no\s*idea|dunno|unsure|beats\s*me)\.?$/i,
    /^(?:\?+)$/,
    /^(?:um+|uh+|hmm+|hm+)\.?$/i,
    /^(?:whatever|doesn'?t\s*matter|you\s*decide|up\s*to\s*you)\.?$/i,
    /^(?:\?|\.{2,}|...)$/,  // Just punctuation
    // Longer uncertainty phrases (looser match for General/Unknown flows)
    /^i\s*(?:really\s*)?(?:don'?t|do\s*not)\s*know/i,
    /^(?:i\s*)?(?:have\s*)?no\s*(?:idea|clue)/i,
    /^(?:i\s*)?(?:can'?t|cannot)\s*(?:tell|say|figure)/i,
    /^(?:i'?m\s*)?not\s*(?:really\s*)?sure/i,
    /^(?:i\s*)?honestly\s*(?:don'?t|have\s*no)\s*(?:know|idea|clue)/i,
    /^(?:couldn'?t|could\s*not)\s*(?:tell|say)\s*(?:you)?/i,
    /^(?:no\s*)?(?:sorry|idk),?\s*(?:i\s*)?(?:don'?t|have\s*no)\s*(?:know|idea)/i,
    /^(?:i\s*)?(?:wish\s*i\s*knew|don'?t\s*have\s*(?:a\s*)?clue)/i,
    /^(?:hard|difficult)\s*to\s*(?:tell|say|know)/i,
    /^(?:i\s*)?(?:can'?t|cannot)\s*(?:see|find|locate|figure\s*out)/i
  ],
  
  // Valid answer patterns - these should NEVER be treated as non-answers
  validAnswerPatterns: [
    /\b(?:kinda|kind\s*of|sorta|sort\s*of|not\s*really|i\s*think\s*so|i\s*guess|maybe|possibly|probably|might\s*be)\b/i,
    /\b(?:yes|yeah|yea|yep|yup|no|nope|nah)\b/i,
    /\b(?:ok|okay|sure|fine|alright)\b/i,
    /\b(?:constant(?:ly)?|intermittent(?:ly)?|sometimes|always|never|occasionally|rarely|often)\b/i,
    /\b(?:slow|fast|blocked|clogged|running|leaking|dripping|stopped)\b/i,
    /\b(?:one|both|all|none|some|few|many|multiple|single|just\s*(?:one|this|that))\b/i
  ],
  
  // Contradiction escalation patterns - user says something worse than before
  escalationPatterns: {
    to_leak: [/water\s*everywhere/i, /flooding/i, /pouring/i, /spraying/i, /gushing/i],
    to_emergency: [/sewage/i, /gas\s*smell/i, /burst/i, /can'?t\s*stop/i, /won'?t\s*stop/i],
    to_backup: [/backing\s*up/i, /coming\s*back/i, /overflow/i]
  },
  
  // Explicit reset phrases (only these should reset state)
  resetPhrases: [
    /\b(?:start\s*over|restart|begin\s*again|reset)\b/i,
    /\b(?:wrong\s*number|wrong\s*person)\b/i,
    /\b(?:cancel|nevermind|never\s*mind|forget\s*it)\b/i
  ],
  
  // Check if message is a non-answer
  isNonAnswer: function(message) {
    const msg = message.trim();
    
    // GUARD: If message contains valid answer patterns, it's NOT a non-answer
    if (this.validAnswerPatterns.some(p => p.test(msg))) {
      return false;
    }
    
    // GUARD: If message contains specific fixture/location/symptom info, it's NOT a non-answer
    // Even if they say "I don't know" but also mention "toilet" or "kitchen" - that's useful info
    if (/\b(?:toilet|sink|shower|tub|kitchen|bathroom|basement|upstairs|downstairs|leak|clog|drip|flood|water\s*heater|pipe|drain|faucet)\b/i.test(msg)) {
      return false;
    }
    
    // Check patterns - allow longer uncertainty phrases now
    return this.nonAnswerPatterns.some(p => p.test(msg));
  },
  
  // Check if message escalates the situation
  detectEscalation: function(message) {
    const msg = message.toLowerCase();
    
    for (const [escalationType, patterns] of Object.entries(this.escalationPatterns)) {
      if (patterns.some(p => p.test(msg))) {
        return escalationType;
      }
    }
    return null;
  },
  
  // Check if user wants to reset
  isResetRequest: function(message) {
    // GUARD: Exclude "reset button" references (e.g., "tried the reset button", "push the reset")
    // These refer to physical buttons on appliances, not conversation reset requests
    if (/\breset\s+button\b/i.test(message) ||
        /\b(?:tried|push|press|hit|pressed|pushed)\b.*\breset\b/i.test(message) ||
        /\bthe\s+reset\b/i.test(message)) {
      return false;
    }
    return this.resetPhrases.some(p => p.test(message));
  },
  
  // Get graceful proceed-to-booking message
  getGracefulProceedMessage: function(reason) {
    if (reason === 'non_answers') {
      return "No problem - sometimes it's hard to tell without seeing it. The best next step is to have a plumber take a look. I just need a few details to get someone scheduled.";
    }
    return "No worries - we can take a look in person. I just need a few details to get someone out there.";
  },
  
  // Check if we should force booking due to stalled conversation
  shouldForceBooking: function(booking) {
    const exchangeCount = Math.floor((booking.diagnosticHistory || []).length / 2);
    const aiFailures = booking.diagnosticAiFailures || 0;
    const nonAnswerCount = booking.nonAnswerCount || 0;
    
    // Force booking if:
    // 1. AI has failed 2+ times
    if (aiFailures >= this.maxDiagnosticAttempts) return { force: true, reason: 'ai_failures' };
    
    // 2. User has given 2+ non-answers
    if (nonAnswerCount >= this.maxNonAnswers) return { force: true, reason: 'non_answers' };
    
    // 3. Too many exchanges without resolution
    if (exchangeCount >= this.maxExchangesBeforeForceBooking) return { force: true, reason: 'max_exchanges' };
    
    return { force: false };
  },
  
  // Check if AI response is valid (not empty, not a repeat, not misaligned)
  isValidAIResponse: function(response, diagnosticHistory, suppressedTypes) {
    if (!response || response.trim().length === 0) {
      return { valid: false, reason: 'empty_response' };
    }
    
    // Check if response is just "Got it" (valid completion signal)
    if (/^got it\.?$/i.test(response.trim())) {
      return { valid: true };
    }
    
    // Check if this question was already asked
    const previousQuestions = diagnosticHistory
      .filter(m => m.role === 'plumber')
      .map(m => m.content.toLowerCase());
    
    const responseLower = response.toLowerCase();
    for (const prevQ of previousQuestions) {
      // Check for substantial overlap (same question rephrased)
      if (this.isSimilarQuestion(responseLower, prevQ)) {
        return { valid: false, reason: 'repeat_question' };
      }
    }
    
    // Check if question is about a suppressed topic
    if (suppressedTypes && suppressedTypes.length > 0) {
      const questionTypes = QUESTION_ALIGNMENT.detectQuestionType(response);
      for (const qType of questionTypes) {
        if (suppressedTypes.includes(qType)) {
          return { valid: false, reason: 'suppressed_topic' };
        }
      }
    }
    
    return { valid: true };
  },
  
  // Check if two questions are similar (to detect repeats)
  isSimilarQuestion: function(q1, q2) {
    // Extract key words and compare
    const getKeyWords = (q) => {
      return q.replace(/[^a-z\s]/g, '')
        .split(/\s+/)
        .filter(w => w.length > 3 && !['that', 'this', 'what', 'when', 'where', 'which', 'your', 'have', 'does', 'just', 'still'].includes(w));
    };
    
    const words1 = new Set(getKeyWords(q1));
    const words2 = new Set(getKeyWords(q2));
    
    if (words1.size === 0 || words2.size === 0) return false;
    
    // Count overlapping words
    let overlap = 0;
    for (const w of words1) {
      if (words2.has(w)) overlap++;
    }
    
    // If more than 60% overlap, consider it similar
    const overlapRatio = overlap / Math.min(words1.size, words2.size);
    return overlapRatio > 0.6;
  }
};

// =============================================================================
// GRACE RESPONSE LAYER - Handles uncertainty/delay phrases without state changes
// =============================================================================
// INVARIANT: Grace responses are purely conversational UX
// They do NOT:
//   - resolve diagnostic dimensions
//   - modify slots
//   - advance diagnostic flow
//   - skip required questions
//   - trigger booking
// They DO:
//   - acknowledge the user's uncertainty/delay politely
//   - re-ask the last unresolved diagnostic question
// =============================================================================
const GRACE_RESPONSES = {
  // Patterns that indicate user needs a moment or is uncertain
  delayPatterns: [
    /^(?:uh+|um+|uhh+|umm+|hmm+|hm+)\.?$/i,
    /^(?:one\s*sec|hold\s*on|wait|sec|moment|gimme\s*a\s*(?:sec|minute|moment))\.?$/i,
    /^(?:let\s*me\s*(?:check|see|look|think)|checking|looking|thinking)\.?$/i,
    /^(?:hang\s*on|brb|be\s*right\s*back)\.?$/i
  ],
  
  uncertaintyPatterns: [
    /^(?:idk|i\s*don'?t\s*know|not\s*sure|no\s*idea|dunno|unsure)\.?$/i,
    /^(?:i'?m\s*not\s*sure|not\s*really\s*sure|hard\s*to\s*say)\.?$/i,
    /^(?:maybe|possibly|i\s*guess|i\s*think)\.?$/i,
    /^(?:\?+)$/
  ],
  
  // Grace acknowledgment messages (short, human, neutral)
  delayAcknowledgments: [
    "No problem - take your time.",
    "Sure, no rush.",
    "Take your time.",
    "No worries, I'll wait.",
    "Sure thing.",
    "No rush at all.",
    "Okay, I'm here."
  ],
  
  uncertaintyAcknowledgments: [
    "That's okay - your best guess is fine.",
    "No worries - just your best guess.",
    "That's fine - whatever you think.",
    "No problem - just give me your best guess.",
    "That's alright - rough idea works.",
    "No worries, we'll figure it out when we get there.",
    "Totally fine - just ballpark it."
  ],
  
  // Check if message is a delay phrase
  isDelayPhrase: function(message) {
    const msg = message.trim();
    return this.delayPatterns.some(p => p.test(msg));
  },
  
  // Check if message is an uncertainty phrase
  isUncertaintyPhrase: function(message) {
    const msg = message.trim();
    return this.uncertaintyPatterns.some(p => p.test(msg));
  },
  
  // Check if message triggers grace response (delay OR uncertainty)
  isGracePhrase: function(message) {
    return this.isDelayPhrase(message) || this.isUncertaintyPhrase(message);
  },
  
  // Get appropriate grace acknowledgment
  getGraceAcknowledgment: function(message) {
    if (this.isDelayPhrase(message)) {
      return this.delayAcknowledgments[Math.floor(Math.random() * this.delayAcknowledgments.length)];
    }
    if (this.isUncertaintyPhrase(message)) {
      return this.uncertaintyAcknowledgments[Math.floor(Math.random() * this.uncertaintyAcknowledgments.length)];
    }
    return null;
  },
  
  // Get the last diagnostic question asked (from history)
  getLastDiagnosticQuestion: function(diagnosticHistory) {
    if (!diagnosticHistory || diagnosticHistory.length === 0) return null;
    
    // History format: [{ role: 'customer'|'plumber', content: '...' }, ...]
    // Find the last plumber message that contains a question
    for (let i = diagnosticHistory.length - 1; i >= 0; i--) {
      const entry = diagnosticHistory[i];
      
      // Handle object format { role, content }
      if (entry && typeof entry === 'object' && entry.role === 'plumber' && entry.content) {
        if (entry.content.includes('?')) {
          return entry.content;
        }
      }
      // Handle legacy string format (fallback)
      else if (entry && typeof entry === 'string' && entry.includes('?')) {
        return entry;
      }
    }
    return null;
  },
  
  // Build grace response with question re-ask
  buildGraceResponse: function(message, diagnosticHistory, problemType, diagnosticSlots) {
    const acknowledgment = this.getGraceAcknowledgment(message);
    if (!acknowledgment) return null;
    
    // Try to get the last question from history
    let questionToReask = this.getLastDiagnosticQuestion(diagnosticHistory);
    
    // If no question in history, generate from next unresolved dimension
    if (!questionToReask && problemType) {
      const nextDim = BOOKING_GATE.getNextDimensionToResolve(problemType, diagnosticSlots);
      if (nextDim) {
        questionToReask = BOOKING_GATE.getQuestionForDimension(nextDim, problemType);
      }
    }
    
    // If we have a question to re-ask, combine with acknowledgment
    if (questionToReask) {
      return `${acknowledgment} ${questionToReask}`;
    }
    
    // Fallback: just the acknowledgment (rare edge case)
    return acknowledgment;
  }
};

// =============================================================================
// BOOKING GATE - Determines when issue is sufficiently understood for dispatch
// =============================================================================
const BOOKING_GATE = {
  // Problem types that are clear/routine - can book faster
  clearIssues: [
    'toilet_clogged', 'sink_clogged', 'drain', 'faucet_dripping',
    'garbage_disposal', 'garbage_disposal_jammed', 'garbage_disposal_humming',
    'garbage_disposal_clogged', 'garbage_disposal_not_working', 'garbage_disposal_smell',
    'toilet_running', 'shower_drain_clogged', 'sink_slow_drain'
  ],
  
  // Problem types that need more context before booking
  ambiguousIssues: [
    'leak', 'pipe', 'water_heater', 'sewer', 'toilet', 'sink',
    'no_water_house', 'low_pressure_house', 'leak_hidden', 'leak_slab'
  ],
  
  // Emergency types - minimal triage, book fast after safety
  emergencyIssues: [
    'gas_leak', 'gas_smell', 'pipe_burst', 'pipe_frozen', 'sewer_backup', 'septic_backup',
    'flooding', 'sewage_emergency', 'ejector_pump_overflow', 'ejector_pump_alarm',
    'toilet_overflowing', 'no_water_house', 'water_heater_burst', 'water_heater_leaking'
  ],
  
  // ==========================================================================
  // DIAGNOSTIC DIMENSIONS - The core dimensions that determine dispatch readiness
  // ==========================================================================
  // Each dimension can be resolved at most once and must not be re-asked
  
  DIMENSIONS: {
    // Core dimensions (required for most issues)
    NATURE: 'nature',           // What is happening (clogged vs leaking vs running)
    SEVERITY: 'severity',       // How bad (complete vs partial, constant vs intermittent)
    SCOPE: 'scope',             // One fixture vs multiple vs whole house
    LOCATION: 'location',       // Room, floor, basement vs upstairs
    
    // Situational dimensions (triggered by specific problem types)
    ACCESS: 'access',           // Hidden leak, ceiling leak - visibility/access
    ESCALATION: 'escalation',   // Actively worsening vs stable vs earlier today
    APPLIANCE_TYPE: 'appliance_type'  // Gas vs electric (water heaters)
  },
  
  // Map problem types to their REQUIRED dimensions
  // Nature is always resolved by the initial problem description
  getRequiredDimensions: function(problemType) {
    const base = ['severity', 'scope']; // Most issues need these
    
    // FIX: Early return if problemType is null/undefined to prevent crashes
    if (!problemType) {
      return base;
    }
    
    // INSTALLATION INVARIANT: Installations don't need severity or scope questions
    // "How bad is it?" doesn't apply to installs - go straight to booking
    if (problemType.includes('install') || problemType.includes('_install')) {
      return []; // No dimensions required for installations
    }
    
    // TOILET INVARIANT: Toilets are single, isolated fixtures.
    // Location and scope do NOT matter for booking/dispatch.
    // Allow booking immediately once toilet + condition identified.
    if (problemType.startsWith('toilet_')) {
      return []; // No dimensions required for toilets
    }
    
    // Clear/simple issues - just severity and scope
    if (this.clearIssues.includes(problemType)) {
      return base;
    }
    
    // Leak issues may need location and access
    if (problemType.includes('leak') || problemType.includes('pipe')) {
      return [...base, 'location'];
    }
    
    // Water heater needs appliance type
    if (problemType.includes('water_heater')) {
      return [...base, 'appliance_type'];
    }
    
    // Sewer/drain issues need scope (single vs multiple fixtures)
    if (problemType.includes('sewer') || problemType.includes('drain') || problemType.includes('backup')) {
      return [...base, 'location'];
    }
    
    // Hidden/ceiling leaks need access dimension
    if (problemType.includes('hidden') || problemType.includes('ceiling') || problemType.includes('wall')) {
      return [...base, 'location', 'access'];
    }
    
    return base; // Default: severity + scope
  },
  
  // Check which dimensions are resolved from diagnostic slots
  // INVARIANT: Once a dimension is in this list, it stays resolved forever
  getResolvedDimensions: function(diagnosticSlots) {
    const resolved = [];
    const slots = diagnosticSlots || {};
    
    // Nature is resolved if we have a problemType (always true at this point)
    resolved.push('nature');
    
    // SEVERITY DIMENSION - resolved ONLY by explicit severity slot
    // activity, amount, and frequency alone do NOT resolve severity
    // This prevents premature booking readiness from vague descriptions
    if (slots.severity !== undefined && slots.severity !== null) {
      resolved.push('severity');
    }
    
    // SCOPE DIMENSION - resolved by scope slot
    if (slots.scope !== undefined && slots.scope !== null) {
      resolved.push('scope');
    }
    
    // LOCATION DIMENSION - resolved by room, floor, leak_location, OR pipe_location
    if (slots.room !== undefined && slots.room !== null) {
      resolved.push('location');
    } else if (slots.floor !== undefined && slots.floor !== null) {
      resolved.push('location');
    } else if (slots.leak_location !== undefined && slots.leak_location !== null) {
      resolved.push('location');
    } else if (slots.pipe_location !== undefined && slots.pipe_location !== null) {
      resolved.push('location');
    }
    
    // ACCESS DIMENSION
    if (slots.access !== undefined && slots.access !== null) {
      resolved.push('access');
    } else if (slots.visibility !== undefined && slots.visibility !== null) {
      resolved.push('access');
    }
    
    // ESCALATION DIMENSION
    if (slots.escalation !== undefined && slots.escalation !== null) {
      resolved.push('escalation');
    } else if (slots.timing !== undefined && slots.timing !== null) {
      resolved.push('escalation');
    } else if (slots.worsening !== undefined && slots.worsening !== null) {
      resolved.push('escalation');
    }
    
    // Appliance type dimension
    // WATER HEATER FIX 1: Also treat as resolved if set to 'unknown' after repeated uncertainty
    if (slots.appliance_type) {
      resolved.push('appliance_type');
    }
    
    return resolved;
  },
  
  // Get unresolved dimensions for a problem type
  getUnresolvedDimensions: function(problemType, diagnosticSlots) {
    const required = this.getRequiredDimensions(problemType);
    const resolved = this.getResolvedDimensions(diagnosticSlots);
    return required.filter(dim => !resolved.includes(dim));
  },
  
  // Check if all required dimensions are resolved (booking ready)
  areDimensionsComplete: function(problemType, diagnosticSlots) {
    const unresolved = this.getUnresolvedDimensions(problemType, diagnosticSlots);
    return unresolved.length === 0;
  },
  
  // Check if booking is ready based on DIMENSION COMPLETENESS
  isReadyToBook: function(booking) {
    const problemType = booking.problemType;
    const diagnosticSlots = booking.diagnosticSlots || {};
    const exchangeCount = Math.floor((booking.diagnosticHistory || []).length / 2);
    const isEmergency = booking.isEmergency;
    
    // Emergency: book immediately after safety acknowledgment (1 exchange)
    if (isEmergency || this.emergencyIssues.includes(problemType)) {
      return exchangeCount >= 1;
    }
    
    // TOILET INVARIANT: Toilets are single, isolated fixtures.
    // Location/scope do NOT matter for booking. Book immediately once condition identified.
    if (problemType && problemType.startsWith('toilet_')) {
      return true; // Always ready to book for toilet repairs
    }
    
    // SINK LEAK CLARIFICATION GATE: For sink leaks (shutoff/valve/under-sink),
    // require water state clarification (drip vs spray) before booking
    const isSinkLeak = problemType && (
      problemType === 'sink_leak_trap' ||
      problemType === 'sink_leak_supply' ||
      problemType === 'sink_leak_faucet' ||
      problemType === 'leak_under_sink'
    );
    if (isSinkLeak && !diagnosticSlots.sinkLeakWaterState) {
      // Must clarify water state before booking
      return false;
    }
    
    // DIMENSION-BASED COMPLETION: All required dimensions must be resolved
    if (this.areDimensionsComplete(problemType, diagnosticSlots)) {
      return true;
    }
    
    // FALLBACK: If user can't answer (4+ exchanges), allow booking anyway
    // This prevents infinite loops when user doesn't know technical details
    if (exchangeCount >= 4) {
      return true;
    }
    
    return false;
  },
  
  // Get the next dimension to ask about (for fixed question selection)
  // INVARIANT: Returns null if all dimensions resolved, never returns a resolved dimension
  getNextDimensionToResolve: function(problemType, diagnosticSlots) {
    const resolved = this.getResolvedDimensions(diagnosticSlots);
    const unresolved = this.getUnresolvedDimensions(problemType, diagnosticSlots);
    
    // HARD GUARD: If no unresolved dimensions, return null
    if (unresolved.length === 0) return null;
    
    // Priority order: severity > scope > location > access > appliance_type
    const priority = ['severity', 'scope', 'location', 'access', 'appliance_type', 'escalation'];
    for (const dim of priority) {
      // DOUBLE CHECK: Only return if truly unresolved
      if (unresolved.includes(dim) && !resolved.includes(dim)) {
        return dim;
      }
    }
    
    // Fallback: return first unresolved that's definitely not resolved
    for (const dim of unresolved) {
      if (!resolved.includes(dim)) {
        return dim;
      }
    }
    
    // All dimensions resolved - should not reach here
    return null;
  },
  
  // Get question template for a dimension
  getQuestionForDimension: function(dimension, problemType) {
    const templates = {
      severity: {
        clog: "Is it completely blocked, or just draining slow - or something else?",
        leak: "Is it actively dripping right now, or just when you use it - or is it something else?",
        running: "Is it running constantly, or does it stop sometimes - or is it doing something different?",
        not_filling: "Is there any water going into the tank at all - or is something else going on?",
        no_water: "Is there no water at all, or just very weak flow - or something else?",
        default: "How bad is it - minor, more serious, or something in between?"
      },
      scope: {
        drain: "Is it just that one drain, or are others slow too - or is something else going on?",
        toilet: "Is it just that toilet, or are other drains backing up too - or neither?",
        running: "Is it just that toilet, or are others doing the same thing - or is it something else?",
        fixture: "Is it just that one, or are others affected too - or is something else going on?",
        no_water: "Is it just that faucet, or are others affected too - or is something else going on?",
        default: "Is it just that one, or are others affected too - or is something else going on?"
      },
      location: {
        leak: "Where exactly do you see the water?",
        // PIPE FIX 2: Pipe-specific location options (not fixture-oriented)
        pipe: "Where is the pipe - basement, inside a wall, utility room, crawlspace, outside, or somewhere else?",
        no_water: "Which faucet or fixture has no water?",
        default: "Which room or area is this in?"
      },
      access: {
        default: "Can you see where it's coming from, or is it hidden - or are you not sure?"
      },
      appliance_type: {
        default: "Is it gas or electric - or are you not sure?"
      },
      escalation: {
        default: "Is it getting worse, or has it stayed the same - or are you not sure?"
      }
    };
    
    const dimTemplates = templates[dimension] || templates.severity;
    
    // FIX: Early return if problemType is null/undefined to prevent crashes
    if (!problemType) {
      return dimTemplates.default;
    }
    
    // FIX: Running toilets must NEVER get clog/drain questions
    if (problemType.includes('running') || problemType.includes('refilling')) {
      return dimTemplates.running || dimTemplates.default;
    }
    
    // FIX: Not-filling toilets must get fill/valve questions, NOT leak questions
    if (problemType.includes('not_filling') || problemType.includes('tank_not')) {
      return dimTemplates.not_filling || dimTemplates.default;
    }
    
    // FIX: No-water issues must NEVER get leak/drip questions
    if (problemType.includes('no_water') || problemType.includes('low_pressure')) {
      return dimTemplates.no_water || dimTemplates.default;
    }
    
    // FIX 2: Faucet leaks stay in faucet path, don't get generic leak location questions
    if ((problemType === 'sink_leak_faucet' || problemType === 'faucet_dripping') && dimension === 'location') {
      return dimTemplates.default; // Skip generic "where do you see the water?" for faucet leaks
    }
    
    // PIPE FIX 2: Pipe issues get pipe-specific location question
    if (problemType.includes('pipe') && dimension === 'location') {
      return dimTemplates.pipe || dimTemplates.default;
    }
    
    // Try to match problem type to a specific template
    if (problemType.includes('clog')) return dimTemplates.clog || dimTemplates.default;
    if (problemType.includes('leak')) return dimTemplates.leak || dimTemplates.default;
    if (problemType.includes('running')) return dimTemplates.running || dimTemplates.default;
    if (problemType.includes('drain')) return dimTemplates.drain || dimTemplates.default;
    if (problemType.includes('toilet')) return dimTemplates.toilet || dimTemplates.default;
    
    return dimTemplates.default;
  }
};

// =============================================================================
// UX BEHAVIOR PATTERNS - Cancellation, restart, emergency detection
// =============================================================================
const UX_BEHAVIORS = {
  // Detect HARD STOP commands (standalone STOP/END/QUIT/CANCEL - immediate exit)
  isHardStop: function(message) {
    const msg = message.trim();
    return INTENT_PATTERNS.hardStopCommands.some(p => p.test(msg));
  },
  
  // Detect SOFT cancellation intent (requires confirmation before exit)
  isCancellation: function(message) {
    const msg = message.toLowerCase();
    return INTENT_PATTERNS.cancellation.some(p => p.test(msg));
  },
  
  // Detect restart intent
  isRestart: function(message) {
    const msg = message.toLowerCase();
