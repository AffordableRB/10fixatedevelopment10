// =============================================================================
// REGEX CONFIDENCE SCORING - Determines when to hand off to AI
// =============================================================================
const REGEX_CONFIDENCE = {
  // Score a message's regex match confidence
  // Returns: { confidence: 'high' | 'medium' | 'low' | 'blocked' | 'emergency_triage', reason: string, matchedIntent: string|null, matchedProblemType: string|null }
  score: function(message, entities, intent) {
    const msg = message.toLowerCase().trim();
    
    // ================================================================
    // EMERGENCY SAFETY GATE - Check FIRST before any other processing
    // Ultra-broad patterns that trigger AI triage for potential emergencies
    // AI will then classify and route appropriately
    // ================================================================
    
    // Skip emergency gate if already in booking/confirmation stage (they've already been triaged)
    const isInBookingFlow = entities?.stage === 'booking_details' || 
                            entities?.stage === 'awaiting_confirmation' ||
                            entities?.emergencyEvaluated === true;
    
    // Skip emergency gate for clear installation requests
    // Includes common typos: instalation, instll, instal
    const hasInstallIntent = /\b(?:install|installed|installing|installation|instalation|instll|instal|hook\s*up|set\s*up|put\s*in)\b/i.test(msg) ||
                             /\bgas\s*line\s+(?:for|to)\b/i.test(msg);
    
    // TOILET NON-EMERGENCY PATTERNS
    // Hissing toilet = fill valve issue, NOT gas leak
    // Toilet overflow/sewage smell = urgent but not 911-level emergency
    const hasToiletContext = /\b(?:toilet|tolet|toylet|toiley|tilet|toiet|toliet|commode)\b/i.test(msg);
    
    const isToiletRunningOrNoise = 
      /\b(?:toilet|tolet|toylet|toiley|tilet|toiet|toliet|commode).*(?:running|keeps\s+running|won'?t\s+stop|constantly|noise|noisy|making\s+noise|loud|hiss|hissing|whistl)/i.test(msg) ||
      /(?:running|keeps\s+running|won'?t\s+stop|noise|noisy|hiss|hissing|whistl).*\b(?:toilet|tolet|toylet|toiley|tilet|toiet|toliet|commode)\b/i.test(msg);
    
    const isToiletOverflowOrSmell =
      hasToiletContext && /\b(?:overflow|overflowing|sewage|sewer)\b/i.test(msg);
    
    const hasToiletLossOfControl = 
      /\b(?:water\s+everywhere|flooding|flooded|spraying|gushing|can'?t\s+stop\s+(?:the\s+)?water)\b/i.test(msg);
    
    const isToiletNonEmergency = (isToiletRunningOrNoise || isToiletOverflowOrSmell) && !hasToiletLossOfControl;
    
    // FIX #1: SHOWER HEAD SPRAY EXCLUSION - malfunction, not emergency
    // "Shower head spraying in all directions" or "spraying weird" is NOT water out of control
    const isShowerHeadMalfunction = 
      /\b(?:shower\s*head|showerhead)\s+(?:is\s+)?(?:spraying|spray)\b/i.test(msg) ||
      /\b(?:spraying|spray)\s+(?:in\s+)?(?:all\s+)?directions?\b/i.test(msg) ||
      /\b(?:shower\s*head|showerhead)\s+(?:spraying|sprays?)\s+(?:weird|wrong|sideways)\b/i.test(msg);
    
    // FIX: "gas water heater" / "gas heater" = appliance type, NOT gas emergency
    // Customer describing their gas-powered appliance should not trigger gas leak triage
    const isGasApplianceTypeMention = 
      /\b(?:gas\s+water\s*heater|gas\s+heater|gas\s+hot\s*water|gas\s+tankless|gas\s+tank)\b/i.test(msg) ||
      /\b(?:my|the|our)\s+gas\s+(?:water\s*)?heater\b/i.test(msg) ||
      /\b(?:gas|electric)\s+(?:water\s*)?heater.*(?:no\s+hot|not\s+hot|leak|noise|pilot|broken|issue|problem)\b/i.test(msg);
    
    // FIX: "water heater burst/flooding" should stay water heater context, not generic pipe_burst
    const isWaterHeaterEmergency = 
      /\b(?:water\s*heater|hot\s*water\s*tank).*(?:burst|flood|explod|ruptur|gush)\b/i.test(msg) ||
      /\b(?:burst|flood|explod).*(?:water\s*heater|hot\s*water\s*tank)\b/i.test(msg);
    
    // ================================================================
    // FIX 2A: DISPOSAL BACKING UP - Pre-empt emergency gate
    // "water backing up when I run the disposal" is disposal clog, not sewer emergency
    // ================================================================
    const isDisposalBackingUp = /\b(?:back|backing)\s*up.*(?:when|while).*(?:run|running|use|using).*(?:disposal|garburator)\b/i.test(msg) ||
      /\b(?:disposal|garburator).*(?:back|backing)\s*up\b/i.test(msg) ||
      /\b(?:back|backing)\s*up.*(?:disposal|garburator)\b/i.test(msg);
    
    if (isDisposalBackingUp) {
      entities.problemType = 'garbage_disposal_clogged';
      entities.fixture = 'garbage_disposal';
      // Don't trigger emergency gate for disposal backing up
      entities.disposalBackingUpHandled = true;
    }
    
    // SAFETY-6: Gas leak indicators must be checked BEFORE emergency gate
    // Otherwise hissing+gas goes to AI triage which may misclassify as non-emergency
    // GUARD: Rotten egg smell near drain/sewer/sink = sewer gas, not natural gas
    // Also: sulfur smell from hot water = anode rod issue, not gas leak
    const isSewerGasContext = /\b(?:drain|sewer|septic|bathroom|toilet|sink|floor\s+drain|hot\s+water)\s*(?:smell|odor)?\b/i.test(msg) &&
                              !/\b(?:kitchen|stove|oven|range|furnace|heater|garage|basement)\b/i.test(msg);
    
    // FIX BUG 1: "from sink" = sewer gas context (dry p-trap)
    const isSinkSmellContext = /\b(?:from|at|in|near)\s+(?:the\s+)?(?:sink|basin)\b/i.test(msg) &&
                               /\b(?:rotten\s*egg|sulfur|smell)\b/i.test(msg);
    
    // FIX BUG 2: Sulfur/rotten egg + hot water = anode rod issue, not gas leak
    const isHotWaterSmellContext = /\b(?:hot\s+water|water\s+heater)\b/i.test(msg) &&
                                   /\b(?:rotten\s*egg|sulfur|smell)\b/i.test(msg) &&
                                   !/\b(?:gas\s+smell|smell\s+gas|gas\s+leak)\b/i.test(msg);
    
    const hasGasLeakIndicators = 
      (/\b(?:hissing|hiss)\b/i.test(msg) && /\b(?:rotten\s*egg|gas\s*smell|smell.*gas|sulfur)\b/i.test(msg)) ||
      (/\b(?:rotten\s*egg|sulfur)\b/i.test(msg) && /\b(?:furnace|heater|stove|range|boiler|water\s*heater|kitchen|garage|basement)\b/i.test(msg) && !isHotWaterSmellContext) ||
      (/\b(?:rotten\s*egg|sulfur)\s*(?:smell|odor)?\b/i.test(msg) && !isSewerGasContext && !isSinkSmellContext && !isHotWaterSmellContext) ||
      (/\b(?:gas)\b/i.test(msg) && /\b(?:leak|hissing|smell|odor)\b/i.test(msg) && !/\b(?:gas\s*bill|billing|sewer\s*gas|septic\s*gas)\b/i.test(msg) && !/\bgas\b.*\b(?:from|in)\s*(?:the\s*)?(?:drain|sewer|septic|pipe|vent)\b/i.test(msg));
    
    if (hasGasLeakIndicators) {
      return { confidence: 'high', reason: 'gas_emergency_override', matchedIntent: 'emergency', matchedProblemType: 'gas_leak' };
    }
    
    // SAFETY-7A: Main water line broke/burst - major flooding emergency
    const hasMainLineBroke = /\b(?:main|water)\s*(?:line|pipe)\s+(?:broke|burst|busted|ruptured|broken)\b/i.test(msg) ||
                             /\b(?:broke|burst|busted|ruptured)\s+(?:the\s+)?(?:main|water)\s*(?:line|pipe)\b/i.test(msg) ||
                             /\bmain\s+(?:line|pipe).*(?:broke|burst|busted)\b/i.test(msg);
    
    if (hasMainLineBroke) {
      return { confidence: 'high', reason: 'main_line_break_emergency', matchedIntent: 'emergency', matchedProblemType: 'pipe_burst' };
    }
    
    // SAFETY-7B: Explicit emergency plea with problem context
    const hasEmergencyPlea = /\b(?:emergency|urgent)\b/i.test(msg) && 
                             /\b(?:help|please|now|asap)\b/i.test(msg) &&
                             /\b(?:water|leak|flood|pipe|burst|sewage|gas|overflow)\b/i.test(msg);
    
    if (hasEmergencyPlea) {
      return { confidence: 'high', reason: 'emergency_plea_override', matchedIntent: 'emergency', matchedProblemType: 'emergency_unspecified' };
    }
    
    // SAFETY-8: Explicit emergency plumber request - bypass AI triage
    // Exclude question formats like "Is there an emergency plumber?" or "Do you have emergency services?"
    const isEmergencyQuestion = /^(?:is\s+there|do\s+you\s+have|are\s+there|does\s+your|can\s+you|what\s+is)/i.test(msg) ||
                                /\b(?:available|services?|offer|provide)\s*\??\s*$/i.test(msg);
    const hasExplicitEmergencyRequest = !isEmergencyQuestion && (
      /\b(?:emergency\s+plumber|plumber\s+emergency)\s*(?:needed|now|asap|immediately)?\b/i.test(msg) ||
      /\bneed\s+(?:an?\s+)?(?:emergency\s+)?plumber\s+(?:now|asap|immediately|urgently|right\s+away)\b/i.test(msg));
    
    if (hasExplicitEmergencyRequest) {
      return { confidence: 'high', reason: 'explicit_emergency_request', matchedIntent: 'emergency', matchedProblemType: 'emergency_unspecified' };
    }
    
    // SAFETY-9: No water with vulnerable persons - habitability emergency
    const hasNoWaterVulnerable = 
      /\bno\s+water\s+(?:and|with)\s+(?:we\s+)?(?:have\s+)?(?:a\s+)?(?:baby|infant|newborn|toddler|child|elderly|disabled)\b/i.test(msg) ||
      /\b(?:baby|infant|newborn|toddler|elderly)\b.*\bno\s+water\b/i.test(msg) ||
      /\bno\s+water.*\b(?:baby|infant|newborn|toddler|elderly)\b/i.test(msg);
    
    if (hasNoWaterVulnerable) {
      return { confidence: 'high', reason: 'no_water_vulnerable_persons', matchedIntent: 'emergency', matchedProblemType: 'no_water_house' };
    }
    
    // SAFETY-10: Pump alarms - immediate attention needed
    const hasPumpAlarm = 
      /\b(?:sump|ejector)\s*(?:pump)?\s*(?:alarm|alert)\s*(?:going\s+off|is\s+on|beeping)?\b/i.test(msg) ||
      /\b(?:alarm|alert)\s*(?:going\s+off|is\s+on|beeping).*(?:sump|ejector)\b/i.test(msg);
    
    if (hasPumpAlarm) {
      const pumpType = /ejector/i.test(msg) ? 'ejector_pump_alarm' : 'sump_pump_alarm';
      return { confidence: 'high', reason: 'pump_alarm_emergency', matchedIntent: 'emergency', matchedProblemType: pumpType };
    }
    
    // SAFETY-11: Single toilet habitability - only toilet won't work
    const hasSingleToiletEmergency = 
      /\b(?:only|one|single)\s+toilet\s+(?:and\s+)?(?:it\s+)?(?:won'?t|can'?t|doesn'?t)\s+(?:flush|work)\b/i.test(msg) ||
      /\bonly\s+(?:have\s+)?(?:one|1)\s+toilet\b.*(?:won'?t|can'?t|broken|clogged)\b/i.test(msg);
    
    if (hasSingleToiletEmergency) {
      return { confidence: 'high', reason: 'single_toilet_habitability', matchedIntent: 'emergency', matchedProblemType: 'toilet_clogged' };
    }
    
    // SAFETY-12: After-hours no water - urgent habitability
    const hasAfterHoursNoWater = 
      /\b(?:it'?s?\s+)?\d+\s*(?:am|pm)\s+(?:and\s+)?(?:we\s+have\s+)?no\s+water\b/i.test(msg) ||
      /\bno\s+water.*(?:it'?s?\s+)?\d+\s*(?:am|pm)\b/i.test(msg) ||
      /\bmiddle\s+of\s+(?:the\s+)?night.*no\s+water\b/i.test(msg);
    
    if (hasAfterHoursNoWater) {
      return { confidence: 'high', reason: 'after_hours_no_water', matchedIntent: 'emergency', matchedProblemType: 'no_water_house' };
    }
    
    // SAFETY-13: Sudden water loss - urgent
    const hasSuddenWaterLoss = 
      /\bwater\s+(?:suddenly|just)\s+stopped\b/i.test(msg) ||
      /\b(?:suddenly|just)\s+(?:lost|have\s+no)\s+water\b/i.test(msg);
    
    if (hasSuddenWaterLoss) {
      return { confidence: 'high', reason: 'sudden_water_loss', matchedIntent: 'emergency', matchedProblemType: 'no_water_house' };
    }
    
    // SAFETY-14: Well pump failure - no water source
    const hasWellPumpFailure = 
      /\bwell\s+(?:pump\s+)?(?:failed|stopped|quit|not\s+working)\b/i.test(msg);
    
    if (hasWellPumpFailure) {
      return { confidence: 'high', reason: 'well_pump_failure', matchedIntent: 'emergency', matchedProblemType: 'well_pump_failure' };
    }
    
    // SAFETY-7C: Multiple fixtures backing up with sewage - sewer line emergency
    const hasMultiFixtureBackup = /\b(?:toilet|sink|shower|tub|drain)s?\s+(?:and|&)\s+(?:toilet|sink|shower|tub|drain)s?\b/i.test(msg) &&
                                   /\b(?:backing\s*up|backed\s*up|sewage|overflow|backing)\b/i.test(msg);
    
    if (hasMultiFixtureBackup) {
      return { confidence: 'high', reason: 'multi_fixture_backup_emergency', matchedIntent: 'emergency', matchedProblemType: 'sewer_backup' };
    }
    
    // Check if any emergency safety gate pattern matches
    // Skip gas patterns (index 0) if this is a gas appliance type mention
    const matchesEmergencyGate = EMERGENCY_SAFETY_GATE.some((pattern, index) => {
      if (index === 0 && isGasApplianceTypeMention) {
        return false;
      }
      return pattern.test(msg);
    });
    
    // If it's a water heater emergency, return HIGH confidence with water_heater_burst
    // This preserves water heater context instead of generic pipe_burst
    if (isWaterHeaterEmergency) {
      return {
        confidence: 'high',
        reason: 'water_heater_emergency',
        matchedIntent: 'emergency',
        matchedProblemType: 'water_heater_burst',
        requiresAI: false,
        safetyPreambleRequired: true
      };
    }
    
    if (!isInBookingFlow && !hasInstallIntent && !isToiletNonEmergency && !isShowerHeadMalfunction && !isGasApplianceTypeMention && !isDisposalBackingUp && matchesEmergencyGate) {
      return {
        confidence: 'emergency_triage',
        reason: 'safety_gate_triggered',
        matchedIntent: 'emergency',
