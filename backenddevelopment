// PROBLEM TYPE AUTHORITY SYSTEM
// Prevents lower-priority sources from overwriting higher-priority classifications
// =============================================================================
const PROBLEM_TYPE_PRIORITY = {
  customer_correction: 1,  // "actually it's the toilet" - highest authority
  emergency: 2,            // Safety-critical classification
  fixture_correction: 3,   // Customer clarifies fixture mid-conversation
  specific_compound: 4,    // toilet_clogged (specific fixture+problem detected together)
  multi_intent_extraction: 5, // FIX 3D: Multi-intent with specific type (e.g., "disposal leaking at 123 Main")
  location_refinement: 6,  // sink_kitchen, sink_bathroom (location only, no problem) - should NOT overwrite problems
  ai_classification: 7,    // AI-determined type
  generic_compound: 8,     // Generic problem + fixture context combined
  generic_pattern: 9,      // Generic "clog", "leak" without fixture
  initial: 10              // First extraction, lowest priority
};

// Helper: Set problemType only if new source has higher or equal priority
// AUTO-SETS isEmergency and isInstall flags based on problem type
function setProblemTypeIfAllowed(booking, newType, source) {
  if (!newType) return false;
  
  // LOCK DURING BOOKING: Once in booking stages, problem type is locked
  // Exception: Emergency upgrades are always allowed (safety first)
  const inBookingStage = booking.stage === 'booking_details' || booking.stage === 'awaiting_confirmation';
  if (inBookingStage && booking.problemType && source !== 'emergency') {
    return false; // Locked - don't change problem during booking
  }
  
  const currentPriority = PROBLEM_TYPE_PRIORITY[booking.problemTypeSource] || 999;
  const newPriority = PROBLEM_TYPE_PRIORITY[source] || 999;
  
  // Allow if: no current type, OR new source is higher/equal priority
  if (!booking.problemType || newPriority <= currentPriority) {
    booking.problemType = newType;
    booking.problemTypeSource = source;
    
    // =================================================================
    // AUTO-SET isEmergency when emergency problem type is detected
    // =================================================================
    const emergencyTypes = ['gas_smell', 'gas_leak', 'pipe_burst', 'pipe_frozen', 'sewer_basement_flood', 
      'toilet_overflowing', 'septic_backup', 'ejector_pump_overflow', 'water_heater_gas_leak',
      'water_heater_burst', 'water_heater_leaking',
      'flooding', 'sewage_backup', 'sewage_emergency', 'basement_flood', 'sewer_backup',
      'no_water_house', 'whole_house_no_water', 'washer_leaking'];
    if (emergencyTypes.includes(newType)) {
      booking.isEmergency = true;
    }
    
    // =================================================================
    // AUTO-SET isInstall when install problem type is detected
    // =================================================================
    if (newType.includes('_install') || newType.includes('install_') || 
        newType === 'fridge_water_line' || newType === 'ice_maker_line_install' ||
        newType === 'tub_to_shower_conversion' || newType === 'repipe' ||
        newType.endsWith('_hookup')) {
      booking.isInstall = true;
    }
    
    return true;
  }
  
  return false; // Blocked - current source has higher priority
}

