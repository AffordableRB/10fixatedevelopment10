          // =================================================================
          // HIGH-CONFIDENCE SINK SHORT-CIRCUIT: Skip diagnostics for clear problems
          // "completely clogged", "totally blocked" = severity already known
          // =================================================================
          const sinkHighConfidence = (
            updatedBooking.problemType === 'sink_clogged' &&
            /\b(?:completely|totally|fully|100%|entirely)\s*(?:clogged|blocked)\b/i.test(customerMessage)
          ) || (
            updatedBooking.problemType === 'sink_backing_up' &&
            /\b(?:backing\s*up|backed\s*up)\b/i.test(customerMessage)
          );
          
          if (sinkHighConfidence) {
            updatedBooking.stage = 'booking_details';
            updatedBooking.highConfidenceDetection = true;
            bookingData.set(customerKey, updatedBooking);
            
            const safetyMsg = updatedBooking.problemType === 'sink_clogged' 
              ? "Avoid using that sink for now so it doesn't back up. "
              : "";
            
            return {
              response: safetyMsg + RESPONSE_TEMPLATES.getSmartBookingRequest(updatedBooking, "Got it, let's get you booked. "),
