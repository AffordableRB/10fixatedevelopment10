      const isServiceInquiry = /\b(?:do\s+(?:you|u|y'?all)\s+(?:guys?\s+)?(?:do|offer|handle|provide)|can\s+(?:you|u|y'?all)\s+(?:guys?\s+)?(?:do|install|help\s+with)|(?:you|u)\s+(?:guys?\s+)?(?:do|offer)\s+(?:install|installation)|wanna\s+ask\s+if\s+(?:you|u)\s+do)\b/i.test(normalizedMessage);
