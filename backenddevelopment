          }
          
          // =================================================================
          // GARBAGE DISPOSAL SHORT-CIRCUIT: "not working" is specific enough
          // =================================================================
          if (updatedBooking.problemType === 'garbage_disposal_not_working' ||
              (updatedBooking.problemType && updatedBooking.problemType.startsWith('garbage_disposal') &&
               /\b(?:not\s*working|broken|dead|won'?t\s*(?:turn|run|start)|doesn'?t\s*(?:turn|run|work))\b/i.test(customerMessage))) {
            updatedBooking.stage = 'booking_details';
            updatedBooking.highConfidenceDetection = true;
            bookingData.set(customerKey, updatedBooking);
            
            return {
              response: "Don't keep trying to run it until we take a look. " + RESPONSE_TEMPLATES.getSmartBookingRequest(updatedBooking, "Let's get you booked. "),
              booking: updatedBooking,
              debug: {
                intent: 'garbage_disposal_shortcircuit',
                stage: 'booking_details',
