          else if (/\b(?:water\s*heater|hot\s*water)\b/i.test(msgLower)) installItem = 'water_heater';
          else if (/\bdishwasher\b/i.test(msgLower)) installItem = 'dishwasher';
          else if (/\b(?:washing\s*machine|washer)\b/i.test(msgLower)) installItem = 'washer';
