  // Get all items by exposure level
  getByExposureLevel: function(level) {
    const results = [];
    const searchIn = (obj) => {
      for (const item of Object.values(obj)) {
        if (item.exposure_level === level) {
          results.push(item);
        }
      }
    };
    searchIn(this.primary_fixtures);
    searchIn(this.components);
    searchIn(this.specialty);
    return results;
  },
  
  // Get all items by category
  getByCategory: function(category) {
    const results = [];
    const searchIn = (obj) => {
      for (const item of Object.values(obj)) {
        if (item.category === category) {
          results.push(item);
        }
      }
    };
    searchIn(this.primary_fixtures);
    searchIn(this.components);
    searchIn(this.specialty);
    return results;
  },
  
  // Get dependencies for a primary install
  getDependencies: function(primaryInstallId) {
    const primary = this.primary_fixtures[primaryInstallId];
    if (!primary || !primary.dependencies) return [];
    
    return primary.dependencies.map(depId => {
      return this.components[depId] || this.specialty[depId] || { id: depId, name: depId };
    });
  },
  
  // Get all items associated with a primary install
  getAssociatedComponents: function(primaryInstallId) {
    const results = [];
    const searchIn = (obj) => {
      for (const item of Object.values(obj)) {
        if (item.associated_primary_installs && 
            item.associated_primary_installs.includes(primaryInstallId)) {
          results.push(item);
        }
      }
    };
    searchIn(this.components);
    searchIn(this.specialty);
    return results;
  },
  
  // Check if an item is booking-enabled (primary fixture)
  isBookingEnabled: function(itemId) {
    const primary = this.primary_fixtures[itemId];
    return primary ? primary.booking_enabled : false;
  },
  
  // Get all primary fixture IDs (for validation)
  getPrimaryFixtureIds: function() {
    return Object.keys(this.primary_fixtures);
  },
  
  // Lookup any item by ID
  getById: function(itemId) {
    return this.primary_fixtures[itemId] || 
           this.components[itemId] || 
           this.specialty[itemId] || 
           null;
  }
};

