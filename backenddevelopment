        };
      case 'carbon_monoxide':
        return {
          safety: "!!  CO SAFETY: Leave the house NOW with everyone including pets. Carbon monoxide is deadly and odorless. Call 911 from outside. Do NOT go back in until cleared by fire department.",
          followUp: "Are you outside and safe?",
