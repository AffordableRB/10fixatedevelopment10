            if (/\b(air\s*gap)\b/i.test(m)) return 'dishwasher_air_gap';
            // Washer types - require "washing machine" or exclude faucet washer context
            if (/\b(washing\s+machine|washer\s+machine|clothes\s+washer|laundry\s+machine).*(?:overflow)\b/i.test(m)) return 'washer_overflow';
            if (/\b(washing\s+machine|washer\s+machine|clothes\s+washer).*(?:drain.*backup|backup.*drain)\b/i.test(m)) return 'washer_drain_backup';
            if (/\b(washing\s+machine|washer\s+machine|clothes\s+washer).*(?:supply|hose).*(?:leak)\b/i.test(m)) return 'washer_supply_leak';
            if (/\b(washer\s*box|laundry\s*box|outlet\s*box)\b/i.test(m)) return 'washer_box_leak';
            if (/\b(washing\s+machine|washer\s+machine|clothes\s+washer|laundry\s+machine).*(?:leak|leaking|water\s+under|puddle)\b/i.test(m)) return 'washer_leak';
            if (/\b(washer|laundry).*(?:leak|leaking|water\s+under|puddle)\b/i.test(m) && !/\b(?:faucet|replace|replacing|replaced|new)\s*washer\b/i.test(m)) return 'washer_leak';
            if (/\b(washing\s+machine|washer\s+machine|clothes\s+washer).*(?:won'?t\s+drain|not\s+draining|standing\s+water)\b/i.test(m)) return 'washer_no_drain';
            if (/\b(washing\s+machine|washer\s+machine|clothes\s+washer).*(?:install|hook\s*up|connect|replace|new)\b/i.test(m)) return 'washer_install';
            // Fridge/ice maker types
            if (/\b(fridge|refrigerator).*(?:water\s*line|supply\s*line)\b/i.test(m)) return 'fridge_water_line';
            if (/\b(fridge|refrigerator).*(?:leak|water|puddle)\b/i.test(m)) return 'fridge_leak';
            if (/\b(ice\s*maker).*(?:leak|leaking|drip)\b/i.test(m)) return 'ice_maker_leak';
            if (/\b(ice\s*maker)\b/i.test(m)) return 'ice_maker_no_water';
          }
          
          // OUTDOOR subtypes (8 categories) - FROZEN first (urgent)
          if (category === 'outdoor') {
            if (/\b(outdoor\s*faucet|outside\s*faucet|hose\s*bib|spigot).*(?:frozen|froze|freeze)\b/i.test(m) ||
                /\b(frozen|froze).*(?:outdoor\s*faucet|outside\s*faucet|hose\s*bib|spigot)\b/i.test(m)) return 'hose_bib_frozen';
            if (/\b(hose\s*bib|spigot).*(?:leak)\b/i.test(m)) return 'hose_bib_leak';
            if (/\b(outdoor\s*faucet|outside\s*faucet|hose\s*bib|spigot).*(?:stuck|won'?t\s+turn)\b/i.test(m)) return 'outdoor_faucet_stuck';
            if (/\b(sprinkler|irrigation|drip\s*line|yard\s*line|lawn\s*system).*(?:leak|broken|not\s*working)\b/i.test(m)) return 'sprinkler_leak';
            if (/\b(outside|outdoor|exterior).*(?:pipe|pipes).*(?:frozen|froze)\b/i.test(m)) return 'exterior_pipe_freeze';
            if (/\b(water\s*meter).*(?:leak)\b/i.test(m)) return 'water_meter_leak';
            if (/\b(yard|lawn|garden).*(?:flood|flooding|water|soggy|wet)\b/i.test(m)) return 'yard_flooding';
            if (/\b(sump\s*pump)\b/i.test(m)) return 'sump_pump';
          }
          
          return null; // No specific subtype detected
        };
        
        // SAFE REFINEMENT: Use new system to upgrade problem type
        // Refinement safety guarantees:
        // - NEVER allows cross-category switches (toilet → leak, sink → drain)
        // - NEVER allows late-message switching after lock
        // - NEVER allows over-refinement (downgrade from specific to general)
        // - NEVER allows looping due to subtype changes
        
        // Try refinement using both old detection and new pattern matching
        const detectedSubtype = detectSubtypeFromMessage(currentCategory, customerMessage);
        const patternRefinedType = getRefinedProblemType(currentProblemType, customerMessage, false); // Always check pattern
        
        // Prioritize pattern-matched refinement, fallback to detected subtype
        let refinedType = patternRefinedType;
        if (refinedType === currentProblemType && detectedSubtype) {
          // Pattern didn't refine, try detected subtype
          const detectedRefined = getRefinedProblemType(currentProblemType, detectedSubtype, false);
          if (detectedRefined !== currentProblemType) {
            refinedType = detectedRefined;
          }
        }
        
        // Apply refinement with strict lock enforcement
        if (refinedType !== currentProblemType) {
          if (updatedBooking.refinementLocked) {
            // LOCKED: Only allow if it's a valid subtype upgrade (same category, higher severity)
            if (isValidSubtypeUpgrade(currentProblemType, refinedType)) {
              setProblemTypeIfAllowed(updatedBooking, refinedType, updatedBooking.problemTypeSource || 'specific_compound');
              bookingData.set(customerKey, updatedBooking);
            }
            // Otherwise: Ignore refinement, keep current type
          } else {
            // NOT LOCKED: Allow refinement
            setProblemTypeIfAllowed(updatedBooking, refinedType, updatedBooking.problemTypeSource || 'specific_compound');
            bookingData.set(customerKey, updatedBooking);
          }
        }
        
        // FIX 5: Deduplication - don't re-ask the same diagnostic question
        const questionKey = `${updatedBooking.problemType}_q${updatedBooking.diagnosticCount || 1}`;
        if (updatedBooking.diagnosticQuestionsAsked && 
            updatedBooking.diagnosticQuestionsAsked.includes(questionKey)) {
          // Already asked this exact question - skip to booking
          // FIX 14: Build secondary responses BEFORE returning (handle service area, price questions)
          const serviceAreasDedup = SERVICE_AREAS.get(context);
          let dedupSecondaryResponses = [];
          if (intent.allIntents && intent.allIntents.length > 0) {
            for (const singleIntent of intent.allIntents) {
              if (singleIntent.intent === 'company_question') {
