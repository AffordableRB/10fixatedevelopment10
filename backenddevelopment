      const isEmergencyInformational = /\b(?:emergency|urgent)\s+(?:contact|number|phone|line|hours)\b/i.test(normalizedMessage) ||
                                        /\b(?:what|do\s+you\s+have|is\s+there)\b.*\b(?:emergency)\b.*\b(?:contact|number|phone|line)\b/i.test(normalizedMessage) ||
