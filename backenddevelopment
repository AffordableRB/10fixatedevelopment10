    // === LAUNDRY/UTILITY SINK DRAIN ===
    else if (/\b(?:laundry|utility|basement)\s+(?:room\s+)?(?:sink)\s+(?:won'?t|wont|doesn'?t|not)\s+drain\b/i.test(message)) {
