        // EMERGENCY LOOP PREVENTION: If we've asked for name 3+ times, try harder to extract it
        if (currentBooking.emergencyNameAsks >= 3 && !currentBooking.name) {
          const words = customerMessage.trim().split(/\s+/);
          if (words.length >= 2 && words.length <= 4) {
            const possibleName = words
              .map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())
              .join(' ');
            if (/^[A-Z][a-z]+\s+[A-Z][a-z]+/.test(possibleName)) {
              currentBooking.name = possibleName;
              bookingData.set(customerKey, currentBooking);
