          // LEAK subtypes
          if (category === 'leak') {
            if (/\b(ceiling|from\s+above|upstairs|dripping\s+from\s+ceiling)\b/i.test(m)) return 'leak_ceiling';
            if (/\b(under\s+sink|below\s+sink|cabinet|under\s+the\s+sink)\b/i.test(m)) return 'leak_under_sink';
