    else if (/\b(?:rough-?in|rough\s+in)\s+(?:plumbing|work|inspection)?\b/i.test(message) ||
             /\b(?:plumbing|bathroom|kitchen|basement)\s+rough-?in\b/i.test(message) ||
             /\bneed\s+(?:a\s+)?(?:plumbing\s+)?rough-?in\b/i.test(message) ||
             /\brough\s+in\s+(?:for\s+)?(?:bathroom|kitchen|basement|addition)\b/i.test(message) ||
             /\b(?:pre-?drywall|before\s+drywall)\s+(?:plumbing|pluming|plumming|inspection)\b/i.test(message) ||
             /\bstub-?(?:out|up)s?\s+(?:plumbing|for)?\b/i.test(message) ||
             /\bstub\s+out\s+(?:plumbing|for|the)?\b/i.test(message) ||
             /\bplumbing\s+(?:stub-?outs?|stubs)\b/i.test(message) ||
             /\b(?:top-?out|top\s+out)\s+(?:plumbing|inspection)\b/i.test(message) ||
             /\bunderground\s+(?:plumbing|rough)\b/i.test(message) ||
             /\brough\s+plumbing\b/i.test(message)) {
      entities.problemType = 'rough_in';
      entities.isInstall = true;
      entities.isConstruction = true;
    }
    
    // === REPIPE (whole house or partial) ===
    else if (/\b(?:repipe|repiped|re-?pipe|re-?piped|repiping|re-?piping)\b/i.test(message) ||
             /\b(?:whole\s*house|entire\s*house)\s+(?:repipe|piping|pipes)\b/i.test(message) ||
             /\breplace\s+(?:all\s+)?(?:the\s+)?(?:pipes|piping|plumbing)\b/i.test(message) ||
             /\b(?:house|home)\s+(?:needs?|requires?)\s+(?:re-?pipe|repiping|new\s+pipes?)\b/i.test(message) ||
             /\b(?:galvanized|polybutylene|poly|lead)\s+(?:pipes?|plumbing).*(?:replace|repipe)\b/i.test(message) ||
             /\b(?:replace|replacing).*(?:galvanized|polybutylene|poly|lead)\s+(?:pipes?|plumbing)\b/i.test(message)) {
      entities.problemType = 'repipe';
      entities.isInstall = true;
      entities.isConstruction = true;
    }
    
    // === BATHROOM/KITCHEN REMODEL ===
    else if (/\b(?:bathroom|bath|kitchen)\s+(?:remodel|renovation|reno|gut|update|plumbing\s+update)\b/i.test(message) ||
             /\b(?:remodel|renovation|reno|gut|updating|renovating).*(?:bathroom|bath|kitchen)\b/i.test(message) ||
             /\b(?:gutting|tearing\s+out)\s+(?:the\s+)?(?:bathroom|kitchen)\b/i.test(message)) {
      entities.problemType = 'remodel_plumbing';
      entities.isInstall = true;
      entities.isConstruction = true;
    }
    
    // === ADDITION / NEW CONSTRUCTION ===
    else if (/\b(?:new\s+construction|addition|adding\s+(?:a\s+)?(?:bathroom|half\s*bath))\b/i.test(message) ||
             /\b(?:building|adding)\s+(?:a\s+)?(?:new\s+)?(?:bathroom|half\s*bath|powder\s*room)\b/i.test(message)) {
      entities.problemType = 'new_construction_plumbing';
      entities.isInstall = true;
      entities.isConstruction = true;
    }
    
    // === FIXTURE RELOCATION ===
    else if (/\b(?:move|relocate|moving|relocating)\s+(?:the\s+)?(?:toilet|sink|shower|tub|washer|dryer)\b/i.test(message) ||
             /\b(?:toilet|sink|shower|tub)\s+(?:relocation|moved|move)\b/i.test(message)) {
      entities.problemType = 'fixture_relocation';
      entities.isInstall = true;
      entities.isConstruction = true;
    }
    // === COMMERCIAL / TENANT IMPROVEMENT ===
    else if (/\b(?:commercial|restaurant|retail|office|medical|dental)\s+(?:plumbing|project|build-?out|buildout|space)\b/i.test(message) ||
             /\b(?:retail|office)\s+space\s+plumbing\b/i.test(message) ||
             /\b(?:tenant\s+improvement|ti\s+project|ti\s+plumbing|build-?out|buildout)\b/i.test(message) ||
             /\b(?:commercial|business)\s+(?:bathroom|restroom|kitchen)\b/i.test(message) ||
             /\b(?:office|retail)\s+(?:bathroom|restroom)\b/i.test(message)) {
      entities.problemType = 'commercial_project';
      entities.isInstall = true;
      entities.isConstruction = true;
    }
    // === BASEMENT FINISH ===
    else if (/\b(?:basement|lower\s+level).*(?:finish|finishing|bathroom|plumbing|remodel)\b/i.test(message) ||
             /\b(?:finish|finishing).*(?:basement|lower\s+level)\b/i.test(message) ||
             /\badd.*(?:bathroom|plumbing|sink|toilet).*basement\b/i.test(message) ||
             /\bbasement\s+(?:bath|bathroom|rough-?in|plumbing|buildout|build-?out)\b/i.test(message) ||
             /\b(?:putting|adding|installing)\s+(?:a\s+)?(?:bathroom|bath).*(?:in\s+)?(?:the\s+)?basement\b/i.test(message) ||
             /\bbasement\s+(?:wet\s*bar|kitchenette|laundry)\b/i.test(message) ||
             /\b(?:wet\s*bar|kitchenette|laundry)\s+(?:in\s+(?:the\s+)?)?basement\b/i.test(message) ||
             /\b(?:need|want).*(?:plumbing|bathroom).*basement\b/i.test(message)) {
      entities.problemType = 'basement_finish';
      entities.isInstall = true;
      entities.isConstruction = true;
    }
    // === ADD BATHROOM ===
    else if (/\b(?:add|adding|install|put\s+in)\s+(?:a\s+)?(?:new\s+)?(?:bathroom|half\s*bath|full\s*bath|powder\s*room)\b/i.test(message) ||
             /\b(?:new|another|second|2nd|extra)\s+(?:full\s+)?(?:bathroom|half\s*bath|full\s*bath)\b/i.test(message) ||
             /\b(?:doing|building|putting\s+in)\s+(?:a\s+)?(?:new\s+)?(?:full\s+)?(?:bathroom|bath|half\s*bath)\b/i.test(message) ||
             /\b(?:bathroom|half\s*bath)\s+(?:addition|install)\b/i.test(message)) {
      entities.problemType = 'add_bathroom';
      entities.isInstall = true;
      entities.isConstruction = true;
    }
    // === ADDITION PLUMBING ===
    else if (/\b(?:home\s+)?addition.*(?:plumbing|bathroom|kitchen)\b/i.test(message) ||
             /\b(?:plumbing|bathroom|kitchen).*(?:home\s+)?addition\b/i.test(message) ||
             /\b(?:adding|building|constructing)\s+(?:an?\s+)?(?:addition|extension|wing|room)\b/i.test(message) ||
             /\b(?:new|building\s+a)\s+(?:addition|wing|extension)\b/i.test(message) ||
             /\baddition\s+(?:needs?|requires?)\s+plumbing\b/i.test(message) ||
             /\b(?:room|master|bedroom)\s+addition.*(?:bath|plumb)\b/i.test(message) ||
             /\b(?:home|house)\s+addition\b/i.test(message) ||
             /\b(?:extension)\s+plumbing\b/i.test(message) ||
             /\badding\s+(?:on)?to\s+(?:the\s+)?(?:house|home)\b/i.test(message)) {
      entities.problemType = 'addition_plumbing';
      entities.isInstall = true;
      entities.isConstruction = true;
    }
    // === TRIM OUT / FINISH PLUMBING (final fixture installation after drywall) ===
    else if (/\b(?:trim-?\s*out)\s+(?:plumbing|work|phase)?\b/i.test(message) ||
             /\b(?:plumbing)\s+(?:trim-?\s*out)\b/i.test(message) ||
             /\bfinish\s+(?:plumbing|fixtures)\b/i.test(message) ||
             /\b(?:install|set)\s+(?:final\s+)?(?:fixtures|toilets?\s+and\s+sinks?|sinks?\s+and\s+toilets?)\b/i.test(message) ||
             /\bfinal\s+(?:plumbing|fixture)\s+(?:install|hookup|hook-?up|connection|connections)\b/i.test(message) ||
             /\b(?:plumbing)\s+(?:connections?|hookups?|hook-?ups?)\b/i.test(message)) {
      entities.problemType = 'trim_out';
      entities.isInstall = true;
      entities.isConstruction = true;
    }
    // === GENERIC FIXTURE INSTALL (construction context) ===
    else if (/\b(?:install|installing|hookup|hook\s*up|set|setting)\s+(?:all\s+)?(?:the\s+)?(?:plumbing\s+)?(?:fixtures)\b/i.test(message) ||
             /\bfixture\s+(?:install|installation|hookup|set)\b/i.test(message) ||
             /\b(?:need|want)\s+(?:fixtures?)\s+(?:installed|hooked\s*up|set)\b/i.test(message)) {
      entities.problemType = 'fixture_install';
      entities.isInstall = true;
      entities.isConstruction = true;
    }
    // === GENERIC CONSTRUCTION/PROJECT FALLBACK ===
    else if (/\b(?:new\s+construction|construction\s+project|building\s+project)\b/i.test(message) ||
             /\b(?:contractor|builder|gc)\s+(?:needs?|looking\s+for|wants?)\s+(?:a\s+)?plumber\b/i.test(message) ||
             /\bplumb(?:ing|er)\s+(?:for|needed\s+for)\s+(?:new\s+)?(?:construction|build|project)\b/i.test(message)) {
      entities.problemType = 'new_construction_plumbing';
      entities.isInstall = true;
      entities.isConstruction = true;
    }
    // === DRAIN LINE INSTALL ===
    else if (/\b(?:install|add|run)\s+(?:a\s+)?(?:drain|drain\s+line|floor\s+drain)\b/i.test(message) ||
             /\b(?:floor\s+drain|drain\s+line)\s+(?:install|installation)\b/i.test(message) ||
             /\bneed\s+(?:a\s+)?(?:new\s+)?(?:floor\s+drain|drain\s+line)\b/i.test(message)) {
      entities.problemType = 'drain_install';
      entities.isInstall = true;
    }
    // === BACKFLOW PREVENTER INSTALL ===
    else if (/\b(?:install|add|need)\s+(?:a\s+)?(?:backflow\s+preventer|backflow\s+device)\b/i.test(message) ||
             /\b(?:city|code)\s+(?:requires?|requiring)\s+(?:backflow|installation)\b/i.test(message) ||
             /\b(?:backflow)\s+(?:install|installation)\b/i.test(message)) {
      entities.problemType = 'backflow_install';
      entities.isInstall = true;
    }
    // === GENERIC INSTALL TYPO ===
    else if (/\b(?:instal|instalation|installl?)\b.*\b(?:toilet|sink|faucet|shower|water\s*heater)\b/i.test(message)) {
      // Catch typos like "instalation", "instal"
      if (/toilet/i.test(message)) { entities.problemType = 'toilet_install'; }
      else if (/sink/i.test(message)) { entities.problemType = 'sink_install'; }
      else if (/faucet/i.test(message)) { entities.problemType = 'faucet_install'; }
      else if (/shower/i.test(message)) { entities.problemType = 'shower_install'; }
      else if (/water\s*heater/i.test(message)) { entities.problemType = 'water_heater_install'; }
      entities.isInstall = true;
    }
    // === GENERIC "NEED INSTALLED" PHRASE ===
    else if (/\bneed\s+(?:it\s+)?(?:installed|hooked\s*up|connected|put\s*in)\b/i.test(message) &&
             /\b(?:toilet|sink|faucet|shower|water\s*heater|disposal|dishwasher|washer|softener)\b/i.test(message)) {
      // Determine fixture type
      if (/toilet/i.test(message)) { entities.problemType = 'toilet_install'; }
      else if (/sink/i.test(message)) { entities.problemType = 'sink_install'; }
      else if (/faucet/i.test(message)) { entities.problemType = 'faucet_install'; }
      else if (/shower/i.test(message)) { entities.problemType = 'shower_install'; }
      else if (/water\s*heater/i.test(message)) { entities.problemType = 'water_heater_install'; }
      else if (/disposal/i.test(message)) { entities.problemType = 'garbage_disposal_install'; }
      else if (/dishwasher/i.test(message)) { entities.problemType = 'dishwasher_install'; }
      else if (/washer/i.test(message)) { entities.problemType = 'washer_install'; }
      else if (/softener/i.test(message)) { entities.problemType = 'water_softener_install'; }
      else { entities.problemType = 'generic_install'; }
      entities.isInstall = true;
    }
    
    // ================================================================
    // HIGH-PRIORITY EMERGENCY PATTERNS - Must be checked FIRST
    // ================================================================
    
    // ================================================================
    // SPECIALTY FIXTURES - Well, Watermain, Pressure, Radiant, Pool, etc.
    // ================================================================
    
    // === WELL SYSTEM ===
    else if (/\b(?:well|wel)\s*(?:pump).*(?:not\s+work|failed|dead|quit|won'?t\s+start|no\s+water)\b/i.test(message) ||
             /\b(?:no\s+water).*(?:well|pump)\b/i.test(message)) {
      entities.problemType = 'well_no_water';
      entities.fixture = 'well';
      entities.isEmergency = true;
    }
    else if (/\b(?:well).*(?:low\s+pressure|weak\s+pressure|pressure\s+low)\b/i.test(message) ||
             /\b(?:low|weak)\s+(?:water\s+)?pressure.*(?:well)\b/i.test(message)) {
      entities.problemType = 'well_low_pressure';
      entities.fixture = 'well';
    }
    else if (/\b(?:well).*(?:pressure\s+switch|switch)\b/i.test(message) ||
             /\b(?:pressure\s+switch).*(?:well|burned|failed|bad)\b/i.test(message)) {
      entities.problemType = 'well_pressure_switch';
      entities.fixture = 'well';
    }
    else if (/\b(?:well).*(?:pressure\s+tank|tank)\b/i.test(message) ||
             /\b(?:pressure\s+tank).*(?:waterlog|leak|replace)\b/i.test(message)) {
      entities.problemType = 'well_pressure_tank';
      entities.fixture = 'well';
    }
    else if (/\b(?:well).*(?:cap|cover|seal)\b/i.test(message) ||
             /\b(?:well\s+cap|well\s+cover)\b/i.test(message)) {
      entities.problemType = 'well_cap';
      entities.fixture = 'well';
    }
    else if (/\b(?:well).*(?:water\s+quality|brown|rusty|dirty|smell|sulfur|iron|sediment)\b/i.test(message) ||
             /\b(?:brown|rusty|dirty|smelly).*(?:well\s+water)\b/i.test(message)) {
      entities.problemType = 'well_water_quality';
      entities.fixture = 'well';
    }
    else if (/\b(?:well).*(?:pump).*(?:replace|install|new)\b/i.test(message) ||
             /\b(?:replace|install|new).*(?:well\s+pump)\b/i.test(message)) {
      entities.problemType = 'well_pump_replace';
      entities.fixture = 'well';
      entities.isInstall = true;
    }
    else if (/\b(?:well)\s*(?:pump|system|pressure)\b/i.test(message)) {
      entities.problemType = 'well_pump';
      entities.fixture = 'well';
    }
    // NEW: well_cycling - pump short cycling
    else if (/\b(?:well|pump).*(?:cycl|short\s*cycl|rapid|on\s+and\s+off|keeps\s+turn)\b/i.test(message) ||
             /\b(?:short\s*cycl|cycling).*(?:well|pump)\b/i.test(message)) {
      entities.problemType = 'well_cycling';
      entities.fixture = 'well';
    }
    // NEW: well_smell_taste - water quality smell/taste specific
    else if (/\b(?:well).*(?:smell|taste|stink|sulfur|rotten|iron|metallic)\b/i.test(message) ||
             /\b(?:well\s+water).*(?:smell|taste|bad|funny|off)\b/i.test(message) ||
             /\b(?:smell|taste).*(?:well\s+water)\b/i.test(message)) {
      entities.problemType = 'well_smell_taste';
      entities.fixture = 'well';
    }
    
    // === WATER PRESSURE ISSUES ===
    else if (/\b(?:water\s*hammer|pipes?\s+bang|banging\s+pipes?|hammering)\b/i.test(message) ||
             /\b(?:loud\s+bang|thump).*(?:pipe|plumbing|water)\b/i.test(message)) {
      entities.problemType = 'water_hammer';
      entities.fixture = 'pipe';
    }
    else if (/\b(?:prv|pressure\s+re(?:ducing|lief)\s+valve).*(?:leak|replace|bad|failed|issue)\b/i.test(message) ||
             /\b(?:replace|fix).*(?:prv|pressure\s+valve)\b/i.test(message)) {
      entities.problemType = 'prv_issue';
      entities.fixture = 'prv';
    }
    else if (/\b(?:prv|pressure\s+reducing\s+valve|pressure\s+regulator)\b/i.test(message)) {
      entities.problemType = 'prv';
      entities.fixture = 'prv';
    }
    else if (/\b(?:high\s+(?:water\s+)?pressure|pressure\s+(?:is\s+)?(?:too\s+)?high)\b/i.test(message) ||
             /\b(?:water|pressure).*(?:burst|blew|explode)\b/i.test(message)) {
      entities.problemType = 'water_pressure_high';
      entities.fixture = 'water_pressure';
    }
    else if (/\b(?:low\s+(?:water\s+)?pressure|pressure\s+(?:is\s+)?(?:too\s+)?low|weak\s+pressure)\b/i.test(message) ||
             /\b(?:barely|hardly)\s+(?:any\s+)?(?:water|pressure)\b/i.test(message)) {
      entities.problemType = 'water_pressure_low';
      entities.fixture = 'water_pressure';
    }
    else if (/\b(?:pressure).*(?:fluctuat|goes\s+up\s+and\s+down|inconsistent|varies)\b/i.test(message) ||
             /\b(?:water\s+pressure).*(?:change|surging)\b/i.test(message)) {
      entities.problemType = 'water_pressure_fluctuating';
      entities.fixture = 'water_pressure';
    }
    else if (/\b(?:no\s+water).*(?:whole\s+house|entire\s+house|anywhere|all\s+faucets?)\b/i.test(message) ||
             /\b(?:whole|entire)\s+house.*(?:no\s+water|lost\s+water)\b/i.test(message) ||
             /\b(?:nothing|not\s+anything)\s+(?:is\s+)?com(?:ing|es?)\s+out\b/i.test(message) ||
             /\bhave\s+nothing\s+coming\s+out\b/i.test(message)) {
      entities.problemType = 'no_water_house';
      entities.fixture = 'water_main';
      entities.isEmergency = true;
    }
    
    // === WATER MAIN ===
    else if (/\b(?:water\s*main|main\s+line|main\s+water).*(?:leak|burst|broke|gushing)\b/i.test(message) ||
             /\b(?:leak|burst|gushing).*(?:water\s*main|main\s+line|front\s+yard)\b/i.test(message) ||
             /\b(?:water|pipe).*(?:burst|gushing).*(?:yard|street|sidewalk|front)\b/i.test(message)) {
      entities.problemType = 'watermain_leak';
      entities.fixture = 'water_main';
      entities.isEmergency = true;
    }
    else if (/\b(?:water\s*main|main\s+line|service\s+line).*(?:no\s+water|lost\s+water|failure)\b/i.test(message) ||
             /\b(?:city|street).*(?:shut\s*off|no\s+water)\b/i.test(message) ||
             /\b(?:lost|no)\s+(?:all\s+)?water.*(?:house|home|whole|entire)\b/i.test(message)) {
      entities.problemType = 'watermain_no_water';
      entities.fixture = 'water_main';
      entities.isEmergency = true;
    }
    else if (/\b(?:curb\s*stop|curb\s+valve|street\s+valve).*(?:stuck|won'?t|broken|replace)\b/i.test(message) ||
             /\b(?:can'?t|won'?t).*(?:turn\s+off|shut\s*off).*(?:water|main)\b/i.test(message) ||
             /\b(?:can'?t|cannot)\s+(?:find|locate).*(?:shut\s*off|water)\b/i.test(message)) {
      entities.problemType = 'watermain_curb_stop';
      entities.fixture = 'water_main';
      entities.isEmergency = true;
    }
    // NEW: watermain_locate - finding shutoff/main
    else if (/\b(?:find|locate|where).*(?:main\s+shut\s*off|water\s+shut\s*off|main\s+valve)\b/i.test(message) ||
             /\b(?:main\s+shut\s*off|water\s+shut\s*off).*(?:find|locate|where)\b/i.test(message) ||
             /\bfind\s+(?:my\s+)?(?:main|water)\s+shut\s*off\b/i.test(message)) {
      entities.problemType = 'watermain_locate';
      entities.fixture = 'water_main';
    }
    // NEW: watermain_tap - new connection to city water
    else if (/\b(?:tap|connect|hook\s*up).*(?:city\s+water|municipal|water\s+main|street)\b/i.test(message) ||
             /\b(?:city\s+water|municipal).*(?:tap|connect|hook\s*up|connection)\b/i.test(message) ||
             /\b(?:new|add)\s+(?:water\s+)?connection\b/i.test(message) ||
             /\bwater\s+tap\b/i.test(message)) {
      entities.problemType = 'watermain_tap';
      entities.fixture = 'water_main';
      entities.isInstall = true;
    }
    // NEW: watermain_pressure - service line restriction/flow issues
    else if (/\b(?:service\s+line|water\s+main|main\s+line).*(?:restrict|pressure|flow)\b/i.test(message) ||
             /\b(?:restrict|low\s+flow).*(?:service\s+line|main)\b/i.test(message) ||
             /\bflow\s+restrict(?:ed|ion)?\b/i.test(message)) {
      entities.problemType = 'watermain_pressure';
      entities.fixture = 'water_main';
    }
    // NEW: watermain_replace - new water line from street
    else if (/\b(?:new|replace).*(?:water\s+line|service\s+line).*(?:street|main|city)\b/i.test(message) ||
             /\b(?:water\s+line|service\s+line).*(?:from\s+street|to\s+house|replacement)\b/i.test(message) ||
             /\breplace.*(?:service\s+line|water\s+main|main\s+line)\b/i.test(message)) {
      entities.problemType = 'watermain_replace';
      entities.fixture = 'water_main';
      entities.isInstall = true;
    }
    // NEW: watermain_meter - meter issues
    else if (/\b(?:water\s+)?meter.*(?:leak|broken|replace|damage|issue)\b/i.test(message) ||
             /\b(?:leak|broken|damage).*(?:water\s+)?meter\b/i.test(message) ||
             /\bmy\s+meter\s+(?:is\s+)?leak/i.test(message)) {
      entities.problemType = 'watermain_meter';
      entities.fixture = 'water_main';
    }
    else if (/\b(?:water\s*main|main\s+line).*(?:repair|replace|fix)\b/i.test(message) ||
             /\b(?:repair|replace|fix).*(?:water\s*main|main\s+line)\b/i.test(message) ||
             /\bwork\s+on\s+water\s+mains?\b/i.test(message)) {
      entities.problemType = 'watermain_repair';
      entities.fixture = 'water_main';
    }
    
    // === RADIANT / HYDRONIC HEATING ===
    else if (/\b(?:radiant|in-?floor|floor\s+heat).*(?:leak|leaking)\b/i.test(message) ||
             /\b(?:leak).*(?:radiant|floor\s+heat)\b/i.test(message)) {
      entities.problemType = 'radiant_leak';
      entities.fixture = 'radiant';
    }
    else if (/\b(?:radiant|in-?floor|floor\s+heat).*(?:not\s+work|no\s+heat|cold|won'?t\s+heat)\b/i.test(message)) {
      entities.problemType = 'radiant_no_heat';
      entities.fixture = 'radiant';
    }
    else if (/\b(?:radiant|in-?floor|floor\s+heat).*(?:install|new)\b/i.test(message) ||
             /\b(?:install).*(?:radiant|floor\s+heat)\b/i.test(message)) {
      entities.problemType = 'radiant_install';
      entities.fixture = 'radiant';
      entities.isInstall = true;
    }
    else if (/\b(?:zone\s*valve).*(?:stuck|leak|bad|replace|not\s+work)\b/i.test(message) ||
             /\b(?:heating\s+)?zone.*(?:not\s+work|no\s+heat|cold)\b/i.test(message)) {
      entities.problemType = 'zone_valve';
      entities.fixture = 'radiant';
    }
    else if (/\b(?:radiator).*(?:leak|leaking|drip)\b/i.test(message)) {
