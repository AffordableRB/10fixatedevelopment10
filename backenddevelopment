        }),
        signal: controller.signal
      });

      clearTimeout(timeoutId);

      if (!response.ok) {
        throw new Error(`AI triage failed: ${response.status}`);
      }

      const data = await response.json();
      const content = data.choices[0].message.content.trim();
      
      // Parse JSON response - handle potential markdown code blocks
      let jsonContent = content;
      if (content.startsWith('```')) {
        jsonContent = content.replace(/```json?\n?/g, '').replace(/```/g, '').trim();
      }
      
      const parsed = JSON.parse(jsonContent);
      
      // Validate required fields
      if (!parsed.classification || !parsed.routing || !parsed.response) {
        throw new Error('AI response missing required fields');
      }
      
      return {
        classification: parsed.classification,
        routing: parsed.routing,
        response: parsed.response,
        reasoning: parsed.reasoning || 'No reasoning provided'
      };
      
    } catch (error) {
      clearTimeout(timeoutId);
      
      if (error.name === 'AbortError') {
        console.error('Emergency triage timed out');
      } else {
        console.error('Emergency triage AI error:', error);
      }
      
      // Conservative fallback - Do NOT ask for address here, booking is handled separately
      return {
        classification: 'UNKNOWN',
        routing: 'CONSERVATIVE_FALLBACK',
        response: "This sounds like it could be urgent. If you smell gas, we strongly recommend leaving the house and calling your gas company or 911 - they test for free. If it's a water emergency, we can help right away.",
        reasoning: `AI error: ${error.message}, using conservative fallback`
      };
    }
  }

  // Keep legacy function for compatibility
  async function aiClassifyMessage(message, conversationContext = {}) {
    return aiConversationalAgent(message, conversationContext);
  }

  async function aiOpenerReasoning(message, conversationContext = {}) {
    return aiConversationalAgent(message, conversationContext);
  }

  async function processMessage(customerMessage, customerKey, context = {}) {
    try {
      // Input sanitization: reject messages over 5,000 characters
      if (!customerMessage || typeof customerMessage !== 'string') {
        return {
          response: RESPONSE_TEMPLATES.generalError(),
          error: 'Invalid message',
          debug: { error: 'Invalid message input', stage: 'error' },
          metadata: { error: true }
        };
      }
      
      if (customerMessage.length > MAX_MESSAGE_LENGTH) {
        return {
          response: 'Message too long. Please keep your message under 5,000 characters.',
          error: 'Message exceeds maximum length',
          debug: { error: 'Message too long', stage: 'error' },
          metadata: { error: true }
        };
      }
      
      // Rate limiting: 1 message per second per customer
      const now = Date.now();
      const lastTime = lastMessageTime.get(customerKey) || 0;
      if (!DISABLE_RATE_LIMIT && now - lastTime < RATE_LIMIT_MS) {
        return {
          response: 'Please wait a moment before sending another message.',
          error: 'Rate limited',
          debug: { error: 'Rate limited', stage: 'error' },
          metadata: { error: true, rateLimited: true }
        };
      }
      lastMessageTime.set(customerKey, now);
      
      // Update TTL timestamp for this customer
      dataTimestamps.set(customerKey, now);
      
      stats.totalMessages++;
      stats.customerMessages++;

      const fullContext = { ...context, customerKey, customerMessage };
      
      let currentBooking = getBookingData(customerKey);
      console.log('=== MESSAGE START ===', {
        customerMessage: customerMessage.substring(0, 50),
        stage: currentBooking.stage,
        emergencyEvaluated: currentBooking.emergencyEvaluated,
        emergencyModeActive: currentBooking.emergencyModeActive,
        closedReason: currentBooking.closedReason,
        bookingConfirmed: currentBooking.bookingConfirmed
      });

      // =============================================================================
      // FIX 1: GAS APPLIANCE TYPE CONTEXT GUARD
      // Prevents "gas" answer to "gas or electric?" from triggering false emergency
      // =============================================================================
      const isGasApplianceTypeAnswer = (() => {
        const msgLower = customerMessage.toLowerCase().trim();
        
        // Short "gas" answers that are clearly appliance type responses
        const isShortGasAnswer = /^(?:gas|its?\s+gas|gas\s+(?:water\s+)?heater|gas\s+unit|gas\s+one|the\s+gas\s+one|gas\s+type|gas\s+powered|i\s+have\s+gas|it'?s\s+a?\s*gas)\.?$/i.test(msgLower);
        
        // Also catch "gas" at start of longer message like "gas, about 10 years old"
        const startsWithGasAnswer = /^gas(?:\s*,|\s+(?:water\s+)?heater|\s+unit|\s+one)?(?:\s*,|\s+|$)/i.test(msgLower) && msgLower.length < 50;
        
        // Check if previous bot message asked about gas/electric
        const diagnosticHistory = currentBooking.diagnosticHistory || [];
        const lastBotMessage = diagnosticHistory
          .filter(m => m.role === 'plumber')
          .slice(-1)[0]?.content || '';
        const askedGasElectric = /\b(?:gas\s+or\s+electric|electric\s+or\s+gas|is\s+it\s+gas)\b/i.test(lastBotMessage);
        
        // Check if we're in water heater context
        const inWaterHeaterContext = currentBooking.problemType && 
          (currentBooking.problemType.includes('water_heater') || 
           currentBooking.problemType === 'water_heater_no_hot' ||
           currentBooking.problemType === 'water_heater_pilot' ||
           currentBooking.problemType === 'water_heater_burner');
        
        // Check if previous question was about appliance type
        const askedApplianceType = currentBooking.diagnosticSlots?.askedApplianceType === true;
        
        return (isShortGasAnswer || startsWithGasAnswer) && (askedGasElectric || inWaterHeaterContext || askedApplianceType);
      })();
      
      // If this is a gas appliance type answer, set the slot and skip emergency triage
      if (isGasApplianceTypeAnswer) {
        if (!currentBooking.diagnosticSlots) currentBooking.diagnosticSlots = {};
        currentBooking.diagnosticSlots.appliance_type = 'gas';
        currentBooking.gasApplianceTypeProvided = true;
        bookingData.set(customerKey, currentBooking);
      }
      
      // ================================================================
      // FIX 3: BOOKING COMPLETED - Prevent confirmation loop
      // If booking is already confirmed, only respond to change requests or new problems
      // ================================================================
      if (currentBooking.bookingConfirmed || currentBooking.stage === 'confirmed') {
        const wantsChange = /\b(?:change|cancel|reschedule|different|wrong|update|correct)\b/i.test(customerMessage);
        const hasNewProblem = /\b(?:also|another|different\s*(?:issue|problem)|new\s*(?:issue|problem))\b/i.test(customerMessage);
        
        if (!wantsChange && !hasNewProblem) {
          return {
            response: "You're all set! Our tech will text you when they're on the way. Anything else I can help with?",
            booking: currentBooking,
            debug: { intent: 'post_booking_followup', stage: 'confirmed' },
            metadata: { bookingAlreadyConfirmed: true }
          };
        }
        // If they want to change or have a new problem, reset and continue
        if (wantsChange) {
          currentBooking.stage = 'booking_details';
          currentBooking.bookingConfirmed = false;
          currentBooking.awaitingConfirmation = false;
          currentBooking.changePromptSent = true;  // Track that change prompt was sent
          bookingData.set(customerKey, currentBooking);
          return {
            response: "No problem - what would you like to change?",
            booking: currentBooking,
            debug: { intent: 'change_after_confirmation', stage: 'booking_details' },
            metadata: { changeRequested: true }
          };
        }
      }
      
      const updates = {};
      let diagnosticAck = '';
      let urgentSafetyMessage = '';
      
      // Reset per-turn AI flags for each new message
      currentBooking.aiClassificationAttempted = false;
      currentBooking.aiAgentUsedThisTurn = false;
      currentBooking.aiClassifiedThisTurn = false;
      
      // ================================================================
      // EARLY CONFIDENCE SCORING - Must happen BEFORE any response paths
      // This ensures all returns have access to confidence data
      // ================================================================
      const initialEntities = extractEntities(customerMessage, currentBooking.stage);
      const initialIntent = classifyIntent(customerMessage);
      fullContext.entities = initialEntities;

      // FIX: If previous question was about smell location and user answers with fixture
      const previousAskedAboutSmellLocation = (currentBooking.diagnosticHistory || []).some(msg =>
        msg.role === 'plumber' &&
        /smell/i.test(msg.content) &&
        /sink|toilet|shower|drain/i.test(msg.content) &&
        /coming from|from/i.test(msg.content)
      );
      
      if (previousAskedAboutSmellLocation && /\b(?:sink|kitchen\s+sink|bathroom\s+sink)\b/i.test(customerMessage)) {
        initialEntities.problemType = 'sink_smell';
        initialEntities.fixture = 'sink';
      }
      
      // PRODUCTION FIX: Persist fixture to booking state if detected (BEFORE confidence scoring)
      // This ensures fixture context is available for confidence scoring and all downstream handlers
      if (initialEntities.fixture && (!currentBooking.fixture || initialEntities.previousFixtureCleared)) {
        currentBooking.fixture = initialEntities.fixture;
        bookingData.set(customerKey, currentBooking);

      }
      
      // FIX: Combine generic problem + fixture from follow-up message
      // e.g., "something is clogged" (clog) + "the toilet" (toilet) → toilet_clogged
      if (initialEntities.fixture && currentBooking.problemType) {
        const genericProblems = {
          'clog': { 'toilet': 'toilet_clogged', 'sink': 'sink_clogged', 'shower': 'shower_drain_clogged', 'tub': 'tub_clogged', 'drain': 'drain_clogged' },
          'leak': { 'toilet': 'toilet_leaking', 'sink': 'sink_leaking', 'shower': 'shower_leaking', 'faucet': 'faucet_leaking', 'pipe': 'pipe_leaking' },
          'running': { 'toilet': 'toilet_running' },
          'overflow': { 'toilet': 'toilet_overflowing' },
          'wont_flush': { 'toilet': 'toilet_not_flushing' }
        };
        
        const mapping = genericProblems[currentBooking.problemType];
        if (mapping && mapping[initialEntities.fixture]) {
          const compoundType = mapping[initialEntities.fixture];
          setProblemTypeIfAllowed(currentBooking, compoundType, 'specific_compound');
          currentBooking.fixture = initialEntities.fixture;
          bookingData.set(customerKey, currentBooking);
        }
      }

      // FIX: Derive fixture from problemType if not already set
      // e.g., problemType "sink_clogged" → fixture "sink"
      if (!currentBooking.fixture && currentBooking.problemType) {
        const fixtureMatch = currentBooking.problemType.match(/^(toilet|sink|shower|tub|faucet|water_heater|drain|pipe)_/);
        if (fixtureMatch) {
          currentBooking.fixture = fixtureMatch[1];
          bookingData.set(customerKey, currentBooking);
        }
      }
      
      // ENHANCED FIXTURE CORRECTION: Detect when customer names a fixture
      // e.g., "something is clogged" (sink assumed) -> "the toilet" -> switch to toilet
      // Also handles: "toilet", "no no toilet", "it's the toilet", etc.
      
      // Detect fixture from single-word or short responses
      let detectedFixture = initialEntities.fixture;
      if (!detectedFixture) {
        const fixtureOnlyMatch = customerMessage.trim().match(/^(?:the\s+)?(?:it'?s?\s+)?(?:the\s+)?(toilet|sink|shower|tub|bathtub|faucet|water\s*heater|drain|pipe)s?$/i);
        if (fixtureOnlyMatch) {
          detectedFixture = fixtureOnlyMatch[1].toLowerCase().replace(/\s+/g, '_');
          if (detectedFixture === 'bathtub') detectedFixture = 'tub';
        }
      }
      
      if (detectedFixture && currentBooking.fixture && 
          detectedFixture !== currentBooking.fixture &&
          currentBooking.stage !== 'booking_details' && 
          currentBooking.stage !== 'awaiting_confirmation') {
        // Customer is clarifying the fixture - update both fixture and problemType
        const oldFixture = currentBooking.fixture;
        const newFixture = detectedFixture;
        currentBooking.fixture = newFixture;
        
        // Update problemType to match new fixture if it was based on old fixture
        if (currentBooking.problemType && currentBooking.problemType.startsWith(oldFixture + '_')) {
          const problemSuffix = currentBooking.problemType.replace(oldFixture + '_', '');
          setProblemTypeIfAllowed(currentBooking, newFixture + '_' + problemSuffix, 'fixture_correction');
        } else if (currentBooking.problemType === oldFixture) {
          setProblemTypeIfAllowed(currentBooking, newFixture, 'fixture_correction');
        } else if (currentBooking.problemType && !currentBooking.problemType.startsWith(newFixture)) {
          // Problem type from different fixture (like 'sink_clogged') - switch to new fixture
          const problemSuffix = currentBooking.problemType.replace(/^[a-z_]+_/, '');
          if (problemSuffix && problemSuffix !== currentBooking.problemType) {
            setProblemTypeIfAllowed(currentBooking, newFixture + '_' + problemSuffix, 'fixture_correction');
          } else {
            setProblemTypeIfAllowed(currentBooking, newFixture + '_clogged', 'fixture_correction');
          }
        }
        
        bookingData.set(customerKey, currentBooking);
      }

      // FIX: Early booking info extraction - capture name/address/city from any message
      // This allows "toilet clogged at 789 Pine St Toronto, this is Mike Johnson" to work
      if (currentBooking.stage === 'initial' || currentBooking.stage === 'problem_diagnosis') {
        if (initialEntities.name && !currentBooking.name) {
          currentBooking.name = initialEntities.name;
        }
        if (initialEntities.address && !currentBooking.address) {
          currentBooking.address = initialEntities.address;
        }
        if (initialEntities.city && !currentBooking.city) {
          currentBooking.city = initialEntities.city;
        }
        if (initialEntities.time && !currentBooking.timePreference) {
          currentBooking.timePreference = initialEntities.time;
        }
        bookingData.set(customerKey, currentBooking);

        // MULTI-INTENT FAST-TRACK: If customer provided problem + substantial booking info,
        // skip diagnostic questions and go straight to booking
        // e.g., "sink clogged at 789 Pine St Toronto, this is Mike Johnson"
        
        // FIX: Also check initialEntities.problemType since currentBooking.problemType
        // may not be set yet at this early stage in the 'initial' stage
        const effectiveProblemType = currentBooking.problemType || initialEntities.problemType;
        if (initialEntities.problemType && !currentBooking.problemType) {
          // FIX 3A: Use appropriate priority source based on problem type specificity
          // Compound types like garbage_disposal_leaking, toilet_clogged should use 'specific_compound'
          // Generic types like 'leak', 'clog' should use 'generic_pattern'
          const isSpecificCompound = initialEntities.problemType.includes('_') && 
            !['not_plumbing', 'no_water', 'low_pressure'].includes(initialEntities.problemType);
          const source = isSpecificCompound ? 'specific_compound' : 'generic_pattern';
          setProblemTypeIfAllowed(currentBooking, initialEntities.problemType, source);
          bookingData.set(customerKey, currentBooking);
        }
        
        const hasSubstantialBookingInfo = 
          (currentBooking.name && currentBooking.address) ||
          (currentBooking.name && currentBooking.city) ||
          (currentBooking.address && currentBooking.city);
        
        if (hasSubstantialBookingInfo && effectiveProblemType) {
          currentBooking.stage = 'booking_details';
          bookingData.set(customerKey, currentBooking);
          
          // Use smart booking request to only ask for missing fields
          const missing = [];
          if (!currentBooking.name) missing.push('name');
          if (!currentBooking.address) missing.push('address');
          if (!currentBooking.city) missing.push('city');
          if (!currentBooking.timePreference) missing.push('best time');
          
          let response;
          if (missing.length === 0) {
            // All info collected - go to confirmation
            currentBooking.stage = 'awaiting_confirmation';
            currentBooking.awaitingConfirmation = true;
            bookingData.set(customerKey, currentBooking);
            response = RESPONSE_TEMPLATES.bookingConfirmation(
              currentBooking.name,
              currentBooking.address,
              currentBooking.city,
              currentBooking.timePreference || 'ASAP',
              currentBooking.problemType,
              currentBooking.phone
            );
          } else if (missing.length === 1) {
            response = `Got it - ${getProblemDescription(currentBooking.problemType)}. I just need your ${missing[0]}.`;
          } else {
            response = `Got it - ${getProblemDescription(currentBooking.problemType)}. I just need your ${missing.slice(0, -1).join(', ')} and ${missing[missing.length - 1]}.`;
          }
          
          return {
            response,
            booking: currentBooking,
            debug: { intent: 'multi_intent_booking_fast_track', captured: { name: !!currentBooking.name, address: !!currentBooking.address, city: !!currentBooking.city } },
            metadata: { stage: currentBooking.stage, multiIntentFastTrack: true }
          };
        }
      }

      // BOOKING SIGNAL: If customer provides time preference during diagnosis,
      // they're signaling readiness to book - transition if problem type is known
      if (currentBooking.stage === 'problem_diagnosis' && 
          initialEntities.time && 
          currentBooking.problemType &&
          !currentBooking.bookingSignalChecked) {
        currentBooking.bookingSignalChecked = true;
        currentBooking.stage = 'booking_details';
        bookingData.set(customerKey, currentBooking);
        
        // Use smart booking request to only ask for missing fields
        const smartRequest = RESPONSE_TEMPLATES.getSmartBookingRequest(currentBooking, "Got it, let's get you booked. ");
        if (smartRequest) {
          return {
            response: smartRequest,
            booking: currentBooking,
            debug: { bookingSignal: 'time_preference', stage: 'booking_details' },
            metadata: { stage: 'booking_details', bookingSignal: true }
          };
        }
      }
      
      // CRITICAL: Refresh currentBooking after fixture correction and early info extraction
      // This ensures later code sees the updated problemType/fixture, not stale values
      currentBooking = getBookingData(customerKey);
      
      // UNIFIED FIX: Pass existing booking state to confidence scorer
      // This enables conversation-aware confidence (follow-ups get HIGH, not LOW)
      const initialConfidenceResult = REGEX_CONFIDENCE.score(
        customerMessage, 
        { 
          ...initialEntities, 
          stage: currentBooking.stage, 
          emergencyEvaluated: currentBooking.emergencyEvaluated,
          existingProblemType: currentBooking.problemType,
          existingFixture: currentBooking.fixture
        },
        initialIntent
      );
      
      // Store confidence immediately so ALL return paths have access
      currentBooking.lastConfidenceResult = initialConfidenceResult;
      AI_OUTPUT_GUARD.setConfidence(initialConfidenceResult.confidence);
      
      // ================================================================
      // APPLY REGEX_CONFIDENCE INSTALL DETECTION
      // When REGEX_CONFIDENCE detects a specific install type (e.g., gas_line_install),
      // apply it immediately so extraction patterns don't override it
      // ================================================================
      if (initialConfidenceResult.matchedIntent === 'installation' && 
          initialConfidenceResult.matchedProblemType &&
          initialConfidenceResult.matchedProblemType.includes('_install')) {
        initialEntities.problemType = initialConfidenceResult.matchedProblemType;
        initialEntities.isInstall = true;
        initialIntent.intent = 'installation';
      }
      
      // ================================================================
      // EMERGENCY CLARIFICATION STAGE - Re-triage after customer clarifies
      // ================================================================
      if (currentBooking.stage === 'emergency_clarification') {
        // Track clarification attempts to prevent infinite loops
        currentBooking.clarificationCount = (currentBooking.clarificationCount || 0) + 1;
        
        // After 2 clarification attempts, force proceed to booking
        if (currentBooking.clarificationCount >= 2) {
          currentBooking.stage = 'booking_details';
          currentBooking.emergencyEvaluated = true;
          currentBooking.emergencyPendingClassification = false;
          currentBooking.problemType = currentBooking.problemType || 'plumbing_issue';
          bookingData.set(customerKey, currentBooking);
          
          return {
            response: "Let's get a plumber out to take a look and diagnose the issue properly. Can I get your name and address?",
            booking: currentBooking,
            debug: { intent: 'clarification_timeout', clarificationCount: currentBooking.clarificationCount },
            metadata: { clarificationTimeout: true }
          };
        }
        
        // Re-run triage with new information (includes conversation history)
        const triageResult = await triageEmergencyWithAI(customerMessage, currentBooking, fullContext);
        
        // FIX H: Preserve water heater context for flooding/burst
        // If message mentions water heater and AI classifies as pipe_burst, override to water_heater_burst
        if (triageResult.classification === 'pipe_burst' || triageResult.classification === 'active_flooding') {
          const hasWaterHeaterContext = /\b(?:water\s*heater|hot\s*water\s*tank|water\s*heater\s*closet)\b/i.test(customerMessage);
          if (hasWaterHeaterContext) {
            triageResult.classification = 'water_heater_burst';
            triageResult.routing = 'urgent_plumbing';
            triageResult.reasoning = 'Water heater emergency - flooding/burst detected with water heater context';
          }
        }
        
        console.log('Emergency clarification triage:', {
          classification: triageResult.classification,
          routing: triageResult.routing,
          reasoning: triageResult.reasoning,
          clarificationCount: currentBooking.clarificationCount
        });
        
        // If still unclear after clarification, default to conservative booking
        // Note: Do NOT ask for address here - booking stage will handle it
        if (triageResult.routing === 'CLARIFY') {
          triageResult.routing = 'OUR_JOB_URGENT';
          triageResult.response = "Let's get someone out to take a look and make sure you're safe.";
        }
        
        // No preamble this time - already sent
        const updates = {};
        
        if (triageResult.routing === 'NOT_OUR_JOB') {
          updates.stage = 'closed';
          updates.closedReason = 'routed_to_other_service';
          updates.emergencyClassification = triageResult.classification;
          updates.emergencyEvaluated = true;
          updates.emergencyPendingClassification = false;
          
        } else if (triageResult.routing === 'OUR_JOB_URGENT') {
          updates.stage = 'booking_details';
          updates.emergencyModeActive = true;
          updates.emergencyClassification = triageResult.classification;
          updates.timePreference = 'ASAP';
          updates.urgencyLevel = 'emergency';
          updates.isEmergency = true;
          updates.emergencyEvaluated = true;
          updates.emergencyPendingClassification = false;
          
          if (triageResult.classification === 'SEWAGE') {
            // FIX B1: Check if message mentions septic - use septic_backup instead of sewer_backup
            const isSepticContext = /\b(?:septic|septik|sepitc)\b/i.test(customerMessage);
            const sewageTargetType = isSepticContext ? 'septic_backup' : 'sewer_backup';
            if (setProblemTypeIfAllowed(currentBooking, sewageTargetType, 'emergency')) {
              updates.problemType = currentBooking.problemType;
              updates.problemTypeSource = currentBooking.problemTypeSource;
            }
          } else if (triageResult.classification === 'FLOODING') {
            // FIX A1 + C + F + F2: Expanded pipe burst detection with washer guard
            const isWasherContext = /\b(?:washing\s*machine|washer|laundry)\b/i.test(customerMessage);
            const isPipeBurst = !isWasherContext && (
                                /\b(?:pipe|pipes|line|hose)\s*(?:burst|birst|busted|ruptured|exploded|broke|broken)\b/i.test(customerMessage) ||
                                /\b(?:burst|birst|busted|ruptured|exploded|broken|broke)\s*(?:pipe|pipes|line|hose)\b/i.test(customerMessage) ||
                                /\b(?:pipe|pipes|line)\b.*\b(?:burst|birst|busted|broke)\b/i.test(customerMessage) ||
                                /\b(?:water\s+)?(?:line|main)\s+burst\b/i.test(customerMessage));
            const floodingTargetType = isPipeBurst ? 'pipe_burst' : 'flooding';
            if (setProblemTypeIfAllowed(currentBooking, floodingTargetType, 'emergency')) {
              updates.problemType = currentBooking.problemType;
              updates.problemTypeSource = currentBooking.problemTypeSource;
            }
          } else if (triageResult.classification === 'FROZEN_PIPES') {
            if (setProblemTypeIfAllowed(currentBooking, 'pipe_frozen', 'emergency')) {
              updates.problemType = currentBooking.problemType;
              updates.problemTypeSource = currentBooking.problemTypeSource;
            }
          } else if (triageResult.classification === 'NO_WATER') {
            if (setProblemTypeIfAllowed(currentBooking, 'no_water_house', 'emergency')) {
              updates.problemType = currentBooking.problemType;
              updates.problemTypeSource = currentBooking.problemTypeSource;
            }
          } else if (triageResult.classification === 'CANT_SHUTOFF') {
            if (setProblemTypeIfAllowed(currentBooking, 'main_shutoff_valve', 'emergency')) {
              updates.problemType = currentBooking.problemType;
              updates.problemTypeSource = currentBooking.problemTypeSource;
            }
          }
          
        } else if (triageResult.routing === 'OUR_JOB_NORMAL') {
          updates.emergencyEvaluated = true;
          updates.isEmergency = false;
          updates.emergencyPendingClassification = false;
          
          if (triageResult.classification === 'SEWER_GAS') {
            // FIX E + H: Smart smell classification - but skip if message is about backup/clog (not smell)
            const isBackupContext = /\b(?:back(?:ing)?\s*up|backed\s*up|clog(?:ged)?|slow|block(?:ed)?|overflow)\b/i.test(customerMessage);
            const hasSmellWord = /\b(?:smell|smells|odor|stink|stench|rotten)\b/i.test(customerMessage);
            
            // Only apply smell classification if message actually mentions smell OR isn't about backup
            if (hasSmellWord || !isBackupContext) {
              let smellType = 'drain_smell'; // default
              
              // FIX K: Context-aware smell classification
              // Check for fixture-specific smell context FIRST
              if (/\b(?:from|near|at|in)\s+(?:the\s+)?septic\b/i.test(customerMessage) ||
                  /\bseptic\b.*\b(?:smell|odor|stink)\b/i.test(customerMessage) ||
                  /\b(?:think|might|could)\s+(?:it's|its|it\s+is|be)\s+(?:the\s+)?septic\b/i.test(customerMessage)) {
                smellType = 'septic_smell';
              } else if (/\b(?:from|near|at|in)\s+(?:the\s+)?(?:sink|basin)\b/i.test(customerMessage) ||
