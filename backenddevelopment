        updates.stage = 'booking_details';
        updates.emergencyStage = 'booking';
        updates.timePreference = 'ASAP'; // Default to ASAP for emergencies
        
        const updatedBooking = updateBookingData(customerKey, updates);
        
        // Go straight to booking with urgency
        const bookingPrompt = "Got it. Let me get a plumber out there. Can I get your name, address, city and best time?";
        
        return {
          response: bookingPrompt,
          booking: updatedBooking,
          debug: { 
            intent: 'emergency_to_booking', 
            emergencyType: currentBooking.emergencyType,
            stage: 'booking_details'
