                intent: intent,
                stage: 'booking_details',
                missing: [],
                responseType: `Force Booking - ${forceBookingCheck.reason}`,
                templateParams: [],
                customerMessage: customerMessage
              },
              metadata: {
                stage: 'booking_details',
                usingAI: false,
                forceBooking: true,
                forceReason: forceBookingCheck.reason
              }
            };
          }
          
          // DIMENSION-BASED BOOKING GATE: Check if all required dimensions are resolved
          const bookingReady = BOOKING_GATE.isReadyToBook(updatedBooking);
          const unresolvedDimensions = BOOKING_GATE.getUnresolvedDimensions(
            updatedBooking.problemType, 
            updatedBooking.diagnosticSlots
          );
          const allDimensionsResolved = unresolvedDimensions.length === 0;
          
          // For emergencies, skip to booking after safety message + 1 exchange
          // For non-emergencies, require ALL relevant dimensions to be resolved
          const shouldSkipToBooking = (updatedBooking.isEmergency && exchangeCount >= 1) || 
                                       (allDimensionsResolved && bookingReady);
          
          // Determine next question based on unresolved dimensions
          let diagnosticQuestion = null;
          let aiDecidedComplete = false;
          
          if (shouldSkipToBooking) {
            // All dimensions resolved - move to booking
            aiDecidedComplete = true;
            diagnosticQuestion = "Got it.";
          } else if (unresolvedDimensions.length > 0) {
            // Get question for next unresolved dimension
            const nextDimension = BOOKING_GATE.getNextDimensionToResolve(
              updatedBooking.problemType, 
              updatedBooking.diagnosticSlots
            );
            
            // Try fixed diagnostic sequence first
            diagnosticQuestion = getFixedDiagnosticSequence(
              updatedBooking.problemType, 
              customerMessage, 
              diagnosticHistory, 
              updatedBooking.diagnosticSlots
            );
            
            // CENTRALIZED ELIGIBILITY GATE: Check if question is valid
            if (diagnosticQuestion && !isQuestionEligible(diagnosticQuestion, updatedBooking)) {
              diagnosticQuestion = null;
            }
            
            // If no fixed question, use dimension-based template
            if (!diagnosticQuestion && nextDimension) {
              diagnosticQuestion = BOOKING_GATE.getQuestionForDimension(
                nextDimension, 
                updatedBooking.problemType
              );
              
              // CENTRALIZED ELIGIBILITY GATE: Check dimension question too
              if (diagnosticQuestion && !isQuestionEligible(diagnosticQuestion, updatedBooking)) {
                diagnosticQuestion = null;
              }
            }
            
            // Track slot as asked if question passes eligibility
            if (diagnosticQuestion) {
              const targetSlot = getQuestionTargetSlot(diagnosticQuestion);
              if (targetSlot) {
                markSlotAsked(updatedBooking, targetSlot);
              }
            }
          }
          
          // ================================================================
          // TEMPLATE QUESTION IMMEDIATE RETURN
          // If we have a template question, return immediately with correct label
          // This prevents falling through to the AI path at line 14916+
          // ================================================================
          if (diagnosticQuestion && diagnosticQuestion !== "Got it.") {
            diagnosticHistory.push({ role: 'customer', content: customerMessage });
            diagnosticHistory.push({ role: 'plumber', content: diagnosticQuestion });
            updatedBooking.diagnosticHistory = diagnosticHistory;
            
            // FIX 5: Track that we asked this diagnostic
            const questionIndex = Math.floor(diagnosticHistory.length / 2) || 1;
            if (!updatedBooking.diagnosticQuestionsAsked) {
              updatedBooking.diagnosticQuestionsAsked = [];
            }
            const trackedQuestionKey = `${updatedBooking.problemType}_q${questionIndex}`;
            if (!updatedBooking.diagnosticQuestionsAsked.includes(trackedQuestionKey)) {
              updatedBooking.diagnosticQuestionsAsked.push(trackedQuestionKey);
            }
            updatedBooking.diagnosticCount = Math.max(updatedBooking.diagnosticCount || 0, questionIndex);
            bookingData.set(customerKey, updatedBooking);
            
            return {
              response: diagnosticQuestion,
              booking: updatedBooking,
              debug: {
                booking: updatedBooking,
                entities: entities,
                intent: intent,
                stage: updatedBooking.stage,
                responseType: 'Fixed Diagnostic - Template',
                templateParams: [],
                customerMessage: customerMessage
              },
              metadata: {
                stage: updatedBooking.stage,
                usingAI: false
              }
            };
          }
          
          // If no fixed question available, check BOOKING_GATE first
          // BOOKING_GATE decides when diagnostic is complete - NOT AI
          // AI only helps with follow-up questions when fixed sequences are exhausted
          if (!diagnosticQuestion) {
            // CHECK BOOKING_GATE FIRST: If ready to book, skip AI diagnostic entirely
            if (BOOKING_GATE.isReadyToBook(updatedBooking)) {
              updatedBooking.stage = 'booking_details';
              bookingData.set(customerKey, updatedBooking);
              
              return {
                response: RESPONSE_TEMPLATES.requestBookingDetails(),
                booking: updatedBooking,
                debug: {
                  booking: updatedBooking,
                  entities: entities,
                  intent: intent,
                  stage: 'booking_details',
                  responseType: 'BOOKING_GATE Ready - Moving to Booking',
                  templateParams: [],
                  customerMessage: customerMessage
                },
                metadata: {
                  stage: 'booking_details',
                  usingAI: false,
                  bookingGateTriggered: true
                }
              };
            }
            
            // ================================================================
            // CONFIDENCE TIER ENFORCEMENT FOR CONTINUED DIAGNOSTIC
            // EVERY message gets confidence scored - no exceptions
            // ================================================================
            
            // Score confidence for THIS message (not just first message)
            const msgConfidence = REGEX_CONFIDENCE.score(customerMessage, intent, entities, updatedBooking);
            
            // Update global AI output guard with per-message confidence
            AI_OUTPUT_GUARD.setConfidence(msgConfidence.confidence);
            
            // ================================================================
            // HIGH/MEDIUM CONFIDENCE: Deterministic templates only
            // AI classifies for MEDIUM, but templates generate the response
            // ================================================================
            if (msgConfidence.confidence === 'high' || msgConfidence.confidence === 'medium') {
              
              // For MEDIUM confidence, use AI for classification only (not response generation)
              if (msgConfidence.confidence === 'medium' && !updatedBooking.aiClassifiedThisTurn) {
                updatedBooking.aiClassifiedThisTurn = true;
                try {
                  const classification = await classifyMessageWithAI(customerMessage, {
                    stage: updatedBooking.stage,
                    problemType: updatedBooking.problemType,
                    diagnosticHistory: diagnosticHistory,
                    bookingData: {
                      name: updatedBooking.name,
                      address: updatedBooking.address,
                      city: updatedBooking.city,
                      timePreference: updatedBooking.timePreference
                    },
                    diagnosticSlots: updatedBooking.diagnosticSlots || {}
                  });
                  
                  if (classification?.diagnosticSlots) {
                    updatedBooking.diagnosticSlots = { 
                      ...updatedBooking.diagnosticSlots, 
                      ...classification.diagnosticSlots 
                    };
                  }
                  if (classification?.extractedEntities) {
                    if (classification.extractedEntities.name && !updatedBooking.name) {
                      updatedBooking.name = classification.extractedEntities.name;
                    }
                    if (classification.extractedEntities.address && !updatedBooking.address) {
                      updatedBooking.address = classification.extractedEntities.address;
                    }
                    if (classification.extractedEntities.city && !updatedBooking.city) {
                      updatedBooking.city = classification.extractedEntities.city;
                    }
                  }
                  
                  console.log('AI Classification in diagnostic (MEDIUM):', {
                    slots: classification?.diagnosticSlots,
                    reasoning: classification?.reasoning
                  });
                } catch (classifyErr) {
                  console.error('AI classification error in diagnostic:', classifyErr.message);
                }
              }
              
              // Re-check BOOKING_GATE after potential AI classification updates
              if (BOOKING_GATE.isReadyToBook(updatedBooking)) {
                updatedBooking.stage = 'booking_details';
                bookingData.set(customerKey, updatedBooking);
                
                return {
                  response: RESPONSE_TEMPLATES.requestBookingDetails(),
                  booking: updatedBooking,
                  debug: {
                    booking: updatedBooking,
                    entities: entities,
                    intent: intent,
                    stage: 'booking_details',
                    responseType: 'BOOKING_GATE Ready After Classification',
                    confidence: msgConfidence.confidence,
                    templateParams: [],
                    customerMessage: customerMessage
                  },
                  metadata: {
                    stage: 'booking_details',
                    usingAI: false,
                    bookingGateTriggered: true,
                    confidenceLevel: msgConfidence.confidence
                  }
                };
              }
              
              // Get next question from DETERMINISTIC sources only
              let nextQuestion = getFixedDiagnosticSequence(
                updatedBooking.problemType, 
                customerMessage, 
                diagnosticHistory, 
                updatedBooking.diagnosticSlots
              );
              
              // Check eligibility
              if (nextQuestion && !isQuestionEligible(nextQuestion, updatedBooking)) {
                nextQuestion = null;
              }
              
              // If no fixed question, try dimension-based template
              if (!nextQuestion) {
                const nextDim = BOOKING_GATE.getNextDimensionToResolve(
                  updatedBooking.problemType, 
                  updatedBooking.diagnosticSlots
                );
                if (nextDim) {
                  nextQuestion = BOOKING_GATE.getQuestionForDimension(nextDim, updatedBooking.problemType);
                  if (nextQuestion && !isQuestionEligible(nextQuestion, updatedBooking)) {
                    nextQuestion = null;
                  }
                }
              }
              
              if (nextQuestion) {
                // Use deterministic question - track slot as asked
                const targetSlot = getQuestionTargetSlot(nextQuestion);
                if (targetSlot) {
                  markSlotAsked(updatedBooking, targetSlot);
                }

                // When asking gas or electric question, track it
                if (/gas\s+or\s+electric/i.test(nextQuestion)) {
                  if (!updatedBooking.diagnosticSlots) updatedBooking.diagnosticSlots = {};
                  updatedBooking.diagnosticSlots.askedApplianceType = true;
                  bookingData.set(customerKey, updatedBooking);
                }
                
                // Update diagnostic history
                diagnosticHistory.push({ role: 'customer', content: customerMessage });
                diagnosticHistory.push({ role: 'plumber', content: nextQuestion });
                updatedBooking.diagnosticHistory = diagnosticHistory;
                
                // FIX 5: Track that we asked this diagnostic
                const questionIndex = Math.floor(diagnosticHistory.length / 2) || 1;
                if (!updatedBooking.diagnosticQuestionsAsked) {
                  updatedBooking.diagnosticQuestionsAsked = [];
                }
                const trackedQuestionKey = `${updatedBooking.problemType}_q${questionIndex}`;
                if (!updatedBooking.diagnosticQuestionsAsked.includes(trackedQuestionKey)) {
                  updatedBooking.diagnosticQuestionsAsked.push(trackedQuestionKey);
                }
                updatedBooking.diagnosticCount = Math.max(updatedBooking.diagnosticCount || 0, questionIndex);
                bookingData.set(customerKey, updatedBooking);
                
                // RETURN IMMEDIATELY - do not fall through to AI path
                // FIX: Include secondary responses (service area, price, etc.) with diagnostic question
                const responseWithSecondary = secondaryResponses.length > 0 
                  ? nextQuestion + ' ' + secondaryResponses.join(' ')
                  : nextQuestion;
                return {
                  response: responseWithSecondary,
                  booking: updatedBooking,
                  debug: {
                    booking: updatedBooking,
                    entities: entities,
                    intent: intent,
                    stage: updatedBooking.stage,
                    responseType: 'Fixed Diagnostic - Continued',
                    confidence: msgConfidence.confidence,
                    templateParams: [],
                    customerMessage: customerMessage
                  },
                  metadata: {
                    stage: updatedBooking.stage,
                    usingAI: false,
                    confidenceLevel: msgConfidence.confidence
                  }
                };
              } else {
                // No deterministic question available - move to booking
                updatedBooking.stage = 'booking_details';
                bookingData.set(customerKey, updatedBooking);
                
                // FIX: Include secondary responses (service area, price, etc.) when moving to booking
                const bookingResponse = RESPONSE_TEMPLATES.requestBookingDetails();
                const responseWithSecondary = secondaryResponses.length > 0 
                  ? secondaryResponses.join(' ') + ' ' + bookingResponse
                  : bookingResponse;
                return {
                  response: responseWithSecondary,
                  booking: updatedBooking,
                  debug: {
                    booking: updatedBooking,
                    entities: entities,
                    intent: intent,
                    stage: 'booking_details',
                    responseType: 'No Deterministic Question - Moving to Booking',
                    confidence: msgConfidence.confidence,
                    templateParams: [],
                    customerMessage: customerMessage
                  },
                  metadata: {
                    stage: 'booking_details',
                    usingAI: false,
                    noDeterministicQuestion: true,
                    confidenceLevel: msgConfidence.confidence
                  }
                };
              }
            }
            // ================================================================
            // LOW CONFIDENCE ONLY: AI can generate follow-up question
            // This should be RARE - only for truly ambiguous input
            // GUARD: AI_OUTPUT_GUARD.isAIOutputAllowed() must be true
            // ================================================================
            else if (msgConfidence.confidence === 'low' && AI_OUTPUT_GUARD.isAIOutputAllowed()) {
            const diagnosticResult = await generateDiagnosticResponse(customerMessage, updatedBooking, fullContext);
            
            // Handle AI failure
            if (diagnosticResult.aiFailed) {
              updatedBooking.diagnosticAiFailures = (updatedBooking.diagnosticAiFailures || 0) + 1;
              
              if (updatedBooking.diagnosticAiFailures >= RESILIENCE.maxDiagnosticAttempts) {
                updatedBooking.stage = 'booking_details';
                bookingData.set(customerKey, updatedBooking);
            
            return {
                  response: RESILIENCE.getGracefulProceedMessage('ai_failures') + "\n\n" + RESPONSE_TEMPLATES.requestBookingDetails(),
              booking: updatedBooking,
              debug: {
                booking: updatedBooking,
                entities: entities,
                intent: intent,
                stage: updatedBooking.stage,
                missing: [],
                    responseType: 'AI Failure Recovery - Moving to Booking',
                    templateParams: [],
                customerMessage: customerMessage
              },
              metadata: {
                stage: updatedBooking.stage,
                    usingAI: false,
                    gracefulRecovery: true,
                    recoveryReason: 'ai_failures'
                  }
                };
              }
              
              diagnosticQuestion = "Can you tell me more about the problem?";
            } else {
                // Validate AI response
              const suppressedTypes = updatedBooking.diagnosticSlots?.suppressedQuestionTypes || [];
              const validationResult = RESILIENCE.isValidAIResponse(
                diagnosticResult.response, 
                diagnosticHistory, 
                suppressedTypes
              );
              
              if (!validationResult.valid) {
                updatedBooking.diagnosticAiFailures = (updatedBooking.diagnosticAiFailures || 0) + 1;
                
                if (updatedBooking.diagnosticAiFailures >= RESILIENCE.maxDiagnosticAttempts) {
                  updatedBooking.stage = 'booking_details';
                  bookingData.set(customerKey, updatedBooking);
                  
                  return {
                    response: RESILIENCE.getGracefulProceedMessage('ai_failures') + "\n\n" + RESPONSE_TEMPLATES.requestBookingDetails(),
                    booking: updatedBooking,
                    debug: {
                      booking: updatedBooking,
                      entities: entities,
                      intent: intent,
                      stage: 'booking_details',
                      missing: [],
                      responseType: `AI Invalid Response Recovery - ${validationResult.reason}`,
                      templateParams: [],
                      customerMessage: customerMessage
                    },
                    metadata: {
                      stage: 'booking_details',
                      usingAI: false,
                      gracefulRecovery: true,
                      recoveryReason: validationResult.reason
                    }
                  };
                }
                
                const alternative = QUESTION_ALIGNMENT.getAlignedAlternative(updatedBooking.problemType, suppressedTypes);
                diagnosticQuestion = alternative || "Got it.";
            } else {
              diagnosticQuestion = diagnosticResult.response;
                  
                  // Check for AI completion signal
              const aiSaysComplete = /^got it\.?$/i.test(diagnosticQuestion.trim());
              
              if (aiSaysComplete && !allDimensionsResolved) {
                    // AI tried to complete early - get deterministic fallback
                const nextDim = BOOKING_GATE.getNextDimensionToResolve(
                  updatedBooking.problemType, 
                  updatedBooking.diagnosticSlots
                );
                
                const fallbackQuestion = getFixedDiagnosticSequence(
                  updatedBooking.problemType, 
                  customerMessage, 
                  diagnosticHistory, 
                  updatedBooking.diagnosticSlots
                );
                
                    if (fallbackQuestion && isQuestionEligible(fallbackQuestion, updatedBooking)) {
                  diagnosticQuestion = fallbackQuestion;
                } else if (nextDim) {
                  diagnosticQuestion = BOOKING_GATE.getQuestionForDimension(nextDim, updatedBooking.problemType);
                } else {
                  diagnosticQuestion = "Is it just that one or are others affected too?";
                }
                aiDecidedComplete = false;
              } else {
                aiDecidedComplete = aiSaysComplete && allDimensionsResolved;
              }
                }
              }
            }
            // ================================================================
            // BLOCKED/EMERGENCY_TRIAGE: Use deterministic fallback
            // ================================================================
            else {
              // For blocked or emergency_triage, use deterministic question or move to booking
              const nextDim = BOOKING_GATE.getNextDimensionToResolve(
                updatedBooking.problemType, 
                updatedBooking.diagnosticSlots
              );
              
              if (nextDim) {
                diagnosticQuestion = BOOKING_GATE.getQuestionForDimension(nextDim, updatedBooking.problemType);
              } else {
                // Move to booking
                updatedBooking.stage = 'booking_details';
                bookingData.set(customerKey, updatedBooking);
                
                return {
                  response: RESPONSE_TEMPLATES.requestBookingDetails(),
                  booking: updatedBooking,
                  debug: {
                    booking: updatedBooking,
                    entities: entities,
                    intent: intent,
                    stage: 'booking_details',
                    responseType: 'Blocked/Triage - Moving to Booking',
                    confidence: msgConfidence.confidence,
                    templateParams: [],
                    customerMessage: customerMessage
                  },
                  metadata: {
                    stage: 'booking_details',
                    usingAI: false,
                    confidenceLevel: msgConfidence.confidence
                  }
                };
            }
            }
          }
          
          // Combine diagnostic question with any secondary intent responses
          // Secondary intents are answered but NEVER interrupt or end diagnostic
          let finalResponse = urgentSafetyMessage + diagnosticQuestion;
          if (secondaryResponses.length > 0) {
            finalResponse = urgentSafetyMessage + diagnosticQuestion + ' ' + secondaryResponses.join(' ');
          }
          
          diagnosticHistory.push({ role: 'customer', content: customerMessage });
          diagnosticHistory.push({ role: 'plumber', content: finalResponse });
          
          const finalBooking = { ...updatedBooking, diagnosticHistory: diagnosticHistory };
          
          let responseToSend = finalResponse;
          let wasInDiagnostic = false;
          
          // =================================================================
          // STRUCTURAL BOOKING GATES - Prevent premature booking
          // These gates ensure required context is collected before booking
          // =================================================================
          
          // Gate helper: Check if problem type requires location
          // NOTE: Toilet excluded (implicitly bathroom), Drain excluded (too broad, handled by cross-fixture gate)
          const requiresLocation = (pType) => {
            if (!pType) return false;
            // Only clear interior fixtures require location
            return /^(sink|shower|bathtub|faucet|leak_under|leak_ceiling|pipe_leak)/.test(pType);
          };
          
          // Gate helper: Check if problem type could indicate system-level issue
          const requiresCrossFixtureCheck = (pType) => {
            if (!pType) return false;
            // Issues that could be main line / sewer problems
            return /^(toilet_clogged|toilet_overflowing|toilet_backing|drain|sewer|sink_backing|sink_gurgling|shower_backup)/.test(pType) ||
                   /backup|gurgling|backing_up/.test(pType);
          };
          
          // Gate helper: Check if location is known
          const hasLocation = (slots) => {
            return slots && (slots.room || slots.floor || slots.location);
          };
          
          // Gate helper: Check if cross-fixture status is known
          const hasCrossFixtureStatus = (slots) => {
            return slots && (slots.scope === 'single' || slots.scope === 'multiple');
          };
          
          // STRUCTURAL GATE CHECK (only runs when AI says complete)
          let structuralGateBlocked = false;
          let structuralGateQuestion = null;
          
          if (aiDecidedComplete && !finalBooking.isEmergency) {
            const slots = finalBooking.diagnosticSlots || {};
            const pType = finalBooking.problemType || '';
            
            // LOCATION GATE: Check if location is required but missing
            if (requiresLocation(pType) && !hasLocation(slots) && !finalBooking.locationGateAsked) {
              structuralGateBlocked = true;
              structuralGateQuestion = "Which room is this in - kitchen, bathroom, basement, or somewhere else?";
              finalBooking.locationGateAsked = true;
            }
            // CROSS-FIXTURE GATE: Check if cross-fixture status is required but missing
            else if (requiresCrossFixtureCheck(pType) && !hasCrossFixtureStatus(slots) && !finalBooking.crossFixtureGateAsked) {
              structuralGateBlocked = true;
              structuralGateQuestion = "Is it just this one fixture, or are other drains backing up too - or are you not sure?";
              finalBooking.crossFixtureGateAsked = true;
            }
          }
          
          // If structural gate blocked, ask the gate question instead of proceeding to booking
          if (structuralGateBlocked && structuralGateQuestion) {
            responseToSend = structuralGateQuestion;
            // Stay in diagnostic to collect the answer
            bookingData.set(customerKey, finalBooking);
            
            return {
              response: responseToSend,
              booking: finalBooking,
              debug: {
                booking: finalBooking,
                entities: entities,
                intent: intent,
                stage: finalBooking.stage,
                missing: [],
                responseType: 'Structural Booking Gate',
                gateQuestion: structuralGateQuestion,
                customerMessage: customerMessage
              },
              metadata: {
                stage: finalBooking.stage,
                structuralGate: true
              }
            };
          }
          
          // ONLY AI can end the diagnostic - no other condition allowed
          // exchangeCount, keywords, secondary intents, partial answers - NONE of these end diagnostic
          if (aiDecidedComplete) {
            finalBooking.stage = 'booking_details';
            wasInDiagnostic = true;
            // ONLY here do we say "Got it, let's get you booked."
            // FIX: Preserve secondary responses (service area, price, etc.) when transitioning to booking
            const bookingRequest = RESPONSE_TEMPLATES.getSmartBookingRequest(finalBooking, "Got it, let's get you booked. ");
            if (secondaryResponses.length > 0) {
              responseToSend = secondaryResponses.join(' ') + ' ' + bookingRequest;
            } else {
              responseToSend = bookingRequest;
            }
          }
          // Otherwise stay in problem_diagnosis - AI continues asking questions
          
          bookingData.set(customerKey, finalBooking);
          
          return {
            response: responseToSend,
            booking: finalBooking,
            debug: {
              booking: finalBooking,
              entities: entities,
              intent: intent,
              stage: finalBooking.stage,
              missing: [],
              responseType: wasInDiagnostic ? 'Transition to Booking' : 'AI Diagnostic - Follow-up',
              templateParams: [],
              customerMessage: customerMessage
            },
            metadata: {
              stage: finalBooking.stage,
              usingAI: true
            }
          };
        }
      }
      
      // EMERGENCY GUARD: If emergency mode is still active but we reached fallback,
      // force emergency booking flow instead of normal templates
      if (updatedBooking.emergencyModeActive) {
        const emergencyMissing = [];
        if (!updatedBooking.name) emergencyMissing.push('name');
        if (!updatedBooking.address) emergencyMissing.push('address');
        if (!updatedBooking.city) emergencyMissing.push('city');
        
        let emergencyFallbackResponse;
        if (emergencyMissing.length === 0) {
          // All info collected - go to confirmation
          updatedBooking.awaitingConfirmation = true;
          updatedBooking.stage = 'awaiting_confirmation';
          bookingData.set(customerKey, updatedBooking);
          emergencyFallbackResponse = RESPONSE_TEMPLATES.bookingConfirmation(
            updatedBooking.name,
            updatedBooking.address,
            updatedBooking.city,
            updatedBooking.timePreference || 'ASAP',
            updatedBooking.problemType,
            updatedBooking.phone
          );
        } else {
          const missingStr = emergencyMissing.join(' and ');
          emergencyFallbackResponse = `I'm treating this as urgent. I just need your ${missingStr} to dispatch someone.`;
        }
        
        return {
          response: emergencyFallbackResponse,
          booking: updatedBooking,
          debug: {
            booking: updatedBooking,
            intent: intent,
            stage: updatedBooking.stage,
            responseType: 'Emergency Fallback Guard',
            emergencyMissing: emergencyMissing
          },
          metadata: {
            stage: updatedBooking.stage,
            emergencyMode: true,
            emergencyFallbackTriggered: true
          }
        };
      }
      
      // =================================================================
      // EMERGENCY BOOKING LOCK GUARD (BUG 1 FIX)
      // If emergency is confirmed but not in booking, FORCE booking request
      // This prevents ANY exit path (goodbye, reset, fallback) from firing
      // =================================================================
      if (mustForceEmergencyBooking(updatedBooking)) {
        // Force transition to booking
        updatedBooking.stage = 'booking_details';
        bookingData.set(customerKey, updatedBooking);
        
        const emergencyMissing = [];
        if (!updatedBooking.address) emergencyMissing.push('address');
        if (!updatedBooking.name) emergencyMissing.push('name');
        if (!updatedBooking.city) emergencyMissing.push('city');
        
        return {
          response: RESPONSE_TEMPLATES.requestUrgentBookingDetails(),
          booking: updatedBooking,
          debug: {
            booking: updatedBooking,
            intent: intent,
            stage: 'booking_details',
            responseType: 'Emergency Booking Lock - Forced',
            emergencyMissing: emergencyMissing
          },
          metadata: {
            stage: 'booking_details',
            emergencyMode: true,
            emergencyBookingLockTriggered: true
          }
        };
      }
      
      let responseTemplate = selectResponseTemplate(intent, updatedBooking, fullContext);
      
      // ================================================================
      // INSTALLATION INTENT HANDLER: Route to install flow, bypass diagnostics
      // ================================================================
      if (responseTemplate.template === 'installation') {
        const msgLower = customerMessage.toLowerCase();
        
        // GUARD: If installFlow already exists with confirmed item, preserve it (prevents downgrade)
        if (updatedBooking.installFlow && updatedBooking.installFlow.itemConfirmed) {
          // Already in install flow with confirmed item - let ongoing flow handler manage it
          // This prevents "garbage disposal" from being overwritten by "sink" on clarification
        } else {
          // Detect which item
          let installItem = null;
          if (/\btoilet\b/i.test(msgLower)) installItem = 'toilet';
          else if (/\b(?:garbage\s*disposal|disposal)\b/i.test(msgLower)) installItem = 'garbage_disposal';
          else if (/\bsink\b/i.test(msgLower)) installItem = 'sink';
          else if (/\bfaucet\b/i.test(msgLower)) installItem = 'faucet';
          else if (/\b(?:shower|bathtub|tub)\b/i.test(msgLower)) installItem = 'shower';
          else if (/\b(?:water\s*heater|hot\s*water)\b/i.test(msgLower)) installItem = 'water_heater';
          else if (/\bdishwasher\b/i.test(msgLower)) installItem = 'dishwasher';
          else if (/\b(?:washing\s*machine|washer)\b/i.test(msgLower)) installItem = 'washer';
          else if (/\b(?:fridge|refrigerator)\b/i.test(msgLower)) installItem = 'refrigerator';
          
          // DISPOSAL INSTALL LOCK: If disposal + install verb detected, force lock to garbage_disposal
          // This prevents "under the sink" clarifications from downgrading to sink
          if (!installItem && /\b(?:garbage\s*disposal|disposal)\b/i.test(msgLower) && 
              /\b(?:install|installing|hook\s*up|set\s*up|new)\b/i.test(msgLower)) {
            installItem = 'garbage_disposal';
          }
          
          // Initialize installFlow
          updatedBooking.installFlow = {
            item: installItem,
            itemConfirmed: !!installItem,
            locationAsked: false
          };
        }
        
        const install = updatedBooking.installFlow;
        
        // If item not confirmed, ask for it
        if (!install.itemConfirmed) {
          bookingData.set(customerKey, updatedBooking);
          return {
            response: "Got it - what would you like installed? We can help with toilets, sinks, faucets, showers, water heaters, dishwashers, washing machines, refrigerators, or garbage disposals.",
            booking: updatedBooking,
            debug: { intent: 'installation', stage: 'install_intake' },
            metadata: { stage: 'install_intake', installFlow: true }
          };
        }
        
        // Ask location
        install.locationAsked = true;
        bookingData.set(customerKey, updatedBooking);
        const itemName = install.item === 'washer' ? 'washing machine' : 
                        install.item === 'water_heater' ? 'water heater' :
                        install.item === 'refrigerator' ? 'refrigerator' :
                        install.item === 'garbage_disposal' ? 'garbage disposal' : install.item;
        return {
          response: `Got it - ${itemName} installation. Where will it be installed?`,
          booking: updatedBooking,
          debug: { intent: 'installation', stage: 'install_intake', item: install.item },
          metadata: { stage: 'install_intake', installFlow: true }
        };
      }
      // ================================================================
      
      // INVARIANT 1: WATER HEATER INTENT IS STICKY (STATE-BASED ENFORCEMENT)
      // If water heater intent is locked in state OR detected in current message, NEVER return opener
      const hasWaterHeaterContextFinal = updatedBooking.waterHeaterIntentLocked || 
        /\b(water\s*heater|hot\s*water\s*tank|no\s+hot\s+water|not\s+hot|scalding|too\s+hot|heater.*leak|pilot\s+light|tankless|lukewarm|cold\s+water|not\s+getting\s+hot|barely\s+warm|only\s+(?:getting\s+)?(?:warm|tepid)|little\s+(?:valve|pipe).*heater)\b/i.test(customerMessage);
      if (hasWaterHeaterContextFinal && (responseTemplate.template === 'needProblem' || responseTemplate.template === 'openerClarification')) {
        responseTemplate = { template: 'problem_description', params: [] };
      }
      
      // ================================================================
      // AI OPENER QUESTION - Use AI's suggested question for first message
      // If rules selected a generic opener AND AI provided a better question, use AI's
      // This preserves semantic context that rules may have lost
      // ================================================================
      const isGenericOpener = responseTemplate.template === 'needProblem' || responseTemplate.template === 'openerClarification';
      const aiResult = updatedBooking.aiOpenerResult;
      
      if (isGenericOpener && aiResult && aiResult.suggestedQuestion && aiResult.domain === 'plumbing') {
        // GUARD: AI should only suggest diagnostic questions, NEVER booking requests
        // Reject suggested questions that contain booking language
        const isBookingRequest = /\b(?:book|schedule|full\s*name|address|city|best\s*time|reply\s*with)\b/i.test(aiResult.suggestedQuestion);
        
        if (!isBookingRequest) {
          // AI provided a plumbing-specific diagnostic question - use it instead of generic opener
          // This handles cases like "sink overflowing" where rules don't have specific handler
          
          // Set problem type from AI if available
          if (aiResult.fixture && aiResult.condition) {
            setProblemTypeIfAllowed(updatedBooking, `${aiResult.fixture}_${aiResult.condition}`, 'ai_classification');
          } else if (aiResult.fixture) {
            setProblemTypeIfAllowed(updatedBooking, aiResult.fixture, 'ai_classification');
          } else if (aiResult.condition) {
            setProblemTypeIfAllowed(updatedBooking, aiResult.condition, 'ai_classification');
          }
          bookingData.set(customerKey, updatedBooking);
          
          return {
            response: aiResult.suggestedQuestion,
            booking: updatedBooking,
            debug: { 
              intent: 'ai_opener_question', 
              aiFixture: aiResult.fixture, 
              aiCondition: aiResult.condition,
              aiSeverity: aiResult.severity,
              aiReasoning: aiResult.reasoning
            },
            metadata: { 
              aiOpener: true, 
              severity: aiResult.severity,
              fixture: aiResult.fixture,
              condition: aiResult.condition
            }
          };
        }
        // If AI suggested a booking request, fall through to normal flow
      }
      
      // ================================================================
      // AI AGENT ACTIVATION - Split MEDIUM vs LOW confidence handling
      // MEDIUM: AI classifies/routes only, then FALLS THROUGH to deterministic response
      // LOW: AI generates full response (rare case - truly ambiguous input)
      // INSTALL GUARD: Never activate AI for installation flows - use deterministic path
      // ================================================================
      
      const canUseAI = !updatedBooking.aiAgentUsedThisTurn &&
                               !updatedBooking.installIntentLocked &&
                               !updatedBooking.installFlow;

      // ================================================================
      // MEDIUM CONFIDENCE: AI CLASSIFIES ONLY - Does NOT generate response
      // AI extracts intent/entities, then we FALL THROUGH to deterministic flow
      // Templates, fixed sequences, and gates generate the actual response
      // ================================================================
      if (canUseAI && REGEX_CONFIDENCE.shouldClassifyWithAI(confidenceResult)) {
        updatedBooking.aiAgentUsedThisTurn = true;
        
        try {
          const classification = await classifyMessageWithAI(customerMessage, {
            stage: updatedBooking.stage,
            problemType: updatedBooking.problemType,
            diagnosticHistory: updatedBooking.diagnosticHistory || [],
            bookingData: {
              name: updatedBooking.name,
              address: updatedBooking.address,
              city: updatedBooking.city,
              timePreference: updatedBooking.timePreference
            },
            diagnosticSlots: updatedBooking.diagnosticSlots || {}
          });
          
          if (classification) {
            // Apply classification to booking state (AI suggests, code decides)
            
            // GATE: Problem type - only accept if current is null AND suggestion is valid
            if (!updatedBooking.problemType && classification.suggestedProblemType) {
              setProblemTypeIfAllowed(updatedBooking, classification.suggestedProblemType, 'ai_classification');
              // Also update the intent for downstream template selection
              intent.problemType = classification.suggestedProblemType;
              
              // PRODUCTION FIX: Extract and persist fixture from problem type
              const fixtureFromProblem = classification.suggestedProblemType.match(
                /^(toilet|sink|shower|tub|water_heater|faucet|drain|pipe|disposal|washer|dishwasher|bidet|sump_pump|ejector_pump)/
              );
              if (fixtureFromProblem && !updatedBooking.fixture) {
                updatedBooking.fixture = fixtureFromProblem[1];
              }
            }
            
            // ADDITIONAL FIX: Extract fixture from AI reasoning/response when problemType is null
            // This handles cases like "teoilet problem" where AI understands but returns null problemType
            if (!updatedBooking.fixture && classification.reasoning) {
              const fixtureFromReasoning = classification.reasoning.match(
                /\b(toilet|sink|shower|tub|water\s*heater|faucet|drain|pipe|disposal|washer|dishwasher|bidet)\b/i
              );
              if (fixtureFromReasoning) {
                updatedBooking.fixture = fixtureFromReasoning[1].toLowerCase().replace(/\s+/g, '_');
              }
            }
            
            // GATE: Stage transitions - only allow valid forward movement
            const stageOrder = ['initial', 'problem_diagnosis', 'booking_details', 'awaiting_confirmation', 'confirmed'];
            const currentStageIndex = stageOrder.indexOf(updatedBooking.stage);
            const suggestedStageIndex = stageOrder.indexOf(classification.suggestedNextStage);
            
            if (suggestedStageIndex > currentStageIndex) {
              if (classification.suggestedNextStage === 'booking_details' && updatedBooking.problemType) {
                updatedBooking.stage = 'booking_details';
              } else if (classification.suggestedNextStage === 'problem_diagnosis') {
                updatedBooking.stage = 'problem_diagnosis';
              }
            }
            
            // GATE: Entity extraction - validate before accepting
            if (classification.extractedEntities) {
              if (classification.extractedEntities.name && !updatedBooking.name) {
                const name = classification.extractedEntities.name.trim();
                const aiNameBlacklist = [
                  /^keep\s/i, /^thank/i, /^appreciate/i, /^please/i, /^yes\b/i, /^no\s/i,
                  /^ok\b/i, /^got\s*it/i, /^sounds\s*good/i, /^perfect/i, /^great/i,
                  /updated/i, /guidance/i, /^help/i, /^hurry/i, /^asap/i,
                  /^will\s+do/i, /^on\s+(?:my|the)\s+way/i, /^be\s+(?:there|right)/i,
                  /^stay\s+safe/i, /^call\s+(?:you|us|me)/i, /^i\s+(?:am|will|need|want)/i
                ];
                const isBlacklistedName = aiNameBlacklist.some(pattern => pattern.test(name));
                if ((name.length >= 4 || name.includes(' ')) && !isBlacklistedName) {
                  updatedBooking.name = name;
                }
              }
              if (classification.extractedEntities.address && !updatedBooking.address) {
                const addr = classification.extractedEntities.address.trim();
                if (/\d/.test(addr) && addr.length >= 5) {
                  updatedBooking.address = addr;
                }
              }
              if (classification.extractedEntities.city && !updatedBooking.city) {
                updatedBooking.city = classification.extractedEntities.city.trim();
              }
              if (classification.extractedEntities.timePreference && !updatedBooking.timePreference) {
                updatedBooking.timePreference = classification.extractedEntities.timePreference.trim();
              }
            }
            
            // GATE: Diagnostic slots - merge with existing
            if (classification.diagnosticSlots) {
              updatedBooking.diagnosticSlots = {
                ...updatedBooking.diagnosticSlots,
                ...classification.diagnosticSlots
              };
            }
            
            bookingData.set(customerKey, updatedBooking);
            
            // Log classification for debugging
            console.log('AI Classification (MEDIUM confidence):', {
              problemType: classification.suggestedProblemType,
              stage: classification.suggestedNextStage,
              slots: classification.diagnosticSlots,
              reasoning: classification.reasoning
            });
          }
        } catch (classifyError) {
          console.error('AI classification error:', classifyError.message);
          // Fall through to deterministic handling
        }
        
        // CRITICAL: DO NOT RETURN HERE - Fall through to deterministic flow below
        // The templates, fixed sequences, and gates will generate the response
      }
      
      // ================================================================
      // LOW CONFIDENCE: AI GENERATES FULL RESPONSE (rare case)
      // Only for truly ambiguous input where regex has zero signal
      // AI can generate a clarifying question when deterministic has no answer
      // GUARD: AI_OUTPUT_GUARD.isAIOutputAllowed() must be true (confidence === 'low')
      // ================================================================
      if (canUseAI && REGEX_CONFIDENCE.shouldGenerateWithAI(confidenceResult) && !updatedBooking.problemType && AI_OUTPUT_GUARD.isAIOutputAllowed()) {
        updatedBooking.aiAgentUsedThisTurn = true;
        bookingData.set(customerKey, updatedBooking);
        
        try {
          const aiResult = await aiConversationalAgent(customerMessage, {
            stage: updatedBooking.stage,
            problemType: updatedBooking.problemType,
            diagnosticHistory: updatedBooking.diagnosticHistory || [],
            bookingData: {
              name: updatedBooking.name,
              address: updatedBooking.address,
              city: updatedBooking.city,
              timePreference: updatedBooking.timePreference
            },
            diagnosticSlots: updatedBooking.diagnosticSlots || {},
            isEmergency: updatedBooking.isEmergency,
            emergencyType: updatedBooking.emergencyType
          });
          
          if (aiResult && aiResult.response) {
            // Apply AI's classifications to state
            if (!updatedBooking.problemType && aiResult.suggestedProblemType) {
              setProblemTypeIfAllowed(updatedBooking, aiResult.suggestedProblemType, 'ai_classification');
              
              // PRODUCTION FIX: Extract and persist fixture from problem type
              const fixtureFromProblem = aiResult.suggestedProblemType.match(
                /^(toilet|sink|shower|tub|water_heater|faucet|drain|pipe|disposal|washer|dishwasher|bidet|sump_pump|ejector_pump)/
              );
              if (fixtureFromProblem && !updatedBooking.fixture) {
                updatedBooking.fixture = fixtureFromProblem[1];
              }
            }
            
            // ADDITIONAL FIX: Extract fixture from AI reasoning/response when problemType is null
            // This handles cases like "teoilet problem" where AI understands but returns null problemType
            if (!updatedBooking.fixture && aiResult.reasoning) {
              const fixtureFromReasoning = aiResult.reasoning.match(
                /\b(toilet|sink|shower|tub|water\s*heater|faucet|drain|pipe|disposal|washer|dishwasher|bidet)\b/i
              );
              if (fixtureFromReasoning) {
                updatedBooking.fixture = fixtureFromReasoning[1].toLowerCase().replace(/\s+/g, '_');
              }
            }
            
            // Stage transitions
            const stageOrder = ['initial', 'problem_diagnosis', 'booking_details', 'awaiting_confirmation', 'confirmed'];
            const currentStageIndex = stageOrder.indexOf(updatedBooking.stage);
            const suggestedStageIndex = stageOrder.indexOf(aiResult.suggestedNextStage);
            
            if (suggestedStageIndex > currentStageIndex) {
              if (aiResult.suggestedNextStage === 'booking_details' && updatedBooking.problemType) {
                  updatedBooking.stage = 'booking_details';
              } else if (aiResult.suggestedNextStage === 'problem_diagnosis') {
                updatedBooking.stage = 'problem_diagnosis';
              }
            }
            
            // Entity extraction
            if (aiResult.extractedEntities) {
              if (aiResult.extractedEntities.name && !updatedBooking.name) {
                const name = aiResult.extractedEntities.name.trim();
                const aiNameBlacklist = [
                  /^keep\s/i, /^thank/i, /^appreciate/i, /^please/i, /^yes\b/i, /^no\s/i,
                  /^ok\b/i, /^got\s*it/i, /^sounds\s*good/i, /^perfect/i, /^great/i,
                  /updated/i, /guidance/i, /^help/i, /^hurry/i, /^asap/i,
                  /^will\s+do/i, /^on\s+(?:my|the)\s+way/i, /^be\s+(?:there|right)/i,
                  /^stay\s+safe/i, /^call\s+(?:you|us|me)/i, /^i\s+(?:am|will|need|want)/i
                ];
                const isBlacklistedName = aiNameBlacklist.some(pattern => pattern.test(name));
                if ((name.length >= 4 || name.includes(' ')) && !isBlacklistedName) {
                  updatedBooking.name = name;
                }
              }
              if (aiResult.extractedEntities.address && !updatedBooking.address) {
                const addr = aiResult.extractedEntities.address.trim();
                if (/\d/.test(addr) && addr.length >= 5) {
                  updatedBooking.address = addr;
                }
              }
              if (aiResult.extractedEntities.city && !updatedBooking.city) {
                updatedBooking.city = aiResult.extractedEntities.city.trim();
              }
              if (aiResult.extractedEntities.timePreference && !updatedBooking.timePreference) {
                updatedBooking.timePreference = aiResult.extractedEntities.timePreference.trim();
              }
            }
            
            // Diagnostic slots
            if (aiResult.diagnosticSlots) {
              updatedBooking.diagnosticSlots = {
                ...updatedBooking.diagnosticSlots,
                ...aiResult.diagnosticSlots
              };
            }
            
            // Update diagnostic history
            if (!updatedBooking.diagnosticHistory) {
              updatedBooking.diagnosticHistory = [];
            }
            updatedBooking.diagnosticHistory.push({ role: 'customer', content: customerMessage });
            updatedBooking.diagnosticHistory.push({ role: 'plumber', content: aiResult.response });
            
            // Check if booking is complete
            if (updatedBooking.name && updatedBooking.address && updatedBooking.city && updatedBooking.timePreference && updatedBooking.problemType) {
              updatedBooking.stage = 'awaiting_confirmation';
              updatedBooking.awaitingConfirmation = true;
              bookingData.set(customerKey, updatedBooking);
              
              return {
                response: RESPONSE_TEMPLATES.bookingConfirmation(
                  updatedBooking.name,
                  updatedBooking.address,
                  updatedBooking.city,
                  updatedBooking.timePreference,
                  updatedBooking.problemType,
                  updatedBooking.phone
                ),
                booking: updatedBooking,
                debug: { intent: 'ai_booking_complete', confidence: confidenceResult, aiReasoning: aiResult.reasoning },
                metadata: { stage: 'awaiting_confirmation', aiHandled: true }
              };
            }
            
            bookingData.set(customerKey, updatedBooking);
            
            // LOW confidence: AI generates the response (truly ambiguous case)
            return {
              response: aiResult.response,
              booking: updatedBooking,
              debug: { 
                intent: 'ai_agent_response_low_confidence', 
                confidence: confidenceResult,
                aiSuggestedProblemType: aiResult.suggestedProblemType,
                aiSuggestedStage: aiResult.suggestedNextStage,
                aiReasoning: aiResult.reasoning
              },
              metadata: { 
                stage: updatedBooking.stage,
                aiHandled: true,
                confidenceLevel: 'low'
              }
            };
          }
        } catch (aiError) {
          console.error('AI agent error (LOW confidence):', aiError.message);
          // Fall through to regex-based handling
        }
      }
      
      // Defensive: ensure template function exists before calling
      const templateFn = RESPONSE_TEMPLATES[responseTemplate.template];
      let response = typeof templateFn === 'function' 
        ? templateFn(...responseTemplate.params)
        : RESPONSE_TEMPLATES.generalError();

      if (response === null) {
        if (updatedBooking.name && updatedBooking.address && updatedBooking.city && updatedBooking.timePreference && updatedBooking.problemType) {
          updatedBooking.stage = 'awaiting_confirmation';
          updatedBooking.awaitingConfirmation = true;
          bookingData.set(customerKey, updatedBooking);
          response = RESPONSE_TEMPLATES.bookingConfirmation(
            updatedBooking.name,
            updatedBooking.address,
            updatedBooking.city,
            updatedBooking.timePreference || 'ASAP',
            updatedBooking.problemType,
            updatedBooking.phone
          );
        } else {
          response = RESPONSE_TEMPLATES.generalError();
        }
      }
      
      if (diagnosticAck && updatedBooking.stage === 'booking_details') {
        response = diagnosticAck + response;
      }

      // GUARD: Strip phone-style greetings from SMS responses
      if (typeof response === 'string' && /^(?:thanks\s+for\s+calling|thank\s+you\s+for\s+calling)/i.test(response.trim())) {
        response = response.replace(/^(?:Thanks|Thank\s+you)\s+for\s+calling\s+[^.!,]+[.,!]?\s*(?:this\s+is\s+\w+[.,!]?\s*)?(?:How\s+can\s+I\s+help\s+you\s+today\???\s*)?/i, '').trim();
        if (!response) {
          response = "What plumbing work do you need done? I can get someone scheduled for you.";
        }
      }

      // Deduplicate response to avoid identical messages
      if (typeof response === 'string') {
        response = deduplicateResponse(customerKey, response);
      }
      
      // FIX A + FALLBACK LOOP PREVENTION: Track opener responses and force progression
      const isOpenerTemplate = responseTemplate.template === 'needProblem' || responseTemplate.template === 'openerClarification';
      updatedBooking.lastResponseWasOpener = isOpenerTemplate;
      
      // FALLBACK LOOP PREVENTION: Increment counter if opener, reset if not
      if (isOpenerTemplate) {
        updatedBooking.openerFallbackCount = (updatedBooking.openerFallbackCount || 0) + 1;
      } else {
        updatedBooking.openerFallbackCount = 0;
      }
      
      // PATH B: UNKNOWN FIXTURE SAFETY NET
      // If we've asked clarifying questions 3+ times and still don't have a recognized fixture,
      // skip diagnostics entirely and proceed to booking. The plumber can figure it out on-site.
      if (updatedBooking.openerFallbackCount >= 3 && !updatedBooking.problemType) {
        updatedBooking.problemType = 'general_plumbing';
        updatedBooking.stage = 'booking_details';
        updatedBooking.skipDiagnostics = true;
        const fallbackResponse = "I can help with that! Let me get a plumber scheduled to take a look. Can I get your name, address, city, and best time?";
        bookingData.set(customerKey, updatedBooking);
        return {
          response: fallbackResponse,
          booking: updatedBooking,
          debug: { intent: 'unknown_fixture_fallback', stage: 'booking_details' },
          metadata: { stage: 'booking_details', unknownFixtureFallback: true }
        };
      }
      bookingData.set(customerKey, updatedBooking);
      
      stats.aiResponses++;

      const missing = [];
      if (!updatedBooking.name) missing.push('full name');
      if (!updatedBooking.address) missing.push('address');
      if (!updatedBooking.city) missing.push('city');
      if (!updatedBooking.timePreference) missing.push('best time');

      return {
        response,
        booking: updatedBooking,
        debug: {
          booking: updatedBooking,
          entities: entities,
          intent: intent,
          stage: updatedBooking.stage,
          missing: missing,
          responseType: 'Template: ' + responseTemplate.template,
          templateParams: responseTemplate.params,
          customerMessage: customerMessage
        },
        metadata: {
          stage: updatedBooking.stage,
          usingAI: isAIEnabled()
        }
      };

    } catch (error) {
      // Use getBookingData for safe access - currentBooking might not be defined if error happened early
      const errorBooking = getBookingData(customerKey);
      console.error('Processing error:', {
        message: error.message,
        stack: error.stack,
        customerMessage: customerMessage?.substring(0, 100),
        stage: errorBooking?.stage,
        bookingData: errorBooking
      });
      
      // Try to recover gracefully instead of generic error
      const booking = errorBooking;
      
      // If we have enough info to proceed, try to confirm
      if (booking.name && booking.address && booking.city) {
        booking.timePreference = booking.timePreference || 'ASAP';
        booking.stage = 'awaiting_confirmation';
        booking.awaitingConfirmation = true;
        bookingData.set(customerKey, booking);
        
        return {
          response: `Let me confirm: ${booking.name} at ${booking.address}, ${booking.city}. We'll send someone ${booking.timePreference}. Does that look right?`,
          booking: booking,
          debug: { error: error.message, recovered: true, stage: 'awaiting_confirmation' },
          metadata: { error: true, recovered: true }
        };
      }
      
      // If we're missing info, ask for it
      const missing = [];
      if (!booking.name) missing.push('name');
      if (!booking.address) missing.push('address');
      if (!booking.city) missing.push('city');
      
      if (missing.length > 0 && missing.length < 3) {
        return {
          response: `I want to get you booked - can you confirm your ${missing.join(' and ')}?`,
          booking: booking,
          debug: { error: error.message, recovered: true, stage: 'booking_details' },
          metadata: { error: true, recovered: true }
        };
      }
      
      // Fallback to generic error
      return {
        response: RESPONSE_TEMPLATES.generalError(),
        error: error.message,
        debug: { error: error.message, stage: 'error' },
        metadata: { error: true }
      };
    }
  }

  function hasBeenIntroduced(customerKey) {
    return customerIntroduced.has(customerKey) && customerIntroduced.get(customerKey);
  }

  function markAsIntroduced(customerKey) {
    customerIntroduced.set(customerKey, true);
  }

  function incrementAuthenticationCount(customerKey) {
    const currentCount = authenticationCounts.get(customerKey) || 0;
    const newCount = currentCount + 1;
    authenticationCounts.set(customerKey, newCount);
    return newCount;
  }

  function isAIEnabled() {
    return !!CONFIG.OPENAI_API_KEY;
  }

  function getAIStatus() {
    const enabled = isAIEnabled();
    return {
      enabled,
      status: enabled ? 'AI: ON (Diagnostic Questions)' : 'AI: OFF (Rule-based)',
      usingBackendConfig: true
    };
  }

  function getStats() {
    return { ...stats };
  }

  function cleanupCustomerData(customerKey) {
    conversations.delete(customerKey);
    customerProfiles.delete(customerKey);
    bookingData.delete(customerKey);
    authenticationCounts.delete(customerKey);
    customerIntroduced.delete(customerKey);
  }

  function getConversationStage(customerKey) {
    const booking = getBookingData(customerKey);
    return booking.stage;
  }

  async function handleSMSMessage(message, config) {
    const customerKey = config.customerNumber.replace(/\D/g, '');
    
    const result = await processMessage(message, customerKey, {
      plumberName: config.plumberName || CONFIG.DEFAULT_PLUMBER_NAME,
      businessName: config.businessName || CONFIG.DEFAULT_BUSINESS_NAME,
      serviceAreas: config.serviceAreas || CONFIG.DEFAULT_SERVICE_AREAS
    });

    // POST-PROCESSOR: Auto-append booking prompt if transitioning to booking
    let response = result.response;
    if (result.booking && 
        result.booking.stage === 'booking_details' &&
        response.includes("I'll get a plumber scheduled for you.") &&
        !response.includes("name") && 
        !response.includes("address")) {
      
      const booking = result.booking;
      const missing = [];
      if (!booking.name) missing.push('name');
      if (!booking.address) missing.push('address');
      if (!booking.city) missing.push('city');
      if (!booking.timePreference) missing.push('best time');
      
      if (missing.length === 4) {
        response += ' Can I get your name, address, city and best time?';
      } else if (missing.length > 0) {
        response += ` Can I get your ${missing.join(' and ')}?`;
      }
    }

    return response;
  }

  return {
