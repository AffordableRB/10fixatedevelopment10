        const locationWords = /\b(kitchen|bathroom|basement|garage|laundry\s*room|laundry|utility\s*room|utility|master\s*bath(?:room)?|guest\s*bath(?:room)?|powder\s*room|backyard|back\s*yard|outdoor|outside|yard|office|half\s*bath|guest\s*house|commercial|main\s*floor|upstairs|downstairs|first\s*floor|second\s*floor|mud\s*room|wet\s*bar|bar|pool\s*house|shed|workshop|crawl\s*space|attic|my\s*(?:kitchen|bathroom|basement|garage|laundry))\b/i;
