      // ================================================================
      // END ONGOING SPECIALIST INSTALL FLOW
      // ================================================================
      
      // ================================================================
      // SPECIALIST & ADDON INSTALL DETECTION
      // Only runs if no specialist flow is already active
      // Detects: specialist_only AND addon exposure levels from INSTALLATION_UNIVERSE
      // ================================================================
      if (!currentBooking.isEmergency && 
          !currentBooking.emergencyModeActive &&
          currentBooking.stage !== 'booking_details' && 
          currentBooking.stage !== 'awaiting_confirmation' &&
          !(currentBooking.installFlow && currentBooking.installFlow.isSpecialist)) {
        
        const msgLower = customerMessage.toLowerCase();
        
        // Check for install intent pattern - must have true install verb (full list)
        const hasInstallIntent = /\b(?:install|installing|replace|replacing|put\s*in|hook\s*up|set\s*up|swap\s*(?:out)?|change\s*(?:out)?|add|mount)\b/i.test(msgLower);
        
        if (hasInstallIntent) {
          // Defensive iteration: check INSTALLATION_UNIVERSE exists and has entries
          let installMatch = null;
          const universeEntries = INSTALLATION_UNIVERSE && typeof INSTALLATION_UNIVERSE === 'object' 
            ? Object.entries(INSTALLATION_UNIVERSE) 
            : [];
          
          // Iterate over all INSTALLATION_UNIVERSE sections, filter by specialist_only OR addon
          for (const [sectionName, section] of universeEntries) {
            if (section && typeof section === 'object' && !Array.isArray(section) && typeof section !== 'function') {
              for (const [itemId, item] of Object.entries(section)) {
                if (item && 
                    (item.exposure_level === 'specialist_only' || item.exposure_level === 'addon' || item.exposure_level === 'permission_based') && 
                    item.booking_enabled !== false &&
                    item.detection_patterns && 
                    Array.isArray(item.detection_patterns)) {
                  for (const pattern of item.detection_patterns) {
                    if (pattern && typeof pattern.test === 'function' && pattern.test(msgLower)) {
                      installMatch = { id: itemId, name: item.name || itemId, ...item };
                      break;
                    }
                  }
                  if (installMatch) break;
                }
              }
              if (installMatch) break;
            }
          }
          
          // If specialist/addon install detected, route to streamlined flow
          if (installMatch) {
            // Mark as introduced
            if (!hasBeenIntroduced(customerKey)) {
              markAsIntroduced(customerKey);
            }
            
            // Shallow clone to avoid mutating shared reference
            const updatedBooking = { ...currentBooking };
            
            // Initialize specialist install flow
            updatedBooking.installFlow = {
              item: installMatch.id,
              itemConfirmed: true,
              locationAsked: true,
              isSpecialist: true
            };
            
            // INSTALL LATCH: Lock install intent so it can't be reclassified away
            updatedBooking.installIntentLocked = true;
            
            bookingData.set(customerKey, updatedBooking);
            
            // Format the item name for display
            const displayName = (installMatch.name || installMatch.id).toLowerCase();
            
            return {
              response: `Got it - ${displayName} installation. Where will it be installed?`,
              booking: updatedBooking,
              debug: { intent: 'specialist_installation', stage: 'install_intake', item: installMatch.id, detected: true },
              metadata: { stage: 'install_intake', installFlow: true, specialistInstall: true }
            };
          }
        }
      }
      // ================================================================
      // END SPECIALIST & ADDON INSTALL DETECTION
      // ================================================================
      
      // ================================================================
      // CONFIDENCE-BASED ROUTING - Determines regex vs AI handling
      // ================================================================
      
      // CONFIDENCE FLOOR GUARD: Ensure existing problemType is preserved for score()
      // This prevents confidence from dropping to LOW after a problem is identified,
      // which would cause AI to re-ask "what's the issue?" on follow-up messages.
      const entitiesWithBookingContext = {
        ...entities,
        problemType: entities.problemType || currentBooking.problemType,
        stage: currentBooking.stage,
        emergencyEvaluated: currentBooking.emergencyEvaluated
      };
      
      // Use the early confidence result (already scored and stored at start of processMessage)
      const confidenceResult = currentBooking.lastConfidenceResult;
      
      // BLOCKED: Hard stop - regex handles, AI has no say
      if (REGEX_CONFIDENCE.isBlocked(confidenceResult)) {
        if (confidenceResult.reason === 'hard_stop') {
          return {
            response: RESPONSE_TEMPLATES.cancellation(),
            booking: currentBooking,
            debug: { intent: 'hard_stop', confidence: confidenceResult },
            metadata: { blocked: true, reason: 'hard_stop' }
          };
        }
        if (confidenceResult.reason === 'electrical_trade' || confidenceResult.reason === 'hvac_trade') {
          return {
            response: "That sounds like an electrical/HVAC issue - you'd need a specialist for that. I can help with plumbing: leaks, clogs, toilets, water heaters. Got a plumbing issue?",
            booking: currentBooking,
            debug: { intent: 'trade_redirect', confidence: confidenceResult },
            metadata: { blocked: true, reason: confidenceResult.reason }
          };
        }
        if (confidenceResult.reason === 'billing') {
          return {
            response: "For billing questions, please call our office directly. I'm here to help with plumbing problems - leaks, clogs, or repairs. What can I help with?",
            booking: currentBooking,
            debug: { intent: 'billing_redirect', confidence: confidenceResult },
            metadata: { blocked: true, reason: 'billing' }
          };
        }
      }
      
      // ================================================================
      // OLD EMERGENCY TRIAGE LOCATION REMOVED
      // Emergency triage now runs earlier (line ~8950) to prevent bypassing
      // ================================================================
      
      // ================================================================
      // INSTALLATION INTENT EARLY RETURN (Phase 1 - Primary Fixtures + Generic Fallback)
      // Must execute BEFORE entity extraction or problem handling
      // Installation is a first-class intent (same level as emergency)
      // If no primary fixture matched, use generic_install fallback (NEVER exit conversation)
      // ================================================================
      if (intent.intent === 'installation' && 
          !currentBooking.isEmergency && 
          !currentBooking.emergencyModeActive &&
          currentBooking.stage !== 'booking_details' && 
          currentBooking.stage !== 'awaiting_confirmation') {
        
        const msgLower = customerMessage.toLowerCase();
        
        // Detect which item (primary fixtures only)
        // Note: Check tub BEFORE shower to avoid misclassification
        let installItem = null;
        if (/\btoilet\b/i.test(msgLower)) installItem = 'toilet';
        else if (/\b(?:garbage\s*disposal|disposal)\b/i.test(msgLower)) installItem = 'garbage_disposal';
        else if (/\bsink\b/i.test(msgLower)) installItem = 'sink';
        else if (/\bfaucet\b/i.test(msgLower)) installItem = 'faucet';
        else if (/\b(?:tub|bathtub|soaking\s*tub|freestanding\s*tub|jetted\s*tub|jacuzzi)\b/i.test(msgLower)) installItem = 'tub';
        else if (/\bshower\b/i.test(msgLower)) installItem = 'shower';
        else if (/\b(?:water\s*heater|hot\s*water|tankless)\b/i.test(msgLower)) installItem = 'water_heater';
        else if (/\bdishwasher\b/i.test(msgLower)) installItem = 'dishwasher';
        else if (/\b(?:washing\s*machine|washer)\b/i.test(msgLower)) installItem = 'washer';
        else if (/\b(?:fridge|refrigerator)\b/i.test(msgLower)) installItem = 'refrigerator';
        else if (/\b(?:ice\s*maker\s*line|ice\s*maker)\b/i.test(msgLower)) installItem = 'ice_maker_line';
        else if (/\b(?:bidet)\b/i.test(msgLower)) installItem = 'bidet';
        else if (/\b(?:pot\s*filler)\b/i.test(msgLower)) installItem = 'pot_filler';
        else if (/\b(?:hose\s*bib|outdoor\s*faucet|outside\s*faucet|spigot)\b/i.test(msgLower)) installItem = 'hose_bib';
        else if (/\b(?:sewage\s*pump|ejector\s*pump|grinder\s*pump|lift\s*pump)\b/i.test(msgLower)) installItem = 'sewage_pump';
        else if (/\b(?:sump\s*pump)\b/i.test(msgLower)) installItem = 'sump_pump';
        else if (/\b(?:gas\s*lines?|gas\s*pipe)\b/i.test(msgLower)) installItem = 'gas_line';
        else if (/\bgas\s+(?:stove|range|dryer|oven|cooktop|grill|fireplace)\b/i.test(msgLower)) installItem = 'gas_appliance';
        else if (/\b(?:backflow|back\s*flow)\b/i.test(msgLower)) installItem = 'backflow';
        else if (/\b(?:water\s*line|water\s*supply\s*line)\b/i.test(msgLower)) installItem = 'water_line';
        else if (/\b(?:water\s*meter)\b/i.test(msgLower)) installItem = 'water_meter';
        else if (/\b(?:whole\s*house\s*filter|water\s*filter|water\s*filtration|filtration\s*system|reverse\s*osmosis|ro\s*system)\b/i.test(msgLower)) installItem = 'water_filter';
        else if (/\b(?:under\s*sink\s*filter)\b/i.test(msgLower)) installItem = 'under_sink_filter';
        else if (/\b(?:appliance)\b/i.test(msgLower)) installItem = 'appliance';
        else if (/\b(?:floor\s*drain|drain\s*line|drain)\b/i.test(msgLower)) installItem = 'drain';
        
        // GENERIC FALLBACK: If no primary fixture matched but install intent exists,
        // use 'generic_install' to ensure we NEVER exit or loop
        if (!installItem) {
          installItem = 'generic_install';
        }
        
        // Extract location from initial message if present
        // Expanded to catch more natural location phrases
        // IMPROVED: Match "in my laundry room", "in the basement", "my kitchen", etc.
        const locationPattern = /\b(?:in\s+)?(?:the\s+)?(?:my\s+)?(kitchen|bathroom|basement|garage|laundry\s*room|laundry|utility\s*room|utility|master\s*bath(?:room)?|guest\s*bath(?:room)?|powder\s*room|backyard|back\s*yard|outdoor|outside|yard|office|half\s*bath|guest\s*house|commercial|main\s*floor|upstairs|downstairs|first\s*floor|second\s*floor|mud\s*room|wet\s*bar|bar|pool\s*house|shed|workshop|crawl\s*space|attic)\b/i;
        const locationMatch = msgLower.match(locationPattern);
        const extractedLocation = locationMatch ? locationMatch[1] : null;
        
        // Initialize installFlow - always with confirmed item (no fixture selection question)
        if (!currentBooking.installFlow) {
          currentBooking.installFlow = {
            item: installItem,
            itemConfirmed: true,  // Always confirmed - use generic if no specific fixture
            locationAsked: false,
            location: extractedLocation,  // Pre-fill location if extracted
            isSpecialist: (installItem === 'generic_install')  // Treat generic as specialist flow
          };
        }
        
        // INSTALL LATCH: Lock install intent so it can't be reclassified away
        currentBooking.installIntentLocked = true;
        
        const install = currentBooking.installFlow;
        
        // Mark as introduced
        if (!hasBeenIntroduced(customerKey)) {
          markAsIntroduced(customerKey);
        }
        
        // If we already have location, skip to booking
        if (install.location) {
          currentBooking.stage = 'booking_details';
          setProblemTypeIfAllowed(currentBooking, `install_${install.item}`, 'specific_compound');
          currentBooking.location = install.location;
          bookingData.set(customerKey, currentBooking);
          
          // Format item name for display
          let itemNameForBooking;
          if (install.item === 'generic_install') {
            itemNameForBooking = 'installation';
          } else if (install.item === 'washer') {
            itemNameForBooking = 'washing machine installation';
          } else if (install.item === 'water_heater') {
            itemNameForBooking = 'water heater installation';
          } else if (install.item === 'garbage_disposal') {
