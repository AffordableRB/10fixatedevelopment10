        return {
          response: RESPONSE_TEMPLATES.cancellation(),
          booking: getBookingData(customerKey),
          debug: { intent: 'hard_stop', stage: 'cancelled' },
          metadata: { cancelled: true }
        };
      }
      
      // Tier 2: SOFT CANCEL - Natural language signals require confirmation
      // GUARD: Block during emergency mode, install intent, or if message has problem description
      const hasProblemDescription = /\b(?:leak|clog|drain|flood|burst|broken|water|toilet|sink|faucet|pipe|shower)\b/i.test(customerMessage);
      if (UX_BEHAVIORS.isCancellation(customerMessage) && 
          !currentBooking.emergencyModeActive && 
          !hasInstallVerb &&
          !hasProblemDescription &&
          !currentBooking.awaitingCancellationConfirm) {
        // Don't exit immediately - ask for confirmation
        currentBooking.awaitingCancellationConfirm = true;
        bookingData.set(customerKey, currentBooking);
        return {
          response: RESPONSE_TEMPLATES.cancellationConfirm(),
          booking: currentBooking,
          debug: { intent: 'soft_cancellation', stage: 'awaiting_cancel_confirm' },
          metadata: { awaitingCancellationConfirm: true }
