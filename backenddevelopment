    } else if (/\b(?:toilets?|tolets?|toylets?).*(?:weak\s+flush|poor\s+flush|barely\s+flush|half\s+flush|flush.*weak|flush.*poor|double\s+flush|flush\s+twice|have\s+to\s+flush\s+twice|need\s+to\s+flush\s+twice)\b/i.test(message) ||
